---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { getProductsByCategory } from '../../data/products';

const onGridProducts = getProductsByCategory('on-grid');
const singlePhase = onGridProducts.filter(p => p.phase === 'single');
const threePhase = onGridProducts.filter(p => p.phase === 'three');
---

<Layout
  title="On-Grid Inverters | Qbits Energy"
  description="High-efficiency on-grid solar inverters from 1kW to 100kW. Single and three-phase options with up to 98.8% efficiency, multi-MPPT, and smart monitoring."
  canonical="/on-grid-inverter/"
>
  <Header />

  <main>
    <PageHeader
      label="On-Grid Inverters"
      title="Grid-Tied Solar"
      highlight="Inverters"
      description="Maximize your solar investment with Qbits high-efficiency on-grid inverters. Designed for Indian conditions with advanced MPPT and smart monitoring."
    />

    <section class="section-padding bg-white" aria-labelledby="single-phase-heading">
      <div class="container-main">
        <h2 id="single-phase-heading" class="text-2xl font-bold text-slate-900 mb-8">Single Phase Inverters</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {singlePhase.map(product => (
            <a href={`/our-products/${product.id}/`} class="group card hover:border-brand-200 hover:shadow-lg transition-all">
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-semibold uppercase tracking-wider text-brand-600 bg-brand-50 px-2.5 py-1 rounded-full">1 Phase</span>
                <span class="text-xs text-slate-400">{product.id}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors">{product.name}</h3>
              <div class="grid grid-cols-3 gap-2 mt-4 pt-4 border-t border-slate-100">
                <div class="text-center"><p class="text-lg font-bold text-slate-900">{product.efficiency}</p><p class="text-[10px] text-slate-500 uppercase">Efficiency</p></div>
                <div class="text-center"><p class="text-lg font-bold text-slate-900">{product.mppt}</p><p class="text-[10px] text-slate-500 uppercase">MPPT</p></div>
                <div class="text-center"><p class="text-lg font-bold text-slate-900">{product.powerMax}kW</p><p class="text-[10px] text-slate-500 uppercase">Power</p></div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section-padding bg-slate-50" aria-labelledby="three-phase-heading">
      <div class="container-main">
        <h2 id="three-phase-heading" class="text-2xl font-bold text-slate-900 mb-8">Three Phase Inverters</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {threePhase.map(product => (
            <a href={`/our-products/${product.id}/`} class="group card hover:border-brand-200 hover:shadow-lg transition-all">
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-semibold uppercase tracking-wider text-brand-600 bg-brand-50 px-2.5 py-1 rounded-full">3 Phase</span>
                <span class="text-xs text-slate-400">{product.id}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors">{product.name}</h3>
              <div class="grid grid-cols-3 gap-2 mt-4 pt-4 border-t border-slate-100">
                <div class="text-center"><p class="text-lg font-bold text-slate-900">{product.efficiency}</p><p class="text-[10px] text-slate-500 uppercase">Efficiency</p></div>
                <div class="text-center"><p class="text-lg font-bold text-slate-900">{product.mppt}</p><p class="text-[10px] text-slate-500 uppercase">MPPT</p></div>
                <div class="text-center"><p class="text-lg font-bold text-slate-900">{product.powerMax}kW</p><p class="text-[10px] text-slate-500 uppercase">Power</p></div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>