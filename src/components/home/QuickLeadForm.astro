---
// Quick lead form surfaced near the top of the homepage.
// Posts to /api/lead (Odoo + Sheet, awaited) and to FormSubmit.co (email backup, zero-signup).
// Success is shown if either accepted the enquiry; see src/lib/lead-client.js.
---

<section class="bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 py-16 lg:py-24 border-t border-white/5" aria-labelledby="quick-lead-heading">
  <div class="container-main">
    <div class="max-w-5xl mx-auto bg-gradient-to-br from-brand-600/10 via-white/[0.02] to-transparent ring-1 ring-white/10 rounded-3xl p-8 sm:p-10 lg:p-14 backdrop-blur-sm">
      <div class="grid lg:grid-cols-[1fr_minmax(420px,1fr)] gap-10 lg:gap-14 items-center">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full bg-brand-500/15 ring-1 ring-brand-500/30 px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-brand-400">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-400 animate-pulse"></span>
            Inverter Enquiry
          </span>
          <h2 id="quick-lead-heading" class="mt-5 text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight tracking-tight">
            Discuss an inverter requirement with Qbits.
          </h2>
          <p class="mt-5 text-base sm:text-lg text-slate-300 leading-relaxed">
            Share your project details so Qbits can review the enquiry. Confirm the responsible contact, response time and scope after submission; this form does not promise sizing, savings or partner availability.
          </p>
          <ul class="mt-6 space-y-3 text-sm text-slate-300">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 mt-0.5 text-brand-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Confirm product fit and the current written supply terms.
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 mt-0.5 text-brand-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Share the model or capacity and project location.
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 mt-0.5 text-brand-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Prefer WhatsApp? Use the green button bottom-right.
            </li>
          </ul>
        </div>

        <form id="quick-lead-form" class="bg-white rounded-2xl p-6 sm:p-7 shadow-2xl shadow-brand-500/10 space-y-4" action="#" method="post">
          <div>
            <label for="ql-name" class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wider">Full name</label>
            <input type="text" id="ql-name" name="name" required maxlength="80" autocomplete="name" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all" placeholder="Your name" />
          </div>
          <div>
            <label for="ql-phone" class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wider">Phone</label>
            <input type="tel" id="ql-phone" name="phone" required pattern="[+0-9 ()\-]{7,16}" inputmode="tel" autocomplete="tel" maxlength="20" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all" placeholder="+91 ..." />
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="ql-city" class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wider">City</label>
              <input type="text" id="ql-city" name="city" required maxlength="60" autocomplete="address-level2" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all" placeholder="e.g. Surat" />
            </div>
            <div>
              <label for="ql-size" class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wider">System size</label>
              <select id="ql-size" name="systemSize" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all">
                <option>Not sure yet</option>
                <option>1 – 3 kW (small home)</option>
                <option>3 – 6 kW (typical home)</option>
                <option>6 – 10 kW (large home)</option>
                <option>10 – 50 kW (commercial)</option>
                <option>50 kW + (industrial)</option>
              </select>
            </div>
          </div>
          <div>
            <label for="ql-role" class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wider">Your role (optional)</label>
            <select id="ql-role" name="role" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm">
              <option value="">Select your role</option>
              <option>Solar Installer</option><option>EPC Company</option><option>System Integrator</option>
              <option>Dealer</option><option>Distributor</option><option>Developer</option><option>O&amp;M Company</option>
              <option>Home Owner</option><option>Commercial / Industrial Buyer</option>
            </select>
          </div>
          <!-- Honeypot -->
          <div aria-hidden="true" style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden">
            <label>Leave this empty: <input type="text" id="ql-hp_field_x7" name="hp_field_x7" tabindex="-1" autocomplete="off" /></label>
          </div>
          <input type="hidden" name="subject" value="Product Inquiry" />
          <button type="submit" id="ql-submit" class="w-full rounded-xl bg-brand-600 hover:bg-brand-700 transition-all duration-300 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-brand-600/30">
            <span data-ql-default>Send Inverter Enquiry</span>
            <span data-ql-sending class="hidden">Sending…</span>
          </button>
          <p id="ql-status" class="text-xs mt-1 hidden" role="status" aria-live="polite"></p>
          <p class="text-[11px] text-slate-400 leading-relaxed">
            By submitting, you agree to our <a href="/privacy-policy/" class="text-brand-600 hover:underline">Privacy Policy</a>.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    // Backup email path (FormSubmit). /api/lead (Odoo + Sheet) is awaited alongside it:
    // success if EITHER accepted the enquiry, error only if BOTH failed.
    const ENDPOINT = 'https://formsubmit.co/ajax/ritik@thestacc.com';
    const SUCCESS_MESSAGE = 'Thank you. Our team will get in touch about your inverter enquiry.';
    const ERROR_MESSAGE = 'Couldn’t send your request. Please call +91 99791 92935.';

    const form = document.getElementById('quick-lead-form');
    if (!form) return;
    const status = document.getElementById('ql-status');
    const btn = document.getElementById('ql-submit');
    const labelDefault = btn.querySelector('[data-ql-default]');
    const labelSending = btn.querySelector('[data-ql-sending]');
    const lead = window.QbLead;
    const guard = lead.createGuard();
    // One id per enquiry: reused if the visitor retries after a failure, replaced after success.
    let submissionId = null;

    const setSending = (sending) => {
      btn.disabled = sending;
      btn.setAttribute('aria-busy', sending ? 'true' : 'false');
      labelDefault.classList.toggle('hidden', sending);
      labelSending.classList.toggle('hidden', !sending);
    };

    const showStatus = (msg, ok) => {
      status.classList.remove('hidden');
      status.textContent = msg;
      status.className = 'text-xs mt-1 ' + (ok ? 'text-emerald-600' : 'text-rose-600');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (guard.isBusy()) return;
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      if ((form.elements.namedItem('hp_field_x7') || {}).value) {
        form.reset();
        showStatus(SUCCESS_MESSAGE, true);
        return;
      }

      if (!guard.begin()) return;
      setSending(true);
      try {
        if (!submissionId) submissionId = lead.newSubmissionId(window.crypto);
        const data = Object.assign(
          lead.collectFields(Array.from(new FormData(form).entries()), ['hp_field_x7']),
          lead.getAttribution(),
        );
        data.submission_id = submissionId;
        data.source = 'home-quick-lead';
        data.page = location.pathname;
        data.submittedAt = new Date().toISOString();
        data._subject = 'New Qbits lead (homepage): ' + (data.name || 'Unknown');
        data._template = 'table';
        data._captcha = 'false';

        lead.track(window.gtag, 'form_submit_attempt', { form_id: 'quick_lead' });

        const outcome = await lead.submitLead({
          data,
          sendEmail: () => lead.postFormSubmit(fetch, ENDPOINT, data),
        });

        if (outcome.success) {
          lead.trackLeadOnce(window.gtag, data.submission_id, {
            form_id: 'quick_lead',
            inquiry_type: 'Product Inquiry',
            buyer_role: data.role || '',
            source_page: location.pathname,
          });
          submissionId = null;
          form.reset();
          showStatus(SUCCESS_MESSAGE, true);
        } else {
          lead.track(window.gtag, 'form_error', { form_id: 'quick_lead', error_stage: 'crm_and_email' });
          showStatus(ERROR_MESSAGE, false);
        }
      } catch (err) {
        console.error('Quick-lead submission failed:', err);
        lead.track(window.gtag, 'form_error', { form_id: 'quick_lead', error_stage: 'client' });
        showStatus(ERROR_MESSAGE, false);
      } finally {
        guard.end();
        setSending(false);
      }
    });
  })();
</script>
