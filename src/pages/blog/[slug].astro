---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import { getAuthorByName } from '../../data/authors';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => {
    const sameCategory = posts
      .filter((p) => p.id !== post.id && p.data.category === post.data.category)
      .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date))
      .slice(0, 3);
    // If <3 same-category, pad with most recent overall
    if (sameCategory.length < 3) {
      const more = posts
        .filter((p) => p.id !== post.id && !sameCategory.find((s) => s.id === p.id))
        .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date))
        .slice(0, 3 - sameCategory.length);
      sameCategory.push(...more);
    }
    return {
      params: { slug: post.id },
      props: {
        post,
        relatedPosts: sameCategory.map((p) => ({
          slug: p.id,
          title: p.data.title,
          excerpt: p.data.excerpt,
          category: p.data.category,
          date: p.data.date,
          readTime: p.data.readTime,
          image: p.data.image,
        })),
      },
    };
  });
}

const { post, relatedPosts } = Astro.props;
const { Content, headings } = await render(post);
const {
  title,
  excerpt,
  description,
  category,
  date,
  readTime,
  image,
  author,
  keywords = [],
  faqs = [],
} = post.data;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const isoDate = new Date(date).toISOString();

const authorProfile = getAuthorByName(author);

// Build TOC from H2 headings
const toc = headings.filter((h) => h.depth === 2);

const canonicalUrl = `/blog/${post.id}/`;
const siteUrl = 'https://qbitsenergy.com';
const fullUrl = `${siteUrl}${canonicalUrl}`;
const categorySlug = category ? category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') : '';
const categoryUrl = categorySlug ? `/blog/category/${categorySlug}/` : '/blog/';

// Article JSON-LD schema
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description || excerpt,
  image: `${siteUrl}${image}`,
  datePublished: isoDate,
  dateModified: isoDate,
  author: {
    '@type': 'Organization',
    name: author,
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Qbits Energy',
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/images/logo.webp`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': fullUrl,
  },
  keywords: keywords.join(', '),
  articleSection: category,
};

// FAQPage JSON-LD schema
const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
} : null;

// Breadcrumb JSON-LD schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog/` },
    { '@type': 'ListItem', position: 3, name: title, item: fullUrl },
  ],
};
---

<Layout
  title={`${title} | Qbits Energy Blog`}
  description={description || excerpt}
  canonical={canonicalUrl}
>
  <HeaderV2 />

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <main id="main-content" class="bg-white">
    <!-- Hero: split layout -->
    <section class="relative overflow-hidden bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 pt-[104px] lg:pt-[120px]">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="absolute -top-40 -right-40 w-[28rem] h-[28rem] bg-brand-500/20 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-[28rem] h-[28rem] bg-accent/10 rounded-full blur-3xl"></div>

      <div class="container-main relative py-16 lg:py-24">
        <nav class="flex items-center gap-2 text-xs text-slate-400 mb-8" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white transition">Home</a>
          <span>/</span>
          <a href="/blog/" class="hover:text-white transition">Blog</a>
          <span>/</span>
          <a href={categoryUrl} class="hover:text-white transition">{category}</a>
          <span>/</span>
          <span class="text-slate-300 truncate">{title}</span>
        </nav>

        <div class="max-w-4xl">
          <a href={categoryUrl} class="inline-flex items-center gap-2 text-brand-400 font-bold uppercase tracking-wider text-xs bg-brand-500/15 ring-1 ring-brand-500/30 hover:bg-brand-500/25 hover:text-brand-300 px-3 py-1.5 rounded-full transition-colors">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-400"></span>
            {category}
          </a>

          <h1 class="mt-6 text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-white leading-[1.1] tracking-tight">{title}</h1>

          {excerpt && (
            <p class="mt-6 text-lg text-slate-300 leading-relaxed max-w-3xl">{excerpt}</p>
          )}

          <div class="mt-8 flex items-center gap-4 pt-6 border-t border-white/10">
            {authorProfile ? (
              <a href={`/authors/${authorProfile.slug}/`} class="flex-shrink-0">
                <img
                  src={authorProfile.photo}
                  alt={authorProfile.name}
                  width="48"
                  height="48"
                  class="w-12 h-12 rounded-full object-cover object-top ring-2 ring-white/20 hover:ring-brand-400 transition-all"
                />
              </a>
            ) : (
              <div class="w-12 h-12 rounded-full bg-gradient-to-br from-brand-400 to-brand-600 flex items-center justify-center text-white font-bold flex-shrink-0">
                {author?.[0] ?? 'Q'}
              </div>
            )}
            <div class="flex flex-col">
              {authorProfile ? (
                <a href={`/authors/${authorProfile.slug}/`} class="text-white font-semibold text-sm hover:text-brand-300 transition-colors">
                  {author}
                  <span class="ml-2 text-xs text-slate-400 font-normal">{authorProfile.role}</span>
                </a>
              ) : (
                <span class="text-white font-semibold text-sm">{author}</span>
              )}
              <div class="flex items-center gap-3 text-xs text-slate-400 mt-0.5">
                <span>{formattedDate}</span>
                <span class="w-1 h-1 rounded-full bg-slate-500"></span>
                <span>{readTime} read</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Body: content + sticky sidebar -->
    <section class="py-16 lg:py-20">
      <div class="container-main">
        <div class="grid lg:grid-cols-[minmax(0,1fr)_320px] gap-12 lg:gap-16">
          <article class="min-w-0">
            <div class="blog-content">
              <Content />
            </div>

            <!-- FAQ -->
            {faqs.length > 0 && (
              <div class="mt-16 pt-12 border-t border-slate-200">
                <div class="flex items-center gap-3 mb-8">
                  <span class="text-brand-600 font-bold uppercase tracking-wider text-xs bg-brand-500/10 px-3 py-1 rounded-full">FAQ</span>
                  <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">Frequently Asked Questions</h2>
                </div>
                <div class="space-y-3">
                  {faqs.map((f, i) => (
                    <details class="group rounded-xl border border-slate-200 bg-white hover:border-brand-300 transition-colors" open={i === 0}>
                      <summary class="flex items-center justify-between cursor-pointer list-none p-5 sm:p-6">
                        <span class="font-semibold text-slate-900 text-base sm:text-lg pr-4">{f.q}</span>
                        <span class="flex-shrink-0 w-8 h-8 rounded-full bg-slate-100 group-hover:bg-brand-500 group-hover:text-white text-slate-600 flex items-center justify-center transition-all">
                          <svg class="w-4 h-4 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                        </span>
                      </summary>
                      <div class="px-5 sm:px-6 pb-6 -mt-2 text-slate-600 leading-relaxed">{f.a}</div>
                    </details>
                  ))}
                </div>
              </div>
            )}

            <!-- Share + back -->
            <div class="mt-12 pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
              <a href="/blog/" class="inline-flex items-center gap-2 text-brand-600 hover:text-brand-700 font-semibold">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                Back to Blog
              </a>
              <div class="flex items-center gap-3">
                <span class="text-sm text-slate-500">Share:</span>
                <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${fullUrl}`} target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 hover:bg-brand-500 hover:text-white transition-all">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
                </a>
                <a href={`https://www.linkedin.com/shareArticle?mini=true&url=${fullUrl}&title=${encodeURIComponent(title)}`} target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 hover:bg-brand-500 hover:text-white transition-all">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                </a>
              </div>
            </div>

            <!-- Author box -->
            <div class="mt-16 rounded-2xl bg-gradient-to-br from-slate-50 to-white ring-1 ring-slate-200 p-6 sm:p-8">
              <div class="flex flex-col sm:flex-row gap-6">
                {authorProfile ? (
                  <a href={`/authors/${authorProfile.slug}/`} class="flex-shrink-0">
                    <img
                      src={authorProfile.photo}
                      alt={authorProfile.name}
                      width="80"
                      height="80"
                      class="w-20 h-20 rounded-2xl object-cover object-top ring-2 ring-slate-200 hover:ring-brand-400 transition-all"
                    />
                  </a>
                ) : (
                  <div class="w-20 h-20 flex-shrink-0 rounded-2xl bg-gradient-to-br from-brand-400 to-brand-600 flex items-center justify-center text-white text-2xl font-bold">
                    {author?.[0] ?? 'Q'}
                  </div>
                )}
                <div class="flex-1">
                  <div class="text-xs uppercase tracking-wider text-brand-600 font-bold">Written by</div>
                  {authorProfile ? (
                    <>
                      <h3 class="text-xl font-bold text-slate-900 mt-1">
                        <a href={`/authors/${authorProfile.slug}/`} class="hover:text-brand-600 transition-colors">
                          {authorProfile.name}
                        </a>
                        <span class="ml-2 text-sm font-normal text-slate-500">{authorProfile.role}, Qbits Energy</span>
                      </h3>
                      <p class="text-slate-600 mt-2 leading-relaxed">{authorProfile.shortBio}</p>
                      <div class="mt-4 flex items-center gap-4">
                        <a href={`/authors/${authorProfile.slug}/`} class="text-sm font-semibold text-brand-600 hover:text-brand-700">View all articles →</a>
                        <a href={authorProfile.linkedin} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-slate-500 hover:text-brand-600 inline-flex items-center gap-1">
                          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                          LinkedIn
                        </a>
                      </div>
                    </>
                  ) : (
                    <>
                      <h3 class="text-xl font-bold text-slate-900 mt-1">{author}</h3>
                      <p class="text-slate-600 mt-2 leading-relaxed">The Qbits Energy editorial team writes about solar inverters, battery storage, and the hardware powering India's energy transition.</p>
                      <div class="mt-4">
                        <a href="/about-us/" class="text-sm font-semibold text-brand-600 hover:text-brand-700">More about Qbits →</a>
                      </div>
                    </>
                  )}
                </div>
              </div>
            </div>
          </article>

          <!-- Sticky sidebar -->
          <aside class="lg:block lg:self-start">
            <div class="lg:sticky lg:top-28 space-y-6 lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto lg:pr-1 lg:-mr-1">
              <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-brand-600 via-brand-700 to-slate-900 p-6 text-white shadow-xl">
                <div class="absolute -top-10 -right-10 w-32 h-32 bg-white/10 rounded-full blur-2xl"></div>
                <div class="relative">
                  <span class="inline-block text-[10px] font-bold uppercase tracking-widest bg-white/15 px-2.5 py-1 rounded-full">Free Consultation</span>
                  <h3 class="mt-4 text-xl font-bold leading-tight">Planning a solar project?</h3>
                  <p class="mt-2 text-sm text-white/85 leading-relaxed">Talk to a Qbits engineer about sizing, products, and pricing.</p>
                  <a href="/contact-us/" class="mt-5 inline-flex items-center gap-2 bg-white text-brand-700 text-sm font-bold px-4 py-2.5 rounded-lg hover:bg-slate-100 transition">
                    Talk To Sales
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                  </a>
                </div>
              </div>

              {toc.length > 0 && (
                <nav class="rounded-2xl ring-1 ring-slate-200 bg-white p-6" aria-label="Table of contents">
                  <div class="flex items-center gap-2 mb-4">
                    <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-500">On this page</span>
                  </div>
                  <ul class="space-y-2 text-sm">
                    {toc.map((t) => (
                      <li>
                        <a href={`#${t.slug}`} class="toc-link block py-1.5 pl-3 border-l-2 border-slate-200 text-slate-600 hover:text-brand-600 hover:border-brand-500 transition-colors">{t.text}</a>
                      </li>
                    ))}
                  </ul>
                </nav>
              )}

              <div class="rounded-2xl ring-1 ring-slate-200 bg-white p-6">
                <h4 class="font-bold text-slate-900">Resources</h4>
                <p class="text-sm text-slate-500 mt-1">Datasheets and brochures</p>
                <a href="/download-datasheets/" class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand-600 hover:text-brand-700">
                  Browse downloads
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- Related posts -->
    {relatedPosts && relatedPosts.length > 0 && (
      <section class="bg-slate-50 py-16 lg:py-20" aria-labelledby="related-heading">
        <div class="container-main">
          <div class="flex items-center gap-3 mb-10">
            <span class="text-brand-600 font-bold uppercase tracking-wider text-xs bg-brand-500/10 px-3 py-1 rounded-full">Related Reading</span>
            <h2 id="related-heading" class="text-2xl sm:text-3xl font-bold text-slate-900">Continue exploring</h2>
          </div>
          <div class="grid md:grid-cols-3 gap-6">
            {relatedPosts.map((rp) => (
              <article class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:shadow-brand-500/5 transition-all duration-500 group">
                <a href={`/blog/${rp.slug}/`} class="block aspect-[16/10] overflow-hidden bg-slate-50">
                  <img src={rp.image} alt={rp.title} class="w-full h-full object-contain transition-transform duration-700 group-hover:scale-105" loading="lazy" width="640" height="400" />
                </a>
                <div class="p-6">
                  <div class="flex items-center gap-3 text-xs text-slate-400 mb-3">
                    <span class="text-brand-600 font-bold uppercase tracking-wider text-[10px] bg-brand-50 px-2 py-0.5 rounded-full">{rp.category}</span>
                    <span>{rp.readTime}</span>
                  </div>
                  <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-brand-600 transition-colors leading-snug">
                    <a href={`/blog/${rp.slug}/`}>{rp.title}</a>
                  </h3>
                  <p class="text-sm text-slate-500 line-clamp-2">{rp.excerpt}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Full-width final CTA -->
    <section class="relative overflow-hidden bg-gradient-to-br from-slate-950 via-brand-900 to-slate-950">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[40rem] h-[40rem] bg-brand-500/20 rounded-full blur-3xl"></div>
      <div class="container-main relative py-20 lg:py-28">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-flex items-center gap-2 rounded-full bg-white/5 border border-white/10 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-brand-400">
            <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
            Get Started
          </span>
          <h2 class="mt-6 text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight tracking-tight">
            Ready to power your project with Qbits?
          </h2>
          <p class="mt-5 text-base sm:text-lg text-slate-300 max-w-xl mx-auto">
            Get a personalized quote, request a product demo, or find your nearest distributor - our team is one click away.
          </p>
          <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/contact-us/" class="btn-primary text-sm py-3.5 px-8">
              Talk To Sales
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            <a href="/download-datasheets/" class="btn-outline text-sm py-3.5 px-8">
              Download Datasheets
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
  const targets = Array.from(links)
    .map((l) => document.querySelector(l.getAttribute('href') || ''))
    .filter((el): el is Element => !!el);

  if (targets.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            links.forEach((l) => {
              const active = l.getAttribute('href') === `#${id}`;
              l.classList.toggle('text-brand-600', active);
              l.classList.toggle('border-brand-500', active);
              l.classList.toggle('font-semibold', active);
            });
          }
        });
      },
      { rootMargin: '-30% 0px -60% 0px' }
    );
    targets.forEach((t) => observer.observe(t));
  }
</script>
