---
import '../styles/global.css';
import GooglePreferredSource from '../components/GooglePreferredSource.astro';
// Shared lead-form helper + first-touch attribution capture (see src/lib/lead-client.js).
// Comments and indentation are stripped so the inline copy stays small on every page.
import leadClientRaw from '../lib/lead-client.js?raw';

const leadClientSource =
  leadClientRaw
    .replace(/\/\*[\s\S]*?\*\//g, '')
    .replace(/^\s*\/\/.*$/gm, '')
    .replace(/^\s+/gm, '')
    .trim() +
  "\ntry{QbLead.captureFirstTouch({search:location.search,referrer:document.referrer,pathname:location.pathname},window.sessionStorage);}catch(e){}";

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  preloadImage?: string;
  language?: 'en' | 'hi';
}

const {
  title = 'Qbits Energy | Solar Inverter Company in India',
  description = 'Explore Qbits on-grid and hybrid solar inverter families, model-specific datasheets and product-selection information for projects in India.',
  ogImage = '/og-image.webp',
  canonical = Astro.url.pathname,
  noindex = false,
  preloadImage,
  language = 'en',
} = Astro.props;

const fullTitle = title.includes('Qbits') ? title : `${title} | Qbits Energy`;
const SITE = 'https://qbitsenergy.com';
const canonicalUrl = `${SITE}${canonical}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${SITE}${ogImage}`;

// Build-time env vars (set in Cloudflare Pages dashboard or .env):
//   PUBLIC_GTM_ID            — e.g. "GTM-XXXXXXX". When set, GA/GTM snippet renders.
//   PUBLIC_ROBOTS_NOINDEX    — "true" on preview/staging deployments (keeps pages.dev out of Google).
const GTM_ID = import.meta.env.PUBLIC_GTM_ID || '';
const ENV_NOINDEX = String(import.meta.env.PUBLIC_ROBOTS_NOINDEX || '').toLowerCase() === 'true';
const renderNoindex = noindex || ENV_NOINDEX;
const preferredSourcePath = new URL(canonicalUrl, SITE).pathname.replace(/\/+$/, '') || '/';
const preferredSourceContentRoutes = ['/blog', '/glossary', '/authors', '/events', '/installations'];
const showPreferredSource =
  !renderNoindex &&
  (preferredSourceContentRoutes.some(
    (route) => preferredSourcePath === route || preferredSourcePath.startsWith(`${route}/`)
  ) || preferredSourcePath === '/authorized-service-partners');
---

<!DOCTYPE html>
<html lang={language}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#10b981" />

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-SH1RZZHCXQ"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-SH1RZZHCXQ');
  </script>
  <!-- window.QbLead (form submit helper) + first-touch UTM/gclid/referrer/landing page in sessionStorage. No cookies. -->
  <script is:inline set:html={leadClientSource} />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {renderNoindex && <meta name="robots" content="noindex,nofollow" />}

  {GTM_ID && (
    <script is:inline set:html={`
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
      var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;
      j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','${GTM_ID}');
    `} />
  )}

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
  <link rel="shortcut icon" type="image/png" href="/favicon-192x192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <!-- Fonts: trimmed from 7 weights to 4 -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&display=swap" rel="stylesheet" />

  <!-- LCP preload (per-page) -->
  {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Qbits Energy" />
  <meta property="og:locale" content={language === 'hi' ? 'hi_IN' : 'en_IN'} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalUrl} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <!-- Structured Data - Organization -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Qbits Energy",
    "legalName": "Qbits Inverters Limited",
    "url": SITE,
    "logo": `${SITE}/images/logo.webp`,
    "description": "Qbits Energy provides on-grid and hybrid solar inverter families for residential, commercial and industrial projects in India. Check exact-model documentation and written supply terms.",
    "parentOrganization": {
      "@type": "Organization",
      "name": "Heaven Green Energy Limited"
    },
    "sameAs": [
      "https://www.linkedin.com/company/qbits-inverter/",
      "https://www.facebook.com/61575849178110/",
      "https://www.instagram.com/qbitsenergy/",
      "https://www.youtube.com/@qbitsenergy"
    ],
    "contactPoint": [{
      "@type": "ContactPoint",
      "telephone": "+919979192935",
      "contactType": "customer service",
      "areaServed": "IN",
      "availableLanguage": ["English", "Hindi"]
    }]
  })} />

  <!-- Structured Data - LocalBusiness -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": `${SITE}/#localbusiness`,
    "name": "Qbits Energy",
    "image": `${SITE}/images/logo.webp`,
    "url": SITE,
    "telephone": "+919979192935",
    "email": "service@qbitsenergy.com",
    "priceRange": "₹₹",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "201, Anupam Square, Mahadev Chowk, Mota Varachha",
      "addressLocality": "Surat",
      "addressRegion": "Gujarat",
      "postalCode": "394101",
      "addressCountry": "IN"
    },
    "areaServed": {
      "@type": "Country",
      "name": "India"
    }
  })} />

  <!-- Structured Data - WebSite -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Qbits Energy",
    "url": SITE,
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": `${SITE}/search/?q={search_term_string}`
      },
      "query-input": "required name=search_term_string"
    }
  })} />

  <!-- Per-page extra head (schema, preload, etc.) -->
  <slot name="head" />
</head>
<body>
  {GTM_ID && (
    <noscript>
      <iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`} height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
  )}
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-brand-600 focus:text-white focus:px-4 focus:py-2 focus:rounded-md focus:shadow-lg">Skip to content</a>
  <slot />
  {showPreferredSource && <GooglePreferredSource />}

  <!-- Sitewide conversion-event tracking via gtag.js (delegated — works regardless of GTM container status) -->
  <script is:inline>
    (function () {
      if (window.__qbTrackingBound) return; // guard against double-binding
      window.__qbTrackingBound = true;

      function fire(name, params) {
        try {
          if (typeof window.gtag === 'function') window.gtag('event', name, params || {});
        } catch (err) { /* tracking must never break the page */ }
      }

      // cta-events:begin (pure mapping, unit-tested in tests/cta-events.test.mjs)
      // info: { cta, model, action, id, href, pathname, text }  ->  { name, params }
      // One event per click. Priority: specific module event > tel/WhatsApp/PDF > generic cta_click.
      // Completed enquiries are NOT tracked here; forms fire generate_lead after confirmed success.
      function resolveClickEvent(info) {
        var cta = info.cta || '', model = info.model || '', action = info.action || '';
        var id = info.id || '', href = info.href || '', path = info.pathname || '';
        var text = String(info.text || '').trim().slice(0, 80);
        var isPdf = /\.pdf(\?|#|$)/i.test(href);
        var base = { link_url: href, page_path: path };
        if (cta) base.cta_id = cta;
        if (model && model !== 'hub') base.model_id = model;

        if (cta === 'related_inverter') {
          var linkType = model === 'hub' || action === 'hub' ? 'hub' : (action === 'datasheet' || isPdf ? 'datasheet' : 'view_model');
          var p = { source_path: path, link_type: linkType, link_url: href };
          if (model && model !== 'hub') p.model_id = model;
          return { name: 'related_inverter_click', params: p };
        }
        if (cta === 'glossary_apply_click') {
          return { name: 'glossary_apply_click', params: { source_path: path, link_url: href, link_text: text, term: path.replace(/\/+$/, '').split('/').pop() } };
        }
        if (cta === 'calculator_model_link' || id === 'calc-datasheet' || id === 'calc-product-page') {
          var lt = action === 'datasheet' || id === 'calc-datasheet' || isPdf ? 'datasheet' : 'product_page';
          var cp = { source_path: path, link_type: lt, link_url: href };
          var cm = model || (/\/our-products\/([^/?#]+)/.exec(href) || [])[1];
          if (cm) cp.model_id = decodeURIComponent(cm);
          return { name: 'calculator_model_link', params: cp };
        }
        var rowQuote = cta === 'datasheet_row_quote' || cta === 'datasheet_row_quote_click' ||
          (!cta && path === '/download-datasheets/' && /^\/contact-us\/\?[^#]*\bmodel=/.test(href));
        if (rowQuote) {
          var rp = { source_path: path, link_url: href };
          var rm = model || (/[?&]model=([^&#]+)/.exec(href) || [])[1];
          if (rm) rp.model_id = decodeURIComponent(rm);
          return { name: 'datasheet_row_quote_click', params: rp };
        }
        if (/^(https?:\/\/)?(api\.)?(wa\.me|whatsapp\.com)/i.test(href)) return { name: 'whatsapp_click', params: base };
        if (/^tel:/i.test(href)) return { name: 'phone_click', params: base };
        if (isPdf) return { name: 'datasheet_download', params: base };
        if (cta) {
          var gp = { cta_id: cta, cta_text: text, link_url: href, page_path: path };
          if (model && model !== 'hub') gp.model_id = model;
          return { name: 'cta_click', params: gp };
        }
        return null;
      }
      // cta-events:end
      window.QbCtaEvents = { resolve: resolveClickEvent };

      document.addEventListener('click', function (e) {
        try {
          var t = e.target;
          var ctaEl = t && t.closest ? t.closest('[data-cta]') : null;
          var link = t && t.closest ? t.closest('a[href]') : null;
          if (!ctaEl && !link) return;
          var el = ctaEl || link;
          var hit = resolveClickEvent({
            cta: ctaEl ? ctaEl.getAttribute('data-cta') : '',
            model: el.getAttribute('data-model') || (ctaEl && ctaEl.getAttribute('data-model')) || '',
            action: el.getAttribute('data-action') || '',
            id: el.id || '',
            href: (link || ctaEl).getAttribute('href') || '',
            pathname: location.pathname,
            text: el.textContent || '',
          });
          if (hit) fire(hit.name, hit.params);
        } catch (err) { /* never throw from the click listener */ }
      }, { passive: true });

      // Pagefind search usage — fire once per distinct non-trivial query, debounced.
      let lastQuery = '';
      let searchDebounce;
      document.addEventListener('input', function (e) {
        if (!e.target.matches || !e.target.matches('.pagefind-ui__search-input')) return;
        clearTimeout(searchDebounce);
        searchDebounce = setTimeout(function () {
          const q = (e.target.value || '').trim();
          if (q.length >= 2 && q !== lastQuery) {
            lastQuery = q;
            fire('search_used', { search_term: q });
          }
        }, 600);
      }, { passive: true });
    })();
  </script>
</body>
</html>
