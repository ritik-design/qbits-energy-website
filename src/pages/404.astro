---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeaderV2 from '../components/HeaderV2.astro';
import Footer from '../components/Footer.astro';

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .map((p) => ({
    slug: p.id,
    title: p.data.title,
    excerpt: p.data.excerpt,
    category: p.data.category,
    date: p.data.date,
    readTime: p.data.readTime,
  }))
  .sort((a, b) => +b.date - +a.date)
  .slice(0, 5);

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const destinations = [
  {
    title: 'On-Grid Inverters',
    description: 'Residential & commercial on-grid SKUs from 1.5 kW to 320 kW.',
    href: '/on-grid-inverter/',
    icon: 'grid',
  },
  {
    title: 'Hybrid Inverters',
    description: 'Battery-ready hybrid inverters with intelligent backup.',
    href: '/hybrid-inverter/',
    icon: 'battery',
  },
  {
    title: 'Residential Solution',
    description: 'Complete rooftop solar for Indian homes.',
    href: '/residential-solution/',
    icon: 'home',
  },
  {
    title: 'C & I Solution',
    description: 'Commercial and industrial solar engineered for India.',
    href: '/c-i-solution/',
    icon: 'building',
  },
  {
    title: 'Solar Blog',
    description: 'Buyer guides, comparisons, regulations, and technical deep-dives.',
    href: '/blog/',
    icon: 'document',
  },
  {
    title: 'Solar Glossary',
    description: '150+ solar and inverter terms explained for India.',
    href: '/glossary/',
    icon: 'book',
  },
  {
    title: 'Authorized Service Partners',
    description: 'Find certified Qbits installers and service centres near you.',
    href: '/authorized-service-partners/',
    icon: 'wrench',
  },
  {
    title: 'Download Datasheets',
    description: 'Technical specs, warranty documents, and product brochures.',
    href: '/download-datasheets/',
    icon: 'download',
  },
  {
    title: 'Contact Us',
    description: 'Talk to an engineer or partner with Qbits.',
    href: '/contact-us/',
    icon: 'phone',
  },
];
---

<Layout
  title="404, Page Not Found | Qbits Energy"
  description="The page you are looking for could not be found. Explore Qbits Energy's solar inverter products, technical guides, and service network across India."
  noindex={true}
>
  <HeaderV2 />

  <main id="main-content" class="bg-white">
    <!-- Hero -->
    <section class="relative overflow-hidden bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 pt-[104px] lg:pt-[120px]">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="absolute -top-40 -right-40 w-[28rem] h-[28rem] bg-brand-500/20 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-[28rem] h-[28rem] bg-brand-500/10 rounded-full blur-3xl"></div>

      <div class="container-main relative py-16 lg:py-24">
        <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6 flex-wrap" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white transition">Home</a>
          <span>/</span>
          <span class="text-slate-300">404</span>
        </nav>

        <div class="max-w-3xl">
          <span class="inline-flex items-center gap-2 text-brand-400 font-bold uppercase tracking-wider text-xs bg-brand-500/15 ring-1 ring-brand-500/30 px-3 py-1.5 rounded-full">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-400"></span>
            404 Error
          </span>

          <h1 class="mt-6 text-5xl sm:text-6xl lg:text-7xl font-bold text-white leading-[1.05] tracking-tight">
            This page isn't where we left it.
          </h1>

          <p class="mt-6 text-lg sm:text-xl text-slate-300 leading-relaxed max-w-2xl">
            The page you are looking for may have moved, been renamed, or never existed. The good news: everything else on Qbits Energy is one click away.
          </p>

          <!-- Quick actions -->
          <div class="mt-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <a
              href="/"
              class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-500 px-7 py-3.5 text-sm font-bold text-white hover:bg-brand-600 transition-colors shadow-lg shadow-brand-500/20"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
              Go to Homepage
            </a>
            <a
              href="/search/"
              class="inline-flex items-center justify-center gap-2 rounded-full bg-white/10 ring-1 ring-white/20 px-7 py-3.5 text-sm font-bold text-white hover:bg-white/15 hover:ring-white/30 transition-all"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              Search the site
            </a>
            <a
              href="/contact-us/"
              class="inline-flex items-center justify-center gap-2 rounded-full px-7 py-3.5 text-sm font-bold text-slate-300 hover:text-white transition-colors"
            >
              Talk to an engineer
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Popular destinations -->
    <section class="py-16 lg:py-20 bg-white" aria-labelledby="destinations-heading">
      <div class="container-main">
        <div class="mb-10">
          <span class="section-label">
            <span class="w-8 h-px bg-brand-500"></span>
            Popular destinations
          </span>
          <h2 id="destinations-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-4">
            Looking for one of these?
          </h2>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {destinations.map((d) => (
            <a
              href={d.href}
              class="group relative flex flex-col gap-2 rounded-2xl bg-slate-50 ring-1 ring-slate-200 p-6 hover:bg-brand-50/40 hover:ring-brand-200 transition-all"
            >
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-white ring-1 ring-slate-200 text-brand-600 group-hover:bg-brand-500 group-hover:text-white group-hover:ring-brand-500 transition-colors">
                  {d.icon === 'grid' && <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>}
                  {d.icon === 'battery' && <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>}
                  {d.icon === 'home' && <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>}
                  {d.icon === 'building' && <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>}
                  {d.icon === 'document' && <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>}
                  {d.icon === 'book' && <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>}
                  {d.icon === 'wrench' && <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/></svg>}
                  {d.icon === 'download' && <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>}
                  {d.icon === 'phone' && <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>}
                </span>
                <svg class="w-4 h-4 text-slate-300 group-hover:text-brand-500 group-hover:translate-x-0.5 transition-all flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </div>
              <h3 class="mt-3 text-base font-bold text-slate-900 group-hover:text-brand-700 transition-colors">{d.title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed">{d.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Recent from the blog -->
    {recentPosts.length > 0 && (
      <section class="py-16 lg:py-20 bg-slate-50" aria-labelledby="recent-heading">
        <div class="container-main">
          <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-10">
            <div>
              <span class="section-label">
                <span class="w-8 h-px bg-brand-500"></span>
                Fresh from the blog
              </span>
              <h2 id="recent-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-4">
                Or read what's new
              </h2>
            </div>
            <a href="/blog/" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-600 hover:text-brand-700">
              See all articles
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-8">
            {recentPosts.slice(0, 3).map((post) => (
              <article class="group flex flex-col">
                <a href={`/blog/${post.slug}/`} class="flex flex-col h-full">
                  <div class="flex items-center gap-3 mb-3">
                    <span class="text-brand-600 font-bold uppercase tracking-wider text-[10px] bg-white ring-1 ring-brand-100 px-2.5 py-1 rounded-full">{post.category}</span>
                    <span class="text-xs text-slate-400">{post.readTime}</span>
                  </div>
                  <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-brand-600 transition-colors leading-snug">
                    {post.title}
                  </h3>
                  <p class="text-sm text-slate-500 leading-relaxed line-clamp-2 mb-4">{post.excerpt}</p>
                  <div class="mt-auto pt-3 border-t border-slate-200 text-xs text-slate-400">
                    {formatDate(post.date)}
                  </div>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- CTA strip -->
    <section class="relative overflow-hidden bg-gradient-to-br from-slate-950 via-brand-900 to-slate-950">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[40rem] h-[40rem] bg-brand-500/20 rounded-full blur-3xl"></div>
      <div class="container-main relative py-20 lg:py-24">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight tracking-tight">
            Still can't find what you need?
          </h2>
          <p class="mt-5 text-base sm:text-lg text-slate-300 max-w-xl mx-auto">
            Our engineers can help you with product selection, system sizing, or any solar inverter question, within 48 hours.
          </p>
          <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/contact-us/" class="btn-primary text-sm py-3.5 px-8">Talk To An Engineer</a>
            <a href="/our-products/" class="btn-outline text-sm py-3.5 px-8">Explore Products</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
