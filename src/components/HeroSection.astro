---
const slides = [
  { image: '/images/slider-1.webp', alt: 'Qbits Solar Inverter Solutions' },
  { image: '/images/slider-2.webp', alt: 'Smart Solar Technology' },
  { image: '/images/slider-3.webp', alt: 'High Efficiency Inverters' },
  { image: '/images/slider-4.webp', alt: 'Reliable Solar Power' },
];

const marqueeText = 'Smart Solar Solutions • Clean Energy Power • High Efficiency Output • Long-Lasting Performance • 24/7 Customer Support • Eco-Friendly Innovation • Reliable Solar Protection • ';
---

<section class="relative pt-[104px] lg:pt-[120px]" aria-label="Hero Banner">
  <!-- Slider -->
  <div class="relative w-full h-[400px] sm:h-[500px] lg:h-[600px] overflow-hidden" id="hero-slider">
    {slides.map((slide, i) => (
      <div class={`absolute inset-0 transition-opacity duration-1000 ${i === 0 ? 'opacity-100' : 'opacity-0'}`} data-slide={i}>
        <img width="1920" height="1080" src={slide.image} alt={slide.alt} class="w-full h-full object-cover" loading={i === 0 ? 'eager' : 'lazy'} />
        <div class="absolute inset-0 bg-gradient-to-r from-black/40 to-transparent"></div>
      </div>
    ))}

    <!-- Slider dots -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex items-center gap-2 z-10">
      {slides.map((_, i) => (
        <button class={`w-2.5 h-2.5 rounded-full transition-all duration-300 ${i === 0 ? 'bg-white w-8' : 'bg-white/50 hover:bg-white/80'}`} data-dot={i} aria-label={`Go to slide ${i + 1}`}></button>
      ))}
    </div>
  </div>

  <!-- Marquee -->
  <div class="bg-brand-500 text-white py-3 overflow-hidden">
    <div class="flex whitespace-nowrap animate-marquee">
      <span class="text-sm font-medium tracking-wide">{marqueeText}{marqueeText}{marqueeText}</span>
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.33%); }
  }
  .animate-marquee {
    animation: marquee 30s linear infinite;
  }
</style>

<script>
  const slides = document.querySelectorAll('[data-slide]');
  const dots = document.querySelectorAll('[data-dot]');
  let current = 0;

  function showSlide(index: number) {
    slides.forEach((s, i) => {
      s.classList.toggle('opacity-100', i === index);
      s.classList.toggle('opacity-0', i !== index);
    });
    dots.forEach((d, i) => {
      d.classList.toggle('w-8', i === index);
      d.classList.toggle('bg-white', i === index);
      d.classList.toggle('bg-white/50', i !== index);
    });
    current = index;
  }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => showSlide(i));
  });

  setInterval(() => {
    showSlide((current + 1) % slides.length);
  }, 5000);
</script>
