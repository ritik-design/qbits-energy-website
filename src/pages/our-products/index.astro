---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { products } from '../../data/products';

const onGrid = products.filter(p => p.category === 'on-grid');
const hybrid = products.filter(p => p.category === 'hybrid');
---

<Layout
  title="Our Products | Qbits Energy"
  description="Explore Qbits range of on-grid and hybrid solar inverters. From 1kW residential to 100kW commercial solutions. BIS certified with 12-year warranty."
  canonical="/our-products/"
>
  <Header />

  <main>
    <PageHeader
      label="Product Catalogue"
      title="Explore Our"
      highlight="Solar Inverters"
      description="From residential rooftops to industrial installations, Qbits delivers reliable, efficient solar inverters for every application."
    />

    <!-- On-Grid Section -->
    <section class="section-padding bg-white" aria-labelledby="ongrid-heading">
      <div class="container-main">
        <h2 id="ongrid-heading" class="text-2xl sm:text-3xl font-bold text-slate-900 mb-8 flex items-center gap-3">
          <span class="w-10 h-10 rounded-lg bg-brand-50 flex items-center justify-center text-brand-600">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </span>
          On-Grid Inverters
        </h2>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {onGrid.map(product => (
            <a href={`/our-products/${product.id}/`} class="group card hover:border-brand-200 hover:shadow-lg transition-all">
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-semibold uppercase tracking-wider text-brand-600 bg-brand-50 px-2.5 py-1 rounded-full">{product.phase === 'single' ? 'Single Phase' : 'Three Phase'}</span>
                <span class="text-xs text-slate-400">{product.id}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors mb-2">{product.name}</h3>
              <div class="grid grid-cols-3 gap-2 mt-4 pt-4 border-t border-slate-100">
                <div class="text-center">
                  <p class="text-lg font-bold text-slate-900">{product.efficiency}</p>
                  <p class="text-[10px] text-slate-500 uppercase">Efficiency</p>
                </div>
                <div class="text-center">
                  <p class="text-lg font-bold text-slate-900">{product.mppt}</p>
                  <p class="text-[10px] text-slate-500 uppercase">MPPT</p>
                </div>
                <div class="text-center">
                  <p class="text-lg font-bold text-slate-900">{product.powerMax}kW</p>
                  <p class="text-[10px] text-slate-500 uppercase">Power</p>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Hybrid Section -->
    <section class="section-padding bg-slate-50" aria-labelledby="hybrid-heading">
      <div class="container-main">
        <h2 id="hybrid-heading" class="text-2xl sm:text-3xl font-bold text-slate-900 mb-8 flex items-center gap-3">
          <span class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
          </span>
          Hybrid Inverters
        </h2>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {hybrid.map(product => (
            <a href={`/our-products/${product.id}/`} class="group card hover:border-brand-200 hover:shadow-lg transition-all">
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-semibold uppercase tracking-wider text-accent bg-accent/10 px-2.5 py-1 rounded-full">{product.phase === 'single' ? 'Single Phase' : 'Three Phase'}</span>
                <span class="text-xs text-slate-400">{product.id}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors mb-2">{product.name}</h3>
              <div class="grid grid-cols-3 gap-2 mt-4 pt-4 border-t border-slate-100">
                <div class="text-center">
                  <p class="text-lg font-bold text-slate-900">{product.efficiency}</p>
                  <p class="text-[10px] text-slate-500 uppercase">Efficiency</p>
                </div>
                <div class="text-center">
                  <p class="text-lg font-bold text-slate-900">{product.mppt}</p>
                  <p class="text-[10px] text-slate-500 uppercase">MPPT</p>
                </div>
                <div class="text-center">
                  <p class="text-lg font-bold text-slate-900">{product.powerMax}kW</p>
                  <p class="text-[10px] text-slate-500 uppercase">Power</p>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 bg-brand-500">
      <div class="container-main text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">Need help choosing the right inverter?</h2>
        <p class="text-brand-100 mb-8 max-w-xl mx-auto">Our team can help you select the perfect inverter for your solar installation.</p>
        <a href="/contact-us/" class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-brand-600 hover:bg-brand-50 transition-colors">Contact Sales</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
