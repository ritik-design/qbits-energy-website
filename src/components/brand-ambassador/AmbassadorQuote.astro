---
// Variant 3 — Editorial quote card (light)
// Calm and premium. Sits comfortably between light sections on the homepage.
const {
  image = '/brand-ambassador/portrait-1.webp',
  name = 'Dilip Joshi',
} = Astro.props;

const stats = [
  { value: '10,000+', label: 'Installations' },
  { value: '8 + 4 Yr', label: 'Warranty' },
  { value: '98.8%', label: 'Efficiency' },
];
---

<section class="section-padding bg-slate-50" aria-labelledby="amb-quote-heading">
  <div class="container-main">
    <div class="mx-auto mb-16 max-w-2xl text-center">
      <span class="section-label">
        <span class="h-px w-8 bg-brand-500"></span>
        Brand Ambassador
      </span>
      <h2 id="amb-quote-heading" class="mt-6 text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight text-slate-900">
        Meet Our New <span class="text-gradient">Brand Ambassador</span>
      </h2>
    </div>

    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
      <!-- Copy -->
      <div class="order-2 lg:order-1 lg:col-span-7">
        <p class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight text-slate-900">
          {name}
        </p>

        <p class="mt-4 text-xl sm:text-2xl font-medium text-slate-600">
          Now the face of <span class="text-gradient font-bold">Qbits Energy</span>
        </p>

        <p class="mt-6 max-w-xl text-base sm:text-lg leading-relaxed text-slate-600">
          India knows the name. India trusts the name. And from today, that name stands
          alongside the solar inverters powering homes and businesses across the country.
        </p>

        <div class="mt-10 flex flex-wrap gap-x-12 gap-y-6 border-t border-slate-200 pt-8">
          {stats.map((stat) => (
            <div>
              <p class="text-3xl sm:text-4xl font-bold text-slate-900">{stat.value}</p>
              <p class="mt-1 text-xs uppercase tracking-[0.18em] text-slate-500">{stat.label}</p>
            </div>
          ))}
        </div>

        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/about-us/" class="inline-flex items-center gap-2 rounded-full bg-slate-900 px-7 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-slate-800">
            About Qbits Energy
          </a>
          <a href="/contact-us/" class="inline-flex items-center gap-2 rounded-full border-2 border-slate-200 px-7 py-3.5 text-sm font-semibold text-slate-700 transition-all duration-300 hover:border-brand-500 hover:text-brand-600">
            Talk To Us
          </a>
        </div>
      </div>

      <!-- Portrait -->
      <div class="order-1 lg:order-2 lg:col-span-5">
        <div class="relative">
          <div class="overflow-hidden rounded-[2rem] bg-white shadow-xl shadow-slate-900/5 ring-1 ring-slate-200">
            <img
              src={image}
              alt={`${name}, Brand Ambassador of Qbits Energy, holding a Qbits solar inverter`}
              width="1200"
              height="1600"
              class="h-auto w-full object-cover"
              loading="lazy"
            />
          </div>
          <!-- Floating badge -->
          <div class="absolute -bottom-6 -left-4 hidden rounded-2xl bg-brand-500 px-6 py-4 shadow-lg shadow-brand-500/30 sm:block">
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-white/80">Brand Ambassador</p>
            <p class="mt-1 text-lg font-bold text-white">{name}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
