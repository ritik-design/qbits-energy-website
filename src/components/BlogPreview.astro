---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .map((p) => ({
    slug: p.id,
    title: p.data.title,
    excerpt: p.data.excerpt,
    category: p.data.category,
    date: p.data.date,
    readTime: p.data.readTime,
    image: p.data.image,
  }))
  .sort((a, b) => +b.date - +a.date)
  .slice(0, 3);

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<section class="section-padding bg-slate-50" aria-labelledby="blog-heading">
  <div class="container-main">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12">
      <div>
        <span class="section-label reveal">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
          </svg>
          Latest Insights
        </span>
        <h2 id="blog-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6 reveal reveal-delay-1">
          Solar Knowledge <span class="text-gradient">Hub</span>
        </h2>
      </div>
      <a href="/blog/" class="hidden sm:inline-flex items-center gap-2 text-sm font-semibold text-brand-600 hover:text-brand-700 transition-colors group">
        View All Articles
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
      {posts.map((post, i) => (
        <article class={`group card p-0 overflow-hidden hover:border-brand-200 reveal reveal-delay-${i + 1} relative`}>
          <a href={`/blog/${post.slug}/`} class="block h-48 overflow-hidden relative">
            <img src={post.image} alt={post.title} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
            <div class="absolute top-4 left-4">
              <span class="inline-flex items-center rounded-full bg-white/90 backdrop-blur px-3 py-1 text-xs font-semibold text-brand-700 shadow-sm">
                {post.category}
              </span>
            </div>
          </a>

          <div class="p-6">
            <div class="flex items-center gap-3 text-xs text-slate-400 mb-3">
              <span>{formatDate(post.date)}</span>
              <span class="w-1 h-1 rounded-full bg-slate-300"/>
              <span>{post.readTime} read</span>
            </div>

            <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-brand-700 transition-colors line-clamp-2">
              <a href={`/blog/${post.slug}/`} class="focus:outline-none focus:text-brand-700">
                {post.title}
              </a>
            </h3>

            <p class="text-sm text-slate-500 leading-relaxed line-clamp-3">{post.excerpt}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-8 text-center sm:hidden">
      <a href="/blog/" class="btn-secondary">View All Articles</a>
    </div>
  </div>
</section>
