# Copy to .env.local for local dev, or set in Cloudflare Pages dashboard → Settings → Environment Variables.
# All PUBLIC_* vars are inlined into the build and visible to clients. NEVER put secrets here.

# === Lead capture ===
# Apps Script Web App URL (must end in /exec). When unset, forms fall back to mailto.
# See google-apps-script/README.md.
PUBLIC_GAS_ENDPOINT=

# Shared token: client includes this in every form POST; Apps Script validates it.
# Not a real secret (it ships in the bundle) but filters opportunistic abuse.
PUBLIC_FORM_TOKEN=

# === Analytics ===
# GTM container ID, e.g. GTM-XXXXXXX. When unset, GTM snippet does not render.
PUBLIC_GTM_ID=

# === Indexing ===
# Set to "true" on preview/staging deployments (e.g. *.pages.dev) to keep them out of Google.
# Leave unset/blank on production qbitsenergy.com so the site is crawlable.
PUBLIC_ROBOTS_NOINDEX=
