---
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

const features = [
  { title: '10-320kW Range', desc: 'Scalable solutions for factories, warehouses, malls, and office complexes.', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
  { title: 'Parallel Operation', desc: 'Connect multiple inverters in parallel for MW-scale installations.', icon: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4' },
  { title: 'Remote Monitoring', desc: 'Centralized dashboard for multi-site management and performance analytics.', icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
  { title: 'Rapid ROI', desc: 'Typical payback period of 3-4 years with 25+ year system lifespan.', icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  { title: 'Multi-MPPT Technology', desc: 'Up to 10 MPPT channels for complex roof orientations and shading scenarios.', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
  { title: 'Grid Support Functions', desc: 'Reactive power control, frequency response, and grid stability features.', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
];

const segments = [
  { title: 'Manufacturing', desc: 'Reduce operational costs with rooftop solar. Typical systems: 50kW – 500kW.', icon: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z' },
  { title: 'Warehousing', desc: 'Large rooftop areas ideal for 100kW+ installations with rapid payback.', icon: 'M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z' },
  { title: 'Commercial Buildings', desc: 'Office complexes and retail spaces. Systems from 20kW to 200kW.', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
  { title: 'Educational Institutions', desc: 'Schools and colleges with large rooftops and daytime consumption.', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
];

const roiStats = [
  { value: '3-4', label: 'Year Payback', suffix: 'Y' },
  { value: '25+', label: 'Year Lifespan', suffix: 'Y' },
  { value: '60-80', label: 'Bill Reduction', suffix: '%' },
  { value: '98.8', label: 'Max Efficiency', suffix: '%' },
];
---

<Layout
  title="Commercial & Industrial Solar | Qbits Energy"
  description="Commercial and industrial solar inverter solutions from 10kW to 320kW. Parallel operation, remote monitoring, and maximum ROI for businesses."
  canonical="/c-i-solution/"
>
  <HeaderV2 />

  <main id="main-content">
    <PageHeader
      label="Solutions"
      title="Commercial & Industrial"
      highlight="Solar Solutions"
      description="Maximize your business's energy savings with Qbits commercial and industrial inverters. Scalable, reliable, and built for demanding applications."
      bgImage="/images/ongrid-commercial.webp"
    />

    <!-- Hero Content -->
    <section class="section-padding bg-white overflow-hidden" aria-labelledby="ci-heading">
      <div class="container-main">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div class="relative">
            <div class="absolute -top-10 -left-10 w-72 h-72 bg-brand-100 rounded-full blur-3xl opacity-50"></div>
            <div class="relative rounded-2xl overflow-hidden shadow-2xl">
              <img width="720" height="540" src="/homepage-new/partner-program.png" alt="Commercial Solar Installation" class="w-full" loading="lazy" />
            </div>
            <div class="absolute -bottom-6 -right-6 bg-white rounded-2xl shadow-xl p-5 hidden md:block">
              <p class="text-3xl font-bold text-brand-600">3-4Y</p>
              <p class="text-sm text-slate-500">Typical Payback</p>
            </div>
          </div>
          <div>
            <span class="section-label">
              <span class="w-8 h-px bg-brand-500"></span>
              For Business
            </span>
            <h2 id="ci-heading" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mt-6 mb-6 leading-tight">
              Power Your Business with Solar
            </h2>
            <p class="text-lg text-brand-600 font-semibold mb-6">
              Lower Costs. Higher Returns. Sustainable Operations.
            </p>
            <p class="text-slate-600 leading-relaxed mb-6">
              Qbits commercial and industrial inverters are designed for factories, warehouses, offices, and large-scale installations. With parallel operation capabilities and advanced monitoring, our inverters deliver reliable power and rapid return on investment.
            </p>
            <p class="text-slate-600 leading-relaxed mb-8">
              From 10kW to 320kW, our three-phase inverters with multi-MPPT technology handle complex roof structures and maximize energy harvest. BIS and IEC certified for grid compliance.
            </p>
            <div class="flex flex-wrap gap-4">
              <a href="/our-products/" class="btn-primary">Explore Inverters</a>
              <a href="/contact-us/" class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-slate-200 px-8 py-4 text-sm font-semibold text-slate-700 hover:border-brand-300 hover:text-brand-600 transition-all">
                Request Proposal
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ROI Stats -->
    <section class="py-20 lg:py-24 bg-slate-950 relative overflow-hidden" aria-labelledby="roi-heading">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="container-main relative">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="section-label justify-center text-brand-400">
            <span class="w-8 h-px bg-brand-400"></span>
            ROI
            <span class="w-8 h-px bg-brand-400"></span>
          </span>
          <h2 id="roi-heading" class="text-3xl sm:text-4xl font-bold text-white mt-6">
            Numbers That Matter
          </h2>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
          {roiStats.map(s => (
            <div class="text-center stat-item">
              <p class="text-4xl sm:text-5xl font-extrabold text-white">{s.value}<span class="text-brand-400">{s.suffix}</span></p>
              <p class="text-sm font-medium text-slate-400 mt-3 uppercase tracking-wider">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="section-padding bg-slate-50" aria-labelledby="features-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Features
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="features-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Built for Commercial Scale
          </h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map(f => (
            <div class="bg-white rounded-2xl p-8 feature-card">
              <div class="w-12 h-12 rounded-xl bg-brand-100 flex items-center justify-center text-brand-600 mb-5">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={f.icon}/></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">{f.title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Segments -->
    <section class="section-padding bg-white" aria-labelledby="segment-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Industries
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="segment-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Industries We Serve
          </h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {segments.map(s => (
            <div class="bg-slate-50 rounded-2xl p-8 segment-card hover:bg-brand-500 group transition-all duration-500">
              <div class="w-12 h-12 rounded-xl bg-brand-100 flex items-center justify-center text-brand-600 mb-5 group-hover:bg-white/20 group-hover:text-white transition-all">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={s.icon}/></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-white transition-colors">{s.title}</h3>
              <p class="text-sm text-slate-500 group-hover:text-brand-100 transition-colors">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 lg:py-32 bg-brand-500 text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="container-main relative text-center max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold mb-6">Ready to Cut Energy Costs?</h2>
        <p class="text-lg text-brand-100 mb-10">Get a detailed project proposal with ROI analysis for your commercial or industrial facility.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/contact-us/" class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-8 py-4 text-sm font-semibold text-brand-600 shadow-lg hover:bg-brand-50 transition-all">Request Proposal</a>
          <a href="/our-products/" class="btn-outline">View Products</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

