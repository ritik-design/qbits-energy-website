---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import HeaderV2 from '../../../components/HeaderV2.astro';
import Footer from '../../../components/Footer.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import { CATEGORY_CONTENT } from '../../../data/categoryContent';

export async function getStaticPaths() {
  const all = await getCollection('blog');
  const byCategory: Record<string, typeof all> = {};
  for (const post of all) {
    const cat = post.data.category;
    if (!cat) continue;
    (byCategory[cat] ||= []).push(post);
  }

  return Object.entries(byCategory).map(([category, posts]) => {
    const sorted = posts
      .map((p) => ({
        slug: p.id,
        title: p.data.title,
        excerpt: p.data.excerpt,
        category: p.data.category,
        date: p.data.date,
        readTime: p.data.readTime,
        image: p.data.image,
      }))
      .sort((a, b) => +new Date(b.date) - +new Date(a.date));

    return {
      params: { category: category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') },
      props: { category, posts: sorted },
    };
  });
}

const { category, posts } = Astro.props as {
  category: string;
  posts: any[];
};

const slug = category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const canonical = `/blog/category/${slug}/`;
const content = CATEGORY_CONTENT[slug];

const formatDate = (d: Date) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const faqSchema = content && content.faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;
---

<Layout
  title={`${category} - Solar Inverter ${category} Articles | Qbits Energy`}
  description={content
    ? content.intro.slice(0, 155).trim()
    : `All ${posts.length} Qbits Energy articles in the ${category} category - solar inverter ${category.toLowerCase()} content for buyers, installers, and dealers across India.`}
  canonical={canonical}
>
  <HeaderV2 />

  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}

  <main id="main-content">
    <PageHeader
      label="Category"
      title={category}
      highlight="Articles"
      description={`${posts.length} articles · solar inverter ${category.toLowerCase()} content from Qbits Energy.`}
    />

    <section class="section-padding bg-slate-50" aria-labelledby="cat-posts-heading">
      <div class="container-main">
        <nav class="flex items-center gap-2 text-sm text-slate-500 mb-10" aria-label="Breadcrumb">
          <a href="/" class="hover:text-brand-600 transition-colors">Home</a>
          <span class="text-slate-300">/</span>
          <a href="/blog/" class="hover:text-brand-600 transition-colors">Blog</a>
          <span class="text-slate-300">/</span>
          <span class="text-slate-900 font-medium">{category}</span>
        </nav>

        {content && (
          <div class="max-w-3xl mb-12">
            <p class="text-slate-600 leading-relaxed">{content.intro}</p>
          </div>
        )}

        <h2 id="cat-posts-heading" class="sr-only">{category} articles</h2>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post) => (
            <article class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:shadow-brand-500/5 transition-all duration-500 group">
              <a href={`/blog/${post.slug}/`} class="block aspect-[16/10] overflow-hidden bg-slate-50">
                <img src={post.image} alt={post.title} class="w-full h-full object-contain transition-transform duration-700 group-hover:scale-105" loading="lazy" width="640" height="400" />
              </a>
              <div class="p-6">
                <div class="flex items-center gap-3 text-xs text-slate-400 mb-3">
                  <span class="text-brand-600 font-bold uppercase tracking-wider text-[10px] bg-brand-50 px-2 py-0.5 rounded-full">{post.category}</span>
                  <span>{formatDate(post.date)}</span>
                  <span>{post.readTime}</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-brand-600 transition-colors leading-snug">
                  <a href={`/blog/${post.slug}/`}>{post.title}</a>
                </h3>
                <p class="text-sm text-slate-500 line-clamp-2">{post.excerpt}</p>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-12 text-center">
          <a href="/blog/" class="inline-flex items-center gap-2 text-brand-600 hover:text-brand-700 font-semibold">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            Back to all articles
          </a>
        </div>

        {content && content.faqs.length > 0 && (
          <div class="mt-16 pt-12 border-t border-slate-200 max-w-3xl">
            <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-6">Frequently Asked Questions</h2>
            <div class="space-y-3">
              {content.faqs.map((f) => (
                <details class="group rounded-xl ring-1 ring-slate-200 bg-white">
                  <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer font-semibold text-slate-900 list-none">
                    {f.q}
                    <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                  </summary>
                  <div class="px-5 pb-5 -mt-2 text-slate-600 leading-relaxed">{f.a}</div>
                </details>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
