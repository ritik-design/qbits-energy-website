---
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { products } from '../../data/products';

const categories = ['All', 'On-Grid', 'Hybrid'];

const docTypes = [
  { name: 'Datasheet', desc: 'Technical specifications and performance data' },
  { name: 'User Manual', desc: 'Installation and operation instructions' },
  { name: 'Warranty', desc: 'Warranty terms and claim procedures' },
  { name: 'Certificates', desc: 'BIS, IEC, and ISO certifications' },
];
---

<Layout
  title="Download Datasheets | Qbits Energy"
  description="Download product datasheets, manuals, warranty information, and certificates for all Qbits solar inverters."
  canonical="/download-datasheets/"
>
  <HeaderV2 />

  <main>
    <PageHeader
      label="Resources"
      title="Download"
      highlight="Datasheets"
      description="Access product datasheets, manuals, warranty documents, and certifications for all Qbits inverters."
    />

    <!-- Doc Types -->
    <section class="section-padding bg-white" aria-labelledby="doctypes-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Resources
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="doctypes-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Available Documents
          </h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-4xl mx-auto">
          {docTypes.map(d => (
            <div class="bg-slate-50 rounded-2xl p-8 text-center doc-card">
              <div class="w-14 h-14 mx-auto rounded-xl bg-brand-100 flex items-center justify-center text-brand-600 mb-5">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">{d.name}</h3>
              <p class="text-sm text-slate-500">{d.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Downloads Table -->
    <section class="section-padding bg-slate-50" aria-labelledby="downloads-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Downloads
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="downloads-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Product Documents
          </h2>
        </div>

        <div class="max-w-5xl mx-auto">
          <div class="flex flex-wrap gap-3 mb-8 justify-center">
            {categories.map((cat, i) => (
              <button class={`category-btn px-6 py-3 rounded-full text-sm font-semibold transition-all duration-300 ${i === 0 ? 'bg-brand-500 text-white shadow-lg shadow-brand-500/20' : 'bg-white text-slate-600 border border-slate-200 hover:border-brand-300'}`} data-category={cat.toLowerCase().replace(' ', '-')}>
                {cat}
              </button>
            ))}
          </div>

          <div class="bg-white rounded-2xl shadow-xl shadow-slate-900/5 overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead class="bg-slate-950 text-white">
                  <tr>
                    <th class="text-left px-6 py-4 font-semibold">SKU</th>
                    <th class="text-left px-6 py-4 font-semibold">Product Name</th>
                    <th class="text-left px-6 py-4 font-semibold">Category</th>
                    <th class="text-left px-6 py-4 font-semibold">Power</th>
                    <th class="text-left px-6 py-4 font-semibold">Documents</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {products.map((product) => (
                    <tr class="hover:bg-brand-50/50 transition-colors product-row" data-category={product.category}>
                      <td class="px-6 py-5 font-mono text-xs text-slate-500">{product.id}</td>
                      <td class="px-6 py-5 font-medium text-slate-900">{product.name}</td>
                      <td class="px-6 py-5">
                        <span class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ${product.category === 'on-grid' ? 'bg-brand-50 text-brand-700' : 'bg-accent/10 text-accent-dark'}`}>
                          {product.category === 'on-grid' ? 'On-Grid' : 'Hybrid'}
                        </span>
                      </td>
                      <td class="px-6 py-5 text-slate-500">{product.powerMax}kW</td>
                      <td class="px-6 py-5">
                        <div class="flex items-center gap-3">
                          <a href={`/downloads/datasheet-${product.id}.pdf`} class="inline-flex items-center gap-1.5 text-brand-600 hover:text-brand-700 font-medium text-xs">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                            Datasheet
                          </a>
                          <a href={`/downloads/manual-${product.id}.pdf`} class="inline-flex items-center gap-1.5 text-brand-600 hover:text-brand-700 font-medium text-xs">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                            Manual
                          </a>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 lg:py-32 bg-slate-950 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-brand-500/10 via-transparent to-accent/10"></div>
      <div class="container-main relative text-center max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">Can't Find What You Need?</h2>
        <p class="text-lg text-slate-400 mb-10">Contact our support team for additional documentation or technical assistance.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/contact-us/" class="btn-primary">Contact Support</a>
          <a href="https://wa.me/919979192935" target="_blank" rel="noopener" class="btn-outline">WhatsApp Us</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const btns = document.querySelectorAll('.category-btn');
  const rows = document.querySelectorAll('.product-row');

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-category');
      btns.forEach(b => {
        b.classList.remove('bg-brand-500', 'text-white', 'shadow-lg');
        b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
      });
      btn.classList.add('bg-brand-500', 'text-white', 'shadow-lg');
      btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');

      rows.forEach(row => {
        const rowCat = row.getAttribute('data-category');
        row.classList.toggle('hidden', cat !== 'all' && rowCat !== cat);
      });
    });
  });
</script>

