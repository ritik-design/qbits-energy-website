const inverterDB = [
  { id: 'qb-1540ktls',  name: 'QB 1.5-4.0KTLS',   acPower: '4.0 kW',   phase: '1Φ', vmax: 550,  mpptMin: 40,  mpptMax: 550,  mppts: 1,  strPerMppt: 1, iout: 17.4 },
  { id: 'qb-46ktls',    name: 'QB 4.6-6KTLS',     acPower: '6.0 kW',   phase: '1Φ', vmax: 550,  mpptMin: 50,  mpptMax: 500,  mppts: 1,  strPerMppt: 2, iout: 26.1 },
  { id: 'qb-46ktld',    name: 'QB 4-6KTLD',       acPower: '6.0 kW',   phase: '1Φ', vmax: 550,  mpptMin: 50,  mpptMax: 500,  mppts: 2,  strPerMppt: 1, iout: 26.1 },
  { id: 'qb-617ktlc',   name: 'QB 6-17KTLC',      acPower: '17 kW',    phase: '3Φ', vmax: 900,  mpptMin: 200, mpptMax: 800,  mppts: 2,  strPerMppt: 1, iout: 25.0 },
  { id: 'qb-2030ktlc',  name: 'QB 20-30KTLC',     acPower: '30 kW',    phase: '3Φ', vmax: 900,  mpptMin: 200, mpptMax: 800,  mppts: 3,  strPerMppt: 2, iout: 48.0 },
  { id: 'qb-3040ktlcp', name: 'QB 30-40KTLC-Pro', acPower: '40 kW',    phase: '3Φ', vmax: 900,  mpptMin: 200, mpptMax: 800,  mppts: 4,  strPerMppt: 2, iout: 63.0 },
  { id: 'qb-4050ktlcp', name: 'QB 40-50KTLC-Plus',acPower: '50 kW',    phase: '3Φ', vmax: 900,  mpptMin: 200, mpptMax: 800,  mppts: 4,  strPerMppt: 2, iout: 78.0 },
  { id: 'qb-5060ktlc',  name: 'QB 50-60KTLC',     acPower: '60 kW',    phase: '3Φ', vmax: 900,  mpptMin: 200, mpptMax: 800,  mppts: 6,  strPerMppt: 2, iout: 91.0 },
  { id: 'qb-70110ktlcp',name: 'QB 70-110KTLC-Pro',acPower: '110 kW',   phase: '3Φ', vmax: 1100, mpptMin: 200, mpptMax: 1000, mppts: 6,  strPerMppt: 2, iout: 155.0 },
  { id: 'qb-80125ktlc', name: 'QB 80-125KTLC',    acPower: '125 kW',   phase: '3Φ', vmax: 1100, mpptMin: 200, mpptMax: 1000, mppts: 6,  strPerMppt: 2, iout: 178.0 },
  { id: 'qb-225320ehv', name: 'QB 225-320K-EHV',  acPower: '320 kW',   phase: '3Φ', vmax: 1500, mpptMin: 500, mpptMax: 1450, mppts: 12, strPerMppt: 1, iout: 460.0 },
];
---

<Layout
  title="String Sizing Calculator | Qbits Energy"
  description="Smart solar string sizing tool for Qbits inverters. Select your panel and inverter to see all string configurations with MPPT voltage analysis."
  canonical="/string-sizing-calculator/"
>
  <HeaderV2 />

  <main id="main-content">
    <PageHeader
      label="Solar Tools"
      title="String Sizing"
      highlight="Calculator"
      description="Smart solar string sizing for Qbits Inverters. Select your panel and inverter to instantly see every string configuration rated from BEST to FAIL."
    />

    <section class="section-padding bg-slate-50">
      <div class="container-main max-w-5xl">

        <!-- Tool Card -->
        <div class="bg-white rounded-2xl shadow-xl shadow-slate-900/8 overflow-hidden">

          <!-- Tool Header -->
          <div class="bg-gradient-to-r from-brand-800 to-brand-500 px-8 py-6 text-white flex items-center gap-4">
            <div class="w-11 h-11 bg-white/20 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <h2 class="text-lg font-bold leading-tight">String Sizing Calculator</h2>
              <p class="text-sm text-brand-200">Smart solar string sizing for Qbits Inverters</p>
            </div>
          </div>

          <!-- Section 1: Equipment & Site Conditions -->
          <div class="px-8 py-7 border-b border-slate-100">
            <div class="flex items-center gap-3 mb-6">
              <span class="w-7 h-7 rounded-lg bg-brand-50 text-brand-700 text-sm font-bold flex items-center justify-center shrink-0">1</span>
              <h3 class="text-base font-bold text-brand-700">Equipment &amp; Site Conditions</h3>
            </div>

            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
              <div>
                <label class="field-label">PANEL</label>
                <select id="panel-select" class="tool-select">
                  <option value="">Select Panel</option>
                  {panelDB.map(p => <option value={p.id}>{p.name}</option>)}
                </select>
              </div>
              <div>
                <label class="field-label">INVERTER</label>
                <select id="inverter-select" class="tool-select">
                  <option value="">Select Inverter</option>
                  {inverterDB.map(inv => <option value={inv.id}>{inv.name}</option>)}
                </select>
              </div>
              <div>
                <label class="field-label">TOTAL PANELS</label>
                <input id="total-panels" type="number" min="1" max="200" placeholder="e.g. 10"
                  class="tool-input" />
              </div>
              <div>
                <label class="field-label">MIN TEMP (°C)</label>
                <input id="t-min" type="number" value="-5" class="tool-input" />
              </div>
            </div>

            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
              <div>
                <label class="field-label">MAX TEMP (°C)</label>
                <input id="t-max" type="number" value="50" class="tool-input" />
              </div>
            </div>

            <!-- Info cards -->
            <div id="info-cards" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6">
              <div id="panel-info" class="bg-brand-50/60 border border-brand-100 rounded-xl px-5 py-4">
                <p class="text-xs font-semibold uppercase tracking-wider text-brand-700 mb-3">Panel @ STC</p>
                <div class="grid grid-cols-3 gap-x-4 gap-y-1.5 text-sm">
                  <div><span class="text-slate-400 text-xs">Voc</span><br/><span class="font-semibold text-slate-800" id="pi-voc">-</span></div>
                  <div><span class="text-slate-400 text-xs">Vmp</span><br/><span class="font-semibold text-slate-800" id="pi-vmp">-</span></div>
                  <div><span class="text-slate-400 text-xs">Power</span><br/><span class="font-semibold text-slate-800" id="pi-watt">-</span></div>
                  <div><span class="text-slate-400 text-xs">Isc</span><br/><span class="font-semibold text-slate-800" id="pi-isc">-</span></div>
                  <div><span class="text-slate-400 text-xs">Imp</span><br/><span class="font-semibold text-slate-800" id="pi-imp">-</span></div>
                  <div><span class="text-slate-400 text-xs">T(Voc)</span><br/><span class="font-semibold text-slate-800" id="pi-tc">-</span></div>
                </div>
              </div>
              <div id="inverter-info" class="bg-slate-50 border border-slate-200 rounded-xl px-5 py-4">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-3">Inverter</p>
                <div class="grid grid-cols-3 gap-x-4 gap-y-1.5 text-sm">
                  <div><span class="text-slate-400 text-xs">Max DC</span><br/><span class="font-semibold text-slate-800" id="ii-vmax">-</span></div>
                  <div><span class="text-slate-400 text-xs">MPPT</span><br/><span class="font-semibold text-slate-800" id="ii-mppt">-</span></div>
                  <div><span class="text-slate-400 text-xs">AC</span><br/><span class="font-semibold text-slate-800" id="ii-ac">-</span></div>
                  <div><span class="text-slate-400 text-xs">MPPTs</span><br/><span class="font-semibold text-slate-800" id="ii-mppts">-</span></div>
                  <div><span class="text-slate-400 text-xs">Str</span><br/><span class="font-semibold text-slate-800" id="ii-str">-</span></div>
                  <div><span class="text-slate-400 text-xs">Iout</span><br/><span class="font-semibold text-slate-800" id="ii-iout">-</span></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section 2: MPPT Voltage Range -->
          <div id="section-2" class="hidden px-8 py-7 border-b border-slate-100">
            <div class="flex items-center gap-3 mb-6">
              <span class="w-7 h-7 rounded-lg bg-brand-50 text-brand-700 text-sm font-bold flex items-center justify-center shrink-0">2</span>
              <h3 class="text-base font-bold text-brand-700">MPPT Voltage Range &amp; String Distribution</h3>
            </div>

            <div class="flex items-center gap-4 mb-6">
              <span class="text-sm text-slate-600 font-medium">Panels per string:</span>
              <div class="flex items-center gap-2">
                <button id="dec-btn" class="stepper-btn">−</button>
                <input id="pps-input" type="number" value="6" min="1" max="50"
                  class="w-16 text-center text-base font-bold border border-slate-200 rounded-lg py-1.5 outline-none focus:border-brand-400" />
                <button id="inc-btn" class="stepper-btn">+</button>
              </div>
              <span id="s2-badge" class="hidden text-xs font-bold px-3 py-1 rounded-full"></span>
            </div>

            <!-- Voltage readouts -->
            <div class="grid grid-cols-3 gap-4 mb-6">
              <div class="bg-slate-50 rounded-xl p-4 text-center">
                <p class="text-xs text-slate-400 uppercase tracking-wider mb-1" id="s2-lbl-voc">VOC @ -°C</p>
                <p class="text-2xl font-extrabold text-slate-800" id="s2-voc-cold">-</p>
              </div>
              <div class="bg-brand-50 rounded-xl p-4 text-center ring-2 ring-brand-200">
                <p class="text-xs text-brand-500 uppercase tracking-wider mb-1" id="s2-lbl-vmp-hot">VMP @ -°C</p>
                <p class="text-2xl font-extrabold text-brand-700" id="s2-vmp-hot">-</p>
              </div>
              <div class="bg-slate-50 rounded-xl p-4 text-center">
                <p class="text-xs text-slate-400 uppercase tracking-wider mb-1" id="s2-lbl-vmp-cold">VMP @ -°C</p>
                <p class="text-2xl font-extrabold text-slate-800" id="s2-vmp-cold">-</p>
              </div>
            </div>

            <!-- Voltage bar -->
            <div class="mb-2">
              <div class="relative h-8 rounded-full bg-slate-100 overflow-visible">
                <!-- MPPT range fill -->
                <div id="bar-mppt" class="absolute top-0 bottom-0 bg-brand-200 rounded-full transition-all"></div>
                <!-- Over-voltage zone -->
                <div id="bar-over" class="absolute top-0 bottom-0 bg-red-100 rounded-r-full transition-all"></div>
                <!-- Max DC line -->
                <div id="bar-vmax-line" class="absolute top-0 bottom-0 w-0.5 bg-red-400 z-10 transition-all"></div>
                <!-- Marker: VOC cold -->
                <div id="bar-voc-cold" class="bar-marker bg-slate-600 transition-all" title="VOC @ min temp"></div>
                <!-- Marker: VMP hot -->
                <div id="bar-vmp-hot" class="bar-marker bg-brand-600 transition-all" title="VMP @ max temp"></div>
                <!-- Marker: VMP cold -->
                <div id="bar-vmp-cold" class="bar-marker bg-brand-400 transition-all" title="VMP @ min temp"></div>
              </div>
              <!-- Legend -->
              <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mt-3 text-xs text-slate-500">
                <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-brand-200 inline-block"></span>MPPT Range</span>
                <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-red-100 inline-block"></span>Over-voltage</span>
                <span class="flex items-center gap-1.5"><span class="w-0.5 h-3 bg-slate-600 inline-block"></span>Voc @ min</span>
                <span class="flex items-center gap-1.5"><span class="w-0.5 h-3 bg-brand-600 inline-block"></span>Vmp @ max</span>
                <span class="flex items-center gap-1.5"><span class="w-0.5 h-3 bg-brand-400 inline-block"></span>Vmp @ min</span>
                <span class="flex items-center gap-1.5 ml-auto font-medium text-slate-400" id="bar-max-label"></span>
              </div>
            </div>
          </div>

          <!-- Section 3: All String Configurations -->
          <div id="section-3" class="hidden px-8 py-7">
            <div class="flex items-center gap-3 mb-6">
              <span class="w-7 h-7 rounded-lg bg-brand-50 text-brand-700 text-sm font-bold flex items-center justify-center shrink-0">3</span>
              <h3 class="text-base font-bold text-brand-700">All String Configurations</h3>
            </div>

            <div class="overflow-x-auto rounded-xl border border-slate-100">
              <table class="w-full text-sm">
                <thead class="bg-slate-950 text-white text-xs uppercase tracking-wider">
                  <tr>
                    <th class="px-4 py-3 text-left font-semibold">Panels/String</th>
                    <th class="px-4 py-3 text-left font-semibold">Rating</th>
                    <th class="px-4 py-3 text-right font-semibold" id="th-voc-cold">VOC @ -°C</th>
                    <th class="px-4 py-3 text-right font-semibold" id="th-vmp-hot">VMP @ -°C</th>
                    <th class="px-4 py-3 text-right font-semibold" id="th-vmp-cold">VMP @ -°C</th>
                    <th class="px-4 py-3 text-right font-semibold">VOC (STC)</th>
                    <th class="px-4 py-3 text-right font-semibold">VMP (STC)</th>
                    <th class="px-4 py-3 text-right font-semibold">String kWp</th>
                  </tr>
                </thead>
                <tbody id="config-tbody" class="divide-y divide-slate-100"></tbody>
              </table>
            </div>

            <p class="text-xs text-slate-400 mt-4 text-center" id="table-footer"></p>
          </div>

        </div><!-- /tool card -->

        <!-- Disclaimer -->
        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5 mt-6 flex items-start gap-3">
          <svg class="w-5 h-5 text-amber-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
          <p class="text-sm text-amber-800 leading-relaxed">
            This calculator provides estimates using standard temperature derating formulas. Always verify against official datasheets and consult a qualified solar engineer before finalising your design. Qbits Energy is not liable for system designs based solely on this tool.
          </p>
        </div>

      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  @reference "../../styles/global.css";

  .field-label {
    @apply block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5;
  }
  .tool-select, .tool-input {
    @apply w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-800 bg-white outline-none focus:border-brand-400 focus:ring-2 focus:ring-brand-100 transition-colors;
  }
  .stepper-btn {
    @apply w-8 h-8 rounded-lg border border-slate-200 text-slate-600 font-bold hover:bg-brand-50 hover:border-brand-300 hover:text-brand-700 transition-colors flex items-center justify-center text-lg leading-none;
  }
  .bar-marker {
    @apply absolute top-1 bottom-1 w-0.5 z-20 rounded-full;
  }
</style>

<script define:vars={{ panelDB, inverterDB }}>
  // ── state ──────────────────────────────────────────────────────────────────
  let panel    = null;
  let inverter = null;
  let tMin     = -5;
  let tMax     = 50;
  let pps      = 6;   // panels per string

  // ── elements ────────────────────────────────────────────────────────────────
  const panelSel   = document.getElementById('panel-select');
  const invSel     = document.getElementById('inverter-select');
  const tMinEl     = document.getElementById('t-min');
  const tMaxEl     = document.getElementById('t-max');
  const ppsInput   = document.getElementById('pps-input');
  const decBtn     = document.getElementById('dec-btn');
  const incBtn     = document.getElementById('inc-btn');

  // ── core math ───────────────────────────────────────────────────────────────
  function derate(v, tc, t) {
    return v * (1 + (tc / 100) * (t - 25));
  }

  function getRating(vmpHot, vocCold, inv) {
    if (vocCold > inv.vmax)     return 'FAIL';
    if (vmpHot  < inv.mpptMin)  return 'FAIL';
    const pct = vmpHot / inv.vmax;
    if (pct < 0.25) return 'ON';
    if (pct < 0.40) return 'GOOD';
    if (pct < 0.65) return 'BEST';
    return 'GOOD';
  }

  const ratingCfg = {
    FAIL: { bg: 'bg-red-100',    text: 'text-red-700',    icon: '✕', label: 'FAIL' },
    ON:   { bg: 'bg-amber-100',  text: 'text-amber-700',  icon: '⚠', label: 'ON'   },
    GOOD: { bg: 'bg-green-100',  text: 'text-green-700',  icon: '✓', label: 'GOOD' },
    BEST: { bg: 'bg-brand-500',  text: 'text-white',      icon: '✓', label: 'BEST' },
  };

  // ── populate info cards ──────────────────────────────────────────────────────
  function showInfoCards() {
    if (!panel || !inverter) return;
    document.getElementById('info-cards').classList.remove('hidden');

    document.getElementById('pi-voc').textContent  = panel.voc + ' V';
    document.getElementById('pi-vmp').textContent  = panel.vmp + ' V';
    document.getElementById('pi-watt').textContent = panel.watt + ' Wp';
    document.getElementById('pi-isc').textContent  = panel.isc + ' A';
    document.getElementById('pi-imp').textContent  = panel.imp + ' A';
    document.getElementById('pi-tc').textContent   = panel.tc + '%/°C';

    document.getElementById('ii-vmax').textContent  = inverter.vmax + ' V';
    document.getElementById('ii-mppt').textContent  = inverter.mpptMin + '–' + inverter.mpptMax + ' V';
    document.getElementById('ii-ac').textContent    = inverter.acPower;
    document.getElementById('ii-mppts').textContent = inverter.mppts;
    document.getElementById('ii-str').textContent   = inverter.strPerMppt + '/MPPT';
    document.getElementById('ii-iout').textContent  = inverter.iout + ' A';
  }

  // ── update voltage bar ───────────────────────────────────────────────────────
  function pct(v, total) { return Math.min((v / total) * 100, 105).toFixed(2) + '%'; }

  function updateBar(n) {
    if (!panel || !inverter) return;
    const totalRange = inverter.vmax * 1.1;

    const vocCold = derate(panel.voc, panel.tc, tMin) * n;
    const vmpHot  = derate(panel.vmp, panel.tc, tMax) * n;
    const vmpCold = derate(panel.vmp, panel.tc, tMin) * n;

    // labels
    document.getElementById('s2-lbl-voc').textContent      = `VOC @ ${tMin}°C`;
    document.getElementById('s2-lbl-vmp-hot').textContent  = `VMP @ ${tMax}°C`;
    document.getElementById('s2-lbl-vmp-cold').textContent = `VMP @ ${tMin}°C`;

    document.getElementById('s2-voc-cold').textContent = vocCold.toFixed(1) + ' V';
    document.getElementById('s2-vmp-hot').textContent  = vmpHot.toFixed(1)  + ' V';
    document.getElementById('s2-vmp-cold').textContent = vmpCold.toFixed(1) + ' V';

    // badge
    const rating  = getRating(vmpHot, vocCold, inverter);
    const cfg     = ratingCfg[rating];
    const badge   = document.getElementById('s2-badge');
    badge.className = `text-xs font-bold px-3 py-1 rounded-full ${cfg.bg} ${cfg.text}`;
    badge.textContent = cfg.icon + ' ' + cfg.label;
    badge.classList.remove('hidden');

    // bar
    document.getElementById('bar-mppt').style.left  = pct(inverter.mpptMin, totalRange);
    document.getElementById('bar-mppt').style.width = ((inverter.mpptMax - inverter.mpptMin) / totalRange * 100).toFixed(2) + '%';
    document.getElementById('bar-over').style.left  = pct(inverter.vmax, totalRange);
    document.getElementById('bar-over').style.width = '10%';
    document.getElementById('bar-vmax-line').style.left = pct(inverter.vmax, totalRange);
    document.getElementById('bar-voc-cold').style.left  = pct(vocCold, totalRange);
    document.getElementById('bar-vmp-hot').style.left   = pct(vmpHot,  totalRange);
    document.getElementById('bar-vmp-cold').style.left  = pct(vmpCold, totalRange);
    document.getElementById('bar-max-label').textContent = 'Max DC: ' + inverter.vmax + ' V';
  }

  // ── build config table ───────────────────────────────────────────────────────
  function buildTable() {
    if (!panel || !inverter) return;

    // update table headers
    document.getElementById('th-voc-cold').textContent = `VOC @ ${tMin}°C`;
    document.getElementById('th-vmp-hot').textContent  = `VMP @ ${tMax}°C`;
    document.getElementById('th-vmp-cold').textContent = `VMP @ ${tMin}°C`;

    const tbody = document.getElementById('config-tbody');
    tbody.innerHTML = '';

    // generate rows until first VOC over-voltage fail (include it), max 30
    let rows = 0;
    for (let n = 1; n <= 30; n++) {
      const vocCold  = derate(panel.voc, panel.tc, tMin) * n;
      const vmpHot   = derate(panel.vmp, panel.tc, tMax) * n;
      const vmpCold  = derate(panel.vmp, panel.tc, tMin) * n;
      const vocSTC   = panel.voc * n;
      const vmpSTC   = panel.vmp * n;
      const kwp      = (panel.watt * n / 1000).toFixed(2);
      const rating   = getRating(vmpHot, vocCold, inverter);
      const cfg      = ratingCfg[rating];

      const isActive = n === pps;

      const tr = document.createElement('tr');
      tr.className = `transition-colors cursor-pointer ${isActive ? 'bg-brand-50' : 'hover:bg-slate-50'}`;
      tr.dataset.n = n;
      tr.innerHTML = `
        <td class="px-4 py-3 font-bold text-slate-900">${n}</td>
        <td class="px-4 py-3">
          <span class="inline-flex items-center gap-1 text-xs font-bold px-2.5 py-1 rounded-full ${cfg.bg} ${cfg.text}">
            ${cfg.icon} ${cfg.label}
          </span>
        </td>
        <td class="px-4 py-3 text-right tabular-nums ${vocCold > inverter.vmax ? 'text-red-600 font-semibold' : 'text-slate-600'}">${vocCold.toFixed(1)} V</td>
        <td class="px-4 py-3 text-right tabular-nums ${vmpHot < inverter.mpptMin ? 'text-red-600 font-semibold' : 'text-brand-700 font-semibold'}">${vmpHot.toFixed(1)} V</td>
        <td class="px-4 py-3 text-right tabular-nums text-slate-600">${vmpCold.toFixed(1)} V</td>
        <td class="px-4 py-3 text-right tabular-nums text-slate-500">${vocSTC.toFixed(1)} V</td>
        <td class="px-4 py-3 text-right tabular-nums text-slate-500">${vmpSTC.toFixed(1)} V</td>
        <td class="px-4 py-3 text-right tabular-nums text-slate-600 font-medium">${kwp}</td>
      `;

      // clicking a row updates the stepper & bar
      tr.addEventListener('click', () => {
        pps = n;
        ppsInput.value = n;
        updateBar(n);
        highlightRow(n);
      });

      tbody.appendChild(tr);
      rows++;

      // stop after first over-voltage fail
      if (vocCold > inverter.vmax) break;
    }

    document.getElementById('table-footer').textContent =
      `Panel Data: ${panel.name} · T(Voc): ${panel.tc}%/°C · STC: 25°C, 1000 W/m²  ·  © Qbits Energy`;
  }

  function highlightRow(n) {
    document.querySelectorAll('#config-tbody tr').forEach(tr => {
      tr.classList.toggle('bg-brand-50', Number(tr.dataset.n) === n);
      tr.classList.toggle('hover:bg-slate-50', Number(tr.dataset.n) !== n);
    });
  }

  // ── show / refresh sections 2 & 3 ───────────────────────────────────────────
  function refresh() {
    if (!panel || !inverter) return;
    document.getElementById('section-2').classList.remove('hidden');
    document.getElementById('section-3').classList.remove('hidden');
    updateBar(pps);
    buildTable();
  }

  // ── event listeners ──────────────────────────────────────────────────────────
  panelSel.addEventListener('change', () => {
    panel = panelDB.find(p => p.id === panelSel.value) || null;
    showInfoCards();
    refresh();
  });

  invSel.addEventListener('change', () => {
    inverter = inverterDB.find(i => i.id === invSel.value) || null;
    showInfoCards();
    // reset pps to a sensible default for new inverter
    if (inverter) {
      pps = Math.round(inverter.mpptMax * 0.55 / (panel?.vmp || 40));
      pps = Math.max(1, Math.min(pps, 20));
      ppsInput.value = pps;
    }
    refresh();
  });

  tMinEl.addEventListener('change', () => { tMin = parseFloat(tMinEl.value) || -5; refresh(); });
  tMaxEl.addEventListener('change', () => { tMax = parseFloat(tMaxEl.value) || 50;  refresh(); });

  decBtn.addEventListener('click', () => {
    if (pps > 1) { pps--; ppsInput.value = pps; updateBar(pps); highlightRow(pps); }
  });
  incBtn.addEventListener('click', () => {
    pps++; ppsInput.value = pps; updateBar(pps); highlightRow(pps);
  });
  ppsInput.addEventListener('change', () => {
    pps = Math.max(1, parseInt(ppsInput.value) || 1);
    ppsInput.value = pps;
    updateBar(pps);
    highlightRow(pps);
  });
</script>
