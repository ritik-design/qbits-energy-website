---
const challenges = [
  {
    title: 'Extreme Heat Resistance',
    desc: 'Advanced thermal management keeps inverters running at peak efficiency even at 50°C+ ambient temperatures.',
    icon: 'M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z',
  },
  {
    title: 'Grid Stability Protection',
    desc: 'Built-in protection against voltage fluctuations, frequency variations, and grid disturbances common in India.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
  {
    title: 'Dust & Monsoon Protection',
    desc: 'IP66-rated enclosures with specialized sealing to withstand dust storms and heavy monsoon rains.',
    icon: 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z',
  },
];
---

<section class="relative py-20 sm:py-28 lg:py-36 overflow-hidden bg-slate-950" aria-labelledby="challenges-heading">
  <!-- Full-width background image -->
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-gradient-to-l from-slate-950 via-slate-950/90 to-slate-950/70 z-10"></div>
    <img width="1920" height="1080"
      src="/homepage/built-for-india.webp"
      alt="Indian rooftop solar installation"
      class="w-full h-full object-cover object-center"
      loading="lazy"
    />
  </div>

  <div class="container-main relative z-20">
    <div class="max-w-2xl ml-auto">
      <span class="section-label text-brand-400">
        <span class="w-8 h-px bg-brand-500"></span>
        Built For India
      </span>

      <h2 id="challenges-heading" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mt-6 leading-tight">
        Solar Inverters Designed
        <span class="block mt-1 text-brand-400">For India.</span>
        <span class="block mt-1 text-white text-2xl sm:text-3xl">Not Adapted To India.</span>
      </h2>

      <div class="mt-10 space-y-4">
        {challenges.map((item) => (
          <div class="challenge-card flex items-start gap-4 rounded-2xl p-5 sm:p-6 bg-slate-800 border border-slate-600 shadow-lg">
            <div class="w-11 h-11 rounded-xl bg-brand-500/20 border border-brand-500/40 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon}/>
              </svg>
            </div>
            <div>
              <h3 class="text-base font-bold text-white mb-1">{item.title}</h3>
              <p class="text-sm text-slate-300 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
