---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

const features = [
  { title: '10-100kW Range', desc: 'Scalable for commercial needs', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
  { title: 'Parallel Operation', desc: 'Connect multiple inverters', icon: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4' },
  { title: 'Remote Monitoring', desc: 'Centralized dashboard access', icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
  { title: 'Rapid ROI', desc: 'Fast payback on investment', icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
];
---

<Layout
  title="Commercial & Industrial Solar | Qbits Energy"
  description="Commercial and industrial solar inverter solutions from 10kW to 100kW. Parallel operation, remote monitoring, and maximum ROI for businesses."
  canonical="/c-i-solution/"
>
  <Header />

  <main>
    <PageHeader
      label="Solutions"
      title="Commercial & Industrial"
      highlight="Solar Solutions"
      description="Maximize your business's energy savings with Qbits commercial and industrial inverters. Scalable, reliable, and built for demanding applications."
    />

    <section class="section-padding bg-white">
      <div class="container-main">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl font-bold text-slate-900 mb-4">Power Your Business with Solar</h2>
            <p class="text-slate-600 leading-relaxed mb-6">Qbits commercial and industrial inverters are designed for factories, warehouses, offices, and large-scale installations. With parallel operation capabilities and advanced monitoring, our inverters deliver reliable power and rapid return on investment.</p>
            <ul class="space-y-3">
              {features.map(f => (
                <li class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-lg bg-brand-50 flex items-center justify-center text-brand-600 shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={f.icon}/></svg>
                  </div>
                  <div>
                    <p class="font-semibold text-slate-900">{f.title}</p>
                    <p class="text-sm text-slate-500">{f.desc}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <img src="/images/ongrid-commercial.jpg" alt="Commercial Solar Installation" class="w-full rounded-2xl shadow-lg" loading="lazy" />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
