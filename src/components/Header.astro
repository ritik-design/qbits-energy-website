---
const currentPath = Astro.url.pathname;

const navLinks = [
  {
    label: 'Home', href: '/',
  },
  {
    label: 'About Qbits', href: '#', children: [
      { label: 'About Us', href: '/about-us/' },
      { label: 'Why Qbits?', href: '/why-qbits/' },
    ]
  },
  {
    label: 'Our Products', href: '#', children: [
      { label: 'On Grid Inverter', href: '/on-grid-inverter/' },
      { label: 'Hybrid Inverter', href: '/hybrid-inverter/' },
    ]
  },
  {
    label: 'Solution', href: '#', children: [
      { label: 'Residential Solution', href: '/residential-solution/' },
      { label: 'C & I Solution', href: '/c-i-solution/' },
    ]
  },
  { label: 'Become a Partner', href: '/contact-us/' },
  {
    label: 'Help Center', href: '#', children: [
      { label: 'Authorized Service Partners', href: '/authorized-service-partners/' },
      { label: 'Download Warranty', href: '/download-datasheets/' },
      { label: 'Support', href: '/contact-us/' },
    ]
  },
  {
    label: 'Resources', href: '#', children: [
      { label: 'Download Datasheets', href: '/download-datasheets/' },
      { label: 'Blog', href: '/blog/' },
      { label: 'Glossary', href: '/glossary/' },
      { label: 'Tools', href: '/string-sizing-calculator/' },
    ]
  },
];
---

<header class="fixed top-0 left-0 right-0 z-50" id="main-header">
  <!-- Top Bar -->
  <div class="bg-brand-500 text-white text-xs">
    <div class="container-main">
      <div class="flex items-center justify-between h-8">
        <div class="flex items-center gap-4">
          <a href="mailto:Service@qbitsenergy.com" class="flex items-center gap-1.5 hover:text-brand-100 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            Service@qbitsenergy.com
          </a>
          <a href="tel:+919979192935" class="hidden sm:flex items-center gap-1.5 hover:text-brand-100 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            +91 99791 92935
          </a>
        </div>
        <div class="flex items-center gap-3">
          <a href="https://www.facebook.com/61575849178110/" target="_blank" rel="noopener" class="hover:text-brand-100 transition-colors" aria-label="Facebook"><svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>
          <a href="https://www.instagram.com/qbitsenergy/" target="_blank" rel="noopener" class="hover:text-brand-100 transition-colors" aria-label="Instagram"><svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg></a>
          <a href="https://youtu.be/MSNAnT0y40k" target="_blank" rel="noopener" class="hover:text-brand-100 transition-colors" aria-label="YouTube"><svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg></a>
          <a href="https://www.linkedin.com/company/qbits-inverter/" target="_blank" rel="noopener" class="hover:text-brand-100 transition-colors" aria-label="LinkedIn"><svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Nav -->
  <div class="bg-white border-b border-slate-100">
    <div class="container-main">
      <div class="flex items-center justify-between h-16 lg:h-[72px]">
        <!-- Logo -->
        <a href="/" class="flex items-center shrink-0" aria-label="Qbits Energy Home">
          <img src="/images/footer-logo.webp" alt="Qbits Energy" class="h-10 lg:h-12 w-auto" />
        </a>

        <!-- Desktop Nav -->
        <nav class="hidden xl:flex items-center gap-1">
          {navLinks.map((link) => (
            link.children ? (
              <div class="relative group">
                <button class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-slate-600 hover:text-brand-600 transition-colors">
                  {link.label}
                  <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <div class="absolute top-full left-0 mt-0 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                  <div class="bg-white rounded-b-xl shadow-xl border border-t-0 border-slate-100 py-2 overflow-hidden">
                    {link.children.map((child) => (
                      <a href={child.href} class="block px-4 py-2.5 text-sm text-slate-600 hover:text-brand-600 hover:bg-brand-50 transition-colors">{child.label}</a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <a href={link.href} class={`px-3 py-2 text-sm font-medium transition-colors ${currentPath === link.href ? 'text-brand-600' : 'text-slate-600 hover:text-brand-600'}`}>
                {link.label}
              </a>
            )
          ))}
        </nav>

        <!-- Right Actions -->
        <div class="flex items-center gap-3">
          <a href="/contact-us/" class="hidden md:inline-flex items-center gap-2 rounded-lg bg-brand-500 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-600 transition-colors shadow-sm">
            Contact Us
          </a>
          <button id="mobile-menu-btn" class="xl:hidden p-2 rounded-lg text-slate-600 hover:bg-slate-100 transition-colors" aria-label="Toggle menu">
            <svg class="w-6 h-6 menu-open" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
            <svg class="w-6 h-6 menu-close hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="xl:hidden hidden bg-white border-b border-slate-200 shadow-xl max-h-[80vh] overflow-y-auto">
    <nav class="container-main py-4 space-y-1">
      {navLinks.map((link) => (
        link.children ? (
          <div class="space-y-1">
            <span class="block px-3 py-2 text-sm font-semibold text-slate-900">{link.label}</span>
            {link.children.map((child) => (
              <a href={child.href} class="block px-3 py-2 pl-6 text-sm text-slate-600 hover:text-brand-600 hover:bg-brand-50 rounded-lg transition-colors">{child.label}</a>
            ))}
          </div>
        ) : (
          <a href={link.href} class={`block px-3 py-2 text-sm font-medium rounded-lg transition-colors ${currentPath === link.href ? 'text-brand-600 bg-brand-50' : 'text-slate-600 hover:text-brand-600 hover:bg-brand-50'}`}>
            {link.label}
          </a>
        )
      ))}
    </nav>
  </div>
</header>

<script>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileBtn?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.toggle('hidden');
    mobileBtn.setAttribute('aria-expanded', String(!isHidden));
    mobileBtn.querySelector('.menu-open')?.classList.toggle('hidden');
    mobileBtn.querySelector('.menu-close')?.classList.toggle('hidden');
  });
</script>
