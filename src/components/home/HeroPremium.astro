---
---

<section class="relative min-h-screen flex items-center overflow-hidden bg-slate-950" aria-labelledby="hero-heading">
  <!-- Full-width background image -->
  <div class="absolute inset-0">
    <img
      src="/homepage/qbits-hero.webp"
      alt="Qbits solar inverter installation"
      class="hero-bg w-full h-full object-cover object-bottom scale-[1.05] origin-bottom"
      loading="eager"
    />
  </div>

  <!-- Floating particles effect -->
  <div class="absolute inset-0 z-20 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/4 right-1/4 w-2 h-2 rounded-full bg-brand-400/30 animate-pulse"></div>
    <div class="absolute top-1/3 right-1/3 w-1.5 h-1.5 rounded-full bg-brand-400/20 animate-pulse" style="animation-delay: 1s;"></div>
    <div class="absolute bottom-1/3 right-1/3 w-1 h-1 rounded-full bg-brand-400/40 animate-pulse" style="animation-delay: 2s;"></div>
    <div class="absolute top-2/3 right-1/4 w-2 h-2 rounded-full bg-accent/20 animate-pulse" style="animation-delay: 0.5s;"></div>
  </div>

  <!-- Content - aligned to grid, vertically centered -->
  <div class="container-main relative z-30 w-full py-24">
    <div class="max-w-2xl text-left">
      <span class="hero-badge inline-flex items-center gap-2 rounded-full bg-white/5 border border-white/10 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-brand-400 mb-6">
        <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
        India's Solar Inverter Pioneer
      </span>

      <h1 id="hero-heading" class="hero-headline text-left text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-white leading-[1.05] tracking-tight">
        Built For India's
        <span class="block mt-1 bg-gradient-to-r from-brand-400 via-brand-300 to-accent bg-clip-text text-transparent">
          Toughest Solar
        </span>
        <span class="block mt-1">Conditions</span>
      </h1>

      <p class="hero-desc text-left mt-6 text-base sm:text-lg text-white max-w-lg leading-relaxed">
        High-efficiency solar inverters engineered for India's heat, voltage fluctuations, dust, and demanding grid conditions.
      </p>

      <div class="hero-buttons mt-8 flex flex-col sm:flex-row items-start gap-4">
        <a href="/our-products/" class="btn-primary text-sm py-3.5 px-8">
          Explore Products
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="https://support.qbitsenergy.com/contactus?_gl=1*vncrp7*_ga*MTY3NTYxNjE4LjE3NzQzNzU3NTE.*_ga_CEKB9PFTBJ*czE3ODA0MDI3NDAkbzE0JGcwJHQxNzgwNDAyNzQwJGo2MCRsMCRoMA.." target="_blank" rel="noopener" class="btn-outline text-sm py-3.5 px-8">
          Contact us
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-30 flex flex-col items-center gap-2">
    <span class="text-xs text-slate-600 uppercase tracking-widest">Scroll</span>
    <svg class="w-5 h-5 text-slate-600 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
  </div>
</section>
