---
/**
 * Design A — "Wall of work" hero.
 *
 * Uses container-main, not container-wide: the hero has to line up with every
 * other section on the page rather than running 160px wider than them.
 *
 * Dark and full-bleed. Built for the top of /installations: one photograph held
 * large does the arguing before a line of copy is read. The institutional wall
 * is the right hero shot because scale is the claim — dozens of Qbits units on
 * a single elevation says more than six small tiles ever could.
 */
import { installations, invertersPictured } from '../../data/installations';

interface Props {
  heading?: 'h1' | 'h2';
  /** id from src/data/installations.ts */
  hero?: string;
}
const { heading: Heading = 'h1', hero = 'institutional-inverter-wall' } = Astro.props;

const heroShot =
  installations.find((i) => i.id === hero) ?? installations[0];

const stats = [
  { value: `${installations.length}`, label: 'Sites photographed' },
  { value: `${invertersPictured}+`, label: 'Qbits inverters in frame' },
  { value: '100%', label: 'Shot on site, unretouched' },
];
---

<section class="relative overflow-hidden bg-dark" aria-labelledby="install-hero-heading">
  <!-- Soft brand wash so the dark panel isn't flat -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.18]"
    style="background: radial-gradient(60% 55% at 15% 0%, #049D65 0%, transparent 70%), radial-gradient(50% 50% at 90% 100%, #F69133 0%, transparent 70%);"
    aria-hidden="true"
  >
  </div>

  <div class="container-main relative py-24 sm:py-28 lg:py-32">
    <div class="grid lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] gap-14 lg:gap-16 items-center">
      <!-- Copy -->
      <div>
        <span class="section-label">
          <span class="w-8 h-px bg-brand-500"></span>
          Installed &amp; Running
        </span>
        <Heading
          id="install-hero-heading"
          class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mt-6 leading-[1.05] tracking-tight"
        >
          Our inverters,<br />
          <span class="text-gradient">on real walls.</span>
        </Heading>
        <p class="text-lg text-slate-300 leading-relaxed mt-7 max-w-xl">
          Not renders. Not a studio. Every photograph below is a commissioned Qbits
          installation — rooftop parapets, stairwells, shop fronts and
          multi&#8209;inverter banks — shot exactly as the installer left it.
        </p>

        <dl class="grid grid-cols-3 gap-6 mt-10 max-w-lg">
          {stats.map((s) => (
            <div class="border-l-2 border-brand-500/70 pl-4">
              <dt class="sr-only">{s.label}</dt>
              <dd class="m-0">
                <span class="block text-2xl sm:text-3xl font-bold text-white">{s.value}</span>
                <span class="block text-xs text-slate-400 mt-1.5 leading-snug">{s.label}</span>
              </dd>
            </div>
          ))}
        </dl>

        <div class="flex flex-wrap gap-4 mt-10">
          <a href="#install-gallery" class="btn-primary">
            Browse every install
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>
          <a href="/become-our-partner" class="btn-outline">Become an installer</a>
        </div>
      </div>

      <figure class="m-0 w-full max-w-md lg:max-w-lg lg:ml-auto">
        <div class="relative overflow-hidden rounded-3xl ring-1 ring-white/10 bg-white/5 aspect-square">
          <img
            src={heroShot.image}
            alt={heroShot.alt}
            width="1600"
            height="1600"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover"
          />
          <span
            class="absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-black/75 to-transparent"
            aria-hidden="true"
          ></span>
          <figcaption class="absolute bottom-5 left-5 right-5 sm:bottom-6 sm:left-6 sm:right-6">
            <span class="block text-xs font-bold uppercase tracking-[0.2em] text-brand-400">
              {heroShot.setting}
            </span>
            <span class="block text-sm text-white/90 leading-relaxed mt-2">
              {heroShot.caption}
            </span>
          </figcaption>
        </div>
      </figure>
    </div>
  </div>
</section>
