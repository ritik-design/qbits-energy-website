const DEFAULT_LOADS = [
  { name: 'LED Lights', w: 10, qty: 6, h: 5 },
  { name: 'Ceiling Fan', w: 75, qty: 3, h: 8 },
  { name: 'Television', w: 100, qty: 1, h: 5 },
  { name: 'Refrigerator', w: 150, qty: 1, h: 12 },
  { name: 'Air Conditioner', w: 1500, qty: 1, h: 6 },
];
---

<Layout
  title="String Sizing &amp; Battery Calculator | Qbits Energy"
  description="Smart solar string sizing and hybrid battery sizing tool for Qbits inverters. Pick your Adani panel and Qbits inverter to see the optimal MPPT string layout, voltage-window checks, DC/AC ratio and — in Hybrid mode — the recommended battery bank."
  canonical="/string-sizing-calculator/"
>
  <HeaderV2 />

  <main id="main-content">
    <PageHeader
      label="Solar Tools"
      title="String Sizing"
      highlight="&amp; Battery Calculator"
      description="Match your Adani panels to the right Qbits inverter string configuration — and, for Hybrid systems, size the battery bank — instantly."
    />

    <section class="section-padding bg-slate-50">
      <div class="container-main max-w-6xl">

        <!-- Tool header -->
        <div class="flex items-start gap-4 mb-8">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center shrink-0 shadow-lg shadow-brand-500/30">
            <svg class="w-7 h-7" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19"></path>
            </svg>
          </div>
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 leading-tight">Solar String and Battery Sizing Calculator</h2>
            <p class="text-slate-500 mt-1">Match your Adani panels to the right Qbits inverter string configuration &mdash; instantly.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

          <!-- LEFT: System Inputs -->
          <div class="lg:col-span-5 bg-white rounded-2xl shadow-xl shadow-slate-900/8 p-6 sm:p-7">
            <h3 class="flex items-center gap-2 text-base font-bold text-slate-900 mb-5"><span class="w-2 h-2 rounded-full bg-brand-500 shrink-0"></span>System Inputs</h3>

            <div id="sysType" class="flex bg-slate-100 rounded-xl p-1 gap-1 mb-6">
              <button type="button" data-type="ongrid" class="sys-btn active flex-1 py-2.5 rounded-lg text-sm font-bold transition-colors">On-Grid</button>
              <button type="button" data-type="hybrid" class="sys-btn flex-1 py-2.5 rounded-lg text-sm font-bold transition-colors">Hybrid</button>
            </div>

            <label class="field-label" for="panel-select">Solar Panel (Adani)</label>
            <select id="panel-select" class="tool-select"></select>
            <div id="panelChips" class="flex flex-wrap gap-2 mt-3 mb-5"></div>

            <label class="field-label" for="inverter-select">Inverter (Qbits)</label>
            <select id="inverter-select" class="tool-select"></select>
            <div id="invChips" class="flex flex-wrap gap-2 mt-3 mb-5"></div>

            <label class="field-label" for="total-panels">Number of Panels</label>
            <input id="total-panels" type="number" min="1" max="5000" step="1" value="30" class="tool-input mb-5" />

            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="field-label" for="t-min">Min Temp (&deg;C)</label>
                <input id="t-min" type="number" step="1" value="5" class="tool-input" />
              </div>
              <div>
                <label class="field-label" for="t-max">Max Temp (&deg;C)</label>
                <input id="t-max" type="number" step="1" max="50" value="50" class="tool-input" />
              </div>
            </div>
            <p class="text-xs text-slate-400 mt-2 mb-6">Cold min temp raises Voc (over-voltage risk); hot max temp lowers Vmp. Defaults: 5&deg;C / 50&deg;C.</p>

            <!-- Hybrid backup loads -->
            <div id="hybrid-section" class="hidden">
              <div class="flex items-start gap-3 bg-blue-50 border border-blue-100 rounded-xl px-4 py-3 mb-5">
                <svg class="w-4 h-4 text-blue-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke-width="2"></circle><path stroke-linecap="round" stroke-width="2" d="M12 8h.01M11 12h1v4h1"></path></svg>
                <p class="text-xs text-blue-800 leading-relaxed">PV string sizing uses the hybrid inverter selected above; the battery bank is sized from the backup loads below.</p>
              </div>

              <label class="field-label">Backup Loads (Hybrid)</label>
              <div class="rounded-xl border border-slate-200 overflow-hidden">
                <div class="grid grid-cols-[1fr_70px_50px_56px_28px] gap-2 items-center px-4 py-2.5 bg-slate-50 text-[10px] font-bold uppercase tracking-wider text-slate-500">
                  <span>Appliance</span><span>Watts</span><span>Qty</span><span>Hrs</span><span></span>
                </div>
                <div id="loadRows"></div>
                <div class="flex justify-between items-center px-4 py-3 bg-brand-50/60 border-t border-slate-200 text-sm font-bold">
                  <span class="text-slate-700">Daily energy</span>
                  <span id="loadTotal" class="text-brand-700">0 Wh/day</span>
                </div>
              </div>
              <button type="button" id="addLoad" class="mt-2 w-full py-2.5 border border-dashed border-slate-300 rounded-lg text-brand-700 font-semibold text-sm hover:border-brand-400 hover:bg-brand-50/60 transition-colors">+ Add custom load</button>

              <div class="grid grid-cols-2 gap-4 mt-5">
                <div>
                  <label class="field-label" for="dod">Depth of Discharge (%)</label>
                  <input id="dod" type="number" min="10" max="100" step="1" value="90" class="tool-input" />
                </div>
                <div>
                  <label class="field-label" for="backupDays">Backup Days</label>
                  <input id="backupDays" type="number" min="0.5" max="7" step="0.5" value="1" class="tool-input" />
                </div>
              </div>
              <p class="text-xs text-slate-400 mt-2 mb-6">Battery is sized to cover the daily load at the set DOD, then rounded up to whole 5&nbsp;kWh stackable packs.</p>
            </div>

            <button class="calc-btn w-full py-3.5 rounded-xl font-bold text-white bg-gradient-to-r from-brand-500 to-brand-600 shadow-lg shadow-brand-500/30 hover:shadow-xl hover:from-brand-600 hover:to-brand-700 transition-all flex items-center justify-center gap-2" id="calcBtn">
              <svg class="calc-btn-icon w-[18px] h-[18px]" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0H5a2 2 0 0 1-2-2v-4m6 6h10a2 2 0 0 0 2-2v-4"></path></svg>
              <span class="calc-btn-label">Calculate String Sizing</span>
            </button>
          </div>

          <!-- RIGHT: Recommended Configuration -->
          <div class="lg:col-span-7 bg-white rounded-2xl shadow-xl shadow-slate-900/8 p-6 sm:p-7 lg:sticky lg:top-24">
            <h3 class="flex items-center gap-2 text-base font-bold text-slate-900 mb-5"><span class="w-2 h-2 rounded-full bg-brand-500 shrink-0"></span>Recommended Configuration</h3>
            <div id="results">
              <div class="border-2 border-dashed border-slate-200 rounded-2xl py-16 px-6 text-center text-slate-400 min-h-[420px] flex flex-col items-center justify-center">
                <svg class="w-12 h-12 mx-auto mb-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M3 3v18h18"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M7 14l3-3 3 3 5-6"></path></svg>
                <p class="font-semibold text-sm text-slate-500">Your optimal string layout will appear here</p>
                <p class="text-xs mt-1">Pick a panel &amp; inverter, then hit Calculate.</p>
              </div>
            </div>
          </div>

        </div>

        <p class="text-center text-xs text-slate-400 mt-8 leading-relaxed">
          Engine matches <b class="text-slate-500 font-semibold">Qbits</b> String Sizing logic &middot; Temperature-corrected voltage window, per-MPPT current &amp; DC/AC ratio checks.<br>
          Indicative sizing tool &mdash; always confirm against the manufacturer datasheet before installation.
        </p>

      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style is:global>
  @reference "../../styles/global.css";

  .field-label {
    @apply block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5;
  }
  .tool-select, .tool-input {
    @apply w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-800 bg-white outline-none focus:border-brand-400 focus:ring-2 focus:ring-brand-100 transition-colors;
  }
  .sys-btn {
    @apply text-slate-500;
  }
  .sys-btn.active {
    @apply bg-white text-slate-900 shadow-sm;
  }
  .chip {
    @apply inline-flex items-center gap-1 text-xs font-medium px-3 py-1.5 rounded-full bg-slate-100 text-slate-500 border border-slate-200;
  }
  .chip b {
    @apply text-slate-900 font-bold;
  }
  .load-row-input {
    @apply w-full px-2 py-1.5 text-sm rounded-md border border-slate-200 outline-none focus:border-brand-400 focus:ring-2 focus:ring-brand-100 transition-colors;
  }
  .calc-btn:disabled {
    @apply opacity-70 cursor-default;
  }
  .spinner {
    width: 16px; height: 16px; border: 2.5px solid rgba(255,255,255,.45);
    border-top-color: #fff; border-radius: 50%; animation: spin .7s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .vmark {
    position: absolute; top: -6px; width: 3px; height: 26px; border-radius: 2px;
    transform: translateX(-50%); transition: left .6s cubic-bezier(.2,.7,.2,1);
  }
  .vmark span {
    position: absolute; top: 28px; left: 50%; transform: translateX(-50%);
    font-size: 10px; font-weight: 700; white-space: nowrap;
  }
  .vwindow {
    transition: left .6s cubic-bezier(.2,.7,.2,1), width .6s cubic-bezier(.2,.7,.2,1);
  }
</style>

<script define:vars={{ PANELS, INVERTERS, DEFAULT_LOADS }}>
  var STC = 25;

  // Rating thresholds.
  var CFG = {
    BEST_CENTER: 0.75, BEST_HH: 0.05, BEST_HL: 0.15, BEST_VM: 0.05,
    GOOD_CENTER: 0.55, GOOD_HH: 0.03, GOOD_HL: 0.08, GOOD_VM: 0.03,
    OK_HH: 0.01, OK_HL: 0.02, OK_VM: 0.01,
    MAX_N: 40, MIN_RATING: 2,
    DC_LOSS: 0.96,
    CLIP_CRIT: 30, CLIP_HIGH: 15, CLIP_MOD: 5,
    DCAC_WARN: 1.5,
    DCAC_WARN_HYBRID: 2.0,
    PSH: 4.5,
    GEN_DAYS: 300,
  };

  var RATING_STYLE = {
    BEST:  { chip: 'bg-brand-500 text-white',  hex: '#049D65' },
    GOOD:  { chip: 'bg-blue-600 text-white',   hex: '#2563eb' },
    OK:    { chip: 'bg-accent text-white',     hex: '#F69133' },
    WORSE: { chip: 'bg-red-500 text-white',    hex: '#ef4444' },
    FAIL:  { chip: 'bg-red-600 text-white',    hex: '#dc2626' },
  };

  function vocAtTemp(voc, tc, t) { return voc * (1 + (tc / 100) * (t - STC)); }
  function vmpAtTemp(vmp, tc, t) { return vmp * (1 + (tc / 100) * (t - STC)); }

  function rateStringConfig(n, vocCold, vmpHot, vmpCold, invObj, sysLimit) {
    var sVocCold = n * vocCold, sVmpHot = n * vmpHot, sVmpCold = n * vmpCold;
    if (sVocCold > invObj.maxDcV) return { label: 'FAIL', score: 0, reason: 'String Voc ' + sVocCold.toFixed(0) + 'V > inverter max DC ' + invObj.maxDcV + 'V' };
    if (sVocCold > sysLimit)      return { label: 'FAIL', score: 0, reason: 'String Voc ' + sVocCold.toFixed(0) + 'V > ' + sysLimit + 'V system limit' };
    if (sVmpHot  < invObj.vmin)   return { label: 'FAIL', score: 0, reason: 'String Vmp@hot ' + sVmpHot.toFixed(0) + 'V < MPPT min ' + invObj.vmin + 'V' };
    if (sVmpCold > invObj.vmax)   return { label: 'FAIL', score: 0, reason: 'String Vmp@cold ' + sVmpCold.toFixed(0) + 'V > MPPT max ' + invObj.vmax + 'V' };

    var headroomHigh  = (invObj.vmax - sVmpCold) / invObj.vmax;
    var headroomLow   = (sVmpHot - invObj.vmin) / invObj.vmin;
    var voltageMargin = (invObj.maxDcV - sVocCold) / invObj.maxDcV;
    var midPoint      = (sVmpHot + sVmpCold) / 2;
    var centeredness  = 1 - Math.abs(midPoint - invObj.vnom) / (invObj.vmax - invObj.vmin);

    if (centeredness > CFG.BEST_CENTER && headroomHigh > CFG.BEST_HH && headroomLow > CFG.BEST_HL && voltageMargin > CFG.BEST_VM) return { label: 'BEST', score: 4 };
    if (centeredness > CFG.GOOD_CENTER && headroomHigh > CFG.GOOD_HH && headroomLow > CFG.GOOD_HL && voltageMargin > CFG.GOOD_VM) return { label: 'GOOD', score: 3 };
    if (headroomHigh > CFG.OK_HH && headroomLow > CFG.OK_HL && voltageMargin > CFG.OK_VM) return { label: 'OK', score: 2 };
    return { label: 'WORSE', score: 1 };
  }

  function getAllStringConfigs(panel, invObj, tMin, tMax, sysLimit) {
    var vocCold = vocAtTemp(panel.voc, panel.tcVoc, tMin);
    var vmpHot  = vmpAtTemp(panel.vmp, panel.tcVmp, tMax);
    var vmpCold = vmpAtTemp(panel.vmp, panel.tcVmp, tMin);
    var out = [];
    for (var n = 1; n <= CFG.MAX_N; n++) {
      var r = rateStringConfig(n, vocCold, vmpHot, vmpCold, invObj, sysLimit);
      out.push({ n: n, vocCold: n * vocCold, vmpHot: n * vmpHot, vmpCold: n * vmpCold, rating: r });
    }
    return out;
  }

  function optimizeMppt(totalPanels, invObj, panel, tMin, tMax, sysLimit) {
    var vocCold = vocAtTemp(panel.voc, panel.tcVoc, tMin);
    var vmpHot  = vmpAtTemp(panel.vmp, panel.tcVmp, tMax);
    var vmpCold = vmpAtTemp(panel.vmp, panel.tcVmp, tMin);

    var validMap = {};
    for (var n = 1; n <= CFG.MAX_N; n++) {
      var r = rateStringConfig(n, vocCold, vmpHot, vmpCold, invObj, sysLimit);
      if (r.score >= CFG.MIN_RATING) validMap[n] = r;
    }
    var validNs = Object.keys(validMap).map(Number);
    if (!validNs.length) return { error: 'No valid string size for this panel + inverter at these temperatures.' };

    var mppts = invObj.mppts;
    var impPerStr = panel.imp || panel.isc;
    var iscPerStr = panel.isc;
    var best = null;

    function tryConfig(dists, used) {
      if (used > totalPanels) return;
      var unused = totalPanels - used;
      var ns = dists.map(function (d) { return d.modulesPerString; });
      var gap = ns.length > 1 ? Math.abs(Math.max.apply(null, ns) - Math.min.apply(null, ns)) : 0;
      var isU = (new Set(ns)).size === 1;
      var minR = Math.min.apply(null, dists.map(function (d) { return d.rating.score; }));
      var avgR = dists.reduce(function (s, d) { return s + d.rating.score; }, 0) / dists.length;
      var overload = 0;
      dists.forEach(function (d) {
        if (d.strings * impPerStr > d.maxCur) overload++;
        if (d.strings * iscPerStr > d.maxIsc) overload++;
      });
      var sc = dists.map(function (d) { return d.strings; }).filter(function (s) { return s > 0; });
      var mpptsUsed = sc.length;
      var sGap = sc.length > 1 ? Math.max.apply(null, sc) - Math.min.apply(null, sc) : 0;
      var score = -overload * 1e13
        + mpptsUsed * 1e11
        - unused * 1e7
        - sGap * 1e5
        - gap * 1e3
        + (isU ? 500 : 0)
        + minR * 50
        + avgR * 1;
      if (!best || score > best.score) best = { distributions: dists, usedPanels: used, unusedPanels: unused, score: score };
    }
    function mk(i, s, n) {
      return { mpptIndex: i, strings: s, modulesPerString: n, totalModules: s * n, maxCur: mppts[i].cur, maxIsc: mppts[i].cur, maxStrings: mppts[i].str, rating: validMap[n] };
    }

    if (mppts.length === 1) {
      validNs.forEach(function (n) {
        for (var s = 1; s <= mppts[0].str; s++) { var u = s * n; if (u <= totalPanels) tryConfig([mk(0, s, n)], u); }
      });
    }
    if (mppts.length === 2) {
      validNs.forEach(function (n1) {
        for (var s1 = 1; s1 <= mppts[0].str; s1++) {
          var m1 = s1 * n1; if (m1 > totalPanels) continue;
          validNs.forEach(function (n2) {
            for (var s2 = 1; s2 <= mppts[1].str; s2++) {
              var m2 = s2 * n2; if (m1 + m2 > totalPanels) continue;
              tryConfig([mk(0, s1, n1), mk(1, s2, n2)], m1 + m2);
            }
          });
        }
      });
      validNs.forEach(function (n1) { for (var s = 1; s <= mppts[0].str; s++) { var u = s * n1; if (u <= totalPanels) tryConfig([mk(0, s, n1)], u); } });
      validNs.forEach(function (n2) { for (var s = 1; s <= mppts[1].str; s++) { var u = s * n2; if (u <= totalPanels) tryConfig([mk(1, s, n2)], u); } });
    }
    if (mppts.length === 3) {
      validNs.forEach(function (n1) {
        for (var s1 = 1; s1 <= mppts[0].str; s1++) {
          var m1 = s1 * n1; if (m1 > totalPanels) continue;
          validNs.forEach(function (n2) {
            for (var s2 = 1; s2 <= mppts[1].str; s2++) {
              var m2 = s2 * n2; if (m1 + m2 > totalPanels) continue;
              validNs.forEach(function (n3) {
                for (var s3 = 1; s3 <= mppts[2].str; s3++) {
                  var m3 = s3 * n3; if (m1 + m2 + m3 > totalPanels) continue;
                  tryConfig([mk(0, s1, n1), mk(1, s2, n2), mk(2, s3, n3)], m1 + m2 + m3);
                }
              });
            }
          });
        }
      });
    }
    if (mppts.length >= 4) {
      var caps = mppts.map(function (m) {
        var byImp = impPerStr > 0 ? Math.floor(m.cur / impPerStr) : m.str;
        var byIsc = iscPerStr > 0 ? Math.floor(m.cur / iscPerStr) : m.str;
        return Math.max(0, Math.min(m.str, byImp, byIsc));
      });
      var strict = caps.reduce(function (s, c) { return s + c; }, 0) > 0;
      var capAt = function (i) { return strict ? caps[i] : mppts[i].str; };
      var sortedNs = validNs.slice().sort(function (a, b) {
        return validMap[b].score !== validMap[a].score ? validMap[b].score - validMap[a].score : b - a;
      });
      sortedNs.forEach(function (N) {
        var wanted = Math.floor(totalPanels / N);
        var totalCap = 0; for (var j = 0; j < mppts.length; j++) totalCap += capAt(j);
        var toPlace = Math.min(wanted, totalCap);
        if (toPlace === 0) return;
        var counts = new Array(mppts.length).fill(0), placed = 0;
        while (placed < toPlace) {
          var progressed = false;
          for (var k = 0; k < mppts.length && placed < toPlace; k++) {
            if (counts[k] < capAt(k)) { counts[k]++; placed++; progressed = true; }
          }
          if (!progressed) break;
        }
        var dists = [];
        for (var i2 = 0; i2 < mppts.length; i2++) if (counts[i2] > 0) dists.push(mk(i2, counts[i2], N));
        if (dists.length) tryConfig(dists, toPlace * N);
      });
    }

    if (!best) return { error: 'Cannot fit these panels in any valid string configuration.' };

    var warnings = [];
    best.distributions.forEach(function (d) {
      var impA = d.strings * impPerStr, iscA = d.strings * iscPerStr;
      d.impA = impA; d.iscA = iscA; d.impOk = impA <= d.maxCur; d.iscOk = iscA <= d.maxIsc;
      if (!d.impOk) warnings.push('MPPT ' + (d.mpptIndex + 1) + ': ' + impA.toFixed(1) + 'A input current exceeds ' + d.maxCur + 'A limit.');
      if (!d.iscOk) warnings.push('MPPT ' + (d.mpptIndex + 1) + ': ' + iscA.toFixed(1) + 'A short-circuit current exceeds ' + d.maxIsc + 'A limit.');
    });
    best.warnings = warnings;
    return best;
  }

  function analyzeClipping(usedPanels, panelWp, invObj) {
    var dcPeak = usedPanels * panelWp;
    var dcDerated = dcPeak * CFG.DC_LOSS;
    var clippedW = Math.max(0, dcDerated - invObj.maxAcW);
    var clipPct = dcDerated > 0 ? (clippedW / dcDerated * 100) : 0;
    var sev = 'none';
    if (clipPct > CFG.CLIP_CRIT) sev = 'critical';
    else if (clipPct > CFG.CLIP_HIGH) sev = 'high';
    else if (clipPct > CFG.CLIP_MOD) sev = 'moderate';
    else if (clipPct > 0) sev = 'low';
    var annualLossKwh = (clippedW / 1000) * CFG.PSH * CFG.GEN_DAYS;
    return { dcPeak: dcPeak, dcAcRatio: (dcPeak / invObj.ratedW), clippedW: clippedW, clipPct: clipPct, annualLossKwh: annualLossKwh, severity: sev };
  }

  // ── DOM ──────────────────────────────────────────────────────────────────
  var $ = function (id) { return document.getElementById(id); };
  function esc(s) { return String(s).replace(/[&<>]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]; }); }
  function fmtKw(w) { return (w / 1000) + 'kW'; }

  var sysType = 'ongrid';
  var loads = DEFAULT_LOADS.map(function (l) { return { name: l.name, w: l.w, qty: l.qty, h: l.h }; });

  function renderInverterOptions(preferModel) {
    var invSel = $('inverter-select');
    var current = INVERTERS[+invSel.value] || null;
    var opts = INVERTERS
      .map(function (v, i) { return { v: v, i: i }; })
      .filter(function (o) { return o.v.type === sysType; })
      .map(function (o) { return '<option value="' + o.i + '">' + o.v.model + ' &middot; ' + fmtKw(o.v.ratedW) + ' ' + o.v.phase + ' &middot; ' + o.v.mppts.length + ' MPPT</option>'; })
      .join('');
    invSel.innerHTML = opts;
    var wantModel = preferModel || (current && current.type === sysType ? current.model : null);
    var idx = wantModel ? INVERTERS.findIndex(function (v) { return v.model === wantModel && v.type === sysType; }) : -1;
    if (idx < 0) idx = INVERTERS.findIndex(function (v) { return v.type === sysType; });
    invSel.value = String(idx);
  }

  function fillDropdowns() {
    $('panel-select').innerHTML = PANELS.map(function (p, i) { return '<option value="' + i + '">' + p.model + ' &middot; ' + p.wp + 'W</option>'; }).join('');
    $('panel-select').value = '0';
    renderInverterOptions('QB-10KTLC');
    renderChips();
  }

  function renderChips() {
    var p = PANELS[+$('panel-select').value];
    var v = INVERTERS[+$('inverter-select').value];
    if (!p || !v) return;
    $('panelChips').innerHTML =
      '<span class="chip">Voc <b>' + p.voc + 'V</b></span>' +
      '<span class="chip">Vmp <b>' + p.vmp + 'V</b></span>' +
      '<span class="chip">Isc <b>' + p.isc + 'A</b></span>' +
      '<span class="chip">Imp <b>' + p.imp + 'A</b></span>';
    $('invChips').innerHTML =
      '<span class="chip">Max DC <b>' + v.maxDcV + 'V</b></span>' +
      '<span class="chip">MPPT <b>' + v.vmin + '&ndash;' + v.vmax + 'V</b></span>' +
      '<span class="chip">MPPTs <b>' + v.mppts.length + '</b></span>' +
      '<span class="chip">Max AC <b>' + (v.maxAcW / 1000) + 'kW</b></span>';
  }

  // ── hybrid load table ──────────────────────────────────────────────────────
  function loadRowHtml(l) {
    return '<div class="load-row grid grid-cols-[1fr_70px_50px_56px_28px] gap-2 items-center px-4 py-2 border-t border-slate-200">' +
      '<input class="load-row-input" type="text" value="' + esc(l.name) + '" data-f="name">' +
      '<input class="load-row-input" type="number" min="0" step="1" value="' + l.w + '" data-f="w">' +
      '<input class="load-row-input" type="number" min="0" step="1" value="' + l.qty + '" data-f="qty">' +
      '<input class="load-row-input" type="number" min="0" step="0.5" value="' + l.h + '" data-f="h">' +
      '<button type="button" class="rm text-slate-300 hover:text-red-500 text-xl leading-none" title="Remove">&times;</button>' +
      '</div>';
  }
  function renderLoads() { $('loadRows').innerHTML = loads.map(loadRowHtml).join(''); updateLoadTotal(); }
  function domLoads() {
    return [].slice.call(document.querySelectorAll('#loadRows .load-row')).map(function (r) {
      return {
        name: r.querySelector('[data-f=name]').value,
        w: +r.querySelector('[data-f=w]').value || 0,
        qty: +r.querySelector('[data-f=qty]').value || 0,
        h: +r.querySelector('[data-f=h]').value || 0,
      };
    });
  }
  function dailyWh() { return domLoads().reduce(function (s, l) { return s + l.w * l.qty * l.h; }, 0); }
  function updateLoadTotal() {
    var wh = dailyWh();
    $('loadTotal').textContent = wh >= 1000 ? (wh / 1000).toFixed(2) + ' kWh/day' : Math.round(wh) + ' Wh/day';
  }
  function computeBattery() {
    var wh = dailyWh();
    var dod = Math.max(10, Math.min(100, +$('dod').value || 90)) / 100;
    var days = Math.max(0.5, +$('backupDays').value || 1);
    var neededKwh = (wh / 1000) * days / dod;
    var packs = wh > 0 ? Math.max(1, Math.ceil(neededKwh / 5)) : 0;
    var installedKwh = packs * 5;
    var usableKwh = installedKwh * dod;
    return { wh: wh, dailyKwh: wh / 1000, dodPct: Math.round(dod * 100), days: days, neededKwh: neededKwh, packs: packs, installedKwh: installedKwh, usableKwh: usableKwh };
  }

  function batteryCardHtml(b) {
    if (b.packs === 0) {
      return '<div class="flex items-start gap-3 bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 mb-5">' +
        '<svg class="w-4 h-4 text-amber-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path></svg>' +
        '<p class="text-xs text-amber-800">Add at least one backup load (with hours) to size the battery pack.</p></div>';
    }
    return '<div class="relative overflow-hidden rounded-2xl p-6 text-white bg-gradient-to-br from-brand-900 to-brand-700 mb-5">' +
      '<p class="text-[11px] uppercase tracking-wider font-semibold text-brand-100">Recommended battery bank</p>' +
      '<div class="flex items-baseline gap-2 mt-1"><span class="text-4xl font-extrabold" id="anPacks">0</span><span class="text-sm font-semibold text-brand-100">&times; 5 kWh packs (stacked)</span></div>' +
      '<p class="text-sm text-brand-100 mt-1">' + b.installedKwh + ' kWh installed &middot; ' + b.usableKwh.toFixed(1) + ' kWh usable at ' + b.dodPct + '% DOD</p>' +
      '</div>' +
      '<div class="grid grid-cols-3 gap-3 mb-5">' +
        statTile('anDaily', 'Daily load (kWh)') +
        statTile('anNeeded', 'Battery needed (kWh)') +
        statTile('anBackup', 'Backup days') +
      '</div>';
  }
  function animateNumber(el, to, decimals) {
    if (!el) return;
    var dur = 600, start = performance.now(), from = 0;
    function frame(now) {
      var t = Math.min(1, (now - start) / dur);
      var e = 1 - Math.pow(1 - t, 3);
      el.textContent = (from + (to - from) * e).toFixed(decimals);
      if (t < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }
  function animateBattery(b) {
    animateNumber($('anPacks'), b.packs, 0);
    animateNumber($('anDaily'), b.dailyKwh, 2);
    animateNumber($('anNeeded'), b.neededKwh, 1);
    animateNumber($('anBackup'), b.days, b.days % 1 ? 1 : 0);
  }

  function statTile(id, label) {
    return '<div class="bg-white border border-slate-200 rounded-xl px-4 py-3">' +
      '<div class="text-xl font-extrabold text-slate-900" id="' + id + '">0</div>' +
      '<div class="text-[11px] font-semibold uppercase tracking-wide text-slate-400 mt-0.5">' + label + '</div>' +
      '</div>';
  }

  // ── main calculate ──────────────────────────────────────────────────────────
  function calculate() {
    var panel = PANELS[+$('panel-select').value];
    var invObj = INVERTERS[+$('inverter-select').value];
    if (!panel || !invObj) return;

    var num = Math.max(1, Math.min(5000, parseInt($('total-panels').value, 10) || 0));
    var tMin = parseFloat($('t-min').value); if (isNaN(tMin)) tMin = 5;
    var tMax = parseFloat($('t-max').value); if (isNaN(tMax)) tMax = 50;
    if (tMax > 50) { tMax = 50; $('t-max').value = 50; }
    $('total-panels').value = num;

    var sysLimit = invObj.maxDcV;
    var opt = optimizeMppt(num, invObj, panel, tMin, tMax, sysLimit);
    var all = getAllStringConfigs(panel, invObj, tMin, tMax, sysLimit);

    var box = $('results');
    var hybrid = (sysType === 'hybrid');

    var battery = hybrid ? computeBattery() : null;
    var batteryHtml = hybrid ? batteryCardHtml(battery) : '';

    var pvHtml;
    if (opt.error) {
      var vc = vocAtTemp(panel.voc, panel.tcVoc, tMin);
      pvHtml = '<div class="flex items-start gap-3 bg-red-50 border border-red-200 rounded-xl px-4 py-3">' +
        '<svg class="w-5 h-5 text-red-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke-width="2"></circle><path stroke-linecap="round" stroke-width="2" d="M12 8v5M12 16.5v.01"></path></svg>' +
        '<div class="text-sm text-red-800"><b>No valid string configuration.</b> ' + esc(opt.error) +
        ' Try a different panel/inverter pair or fewer panels per string. (1&times;panel Voc@' + tMin + '&deg;C = ' + vc.toFixed(1) + 'V, max DC ' + invObj.maxDcV + 'V.)</div></div>';
      box.innerHTML = batteryHtml + pvHtml;
      if (battery && battery.packs) animateBattery(battery);
      return;
    }

    var d = opt.distributions;
    var used = opt.usedPanels, unused = opt.unusedPanels;
    var totalStrings = d.reduce(function (s, x) { return s + x.strings; }, 0);
    var minScore = Math.min.apply(null, d.map(function (x) { return x.rating.score; }));
    var topLabel = ['WORSE', 'WORSE', 'OK', 'GOOD', 'BEST'][minScore] || 'OK';
    var top = RATING_STYLE[topLabel];
    var clip = analyzeClipping(used, panel.wp, invObj);
    var kwp = used * panel.wp / 1000;
    var nList = Array.from(new Set(d.map(function (x) { return x.modulesPerString; }))).sort(function (a, b) { return a - b; });
    var primaryN = d.reduce(function (a, b) { return b.strings > a.strings ? b : a; }, d[0]).modulesPerString;
    var hasCurrentIssue = opt.warnings.length > 0;
    var dcac = clip.dcAcRatio;
    var dcacLimit = hybrid ? CFG.DCAC_WARN_HYBRID : CFG.DCAC_WARN;
    var dcacOver = dcac > dcacLimit;

    var WARN_ICON = '<svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path></svg>';
    var warnBlocks = [];
    if (hasCurrentIssue) warnBlocks.push('<div class="flex items-start gap-3 bg-amber-50 border border-amber-200 text-amber-800 rounded-xl px-4 py-3">' + WARN_ICON + '<div class="text-sm"><b>Current check:</b> ' + opt.warnings.map(esc).join('<br>') + '</div></div>');
    if (dcacOver) warnBlocks.push('<div class="flex items-start gap-3 bg-amber-50 border border-amber-200 text-amber-800 rounded-xl px-4 py-3">' + WARN_ICON +
      '<div class="text-sm"><b>DC/AC ratio ' + dcac.toFixed(2) + ' &mdash; over the ' + dcacLimit.toFixed(1) + ' limit.</b> The array overloads the inverter; excess DC power is clipped at peak. Reduce the panel count or choose a higher-rated inverter.' +
      '<br><span class="opacity-80">Peak clipping ~' + Math.round(clip.clipPct) + '% &middot; est. ~' + Math.round(clip.annualLossKwh).toLocaleString('en-IN') + ' kWh/yr not harvested.</span></div></div>');
    var notesHtml = warnBlocks.length ? warnBlocks.join('<div class="h-3"></div>') :
      '<div class="flex items-center gap-3 bg-brand-50 border border-brand-100 text-brand-800 rounded-xl px-4 py-3"><svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 6 9 17l-5-5"></path></svg><span class="text-sm">All voltage-window, per-MPPT current and DC/AC ratio checks pass for this layout.</span></div>';

    var vocCold = primaryN * vocAtTemp(panel.voc, panel.tcVoc, tMin);
    var vmpHot  = primaryN * vmpAtTemp(panel.vmp, panel.tcVmp, tMax);
    var vmpCold = primaryN * vmpAtTemp(panel.vmp, panel.tcVmp, tMin);
    var scaleMax = invObj.maxDcV;
    var pct = function (v) { return Math.max(0, Math.min(100, v / scaleMax * 100)); };

    var validConfigs = all.filter(function (c) { return c.rating.score >= 1 && c.rating.label !== 'FAIL'; });

    var mpptRows = d.map(function (x) {
      var impCls = x.impOk ? 'text-brand-600' : 'text-red-600 font-bold';
      var iscCls = x.iscOk ? 'text-brand-600' : 'text-red-600 font-bold';
      return '<div class="flex items-center gap-3 px-4 py-3 border border-slate-200 rounded-xl mb-2 bg-white">' +
        '<div class="w-10 h-10 rounded-lg bg-brand-50 text-brand-700 border border-brand-100 flex flex-col items-center justify-center text-[10px] font-extrabold leading-tight shrink-0">MPPT<br>' + (x.mpptIndex + 1) + '</div>' +
        '<div class="flex-1 min-w-0"><div class="text-sm font-bold text-slate-800">' + x.strings + ' string' + (x.strings > 1 ? 's' : '') + ' &times; ' + x.modulesPerString + ' panels</div>' +
        '<div class="text-xs text-slate-500">' + x.totalModules + ' panels &middot; ' + x.rating.label + '</div></div>' +
        '<div class="text-right text-xs font-semibold text-slate-500 shrink-0">Imp <span class="' + impCls + '">' + x.impA.toFixed(1) + '/' + x.maxCur + 'A</span><br>Isc <span class="' + iscCls + '">' + x.iscA.toFixed(1) + '/' + x.maxIsc + 'A</span></div>' +
        '</div>';
    }).join('');

    var rows = validConfigs.map(function (c) {
      var hlCls = (c.n === primaryN) ? 'bg-brand-50 font-bold' : '';
      var rs = RATING_STYLE[c.rating.label];
      return '<tr class="' + hlCls + '"><td class="px-4 py-2.5">' + c.n + ' panels</td><td class="px-4 py-2.5 text-right tabular-nums">' + c.vocCold.toFixed(0) + 'V</td><td class="px-4 py-2.5 text-right tabular-nums">' + c.vmpHot.toFixed(0) + 'V</td><td class="px-4 py-2.5 text-right tabular-nums">' + c.vmpCold.toFixed(0) + 'V</td>' +
        '<td class="px-4 py-2.5 text-right"><span class="inline-block text-[10px] font-extrabold px-2.5 py-1 rounded-full ' + rs.chip + '">' + c.rating.label + '</span></td></tr>';
    }).join('');

    pvHtml =
      '<div class="relative overflow-hidden rounded-2xl p-6 text-white bg-gradient-to-br from-slate-900 to-slate-800 mb-5">' +
        '<span class="absolute top-5 right-5 text-[11px] font-extrabold tracking-wide px-3 py-1.5 rounded-full text-white" style="background:' + top.hex + '">' + topLabel + '</span>' +
        '<p class="text-[11px] uppercase tracking-wider font-semibold text-slate-400">Recommended string size</p>' +
        '<div class="flex items-baseline gap-2 mt-1"><span class="text-4xl font-extrabold" id="anN">0</span><span class="text-sm font-semibold text-slate-400">panels per string</span></div>' +
        '<p class="text-sm text-slate-300 mt-1">' + totalStrings + ' string' + (totalStrings > 1 ? 's' : '') + ' across ' + d.length + ' MPPT' + (d.length > 1 ? 's' : '') +
          (nList.length > 1 ? ' &middot; mixed ' + nList.join('/') + ' layout' : '') + '</p>' +
      '</div>' +

      '<div class="grid grid-cols-3 gap-3 mb-5">' +
        statTile('anKwp', 'System size (kWp)') +
        '<div class="bg-white border border-slate-200 rounded-xl px-4 py-3">' +
          '<div class="text-xl font-extrabold ' + (dcacOver ? 'text-amber-600' : 'text-slate-900') + '" id="anRatio">0</div>' +
          '<div class="text-[11px] font-semibold uppercase tracking-wide text-slate-400 mt-0.5">DC / AC ratio' + (dcacOver ? ' &middot; over ' + dcacLimit : '') + '</div>' +
        '</div>' +
        '<div class="bg-white border border-slate-200 rounded-xl px-4 py-3">' +
          '<div class="text-xl font-extrabold text-slate-900" id="anUsed">0</div>' +
          '<div class="text-[11px] font-semibold uppercase tracking-wide text-slate-400 mt-0.5">Panels used' + (unused > 0 ? ' (' + unused + ' spare)' : '') + '</div>' +
        '</div>' +
      '</div>' +

      notesHtml +

      '<div class="mt-5">' +
        '<p class="text-sm font-bold text-slate-800 mb-3">Voltage window at ' + primaryN + ' panels/string</p>' +
        '<div class="bg-slate-50 border border-slate-200 rounded-xl px-4 pt-4 pb-8">' +
          '<div class="relative h-4 rounded-full" style="background:linear-gradient(90deg,#fecaca 0%,#fde68a 18%,#bbf7d0 40%,#bbf7d0 78%,#fecaca 100%)">' +
            '<div class="vwindow absolute top-0 bottom-0 rounded-full" style="background:rgba(4,157,101,.18);border:1.5px solid rgba(4,157,101,.5);left:0;width:0" id="vwin"></div>' +
            '<div class="vmark" id="mVocCold" style="left:0;background:#dc2626"><span style="color:#dc2626">Voc@cold ' + vocCold.toFixed(0) + 'V</span></div>' +
            '<div class="vmark" id="mVmpHot" style="left:0;background:#049D65"><span style="color:#049D65;top:-18px">Vmp@hot ' + vmpHot.toFixed(0) + 'V</span></div>' +
          '</div>' +
          '<div class="flex justify-between text-[10px] font-semibold text-slate-400 mt-2"><span>0V</span><span>MPPT ' + invObj.vmin + '–' + invObj.vmax + 'V (green)</span><span>' + scaleMax + 'V max</span></div>' +
        '</div>' +
      '</div>' +

      '<div class="mt-5">' +
        '<p class="text-sm font-bold text-slate-800 mb-3">MPPT distribution</p>' + mpptRows +
      '</div>' +

      '<div class="mt-5">' +
        '<p class="text-sm font-bold text-slate-800 mb-3">Valid string sizes for this pair</p>' +
        '<div class="overflow-x-auto rounded-xl border border-slate-100">' +
          '<table class="w-full text-sm"><thead class="bg-slate-950 text-white text-[11px] uppercase tracking-wider"><tr>' +
            '<th class="px-4 py-3 text-left font-semibold">Config</th><th class="px-4 py-3 text-right font-semibold">Voc@cold</th><th class="px-4 py-3 text-right font-semibold">Vmp@hot</th><th class="px-4 py-3 text-right font-semibold">Vmp@cold</th><th class="px-4 py-3 text-right font-semibold">Rating</th>' +
          '</tr></thead><tbody class="divide-y divide-slate-100">' + (rows || '<tr><td colspan="5" class="text-center text-slate-400 py-4">None</td></tr>') + '</tbody></table>' +
        '</div>' +
      '</div>';

    box.innerHTML = batteryHtml + pvHtml;

    if (battery && battery.packs) animateBattery(battery);
    animateNumber($('anN'), primaryN, 0);
    animateNumber($('anKwp'), kwp, 1);
    animateNumber($('anRatio'), clip.dcAcRatio, 2);
    animateNumber($('anUsed'), used, 0);

    requestAnimationFrame(function () {
      setTimeout(function () {
        var win = $('vwin');
        if (win) { win.style.left = pct(invObj.vmin) + '%'; win.style.width = (pct(invObj.vmax) - pct(invObj.vmin)) + '%'; }
        var a = $('mVocCold'); if (a) a.style.left = pct(vocCold) + '%';
        var b = $('mVmpHot'); if (b) b.style.left = pct(vmpHot) + '%';
      }, 50);
    });
  }

  // ── wire up ──────────────────────────────────────────────────────────────
  $('panel-select').addEventListener('change', renderChips);
  $('inverter-select').addEventListener('change', renderChips);

  [].slice.call(document.querySelectorAll('#sysType button')).forEach(function (btn) {
    btn.addEventListener('click', function () {
      sysType = btn.getAttribute('data-type');
      [].slice.call(document.querySelectorAll('#sysType button')).forEach(function (b) { b.classList.toggle('active', b === btn); });
      $('hybrid-section').classList.toggle('hidden', sysType !== 'hybrid');
      renderInverterOptions(sysType === 'hybrid' ? 'QBH-8KS48P3' : 'QB-10KTLC');
      renderChips();
    });
  });

  $('loadRows').addEventListener('input', updateLoadTotal);
  $('loadRows').addEventListener('click', function (e) {
    if (!e.target.classList.contains('rm')) return;
    var rows = [].slice.call($('loadRows').children);
    var idx = rows.indexOf(e.target.closest('.load-row'));
    if (idx < 0) return;
    loads = domLoads(); loads.splice(idx, 1); renderLoads();
  });
  $('addLoad').addEventListener('click', function () {
    loads = domLoads(); loads.push({ name: 'Custom load', w: 100, qty: 1, h: 2 }); renderLoads();
  });

  $('calcBtn').addEventListener('click', function () {
    var btn = this;
    var icon = btn.querySelector('.calc-btn-icon');
    var label = btn.querySelector('.calc-btn-label');
    btn.disabled = true;
    icon.outerHTML = '<span class="spinner"></span>';
    label.textContent = 'Calculating…';
    setTimeout(function () {
      calculate();
      btn.disabled = false;
      var spinner = btn.querySelector('.spinner');
      if (spinner) spinner.outerHTML = '<svg class="calc-btn-icon w-[18px] h-[18px]" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0H5a2 2 0 0 1-2-2v-4m6 6h10a2 2 0 0 0 2-2v-4"></path></svg>';
      btn.querySelector('.calc-btn-label').textContent = 'Recalculate';
    }, 400);
  });

  renderLoads();
  fillDropdowns();
</script>
