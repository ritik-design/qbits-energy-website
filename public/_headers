# Security headers (Cloudflare Pages format)
# Applies to every route.
#
# geolocation=(self): the partner map's "Near Me" filter needs it. Same-origin
# only, still gated on the browser's permission prompt; embeds stay blocked.
#
# news.google.com in script-src/frame-src: the Google Preferred Sources button
# (GooglePreferredSource.astro) loads swg/js/v1/publisher.js and renders the
# button into a shadow root; its confirmation toast and analytics are iframes on
# that origin. frame-src is spelled out because it otherwise inherits
# default-src 'self' and the toast would be refused.
#
# COOP same-origin-allow-popups: the add-source flow opens /addpreferredsource
# as a popup and messages back over window.opener. Plain same-origin severs that
# handle, so the flow can never report success. Google serves that endpoint with
# same-origin-allow-popups for the same reason.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(), interest-cohort=(), accelerometer=(), gyroscope=(), magnetometer=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://unpkg.com https://maps.googleapis.com https://maps.gstatic.com https://static.cloudflareinsights.com https://news.google.com; frame-src 'self' https://news.google.com; connect-src 'self' https://formsubmit.co https://script.google.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://qbits.quickestimate.co https://maps.googleapis.com https://maps.gstatic.com https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto: https://formsubmit.co

# Cache hashed assets (Astro emits content-hashed filenames under /_astro/)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cache images aggressively
/images/*
  Cache-Control: public, max-age=2592000

/homepage/*
  Cache-Control: public, max-age=2592000

/product-images/*
  Cache-Control: public, max-age=2592000

/logos/*
  Cache-Control: public, max-age=2592000

# Favicons
/favicon*
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800
