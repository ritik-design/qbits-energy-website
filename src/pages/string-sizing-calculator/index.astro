---
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

const panelDB = [
  { id: 'adani-540',  name: 'Adani Solar 540Wp',       watt: 540, voc: 49.3, vmp: 41.2, isc: 13.92, imp: 13.10, tc: -0.239 },
  { id: 'adani-580',  name: 'Adani Solar 580Wp',       watt: 580, voc: 49.4, vmp: 41.3, isc: 15.09, imp: 14.06, tc: -0.239 },
  { id: 'adani-620',  name: 'Adani Solar 620Wp',       watt: 620, voc: 49.6, vmp: 41.4, isc: 15.91, imp: 14.99, tc: -0.239 },
  { id: 'adani-650',  name: 'Adani Solar 650Wp',       watt: 650, voc: 50.2, vmp: 42.1, isc: 16.50, imp: 15.44, tc: -0.239 },
  { id: 'waaree-500', name: 'Waaree 500Wp',            watt: 500, voc: 49.6, vmp: 41.8, isc: 12.77, imp: 11.97, tc: -0.280 },
  { id: 'waaree-545', name: 'Waaree 545Wp',            watt: 545, voc: 49.9, vmp: 42.1, isc: 13.90, imp: 12.95, tc: -0.280 },
  { id: 'waaree-580', name: 'Waaree 580Wp',            watt: 580, voc: 50.0, vmp: 42.2, isc: 14.75, imp: 13.74, tc: -0.280 },
  { id: 'vikram-440', name: 'Vikram Solar 440Wp',      watt: 440, voc: 49.2, vmp: 41.3, isc: 11.38, imp: 10.65, tc: -0.285 },
  { id: 'vikram-500', name: 'Vikram Solar 500Wp',      watt: 500, voc: 49.5, vmp: 41.6, isc: 12.93, imp: 12.02, tc: -0.285 },
  { id: 'tata-445',   name: 'Tata Power Solar 445Wp',  watt: 445, voc: 49.2, vmp: 41.2, isc: 11.55, imp: 10.80, tc: -0.290 },
