  { model: 'AS-M12120-BHC-610W', wp: 610, voc: 49.00, vmp: 40.80, isc: 15.86, imp: 14.96, tcVoc: -0.23, tcVmp: -0.28 },
  { model: 'AS-M12120-BHC-615W', wp: 615, voc: 49.30, vmp: 41.10, isc: 15.89, imp: 14.98, tcVoc: -0.23, tcVmp: -0.28 },
  { model: 'AS-M12120-BHC-620W', wp: 620, voc: 49.60, vmp: 41.40, isc: 15.91, imp: 14.99, tcVoc: -0.23, tcVmp: -0.28 },
  { model: 'AS-M12120-BHC-625W', wp: 625, voc: 49.90, vmp: 41.70, isc: 15.94, imp: 15.01, tcVoc: -0.23, tcVmp: -0.28 },
  { model: 'AS-M12120-BHC-630W', wp: 630, voc: 50.20, vmp: 42.00, isc: 15.97, imp: 15.03, tcVoc: -0.23, tcVmp: -0.28 },
  { model: 'AS-M12120-BHC-635W', wp: 635, voc: 50.50, vmp: 42.30, isc: 16.00, imp: 15.05, tcVoc: -0.23, tcVmp: -0.28 },
  { model: 'AS-M12120-BHC-640W', wp: 640, voc: 50.80, vmp: 42.60, isc: 16.03, imp: 15.07, tcVoc: -0.23, tcVmp: -0.28 },
];

// Qbits inverter database (On-grid + Hybrid). mppts: per-channel { cur = max input current (A), str = max strings/MPPT }.
function inv(model, phase, type, ratedW, maxAcW, maxDcV, vmin, vmax, vnom, eff, mppts) {
  return { model, phase, type, ratedW, maxAcW, maxDcV, vmin, vmax, vnom, eff, mppts };
}
function chN(n, cur, str) { return Array.from({ length: n }, () => ({ cur, str })); }
const C20 = [{ cur: 20, str: 1 }];
const C20x2 = [{ cur: 20, str: 1 }, { cur: 20, str: 1 }];

const INVERTERS = [
  // ===================== ON-GRID =====================
  inv('QB-1.5KTLS', '1-Ph', 'ongrid', 1500, 1650, 550, 40, 550, 360, 98.0, C20),
  inv('QB-2.0KTLS', '1-Ph', 'ongrid', 2000, 2200, 550, 40, 550, 360, 98.0, C20),
  inv('QB-2.7KTLS', '1-Ph', 'ongrid', 2700, 2970, 550, 40, 550, 360, 98.0, C20),
  inv('QB-3.0KTLS', '1-Ph', 'ongrid', 3000, 3300, 550, 40, 550, 360, 98.0, C20),
  inv('QB-3.3KTLS', '1-Ph', 'ongrid', 3300, 3630, 550, 40, 550, 360, 98.0, C20),
  inv('QB-3.6KTLS', '1-Ph', 'ongrid', 3600, 3960, 550, 40, 550, 360, 98.0, C20),
  inv('QB-4.0KTLS', '1-Ph', 'ongrid', 4000, 4400, 550, 40, 550, 360, 98.0, C20),
  inv('QB-4.6KTLD-S', '1-Ph', 'ongrid', 4600, 5060, 600, 40, 600, 360, 98.1, C20),
  inv('QB-5KTLD-S', '1-Ph', 'ongrid', 5000, 5500, 600, 40, 600, 360, 98.1, C20),
  inv('QB-6KTLD-S', '1-Ph', 'ongrid', 6000, 6600, 600, 40, 600, 360, 98.1, C20),
  inv('QB-4KTLD', '1-Ph', 'ongrid', 4000, 4400, 550, 80, 550, 360, 98.1, C20x2),
  inv('QB-5KTLD', '1-Ph', 'ongrid', 5000, 5500, 550, 80, 550, 360, 98.1, C20x2),
  inv('QB-6KTLD', '1-Ph', 'ongrid', 6000, 6600, 550, 80, 550, 360, 98.1, C20x2),
  inv('QB-6KTLC', '3-Ph', 'ongrid', 6000, 6600, 1100, 180, 1000, 650, 98.5, C20x2),
  inv('QB-8KTLC', '3-Ph', 'ongrid', 8000, 8800, 1100, 180, 1000, 650, 98.5, C20x2),
  inv('QB-10KTLC', '3-Ph', 'ongrid', 10000, 11000, 1100, 180, 1000, 650, 98.6, C20x2),
  inv('QB-12KTLC', '3-Ph', 'ongrid', 12000, 13200, 1100, 180, 1000, 650, 98.7, C20x2),
  inv('QB-15KTLC', '3-Ph', 'ongrid', 15000, 16500, 1100, 180, 1000, 650, 98.7, [{ cur: 20, str: 1 }, { cur: 30, str: 2 }]),
  inv('QB-17KTLC', '3-Ph', 'ongrid', 17000, 18700, 1100, 180, 1000, 650, 98.7, [{ cur: 20, str: 1 }, { cur: 30, str: 2 }]),
  inv('QB-20KTLC', '3-Ph', 'ongrid', 20000, 22000, 1100, 180, 1000, 650, 98.8, [{ cur: 30, str: 2 }, { cur: 30, str: 2 }]),
  inv('QB-23KTLC', '3-Ph', 'ongrid', 23000, 25300, 1100, 180, 1000, 650, 98.8, [{ cur: 30, str: 2 }, { cur: 30, str: 2 }]),
  inv('QB-25KTLC', '3-Ph', 'ongrid', 25000, 27500, 1100, 180, 1000, 650, 98.8, [{ cur: 40, str: 2 }, { cur: 30, str: 2 }]),
  inv('QB-28KTLC', '3-Ph', 'ongrid', 28000, 30800, 1100, 180, 1000, 650, 98.8, [{ cur: 40, str: 2 }, { cur: 40, str: 2 }]),
  inv('QB-30KTLC', '3-Ph', 'ongrid', 30000, 33000, 1100, 180, 1000, 650, 98.8, [{ cur: 40, str: 2 }, { cur: 40, str: 2 }]),
  inv('QB-30KTLC-Pro', '3-Ph', 'ongrid', 30000, 33000, 1100, 200, 1000, 650, 98.6, [{ cur: 40, str: 2 }, { cur: 40, str: 2 }, { cur: 20, str: 2 }]),
  inv('QB-33KTLC-Pro', '3-Ph', 'ongrid', 33000, 36300, 1100, 200, 1000, 650, 98.6, [{ cur: 40, str: 2 }, { cur: 40, str: 2 }, { cur: 20, str: 2 }]),
  inv('QB-36KTLC-Pro', '3-Ph', 'ongrid', 36000, 39600, 1100, 200, 1000, 650, 98.6, [{ cur: 40, str: 2 }, { cur: 40, str: 2 }, { cur: 20, str: 2 }]),
  inv('QB-40KTLC-Pro', '3-Ph', 'ongrid', 40000, 44000, 1100, 200, 1000, 650, 98.7, [{ cur: 40, str: 2 }, { cur: 40, str: 2 }, { cur: 20, str: 2 }]),
  inv('QB-40KTLC-Plus', '3-Ph', 'ongrid', 40000, 44000, 1100, 200, 1000, 650, 98.6, [{ cur: 40, str: 2 }, { cur: 40, str: 2 }, { cur: 20, str: 2 }, { cur: 20, str: 2 }]),
  inv('QB-45KTLC-Plus', '3-Ph', 'ongrid', 45000, 49500, 1100, 200, 1000, 650, 98.6, [{ cur: 40, str: 2 }, { cur: 40, str: 2 }, { cur: 20, str: 2 }, { cur: 20, str: 2 }]),
  inv('QB-50KTLC-Plus', '3-Ph', 'ongrid', 50000, 55000, 1100, 200, 1000, 650, 98.7, [{ cur: 40, str: 2 }, { cur: 40, str: 2 }, { cur: 20, str: 2 }, { cur: 20, str: 2 }]),
  inv('QB-50KTLC', '3-Ph', 'ongrid', 50000, 55000, 1100, 250, 1100, 650, 98.7, chN(3, 45, 4)),
  inv('QB-60KTLC', '3-Ph', 'ongrid', 60000, 66000, 1100, 250, 1100, 650, 98.9, chN(3, 45, 4)),
  inv('QB-70KTLC-Pro', '3-Ph', 'ongrid', 70000, 77000, 1100, 200, 1000, 600, 98.6, [{ cur: 40, str: 2 }, { cur: 40, str: 2 }, { cur: 20, str: 2 }, { cur: 40, str: 2 }, { cur: 40, str: 2 }, { cur: 20, str: 2 }]),
  inv('QB-75KTLC-Pro', '3-Ph', 'ongrid', 75000, 82500, 1100, 200, 1000, 600, 98.6, [{ cur: 40, str: 2 }, { cur: 40, str: 2 }, { cur: 20, str: 2 }, { cur: 40, str: 2 }, { cur: 40, str: 2 }, { cur: 20, str: 2 }]),
  inv('QB-80KTLC-Pro', '3-Ph', 'ongrid', 80000, 88000, 1100, 200, 1000, 600, 98.6, [{ cur: 40, str: 2 }, { cur: 40, str: 2 }, { cur: 20, str: 2 }, { cur: 20, str: 2 }, { cur: 40, str: 2 }, { cur: 40, str: 2 }, { cur: 20, str: 2 }, { cur: 20, str: 2 }]),
  inv('QB-90KTLC-Pro', '3-Ph', 'ongrid', 90000, 99000, 1100, 200, 1000, 600, 98.6, [{ cur: 40, str: 2 }, { cur: 40, str: 2 }, { cur: 20, str: 2 }, { cur: 20, str: 2 }, { cur: 40, str: 2 }, { cur: 40, str: 2 }, { cur: 20, str: 2 }, { cur: 20, str: 2 }]),
  inv('QB-100KTLC-Pro', '3-Ph', 'ongrid', 100000, 110000, 1100, 200, 1000, 600, 98.7, [{ cur: 40, str: 2 }, { cur: 40, str: 2 }, { cur: 20, str: 2 }, { cur: 20, str: 2 }, { cur: 40, str: 2 }, { cur: 40, str: 2 }, { cur: 20, str: 2 }, { cur: 20, str: 2 }]),
  inv('QB-110KTLC-Pro', '3-Ph', 'ongrid', 110000, 121000, 1100, 200, 1000, 600, 98.7, [{ cur: 40, str: 2 }, { cur: 40, str: 2 }, { cur: 20, str: 2 }, { cur: 20, str: 2 }, { cur: 40, str: 2 }, { cur: 40, str: 2 }, { cur: 20, str: 2 }, { cur: 20, str: 2 }]),
  inv('QB-80KTLC', '3-Ph', 'ongrid', 80000, 88000, 1100, 200, 1000, 600, 98.6, chN(8, 30, 2)),
  inv('QB-90KTLC', '3-Ph', 'ongrid', 90000, 99000, 1100, 200, 1000, 600, 98.6, chN(9, 30, 2)),
  inv('QB-100KTLC', '3-Ph', 'ongrid', 100000, 110000, 1100, 200, 1000, 600, 98.7, chN(10, 30, 2)),
  inv('QB-110KTLC', '3-Ph', 'ongrid', 110000, 121000, 1100, 200, 1000, 600, 98.7, chN(10, 30, 2)),
  inv('QB-125KTLC', '3-Ph', 'ongrid', 125000, 137500, 1100, 200, 1000, 600, 98.9, chN(10, 30, 2)),
  inv('QB-225K-EHV', '3-Ph', 'ongrid', 225000, 247500, 1500, 500, 1500, 1080, 99.0, chN(12, 40, 2)),
  inv('QB-320K-EHV', '3-Ph', 'ongrid', 320000, 352000, 1500, 500, 1500, 1080, 99.0, chN(12, 40, 2)),

  // ===================== HYBRID =====================
  inv('QBH-7KS48P', '1-Ph', 'hybrid', 7000, 7700, 500, 150, 450, 300, 98.0, [{ cur: 30, str: 2 }, { cur: 18, str: 1 }]),
  inv('QBH-7K6S48P', '1-Ph', 'hybrid', 7600, 8360, 500, 150, 450, 300, 98.0, [{ cur: 30, str: 2 }, { cur: 18, str: 1 }]),
  inv('QBH-8KS48P', '1-Ph', 'hybrid', 8000, 8800, 500, 150, 450, 300, 98.0, [{ cur: 30, str: 2 }, { cur: 18, str: 1 }]),
  inv('QBH-5KS48P3', '3-Ph', 'hybrid', 5000, 5500, 1000, 200, 800, 500, 98.0, [{ cur: 18, str: 1 }]),
  inv('QBH-6KS48P3', '3-Ph', 'hybrid', 6000, 6600, 1000, 200, 800, 500, 98.0, [{ cur: 18, str: 1 }]),
  inv('QBH-7KS48P3', '3-Ph', 'hybrid', 7000, 7700, 1000, 200, 800, 500, 98.0, [{ cur: 18, str: 1 }]),
  inv('QBH-8KS48P3', '3-Ph', 'hybrid', 8000, 8800, 1000, 200, 800, 500, 98.0, [{ cur: 18, str: 1 }, { cur: 18, str: 1 }]),
  inv('QBH-10KS48P3', '3-Ph', 'hybrid', 10000, 11000, 1000, 200, 800, 500, 98.0, [{ cur: 36, str: 2 }, { cur: 18, str: 1 }]),
  inv('QBH-12KS48P3', '3-Ph', 'hybrid', 12000, 13200, 1000, 200, 800, 500, 98.0, [{ cur: 36, str: 2 }, { cur: 18, str: 1 }]),
