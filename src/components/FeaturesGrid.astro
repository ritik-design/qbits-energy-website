---

<section class="py-12 lg:py-16 bg-slate-50" aria-labelledby="features-heading">
  <div class="container-main">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4 lg:gap-6">
      {features.map((feature) => (
        <div class="group bg-white rounded-xl border border-slate-200 p-5 text-center hover:shadow-lg hover:border-brand-200 transition-all duration-300">
          <div class="w-12 h-12 mx-auto rounded-lg bg-brand-50 flex items-center justify-center text-brand-600 mb-3 group-hover:bg-brand-500 group-hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={feature.icon}/></svg>
          </div>
          <h3 class="text-sm font-semibold text-slate-800">{feature.title}</h3>
        </div>
      ))}
    </div>
  </div>
</section>
