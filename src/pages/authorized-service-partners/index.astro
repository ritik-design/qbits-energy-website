---
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

const supportTypes = [
  { title: 'Installation', desc: 'Certified technicians for safe and efficient inverter installation.', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
  { title: 'Maintenance', desc: 'Regular servicing and preventive maintenance to maximize inverter life.', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z' },
  { title: 'Repair & Replacement', desc: 'Quick turnaround for warranty claims and spare part replacement.', icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z' },
  { title: 'Technical Training', desc: 'Product training for dealers and installers across India.', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
];
---

<Layout
  title="Authorized Service Partners | Qbits Energy"
  description="Find Qbits authorized service partners across India. Search by state and district for installation, service, and support."
  canonical="/authorized-service-partners/"
>
  <HeaderV2 />

  <main>
    <PageHeader
      label="Support Network"
      title="Authorized"
      highlight="Service Partners"
      description="Find certified Qbits partners for installation, maintenance, and support across India."
    />

    <!-- Support Types -->
    <section class="section-padding bg-white" aria-labelledby="support-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            What We Offer
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="support-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Comprehensive Support Services
          </h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {supportTypes.map(s => (
            <div class="bg-slate-50 rounded-2xl p-8 text-center support-card">
              <div class="w-14 h-14 mx-auto rounded-xl bg-brand-100 flex items-center justify-center text-brand-600 mb-5">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={s.icon}/></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">{s.title}</h3>
              <p class="text-sm text-slate-500">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Partner Finder -->
    <section class="section-padding bg-slate-50" aria-labelledby="finder-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Partner Directory
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="finder-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Find a Partner Near You
          </h2>
        </div>

        <div class="asp-wrapper">

          <!-- Toggle -->
          <div class="asp-toggle">
            <div class="asp-toggle-wrap">
              <button id="aspMapBtn" class="active">Map View</button>
              <button id="aspListBtn">List View</button>
            </div>
          </div>

          <!-- Map View -->
          <div id="aspMapView"></div>

          <!-- List View -->
          <div id="aspListView" style="display:none">
            <div class="asp-container">

              <!-- Filter Sidebar -->
              <div class="asp-filter">
                <div class="asp-filter-header">
                  <h4>Filter</h4>
                </div>
                <div class="asp-filter-content">
                  <div class="asp-filter-field">
                    <label for="aspState">State</label>
                    <select id="aspState">
                      <option value="">Select State</option>
                    </select>
                  </div>
                  <div class="asp-filter-field">
                    <label for="aspDistrict">District</label>
                    <select id="aspDistrict" disabled>
                      <option value="">Select District</option>
                    </select>
                  </div>
                  <div class="asp-filter-actions">
                    <button id="aspReset">Reset</button>
                    <button id="aspApply" class="apply">Apply</button>
                  </div>
                </div>
              </div>

              <!-- Cards + Pagination -->
              <div>
                <div class="asp-list-grid" id="aspListGrid">
                  <div class="asp-loading">Loading partners…</div>
                </div>
                <div class="asp-pagination" id="aspPagination"></div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Become Partner CTA -->
    <section class="py-24 lg:py-32 bg-brand-500 text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="container-main relative text-center max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold mb-6">Want to Become a Partner?</h2>
        <p class="text-lg text-brand-100 mb-10">Join our growing network of authorized service partners across India. Get exclusive pricing, training, and marketing support.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/contact-us/" class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-8 py-4 text-sm font-semibold text-brand-600 shadow-lg hover:bg-brand-50 transition-all">Apply Now</a>
          <a href="https://wa.me/919979192935" target="_blank" rel="noopener" class="btn-outline">Chat on WhatsApp</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .asp-wrapper {
    max-width: 100%;
  }

  /* Toggle */
  .asp-toggle {
    margin-bottom: 28px;
    text-align: center;
  }
  .asp-toggle-wrap {
    background: rgba(0,0,0,0.04);
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 40px;
    display: inline-flex;
    column-gap: 4px;
    padding: 4px;
    width: 100%;
    max-width: 320px;
  }
  .asp-toggle button {
    background-color: transparent;
    border: none;
    border-radius: 40px;
    cursor: pointer;
    font-size: 15px;
    font-weight: 500;
    flex: 1;
    padding: 10px 20px;
    color: #475569;
    transition: all 0.2s;
  }
  .asp-toggle button.active {
    background-color: #149C68;
    color: #fff;
  }

  /* Map */
  #aspMapView {
    border-radius: 20px;
    height: 600px;
    width: 100%;
    overflow: hidden;
  }

  /* Map popup */
  .asp-map-popup {
    display: flex;
    gap: 12px;
    max-width: 320px;
    position: relative;
    padding-right: 56px;
  }
  .asp-map-popup .asp-image img {
    border-radius: 6px;
    object-fit: cover;
    height: 72px;
    width: 72px;
  }
  .asp-map-popup .asp-info .title {
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 2px;
    color: #0f172a;
  }
  .asp-map-popup .asp-info .designation {
    font-size: 13px;
    color: #475569;
    margin: 0 0 4px;
  }
  .asp-map-popup .asp-info .address {
    font-size: 12px;
    color: #64748b;
    margin: 0;
  }
  .asp-map-popup .asp-actions {
    position: absolute;
    right: 0;
    top: 0;
    display: flex;
    gap: 8px;
  }
  .asp-map-popup .asp-actions a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #f1f5f9;
    transition: background 0.2s;
  }
  .asp-map-popup .asp-actions a:hover {
    background: #e2e8f0;
  }

  /* List layout */
  .asp-container {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 24px;
    align-items: flex-start;
  }

  /* Filter sidebar */
  .asp-filter {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
    position: sticky;
    top: 100px;
  }
  .asp-filter-header {
    border-bottom: 1px solid #e2e8f0;
    padding: 16px 20px;
  }
  .asp-filter-header h4 {
    font-size: 15px;
    font-weight: 600;
    color: #0f172a;
    margin: 0;
  }
  .asp-filter-content {
    padding: 20px;
  }
  .asp-filter-field {
    margin-bottom: 16px;
  }
  .asp-filter-field label {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: #475569;
    margin-bottom: 6px;
  }
  .asp-filter-field select {
    width: 100%;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 10px 12px;
    font-size: 14px;
    color: #0f172a;
    background: #f8fafc;
    outline: none;
    appearance: none;
    cursor: pointer;
    transition: border-color 0.2s;
  }
  .asp-filter-field select:focus {
    border-color: #149C68;
  }
  .asp-filter-field select:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .asp-filter-actions {
    display: flex;
    gap: 10px;
    margin-top: 20px;
  }
  .asp-filter-actions button {
    flex: 1;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    padding: 10px;
    background: #fff;
    color: #475569;
    transition: all 0.2s;
  }
  .asp-filter-actions button:hover {
    border-color: #cbd5e1;
    background: #f8fafc;
  }
  .asp-filter-actions .apply {
    background: #149C68;
    border-color: #149C68;
    color: #fff;
  }
  .asp-filter-actions .apply:hover {
    background: #0f8056;
    border-color: #0f8056;
  }

  /* Card grid */
  .asp-list-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  /* Card */
  .asp-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    display: flex;
    gap: 14px;
    padding: 16px;
    position: relative;
    transition: box-shadow 0.2s, border-color 0.2s;
  }
  .asp-card:hover {
    border-color: #149C68;
    box-shadow: 0 4px 20px rgba(20,156,104,0.1);
  }
  .asp-card .asp-image img {
    border-radius: 8px;
    object-fit: cover;
    height: 80px;
    width: 80px;
    flex-shrink: 0;
  }
  .asp-card .asp-info {
    flex: 1;
    min-width: 0;
    padding-right: 56px;
  }
  .asp-card .asp-info .title {
    font-size: 14px;
    font-weight: 600;
    color: #0f172a;
    margin: 0 0 2px;
    line-height: 1.4;
  }
  .asp-card .asp-info .designation {
    font-size: 13px;
    font-weight: 500;
    color: #149C68;
    margin: 0 0 4px;
  }
  .asp-card .asp-info .location {
    font-size: 12px;
    color: #64748b;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .asp-card .asp-actions {
    position: absolute;
    right: 14px;
    top: 14px;
    display: flex;
    gap: 8px;
  }
  .asp-card .asp-actions a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #f1f5f9;
    transition: background 0.2s;
    flex-shrink: 0;
  }
  .asp-card .asp-actions a:hover {
    background: #dcfce7;
  }

  /* Loading / empty states */
  .asp-loading,
  .asp-empty,
  .asp-error {
    grid-column: 1 / -1;
    text-align: center;
    padding: 48px 0;
    color: #64748b;
    font-size: 14px;
  }

  /* Pagination */
  .asp-pagination {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
  }
  .asp-page-btn {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 50%;
    cursor: pointer;
    width: 36px;
    height: 36px;
    font-size: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #475569;
    transition: all 0.2s;
    line-height: 1;
    padding: 0;
  }
  .asp-page-btn:hover {
    border-color: #149C68;
    color: #149C68;
  }
  .asp-page-current {
    font-size: 13px;
    font-weight: 600;
    color: #475569;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .asp-container {
      grid-template-columns: 1fr;
    }
    .asp-filter {
      position: static;
    }
    .asp-list-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    #aspMapView {
      height: 420px;
    }
  }
</style>

<script>
  const API_BASE = 'https://qbits.quickestimate.co/api/v1/webhook';
  const SIG = 'eyJhbGciOi3nMiGM6H9FNFUROf3wh7SmQ30';
  const PHOTO_BASE = 'https://qbits.quickestimate.co/storage/';
  const DEFAULT_PHOTO = '/default-user.jpg';
  const MARKER_ICON = '/icon-marker.svg';
  const WA_ICON = '/icon-whatsapp.svg';
  const CALL_ICON = '/icon-mobile.svg';

  const headers = { 'Accept': 'application/json', 'X-Signature': SIG };

  async function apiFetch(endpoint: string) {
    const res = await fetch(`${API_BASE}/${endpoint}`, { headers });
    if (!res.ok) throw new Error(`API error: ${res.status}`);
    return res.json();
  }

  /* ---- Map ---- */
  let map: any = null;
  let markers: any[] = [];
  let infoWindow: any = null;

  async function loadMap() {
    try {
      const json = await apiFetch('channel-partner/map-view');
      if (!json?.data) return;

      const mapEl = document.getElementById('aspMapView')!;

      if (!map) {
        map = new (window as any).google.maps.Map(mapEl, {
          center: { lat: 22.5937, lng: 78.9629 },
          zoom: 5,
          mapTypeControl: false,
          streetViewControl: false,
          fullscreenControl: false,
        });
      }
      if (!infoWindow) {
        infoWindow = new (window as any).google.maps.InfoWindow();
      }

      markers.forEach(m => m.setMap(null));
      markers = [];

      const bounds = new (window as any).google.maps.LatLngBounds();
      let hasPoints = false;

      json.data.forEach((item: any) => {
        if (!item.latitude || !item.longitude) return;
        const pos = { lat: parseFloat(item.latitude), lng: parseFloat(item.longitude) };
        bounds.extend(pos);
        hasPoints = true;

        const marker = new (window as any).google.maps.Marker({
          position: pos,
          map,
          icon: { url: MARKER_ICON, scaledSize: new (window as any).google.maps.Size(44, 44) },
        });

        const photo = item.photo ? `${PHOTO_BASE}${item.photo}` : DEFAULT_PHOTO;
        const popup = `
          <div class="asp-map-popup">
            <div class="asp-image"><img src="${photo}" alt="${item.name || ''}"></div>
            <div class="asp-info">
              ${item.name ? `<p class="title">${item.name}</p>` : ''}
              ${item.company_name ? `<p class="designation">${item.company_name}${item.designation ? ' · ' + item.designation : ''}</p>` : ''}
              ${item.address ? `<p class="address">${item.address}${item.city_name ? ', ' + item.city_name : ''}${item.state_name ? ', ' + item.state_name : ''}</p>` : ''}
            </div>
            <div class="asp-actions">
              ${item.whatsapp_no ? `<a href="https://wa.me/${item.whatsapp_no}" target="_blank"><img src="${WA_ICON}" width="20" height="20" alt="WhatsApp"></a>` : ''}
              ${item.mobile ? `<a href="tel:${item.mobile}"><img src="${CALL_ICON}" width="20" height="20" alt="Call"></a>` : ''}
            </div>
          </div>`;

        marker.addListener('click', () => {
          infoWindow.setContent(popup);
          infoWindow.open(map, marker);
        });
        markers.push(marker);
      });

      if (hasPoints) map.fitBounds(bounds);
    } catch (err) {
      console.error('Map load error:', err);
    }
  }

  /* ---- List ---- */
  let currentState = '';
  let currentCity = '';

  async function loadList(state = '', city = '', page = 1) {
    const grid = document.getElementById('aspListGrid')!;
    const pagination = document.getElementById('aspPagination')!;
    grid.innerHTML = '<div class="asp-loading">Loading partners…</div>';
    pagination.innerHTML = '';

    try {
      const json = await apiFetch(`channel-partner/list-view?state_id=${state}&city=${city}&page=${page}`);
      const data = json?.data?.data;
      grid.innerHTML = '';

      if (!data || data.length === 0) {
        grid.innerHTML = '<div class="asp-empty">No service partners found.</div>';
        return;
      }

      data.forEach((item: any) => {
        const photo = item.photo ? `${PHOTO_BASE}${item.photo}` : DEFAULT_PHOTO;
        const card = document.createElement('div');
        card.className = 'asp-card';
        card.innerHTML = `
          <div class="asp-image"><img src="${photo}" alt="${item.name || 'Partner'}" loading="lazy" width="80" height="80"></div>
          <div class="asp-info">
            ${item.name ? `<p class="title">${item.name}</p>` : ''}
            ${item.designation ? `<p class="designation">${item.designation}</p>` : ''}
            <p class="location">${[item.company_name, item.city_name, item.state_name].filter(Boolean).join(', ')}</p>
          </div>
          <div class="asp-actions">
            ${item.whatsapp_no ? `<a href="https://wa.me/${item.whatsapp_no}" target="_blank" title="WhatsApp"><img src="${WA_ICON}" width="20" height="20" alt="WhatsApp"></a>` : ''}
            ${item.mobile ? `<a href="tel:${item.mobile}" title="Call"><img src="${CALL_ICON}" width="20" height="20" alt="Call"></a>` : ''}
          </div>`;
        grid.appendChild(card);
      });

      renderPagination(json.data, state, city);
    } catch (err) {
      console.error('List load error:', err);
      grid.innerHTML = '<div class="asp-error">Something went wrong. Please try again.</div>';
    }
  }

  function renderPagination(paginate: any, state: string, city: string) {
    const el = document.getElementById('aspPagination')!;
    el.innerHTML = '';
    if (!paginate) return;

    if (paginate.prev_page_url) {
      const btn = document.createElement('button');
      btn.className = 'asp-page-btn';
      btn.innerHTML = '&#8249;';
      btn.addEventListener('click', () => {
        loadList(state, city, paginate.current_page - 1);
        document.getElementById('aspListView')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      el.appendChild(btn);
    }

    const span = document.createElement('span');
    span.className = 'asp-page-current';
    span.textContent = `Page ${paginate.current_page} of ${paginate.last_page || '?'}`;
    el.appendChild(span);

    if (paginate.next_page_url) {
      const btn = document.createElement('button');
      btn.className = 'asp-page-btn';
      btn.innerHTML = '&#8250;';
      btn.addEventListener('click', () => {
        loadList(state, city, paginate.current_page + 1);
        document.getElementById('aspListView')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      el.appendChild(btn);
    }
  }

  /* ---- States ---- */
  async function loadStates() {
    try {
      const json = await apiFetch('state');
      const select = document.getElementById('aspState') as HTMLSelectElement;
      json.data.forEach((s: any) => {
        const opt = document.createElement('option');
        opt.value = s.id;
        opt.textContent = s.name;
        select.appendChild(opt);
      });
    } catch (err) {
      console.error('States load error:', err);
    }
  }

  /* ---- Events ---- */
  document.getElementById('aspState')?.addEventListener('change', async function () {
    const stateId = (this as HTMLSelectElement).value;
    const districtSelect = document.getElementById('aspDistrict') as HTMLSelectElement;
    districtSelect.innerHTML = '<option value="">Select District</option>';
    districtSelect.disabled = true;

    if (!stateId) return;

    try {
      const json = await apiFetch(`states/${stateId}/cities`);
      json.data.forEach((c: any) => {
        const opt = document.createElement('option');
        opt.value = c.id;
        opt.textContent = c.name;
        districtSelect.appendChild(opt);
      });
      districtSelect.disabled = false;
    } catch {
      districtSelect.innerHTML = '<option value="">Failed to load</option>';
    }
  });

  document.getElementById('aspApply')?.addEventListener('click', () => {
    const state = (document.getElementById('aspState') as HTMLSelectElement).value;
    const city = (document.getElementById('aspDistrict') as HTMLSelectElement).value;
    if (!state) { alert('Please select a State first'); return; }
    currentState = state;
    currentCity = city;
    loadList(state, city, 1);
  });

  document.getElementById('aspReset')?.addEventListener('click', () => {
    (document.getElementById('aspState') as HTMLSelectElement).value = '';
    const districtSelect = document.getElementById('aspDistrict') as HTMLSelectElement;
    districtSelect.innerHTML = '<option value="">Select District</option>';
    districtSelect.disabled = true;
    currentState = '';
    currentCity = '';
    loadList();
  });

  document.getElementById('aspMapBtn')?.addEventListener('click', function () {
    this.classList.add('active');
    document.getElementById('aspListBtn')?.classList.remove('active');
    document.getElementById('aspMapView')!.style.display = '';
    document.getElementById('aspListView')!.style.display = 'none';
  });

  document.getElementById('aspListBtn')?.addEventListener('click', function () {
    this.classList.add('active');
    document.getElementById('aspMapBtn')?.classList.remove('active');
    document.getElementById('aspMapView')!.style.display = 'none';
    document.getElementById('aspListView')!.style.display = '';
  });

  /* ---- Init ---- */
  function init() {
    loadStates();
    loadList();
    loadMap();
  }

  // Wait for Google Maps to be ready
  if ((window as any).google?.maps) {
    init();
  } else {
    (window as any).__aspInit = init;
  }
</script>

<!-- Google Maps -->
