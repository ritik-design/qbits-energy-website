---
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Search | Qbits Energy"
  description="Search Qbits Energy - solar inverters, blog posts, glossary terms, and resources."
  canonical="/search/"
  noindex={true}
>
  <HeaderV2 />

  <main id="main-content" class="pt-[104px] lg:pt-[120px]">
    <section class="section-padding bg-white">
      <div class="container-main max-w-3xl">
        <header class="mb-10">
          <span class="section-label">
            <span class="w-8 h-px bg-brand-500"></span>
            Search
          </span>
          <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 mt-4 leading-tight">
            What are you looking for?
          </h1>
          <p class="mt-3 text-slate-500">
            Inverter models, blog posts, glossary terms, datasheets - all indexed.
          </p>
        </header>

        <div id="search" class="pagefind-host" data-pagefind-host></div>

        <noscript>
          <p class="mt-6 text-sm text-slate-500">
            JavaScript is required for site search. Browse our
            <a href="/blog/" class="text-brand-600 hover:underline">blog</a>,
            <a href="/glossary/" class="text-brand-600 hover:underline">glossary</a>, or
            <a href="/our-products/" class="text-brand-600 hover:underline">product catalogue</a>
            instead.
          </p>
        </noscript>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style is:global>
  /* Pagefind UI overrides to fit brand */
  .pagefind-ui {
    --pagefind-ui-primary: #047857;
    --pagefind-ui-text: #0f172a;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #e2e8f0;
    --pagefind-ui-tag: #f1f5f9;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 12px;
    --pagefind-ui-image-border-radius: 8px;
    --pagefind-ui-image-box-ratio: 3 / 2;
    --pagefind-ui-font: 'Inter', ui-sans-serif, system-ui, sans-serif;
  }
</style>

<!-- Pagefind stylesheet (generated by `pagefind --site dist` post-build) -->
<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />

<script is:inline type="module">
  // /pagefind/* is emitted by `pagefind --site dist` after astro build (see package.json).
  // Skip with is:inline so Vite doesn't try to resolve it at build time.
  import('/pagefind/pagefind-ui.js')
    .then(({ PagefindUI }) => {
      new PagefindUI({
        element: '#search',
        showImages: false,
        excerptLength: 30,
        resetStyles: false,
        showSubResults: true,
        processResult: (result) => {
          const blocked = ['/404', '/search'];
          if (blocked.some((b) => result.url?.startsWith(b))) return null;
          return result;
        },
      });
    })
    .catch((err) => {
      console.error('Pagefind failed to load:', err);
      const el = document.getElementById('search');
      if (el) {
        el.innerHTML =
          '<p class="text-sm text-slate-500">Search index unavailable. Try the <a href="/blog/" class="text-brand-600 hover:underline">blog</a> or <a href="/glossary/" class="text-brand-600 hover:underline">glossary</a>.</p>';
      }
    });
</script>
