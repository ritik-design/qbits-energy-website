---
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import AmbassadorDealer from '../../components/brand-ambassador/AmbassadorDealer.astro';

const businessTypes = ['Dealer', 'Distributor', 'EPC', 'System Integrator'];
const officeTypes = ['Owned', 'Rented'];
const yesNo = ['Yes', 'No'];
// Indian states and union territories (optional State field).
const indianStates = [
  'Andhra Pradesh', 'Arunachal Pradesh', 'Assam', 'Bihar', 'Chhattisgarh', 'Goa', 'Gujarat', 'Haryana',
  'Himachal Pradesh', 'Jharkhand', 'Karnataka', 'Kerala', 'Madhya Pradesh', 'Maharashtra', 'Manipur',
  'Meghalaya', 'Mizoram', 'Nagaland', 'Odisha', 'Punjab', 'Rajasthan', 'Sikkim', 'Tamil Nadu', 'Telangana',
  'Tripura', 'Uttar Pradesh', 'Uttarakhand', 'West Bengal',
  'Andaman and Nicobar Islands', 'Chandigarh', 'Dadra and Nagar Haveli and Daman and Diu', 'Delhi',
  'Jammu and Kashmir', 'Ladakh', 'Lakshadweep', 'Puducherry',
];

// Visible FAQ (also emitted as FAQPage JSON-LD below). Answers state only what the page and site already say.
const partnerFaqs = [
  {
    q: 'Who can apply to become a Qbits partner?',
    a: 'The application has four business types: dealer, distributor, EPC and system integrator. Pick the one that matches how your business actually buys and sells solar inverters.',
  },
  {
    q: 'What happens after I submit the application?',
    a: 'The Qbits team reviews the details you submitted and contacts you about the relevant partner route. Submitting does not guarantee an appointment, and this page does not state a response time.',
  },
  {
    q: 'Which fields are required?',
    a: 'Company name, registered address, official business email, a 10-digit WhatsApp number and a GST number. State and city are optional, as are the business, infrastructure, financial and sales questions.',
  },
  {
    q: 'Does the page state margins, territories or minimum orders?',
    a: 'No. Qbits does not publish margins, territories, incentives, training, minimum orders or lead commitments on this page. Ask the partner team directly and get any terms you rely on in writing.',
  },
  {
    q: 'Which Qbits products would I be selling?',
    a: 'Qbits publishes on-grid inverters from 1.5 kW to 320 kW and hybrid inverters from 3 kW to 12 kW. Browse the model pages and datasheets before you apply.',
  },
  {
    q: 'Can I ask a question before filling in the full form?',
    a: 'Yes. Use the short dealer, distributor or EPC enquiry buttons above the form, or message the team on WhatsApp.',
  },
];
const partnerFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: partnerFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Dealer guides already published on this site (all exist under src/content/blog).
const dealerGuides = [
  { href: '/blog/how-to-become-a-solar-inverter-partner-in-india/', label: 'How to become a Qbits solar inverter dealer in India' },
  { href: '/blog/qbits-partner-application-guide/', label: 'What the Qbits partner application asks and why' },
  { href: '/blog/become-qbits-distributor/', label: 'How to become a Qbits solar inverter distributor' },
  { href: '/blog/dealer-vs-distributor-vs-epc/', label: 'Dealer vs distributor vs EPC vs system integrator' },
  { href: '/blog/solar-dealer-agreement-checklist/', label: 'Solar dealer agreement: territory, termination and buyback checklist' },
  { href: '/blog/solar-distributor-credit-territory-terms/', label: 'Distributor credit and territory terms: a practical review guide' },
  { href: '/blog/solar-dealer-margin-india/', label: 'Solar dealer margins in India: what is actually published?' },
  { href: '/blog/solar-dealership-investment-india/', label: 'How much investment does a solar dealership need in India?' },
  { href: '/blog/working-capital-solar-dealers/', label: 'Working capital and stock financing for solar dealers' },
  { href: '/blog/gst-udyam-solar-inverter-dealer/', label: 'GST and Udyam registration for solar inverter dealers' },
  { href: '/blog/indian-inverter-partner-programmes/', label: 'Indian solar inverter partner programmes compared' },
];
---

<Layout
  title="Become a Qbits Solar Inverter Dealer or Distributor"
  description="Apply to become a Qbits solar inverter dealer, distributor or EPC partner in India. Share your business details and region; terms are confirmed on approval."
  canonical="/become-our-partner/"
>
  <HeaderV2 />

  <main id="main-content">
    <PageHeader
      label="Channel Partner"
      title="Become Our"
      highlight="Partner"
      description="Apply as a dealer, distributor, EPC or system integrator. The Qbits partner team reviews your details and contacts you to discuss the next step."
      bgImage="/homepage/built-for-india.webp"
      centered={true}
    />

    <!-- Partner Form -->
    <section class="py-10 bg-white" aria-labelledby="partner-route-heading"><div class="container-main max-w-5xl">
      <h2 id="partner-route-heading" class="text-2xl font-bold text-slate-900">Choose the right partner route</h2>
      <p class="mt-3 text-slate-600">Dealers and distributors can describe their sales territory and current product lines. EPCs and system integrators can provide project types, typical capacities and technical-support needs. Use the route that matches your actual business; the application form asks for the details Qbits needs to review it.</p>
      <p class="mt-3 text-slate-600">Review the <a class="text-brand-600 underline" href="/our-products/">inverter families</a> and <a class="text-brand-600 underline" href="/download-datasheets/">model datasheets</a> before applying. Current commercial terms, eligibility, territory and support arrangements should be confirmed directly with the partner team; this page does not promise a fixed margin or automatic acceptance.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="btn-primary" href="/contact-us/?subject=Become+a+Dealer&role=Dealer&from=%2Fbecome-our-partner%2F#lead-form">Dealer Enquiry</a>
        <a class="btn-primary" href="/contact-us/?subject=Become+a+Distributor&role=Distributor&from=%2Fbecome-our-partner%2F#lead-form">Distributor Enquiry</a>
        <a class="btn-primary" href="/contact-us/?subject=EPC+%2F+Bulk+Supply&role=EPC+Company&from=%2Fbecome-our-partner%2F#lead-form">EPC / Installer Enquiry</a>
      </div>
      <p class="mt-3 text-sm text-slate-500">Start with a short enquiry if you need to discuss the route first. Use the detailed application below when you are ready to share your business profile.</p>
    </div></section>
    <!-- Opportunity overview: product range, who applies, what happens next, what the form asks -->
    <section class="py-12 bg-slate-50" aria-labelledby="overview-heading"><div class="container-main max-w-5xl">
      <h2 id="overview-heading" class="text-2xl font-bold text-slate-900">What you would be selling, who applies and what happens next</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl bg-white p-6 ring-1 ring-slate-200">
          <h3 class="text-lg font-bold text-slate-900">The Qbits product range</h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">The Qbits range is solar inverters. The published range is <a class="text-brand-600 underline" href="/on-grid-inverter/">on-grid inverters from 1.5 kW to 320 kW</a> (single-phase and three-phase, residential to utility-scale) and <a class="text-brand-600 underline" href="/hybrid-inverter/">hybrid inverters from 3 kW to 12 kW</a>. See every model on the <a class="text-brand-600 underline" href="/our-products/">products page</a>, then read the exact-model <a class="text-brand-600 underline" href="/download-datasheets/">datasheets</a>. Specifications differ by model, so check the one you plan to stock.</p>
        </div>
        <div class="rounded-2xl bg-white p-6 ring-1 ring-slate-200">
          <h3 class="text-lg font-bold text-slate-900">Who the programme is for</h3>
          <ul class="mt-2 space-y-2 text-sm text-slate-600 leading-relaxed">
            <li><strong class="text-slate-900">Dealers:</strong> businesses that sell inverters to installers and end customers.</li>
            <li><strong class="text-slate-900">Distributors:</strong> businesses that supply inverters on to dealers and installers.</li>
            <li><strong class="text-slate-900">EPCs and system integrators:</strong> companies that design and install solar systems and buy inverters for those projects.</li>
          </ul>
          <p class="mt-3 text-sm text-slate-600">Not sure which fits? Read <a class="text-brand-600 underline" href="/blog/dealer-vs-distributor-vs-epc/">dealer vs distributor vs EPC</a>.</p>
        </div>
        <div class="rounded-2xl bg-white p-6 ring-1 ring-slate-200">
          <h3 class="text-lg font-bold text-slate-900">What happens after you apply</h3>
          <ol class="mt-2 list-decimal space-y-2 pl-5 text-sm text-slate-600 leading-relaxed">
            <li>You submit the application below. It goes to the Qbits team.</li>
            <li>The team reviews your details. Submitting does not guarantee an appointment.</li>
            <li>The team contacts you to discuss the relevant partner route and terms. This page does not publish margins, territories, incentives, training, minimum orders or lead commitments, so ask about anything you need and get it in writing before you commit.</li>
          </ol>
        </div>
        <div class="rounded-2xl bg-white p-6 ring-1 ring-slate-200">
          <h3 class="text-lg font-bold text-slate-900">What the form asks, and why</h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">Required: company name, registered address, business email, WhatsApp number and GST number, so Qbits can identify the business and reach you. The rest describes your business: partner type, brands you use now, office, warehouse and team, finances, and your sales plan and experience. These answers give the team a business profile to review. Qbits does not publish a pass mark or scoring for any answer. State and city are optional. Details are covered in <a class="text-brand-600 underline" href="/blog/qbits-partner-application-guide/">what the application asks and why</a> and the <a class="text-brand-600 underline" href="/privacy-policy/">privacy policy</a>.</p>
        </div>
      </div>
    </div></section>
    <section class="section-padding bg-slate-50" aria-labelledby="form-heading">
      <div class="container-main">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <span class="section-label justify-center">
              <span class="w-8 h-px bg-brand-500"></span>
              Partner Application
              <span class="w-8 h-px bg-brand-500"></span>
            </span>
            <h2 id="form-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
              Channel Partner Application Form
            </h2>
            <p class="text-slate-500 mt-4">Use the form to describe your business. The Qbits team will review your application and contact you about the relevant route.</p>
          </div>

          <form
            id="partner-form"
            class="bg-white rounded-2xl shadow-xl shadow-slate-900/5 p-8 lg:p-10 space-y-10"
            novalidate
            action="#"
            method="post"
          >
            <!-- Company Information -->
            <fieldset class="space-y-5">
              <legend class="text-lg font-bold text-slate-900 mb-2 flex items-center gap-2">
                <span class="w-8 h-8 rounded-lg bg-brand-100 text-brand-600 flex items-center justify-center text-sm">1</span>
                Company Information
              </legend>
              <div class="grid sm:grid-cols-2 gap-5">
                <div class="sm:col-span-2">
                  <label for="companyName" class="block text-sm font-medium text-slate-700 mb-1.5">Company Name <span class="text-rose-500">*</span></label>
                  <input type="text" id="companyName" name="companyName" required maxlength="120" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all bg-slate-50/50" placeholder="Registered company name" />
                </div>
                <div class="sm:col-span-2">
                  <label for="registeredAddress" class="block text-sm font-medium text-slate-700 mb-1.5">Registered Address <span class="text-rose-500">*</span></label>
                  <textarea id="registeredAddress" name="registeredAddress" rows="3" required minlength="10" maxlength="500" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all resize-none bg-slate-50/50" placeholder="Full registered address"></textarea>
                </div>
                <div>
                  <label for="state" class="block text-sm font-medium text-slate-700 mb-1.5">State <span class="text-xs text-slate-400 font-normal">(optional)</span></label>
                  <select id="state" name="state" autocomplete="address-level1" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all bg-slate-50/50">
                    <option value="">Select state or UT</option>
                    {indianStates.map((st) => <option value={st}>{st}</option>)}
                  </select>
                </div>
                <div>
                  <label for="city" class="block text-sm font-medium text-slate-700 mb-1.5">City <span class="text-xs text-slate-400 font-normal">(optional)</span></label>
                  <input type="text" id="city" name="city" maxlength="60" autocomplete="address-level2" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all bg-slate-50/50" placeholder="e.g. Surat" />
                </div>
                <div>
                  <label for="businessEmail" class="block text-sm font-medium text-slate-700 mb-1.5">Official Business Email <span class="text-rose-500">*</span></label>
                  <input type="email" id="businessEmail" name="businessEmail" required maxlength="120" autocomplete="email" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all bg-slate-50/50" placeholder="info@company.com" />
                </div>
                <div>
                  <label for="whatsappNumber" class="block text-sm font-medium text-slate-700 mb-1.5">WhatsApp Number <span class="text-rose-500">*</span></label>
                  <input type="tel" id="whatsappNumber" name="whatsappNumber" required pattern="[0-9]{10}" inputmode="tel" maxlength="10" autocomplete="tel" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all bg-slate-50/50" placeholder="10-digit mobile number without country code" />
                  <p class="text-xs text-slate-500 mt-1">Write mobile number without country code</p>
                </div>
                <div>
                  <label for="website" class="block text-sm font-medium text-slate-700 mb-1.5">Website</label>
                  <input type="url" id="website" name="website" maxlength="120" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all bg-slate-50/50" placeholder="https://www.company.com" />
                </div>
                <div>
                  <label for="gstPan" class="block text-sm font-medium text-slate-700 mb-1.5">GST Number <span class="text-rose-500">*</span></label>
                  <input type="text" id="gstPan" name="gstPan" required maxlength="20" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all bg-slate-50/50" placeholder="GST or PAN number" />
                </div>
              </div>
            </fieldset>

            <!-- Business Profile -->
            <fieldset class="space-y-5">
              <legend class="text-lg font-bold text-slate-900 mb-2 flex items-center gap-2">
                <span class="w-8 h-8 rounded-lg bg-brand-100 text-brand-600 flex items-center justify-center text-sm">2</span>
                Business Profile
              </legend>
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-3">Business Type</label>
                  <div class="flex flex-wrap gap-3">
                    {businessTypes.map(type => (
                      <label class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 cursor-pointer hover:border-brand-300 transition-colors has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50">
                        <input type="radio" name="businessType" value={type} class="w-4 h-4 text-brand-600 focus:ring-brand-500 border-slate-300" />
                        <span class="text-sm text-slate-700">{type}</span>
                      </label>
                    ))}
                  </div>
                </div>
                <div>
                  <label for="pmSuryagharName" class="block text-sm font-medium text-slate-700 mb-1.5">PM Suryaghar Registered Name <span class="text-xs text-slate-400 font-normal">(Applicable to EPC)</span></label>
                  <input type="text" id="pmSuryagharName" name="pmSuryagharName" maxlength="120" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all bg-slate-50/50" placeholder="Registered PM Suryaghar name" />
                </div>
                <div>
                  <label for="annualTurnover" class="block text-sm font-medium text-slate-700 mb-1.5">Annual Turnover (₹)</label>
                  <input type="text" id="annualTurnover" name="annualTurnover" maxlength="50" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all bg-slate-50/50" placeholder="e.g. ₹50 Lakhs" />
                </div>
                <div class="sm:col-span-2">
                  <label for="brandsUsed" class="block text-sm font-medium text-slate-700 mb-1.5">Brands Currently Using in Inverter for Solar Projects</label>
                  <input type="text" id="brandsUsed" name="brandsUsed" maxlength="250" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all bg-slate-50/50" placeholder="Qbits,Havells" />
                </div>
              </div>
            </fieldset>

            <!-- Infrastructure -->
            <fieldset class="space-y-5">
              <legend class="text-lg font-bold text-slate-900 mb-2 flex items-center gap-2">
                <span class="w-8 h-8 rounded-lg bg-brand-100 text-brand-600 flex items-center justify-center text-sm">3</span>
                Infrastructure & Team
              </legend>
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-3">Office Type</label>
                  <div class="flex flex-wrap gap-3">
                    {officeTypes.map(type => (
                      <label class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 cursor-pointer hover:border-brand-300 transition-colors has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50">
                        <input type="radio" name="officeType" value={type} class="w-4 h-4 text-brand-600 focus:ring-brand-500 border-slate-300" />
                        <span class="text-sm text-slate-700">{type}</span>
                      </label>
                    ))}
                  </div>
                </div>
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-3">Warehouse Available</label>
                  <div class="flex flex-wrap gap-3">
                    {yesNo.map(type => (
                      <label class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 cursor-pointer hover:border-brand-300 transition-colors has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50">
                        <input type="radio" name="warehouseAvailable" value={type} class="w-4 h-4 text-brand-600 focus:ring-brand-500 border-slate-300" />
                        <span class="text-sm text-slate-700">{type}</span>
                      </label>
                    ))}
                  </div>
                </div>
                <div>
                  <label for="warehouseSize" class="block text-sm font-medium text-slate-700 mb-1.5">Warehouse Size in Sq. Feet</label>
                  <input type="text" id="warehouseSize" name="warehouseSize" maxlength="50" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all bg-slate-50/50" placeholder="e.g. 2000 sq ft" />
                </div>
                <div>
                  <label for="salesTeam" class="block text-sm font-medium text-slate-700 mb-1.5">Sales Team Availability <span class="text-xs text-slate-400 font-normal">(Yes or No / in numbers)</span></label>
                  <input type="text" id="salesTeam" name="salesTeam" maxlength="50" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all bg-slate-50/50" placeholder="e.g. Yes, 5 members" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-3">Technical Support Team</label>
                  <div class="flex flex-wrap gap-3">
                    {yesNo.map(type => (
                      <label class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 cursor-pointer hover:border-brand-300 transition-colors has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50">
                        <input type="radio" name="technicalSupportTeam" value={type} class="w-4 h-4 text-brand-600 focus:ring-brand-500 border-slate-300" />
                        <span class="text-sm text-slate-700">{type}</span>
                      </label>
                    ))}
                  </div>
                </div>
                <div>
                  <label for="serviceTeam" class="block text-sm font-medium text-slate-700 mb-1.5">Service Team Availability <span class="text-xs text-slate-400 font-normal">(Yes or No / in numbers)</span></label>
                  <input type="text" id="serviceTeam" name="serviceTeam" maxlength="50" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all bg-slate-50/50" placeholder="e.g. Yes, 3 members" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-3">Service Center Available</label>
                  <div class="flex flex-wrap gap-3">
                    {yesNo.map(type => (
                      <label class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 cursor-pointer hover:border-brand-300 transition-colors has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50">
                        <input type="radio" name="serviceCenterAvailable" value={type} class="w-4 h-4 text-brand-600 focus:ring-brand-500 border-slate-300" />
                        <span class="text-sm text-slate-700">{type}</span>
                      </label>
                    ))}
                  </div>
                </div>
                <div>
                  <label for="serviceCenterLocation" class="block text-sm font-medium text-slate-700 mb-1.5">Service Center Location</label>
                  <input type="text" id="serviceCenterLocation" name="serviceCenterLocation" maxlength="200" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all bg-slate-50/50" placeholder="City, State" />
                </div>
              </div>
            </fieldset>

            <!-- Financial Details -->
            <fieldset class="space-y-5">
              <legend class="text-lg font-bold text-slate-900 mb-2 flex items-center gap-2">
                <span class="w-8 h-8 rounded-lg bg-brand-100 text-brand-600 flex items-center justify-center text-sm">4</span>
                Financial Details
              </legend>
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="workingCapital" class="block text-sm font-medium text-slate-700 mb-1.5">Working Capital Total Available (In Lacs)</label>
                  <input type="text" id="workingCapital" name="workingCapital" maxlength="50" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all bg-slate-50/50" placeholder="e.g. 25 Lacs" />
                </div>
                <div>
                  <label for="bankLoanAmount" class="block text-sm font-medium text-slate-700 mb-1.5">Total Bank Loan Amount</label>
                  <input type="text" id="bankLoanAmount" name="bankLoanAmount" maxlength="50" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all bg-slate-50/50" placeholder="Don't include CC and OD limits" />
                  <p class="text-xs text-slate-500 mt-1">Don't include CC and OD limits</p>
                </div>
                <div>
                  <label for="ccLimits" class="block text-sm font-medium text-slate-700 mb-1.5">CC Limits <span class="text-xs text-slate-400 font-normal">(total CC limits in lacs)</span></label>
