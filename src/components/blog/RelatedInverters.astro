---
import { getProductById, getProductPowerLabel } from '../../data/products';
import { getInverterRecommendations } from '../../data/inverter-recommendations';

interface Props {
  slug: string;
  category: string;
}

const { slug, category } = Astro.props;
const rec = getInverterRecommendations(slug, category);
const models = rec ? rec.models.map((id) => getProductById(id)).filter((p) => !!p).slice(0, 3) : [];
const hubLabel = rec?.hub === '/hybrid-inverter/' ? 'Hybrid inverters' : rec?.hub === '/c-i-solution/' ? 'C&I solution' : 'On-grid inverters';
---

{rec && models.length > 0 && (
  <section class="mt-16 pt-12 border-t border-slate-200" aria-labelledby="related-inverters-heading">
    <div class="flex items-center gap-3 mb-3">
      <span class="text-brand-600 font-bold uppercase tracking-wider text-xs bg-brand-500/10 px-3 py-1 rounded-full">Qbits models</span>
    </div>
    <h2 id="related-inverters-heading" class="text-2xl sm:text-3xl font-bold text-slate-900">Qbits inverters for this guide</h2>
    <p class="mt-2 text-sm text-slate-500">Specs below come from each model's datasheet. Confirm the exact model and current written terms with Qbits before you buy.</p>
    <div class={`mt-6 grid gap-4 sm:grid-cols-2 ${models.length > 2 ? 'lg:grid-cols-3' : ''}`}>
      {models.map((p) => (
        <article class="flex flex-col rounded-2xl ring-1 ring-slate-200 bg-white p-5 hover:ring-brand-300 hover:shadow-xl hover:shadow-brand-500/5 transition-all">
          <h3 class="text-base font-bold text-slate-900 leading-snug break-words">{p.name}</h3>
          <dl class="mt-3 space-y-1.5 text-sm text-slate-600">
            <div class="flex justify-between gap-3"><dt class="text-slate-500">Power</dt><dd class="font-medium text-slate-800 text-right">{getProductPowerLabel(p)}</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-slate-500">Phase</dt><dd class="font-medium text-slate-800 text-right">{p.phase === 'single' ? 'Single-phase' : 'Three-phase'}</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-slate-500">MPPT</dt><dd class="font-medium text-slate-800 text-right">{p.mpptLabel}</dd></div>
          </dl>
          <div class="mt-auto pt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
            <a href={`/our-products/${p.id}/`} data-cta="related_inverter" data-model={p.id} class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:text-brand-700">
              View model
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            {p.datasheet && (
              <a href={p.datasheet} data-cta="related_inverter" data-model={p.id} data-action="datasheet" class="text-sm font-semibold text-slate-600 hover:text-brand-600">Datasheet (PDF)</a>
            )}
          </div>
        </article>
      ))}
    </div>
    <p class="mt-5 text-sm">
      <a href={rec.hub} data-cta="related_inverter" data-model="hub" class="font-semibold text-brand-600 hover:text-brand-700">Browse all {hubLabel.toLowerCase()} →</a>
    </p>
  </section>
)}
