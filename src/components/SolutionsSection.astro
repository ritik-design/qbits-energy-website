---
const solutions = [
  {
    title: 'Residential Solar',
    subtitle: 'Homes & Apartments',
    description: 'Compact, efficient inverters designed for rooftop installations. Easy monitoring through mobile app with battery-ready options for energy independence.',
    features: ['Single & three-phase', 'Battery storage ready', 'Net metering ready', 'Compact design'],
    image: '/solutions/residential.webp',
    cta: '/residential-solution/',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
  },
  {
    title: 'Commercial & Industrial',
    subtitle: 'Businesses & Factories',
    description: 'High-capacity inverters for large-scale installations. Advanced grid management, parallel operation, and comprehensive monitoring for maximum ROI.',
    features: ['Up to 125kW capacity', 'Parallel operation', 'Advanced grid support', 'Remote diagnostics'],
    image: '/solutions/commercial.webp',
    cta: '/c-i-solution/',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
  },
];
---

<section class="section-padding bg-white" aria-labelledby="solutions-heading">
  <div class="container-main">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="section-label reveal">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
        </svg>
        Solutions
      </span>
      <h2 id="solutions-heading" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mt-6 reveal reveal-delay-1">
        Solar Solutions for
        <span class="text-gradient">Every Scale</span>
      </h2>
      <p class="mt-4 text-lg text-slate-500 reveal reveal-delay-2">
        From rooftop homes to industrial parks, we deliver optimized solar power systems tailored to your energy needs.
      </p>
    </div>

    <div class="space-y-8">
      {solutions.map((solution, i) => (
        <div class={`grid lg:grid-cols-2 gap-8 lg:gap-12 items-center reveal reveal-delay-${i + 1}`}>
          <div class={`${i % 2 === 1 ? 'lg:order-2' : ''}`}>
            <div class="relative rounded-2xl overflow-hidden bg-gradient-to-br from-slate-100 to-slate-200 aspect-[4/3]">
              <!-- Placeholder illustration -->
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="text-center">
                  <div class="w-20 h-20 mx-auto rounded-2xl bg-white shadow-lg flex items-center justify-center text-brand-600 mb-4">
                    <Fragment set:html={solution.icon} />
                  </div>
                  <p class="text-sm font-medium text-slate-400">{solution.title}</p>
                </div>
              </div>
              <!-- Decorative -->
              <div class="absolute -bottom-8 -right-8 w-32 h-32 rounded-full bg-brand-200/20 blur-2xl"></div>
              <div class="absolute -top-8 -left-8 w-32 h-32 rounded-full bg-accent/10 blur-2xl"></div>
            </div>
          </div>

          <div class={`${i % 2 === 1 ? 'lg:order-1' : ''}`}>
            <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider mb-2">{solution.subtitle}</p>
            <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4">{solution.title}</h3>
            <p class="text-slate-500 leading-relaxed mb-6">{solution.description}</p>

            <ul class="grid grid-cols-2 gap-3 mb-8">
              {solution.features.map(feature => (
                <li class="flex items-center gap-2 text-sm text-slate-600">
                  <div class="w-1.5 h-1.5 rounded-full bg-brand-500 shrink-0"></div>
                  {feature}
                </li>
              ))}
            </ul>

            <a href={solution.cta} class="btn-primary">
              Learn More
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
