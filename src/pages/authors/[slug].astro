---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import { authors } from '../../data/authors';

export async function getStaticPaths() {
  return authors.map((author) => ({
    params: { slug: author.slug },
    props: { author },
  }));
}

const { author } = Astro.props;

const allPosts = await getCollection('blog');
const authorPosts = allPosts
  .filter((p) => p.data.author === author.name)
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date));

const canonicalUrl = `/authors/${author.slug}/`;
const siteUrl = 'https://qbitsenergy.com';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  jobTitle: author.role,
  description: author.shortBio,
  image: `${siteUrl}${author.photo}`,
  url: `${siteUrl}${canonicalUrl}`,
  sameAs: [author.linkedin],
  worksFor: {
    '@type': 'Organization',
    name: 'Qbits Energy',
    url: siteUrl,
  },
};
---

<Layout
  title={`${author.name}, ${author.role} | Qbits Energy`}
  description={author.bio.slice(0, 160)}
  canonical={canonicalUrl}
>
  <HeaderV2 />

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <main id="main-content">
    <!-- Hero -->
    <section class="relative overflow-hidden bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 pt-[104px] lg:pt-[120px]">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="absolute -top-40 -right-40 w-[28rem] h-[28rem] bg-brand-500/20 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-[28rem] h-[28rem] bg-brand-500/10 rounded-full blur-3xl"></div>

      <div class="container-main relative py-16 lg:py-24">
        <nav class="flex items-center gap-2 text-xs text-slate-400 mb-10" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white transition">Home</a>
          <span>/</span>
          <a href="/blog/" class="hover:text-white transition">Blog</a>
          <span>/</span>
          <span class="text-slate-300">{author.name}</span>
        </nav>

        <div class="flex flex-col sm:flex-row items-start gap-8 lg:gap-12">
          <div class="flex-shrink-0">
            <div class="w-28 h-28 lg:w-36 lg:h-36 rounded-2xl overflow-hidden ring-4 ring-white/10">
              <img
                src={author.photo}
                alt={author.name}
                width="144"
                height="144"
                class="w-full h-full object-cover object-top"
              />
            </div>
          </div>

          <div class="flex-1 min-w-0">
            <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-brand-400 bg-brand-500/15 ring-1 ring-brand-500/30 px-3 py-1.5 rounded-full mb-4">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-400"></span>
              {author.role}
            </div>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight">{author.name}</h1>
            <p class="mt-4 text-slate-300 text-lg leading-relaxed max-w-3xl">{author.bio}</p>

            <div class="mt-6 flex items-center gap-4">
              <a
                href={author.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm font-semibold text-white bg-white/10 hover:bg-white/20 px-4 py-2 rounded-lg transition-colors"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
                LinkedIn Profile
              </a>
              <span class="text-slate-400 text-sm">{authorPosts.length} articles published</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Articles by this author -->
    <section class="py-16 lg:py-24 bg-white">
      <div class="container-main">
        <div class="mb-12">
          <span class="section-label justify-start">
            <span class="w-8 h-px bg-brand-500"></span>
            Articles by {author.name.split(' ')[0]}
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mt-4">
            {authorPosts.length} {authorPosts.length === 1 ? 'Article' : 'Articles'} Published
          </h2>
        </div>

        {authorPosts.length > 0 ? (
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
            {authorPosts.map((post) => {
              const postDate = new Date(post.data.date).toLocaleDateString('en-US', {
                year: 'numeric', month: 'short', day: 'numeric',
              });
              const categorySlug = post.data.category
                ? post.data.category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
                : '';
              return (
                <article class="group bg-white rounded-2xl overflow-hidden ring-1 ring-slate-200 hover:ring-brand-300 hover:shadow-xl hover:shadow-brand-500/5 transition-all duration-300 flex flex-col">
                  {post.data.image && (
                    <a href={`/blog/${post.id}/`} class="block aspect-[16/9] overflow-hidden bg-slate-100 flex-shrink-0">
                      <img
                        src={post.data.image}
                        alt={post.data.title}
                        width="640"
                        height="360"
                        loading="lazy"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      />
                    </a>
                  )}
                  <div class="p-5 sm:p-6 flex flex-col flex-1">
                    {categorySlug && (
                      <a
                        href={`/blog/category/${categorySlug}/`}
                        class="text-xs font-bold uppercase tracking-wider text-brand-600 hover:text-brand-700 transition-colors"
                      >
                        {post.data.category}
                      </a>
                    )}
                    <h3 class="mt-2 text-base font-bold text-slate-900 leading-snug group-hover:text-brand-600 transition-colors flex-1">
                      <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                    </h3>
                    <p class="mt-2 text-sm text-slate-500 line-clamp-2">{post.data.excerpt}</p>
                    <div class="mt-4 flex items-center gap-2 text-xs text-slate-400">
                      <span>{postDate}</span>
                      <span class="w-1 h-1 rounded-full bg-slate-300"></span>
                      <span>{post.data.readTime} read</span>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <p class="text-slate-500">No articles published yet.</p>
        )}
      </div>
    </section>

    <!-- Meet the team CTA -->
    <section class="py-16 bg-slate-50">
      <div class="container-main text-center">
        <h2 class="text-2xl font-bold text-slate-900">Meet the Full Team</h2>
        <p class="mt-3 text-slate-500 max-w-lg mx-auto">Learn more about the people building India's most reliable solar inverter brand.</p>
        <a href="/about-us/" class="mt-6 inline-flex items-center gap-2 bg-brand-500 hover:bg-brand-600 text-white font-semibold px-6 py-3 rounded-xl transition-colors">
          About Qbits Energy
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
