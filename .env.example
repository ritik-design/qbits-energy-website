# Set in Cloudflare Pages dashboard → Settings → Environment Variables.
# All PUBLIC_* vars are inlined into the build and visible to clients.

# === Lead capture ===
# Forms post directly to https://formsubmit.co/ajax/<email> from the client (email notification),
# AND to /api/lead (src/pages/api/lead.ts), which syncs the lead into Odoo CRM server-side.
# The FormSubmit recipient email is hardcoded in:
#   src/pages/contact-us/index.astro
#   src/components/home/QuickLeadForm.astro
#   src/pages/download-datasheets/index.astro
# Change it there and rebuild. First-ever submission to a new address requires
# a one-time activation click (FormSubmit emails the recipient an activation link).

# === Odoo CRM sync (server-side only — set as secrets, never PUBLIC_*) ===
# Used by src/pages/api/lead.ts to create crm.lead opportunities via Odoo's JSON-RPC API.
# Set these in Cloudflare Pages dashboard → Settings → Environment Variables (Production + Preview),
# or via `wrangler pages secret put <NAME>`. Requires an Odoo "Custom" pricing plan (external API
# access is not available on One App Free / Standard plans).
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=

# === Analytics ===
# GTM container ID, e.g. GTM-XXXXXXX. When unset, GTM snippet does not render.
PUBLIC_GTM_ID=

# === Indexing ===
# Set to "true" on preview/staging deployments (e.g. *.pages.dev) to keep them out of Google.
# Leave unset/blank on production qbitsenergy.com so the site is crawlable.
PUBLIC_ROBOTS_NOINDEX=
