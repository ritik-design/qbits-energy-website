<script is:inline>
  (() => {
    // Email notification path (FormSubmit AJAX). /api/lead (Odoo + Sheet) is awaited alongside it:
    // success if EITHER accepted the application, error only if BOTH failed.
    const EMAIL_ENDPOINT = 'https://formsubmit.co/ajax/ritik@thestacc.com';
    const SUCCESS_MESSAGE = 'Thank you! Your partner application has been submitted. The Qbits team will review your details and get in touch.';
    const ERROR_MESSAGE = 'Sorry, we couldn’t submit your application. Please call +91 99791 92935 or email service@qbitsenergy.com.';

    const form = document.getElementById('partner-form');
    const status = document.getElementById('partner-status');
    const btn = document.getElementById('partner-submit');
    const labelDefault = btn.querySelector('[data-label-default]');
    const labelSending = btn.querySelector('[data-label-sending]');
    const lead = window.QbLead;
    const guard = lead.createGuard();
    // One id per application: reused if the visitor retries after a failure, replaced after success.
    let submissionId = null;

    // Links from blogs and the contact page pass ?role= (business type) and ?from= (source page).
    const params = new URLSearchParams(location.search);
    const role = params.get('role');
    if (role) {
      for (const radio of form.querySelectorAll('input[name="businessType"]')) {
        if (radio.value === role) radio.checked = true;
      }
    }
    const from = params.get('from') || '';
    if (/^\/(?!\/)[a-zA-Z0-9/_\-.]*$/.test(from) && !/\/\.{1,2}(?:\/|$)/.test(from) && from.length <= 200) {
      form.elements.namedItem('sourcePage').value = from;
    }

    const setSending = (sending) => {
      btn.disabled = sending;
      btn.setAttribute('aria-busy', sending ? 'true' : 'false');
      labelDefault.classList.toggle('hidden', sending);
      labelSending.classList.toggle('hidden', !sending);
    };

    const showStatus = (msg, ok) => {
      status.classList.remove('hidden');
      status.textContent = msg;
      status.className = 'text-sm mt-4 ' + (ok ? 'text-emerald-600' : 'text-rose-600');
      if (ok) status.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (guard.isBusy()) return;

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      // Honeypot - silently succeed for bots, never actually submit.
      if ((form.elements.namedItem('hp_field_x7') || {}).value) {
        form.reset();
        showStatus(SUCCESS_MESSAGE, true);
        return;
      }

      if (!guard.begin()) return;
      setSending(true);
      try {
        if (!submissionId) submissionId = lead.newSubmissionId(window.crypto);
        const data = Object.assign(
          { source: 'partner-form', page: location.pathname, submittedAt: new Date().toISOString() },
          lead.collectFields(Array.from(new FormData(form).entries()), ['hp_field_x7']),
          lead.getAttribution(),
        );
        data.submission_id = submissionId;
        data._subject = 'New Qbits Channel Partner Application: ' + (data.companyName || 'Unknown');
        data._template = 'table';
        data._captcha = 'false';

        lead.track(window.gtag, 'form_submit_attempt', { form_id: 'partner', subject: 'Channel Partner Application' });

        const outcome = await lead.submitLead({
          data,
          sendEmail: () => lead.postFormSubmit(fetch, EMAIL_ENDPOINT, data),
        });

        if (outcome.success) {
          lead.trackLeadOnce(window.gtag, data.submission_id, {
            form_id: 'partner',
            inquiry_type: 'Channel Partner Application',
            buyer_role: data.businessType || '',
            source_page: data.sourcePage || location.pathname,
          });
          submissionId = null;
          form.reset();
          showStatus(SUCCESS_MESSAGE, true);
        } else {
          lead.track(window.gtag, 'form_error', { form_id: 'partner', error_stage: 'crm_and_email' });
          showStatus(ERROR_MESSAGE, false);
        }
      } catch (err) {
        console.error('Partner form submission failed:', err);
        lead.track(window.gtag, 'form_error', { form_id: 'partner', error_stage: 'client' });
        showStatus(ERROR_MESSAGE, false);
      } finally {
        guard.end();
        setSending(false);
      }
    });
  })();
</script>
