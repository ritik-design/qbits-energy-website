---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { getProductsByCategory } from '../../data/products';

const hybridProducts = getProductsByCategory('hybrid');
---

<Layout
  title="Hybrid Inverters | Qbits Energy"
  description="Intelligent battery-ready hybrid solar inverters from 3kW to 10kW. Seamless grid and off-grid switching with smart energy management."
  canonical="/hybrid-inverter/"
>
  <Header />

  <main>
    <PageHeader
      label="Hybrid Inverters"
      title="Battery-Ready"
      highlight="Hybrid Inverters"
      description="Take control of your energy with Qbits hybrid inverters. Store solar power for backup and achieve true energy independence."
    />

    <section class="section-padding bg-white" aria-labelledby="hybrid-heading">
      <div class="container-main">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {hybridProducts.map(product => (
            <a href={`/our-products/${product.id}/`} class="group card hover:border-brand-200 hover:shadow-lg transition-all">
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-semibold uppercase tracking-wider text-accent bg-accent/10 px-2.5 py-1 rounded-full">Hybrid</span>
                <span class="text-xs text-slate-400">{product.id}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors">{product.name}</h3>
              <p class="text-sm text-slate-500 mt-2">{product.voltageRange} | {product.communication}</p>
              <div class="grid grid-cols-3 gap-2 mt-4 pt-4 border-t border-slate-100">
                <div class="text-center"><p class="text-lg font-bold text-slate-900">{product.efficiency}</p><p class="text-[10px] text-slate-500 uppercase">Efficiency</p></div>
                <div class="text-center"><p class="text-lg font-bold text-slate-900">{product.mppt}</p><p class="text-[10px] text-slate-500 uppercase">MPPT</p></div>
                <div class="text-center"><p class="text-lg font-bold text-slate-900">{product.powerMax}kW</p><p class="text-[10px] text-slate-500 uppercase">Power</p></div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section-padding bg-brand-500">
      <div class="container-main text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">Why Choose Hybrid?</h2>
        <div class="grid sm:grid-cols-3 gap-6 mt-10 text-left">
          <div class="bg-white/10 rounded-xl p-6 backdrop-blur-sm">
            <div class="w-10 h-10 rounded-lg bg-white/20 flex items-center justify-center text-white mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <h3 class="font-bold text-white mb-2">Energy Independence</h3>
            <p class="text-sm text-brand-100">Store excess solar energy and use it when the grid is down or during peak hours.</p>
          </div>
          <div class="bg-white/10 rounded-xl p-6 backdrop-blur-sm">
            <div class="w-10 h-10 rounded-lg bg-white/20 flex items-center justify-center text-white mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="font-bold text-white mb-2">Cost Savings</h3>
            <p class="text-sm text-brand-100">Reduce electricity bills by using stored solar power during expensive peak rate periods.</p>
          </div>
          <div class="bg-white/10 rounded-xl p-6 backdrop-blur-sm">
            <div class="w-10 h-10 rounded-lg bg-white/20 flex items-center justify-center text-white mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </div>
            <h3 class="font-bold text-white mb-2">Backup Power</h3>
            <p class="text-sm text-brand-100">Keep critical appliances running during power outages with seamless switching.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>