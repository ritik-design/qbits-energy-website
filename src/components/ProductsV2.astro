---
const products = [
  {
    title: 'On-Grid Residential',
    desc: 'Single-phase inverters for homes and apartments. 1kW to 10kW range with smart monitoring.',
    specs: ['1-10kW', '98.6% Efficiency', 'Single Phase'],
    badge: 'Popular',
    image: 'on-grid-res',
  },
  {
    title: 'On-Grid Commercial',
    desc: 'Three-phase inverters for businesses and industries. 10kW to 125kW with parallel operation.',
    specs: ['10-125kW', '98.8% Efficiency', 'Three Phase'],
    badge: null,
    image: 'ongrid-commercial',
  },
  {
    title: 'Hybrid Inverters',
    desc: 'Battery-ready inverters with seamless grid/off-grid switching. 3kW to 12kW range.',
    specs: ['3-12kW', '98% Efficiency', 'Battery Ready'],
    badge: 'New',
    image: 'hybrid',
  },
];
---

<section class="section-padding bg-slate-950 relative overflow-hidden" aria-labelledby="products-heading">
  <!-- Grid lines -->
  <div class="absolute inset-0 grid-lines opacity-20" aria-hidden="true"></div>

  <div class="container-main relative">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-16">
      <div>
        <span class="section-label">
          <span class="w-8 h-px bg-brand-500"></span>
          Product Range
        </span>
        <h2 id="products-heading" class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mt-6 leading-tight">
          Engineered for Every<br />
          <span class="text-gradient">Solar Application</span>
        </h2>
      </div>
      <a href="/our-products/" class="btn-outline text-white border-slate-700 hover:border-brand-500 hover:text-brand-400 shrink-0">
        View All Products
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

    <div class="grid lg:grid-cols-3 gap-6">
      {products.map((product, i) => (
        <a href={`/${product.image === 'hybrid' ? 'hybrid-inverter' : 'on-grid-inverter'}/`}
           class="group relative bg-slate-900/50 backdrop-blur-sm rounded-3xl border border-slate-800 overflow-hidden hover:border-brand-500/30 transition-all duration-500">

          {product.badge && (
            <div class="absolute top-6 right-6 z-10">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-500/10 border border-brand-500/20 px-3 py-1 text-xs font-semibold text-brand-400">
                {product.badge}
              </span>
            </div>
          )}

          <!-- Image placeholder -->
          <div class="aspect-[4/3] bg-gradient-to-br from-slate-800 to-slate-900 relative overflow-hidden">
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="text-center">
                <div class="w-16 h-16 mx-auto rounded-2xl bg-slate-800 border border-slate-700 flex items-center justify-center mb-3">
                  <svg class="w-8 h-8 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                </div>
                <p class="text-xs text-slate-600">{product.title} Image</p>
              </div>
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent"></div>
          </div>

          <div class="p-8">
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-brand-400 transition-colors">{product.title}</h3>
            <p class="text-sm text-slate-400 leading-relaxed mb-6">{product.desc}</p>

            <div class="flex flex-wrap gap-2">
              {product.specs.map(spec => (
                <span class="inline-flex items-center rounded-lg bg-slate-800 px-3 py-1.5 text-xs font-medium text-slate-300">
                  {spec}
                </span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
