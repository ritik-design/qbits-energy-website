# ============================================================
# Cloudflare Pages / Workers _redirects
# Note: 301 redirects are now declared in astro.config.mjs
# (the Astro Cloudflare adapter emits them into this file at build time)
# Keep only rewrites here that Astro's `redirects` config can't express.
# ============================================================

# ── Standard /sitemap.xml served from Astro's sitemap-index.xml ──
# Status 200 = rewrite/proxy: URL stays as /sitemap.xml but the body
# is the generated sitemap index.
/sitemap.xml /sitemap-index.xml 200
