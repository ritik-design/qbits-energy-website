---
const products = [
  {
    title: 'On Grid Inverters',
    subtitle: '1kW - 125kW',
    desc: 'High-efficiency grid-tied inverters for every scale.',
    href: '/on-grid-inverter/',
    image: '/images/ongrid-res.webp',
  },
  {
    title: 'Hybrid Inverters',
    subtitle: '3kW - 12kW',
    desc: 'Battery-ready inverters for energy independence.',
    href: '/hybrid-inverter/',
    image: '/images/hybrid.webp',
  },
];
---

<section class="py-20 sm:py-28 lg:py-36 bg-white" aria-labelledby="categories-heading">
  <div class="container-main">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="section-label">
        <span class="w-8 h-px bg-brand-500"></span>
        Product Range
      </span>
      <h2 id="categories-heading" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mt-6 leading-tight">
        Choose Your <span class="text-gradient">Power</span>
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {products.map((product) => (
        <a href={product.href} class="group relative rounded-3xl overflow-hidden aspect-[4/3] bg-slate-900">
          <!-- Image -->
          <img width="1920" height="1080"
            src={product.image}
            alt={product.title}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />

          <!-- Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>

          <!-- Content -->
          <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8">
            <p class="text-sm font-medium text-brand-400 mb-2">{product.subtitle}</p>
            <h3 class="text-xl sm:text-2xl lg:text-3xl font-bold text-white mb-2 group-hover:translate-x-2 transition-transform duration-500">{product.title}</h3>
            <p class="text-sm text-slate-300 mb-4">{product.desc}</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-white group-hover:text-brand-400 transition-colors">
              Explore
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
