---
---

<section class="relative min-h-screen flex items-center overflow-hidden bg-slate-950 pt-32 pb-20" aria-labelledby="hero-heading">
  <!-- Animated grid background -->
  <div class="absolute inset-0 grid-lines opacity-30" aria-hidden="true"></div>

  <!-- Gradient orbs -->
  <div class="absolute top-1/4 -left-40 w-96 h-96 rounded-full bg-brand-500/10 blur-[120px] animate-pulse" style="animation-duration: 4s;"></div>
  <div class="absolute bottom-1/4 -right-40 w-96 h-96 rounded-full bg-accent/5 blur-[120px] animate-pulse" style="animation-duration: 6s; animation-delay: 2s;"></div>

  <!-- Diagonal accent line -->
  <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-bl from-brand-500/5 to-transparent" aria-hidden="true"></div>

  <div class="container-main relative z-10">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-20 items-center">
      <!-- Text Content -->
      <div class="max-w-2xl">
        <div class="animate-fade-up" style="animation-delay: 0.1s;">
          <span class="section-label mb-8">
            <span class="w-8 h-px bg-brand-500"></span>
            India's Solar Inverter Pioneer
          </span>
        </div>

        <h1 id="hero-heading" class="text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-bold text-white leading-[1.05] tracking-tight mt-8 animate-fade-up" style="animation-delay: 0.2s;">
          Powering the
          <span class="block mt-2">
            <span class="bg-gradient-to-r from-brand-400 to-brand-300 bg-clip-text text-transparent">Future</span>
          </span>
          <span class="block mt-2 text-slate-400 text-4xl sm:text-5xl lg:text-6xl font-medium">with Intelligent Solar</span>
        </h1>

        <p class="mt-8 text-lg sm:text-xl text-slate-400 leading-relaxed max-w-lg animate-fade-up" style="animation-delay: 0.3s;">
          Advanced on-grid and hybrid solar inverters engineered for Indian conditions. Maximum efficiency, intelligent monitoring, and uncompromising reliability.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row gap-4 animate-fade-up" style="animation-delay: 0.4s;">
          <a href="/our-products/" class="btn-primary text-base py-4 px-8">
            Explore Products
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="/contact-us/" class="btn-outline text-base py-4 px-8 border-slate-700 text-slate-300 hover:border-brand-500 hover:text-brand-400">
            Become a Dealer
          </a>
        </div>

        <!-- Trust badges -->
        <div class="mt-14 pt-8 border-t border-slate-800/50 flex flex-wrap items-center gap-8 animate-fade-up" style="animation-delay: 0.5s;">
          <div class="flex items-center gap-2.5">
            <div class="w-10 h-10 rounded-full bg-brand-500/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <span class="text-sm text-slate-400">BIS Certified</span>
          </div>
          <div class="flex items-center gap-2.5">
            <div class="w-10 h-10 rounded-full bg-brand-500/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
              </svg>
            </div>
            <span class="text-sm text-slate-400">IEC Standards</span>
          </div>
          <div class="flex items-center gap-2.5">
            <div class="w-10 h-10 rounded-full bg-brand-500/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <span class="text-sm text-slate-400">5+ Years Warranty</span>
          </div>
        </div>
      </div>

      <!-- Visual Side - Image Placeholder -->
      <div class="relative hidden lg:flex items-center justify-center animate-fade-in" style="animation-delay: 0.6s;">
        <!-- Decorative ring -->
        <div class="absolute w-[500px] h-[500px] rounded-full border border-slate-700/20 animate-[spin_60s_linear_infinite]" aria-hidden="true"></div>
        <div class="absolute w-[400px] h-[400px] rounded-full border border-slate-700/10 animate-[spin_40s_linear_infinite_reverse]" aria-hidden="true"></div>

        <!-- Image placeholder -->
        <div class="relative w-full max-w-lg aspect-[4/3] rounded-3xl overflow-hidden bg-gradient-to-br from-slate-800 to-slate-900 border border-slate-700/30">
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="text-center">
              <div class="w-20 h-20 mx-auto rounded-2xl bg-brand-500/10 border border-brand-500/20 flex items-center justify-center mb-4">
                <svg class="w-10 h-10 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
              <p class="text-sm text-slate-500">Hero Image</p>
              <p class="text-xs text-slate-600 mt-1">Replace with product/team photo</p>
            </div>
          </div>
          <!-- Decorative glow -->
          <div class="absolute -bottom-20 -right-20 w-40 h-40 rounded-full bg-brand-500/20 blur-3xl"></div>
          <div class="absolute -top-20 -left-20 w-40 h-40 rounded-full bg-accent/10 blur-3xl"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom scroll indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce" aria-hidden="true">
    <span class="text-xs text-slate-600 uppercase tracking-widest">Scroll</span>
    <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>
