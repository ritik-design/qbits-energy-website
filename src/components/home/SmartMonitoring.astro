---
const features = [
  { title: 'Mobile App', desc: 'Monitor your system anywhere with real-time data on iOS and Android.', icon: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z' },
  { title: 'Performance Tracking', desc: 'Detailed analytics on energy generation, consumption, and savings over time.', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
  { title: 'Fault Detection', desc: 'AI-powered alerts instantly notify you of any system issues or anomalies.', icon: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z' },
  { title: 'Remote Diagnostics', desc: 'Our support team can diagnose and resolve issues remotely without site visits.', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
];
---

<section class="relative py-20 sm:py-28 lg:py-36 overflow-hidden bg-slate-950" aria-labelledby="monitoring-heading">
  <!-- Background -->
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/95 to-slate-950/80 z-10"></div>
    <div class="w-full h-full bg-gradient-to-br from-slate-900 to-slate-800"></div>
  </div>

  <div class="container-main relative z-20">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <!-- Content -->
      <div>
        <span class="section-label text-brand-400">
          <span class="w-8 h-px bg-brand-500"></span>
          Monitoring
        </span>
        <h2 id="monitoring-heading" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mt-6 leading-tight">
          Monitor Every Watt <span class="text-gradient">In Real Time</span>
        </h2>
        <p class="mt-6 text-base sm:text-lg text-slate-400 leading-relaxed max-w-lg">
          The Qbits Smart Monitoring Platform puts complete control of your solar system in your pocket. Track performance, detect faults, and optimize output — from anywhere in the world.
        </p>

        <div class="mt-10 grid sm:grid-cols-2 gap-4">
          {features.map((item) => (
            <div class="group flex items-start gap-4 p-4 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 hover:border-brand-500/30 transition-all duration-300">
              <div class="w-10 h-10 rounded-lg bg-brand-500/10 border border-brand-500/20 flex items-center justify-center shrink-0 group-hover:bg-brand-500 group-hover:border-brand-500 transition-all duration-300">
                <svg class="w-5 h-5 text-brand-400 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon}/>
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-bold text-white mb-1">{item.title}</h3>
                <p class="text-xs text-slate-400 leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href="https://apps.apple.com/in/app/qbits-inverter/id6745775491" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white/5 border border-white/10 text-white text-sm font-semibold hover:bg-white/10 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.21-1.96 1.07-3.11-1.05.05-2.31.71-3.06 1.64-.68.84-1.27 2.18-1.11 3.28 1.18.09 2.38-.6 3.1-1.81z"/>
            </svg>
            App Store
          </a>
          <a href="https://play.google.com/store/apps/details?id=io.aotai.qbit" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white/5 border border-white/10 text-white text-sm font-semibold hover:bg-white/10 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/>
            </svg>
            Google Play
          </a>
        </div>
      </div>

      <!-- Dashboard Preview -->
      <div class="relative">
        <div class="aspect-[4/3] rounded-3xl bg-gradient-to-br from-slate-800 to-slate-900 border border-slate-800 overflow-hidden shadow-2xl shadow-brand-500/10">
          <img
            src="/images/smart-features.png"
            alt="Qbits smart monitoring dashboard"
            class="w-full h-full object-cover opacity-80"
            loading="lazy"
          />
        </div>
        <div class="absolute -inset-4 bg-brand-500/5 rounded-[2rem] blur-3xl -z-10"></div>
      </div>
    </div>
  </div>
</section>
