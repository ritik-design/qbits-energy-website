---
const facts = [
  { value: 'On-grid', label: 'Product family' },
  { value: 'Hybrid', label: 'Product family' },
  { value: 'Single-phase', label: 'Model options' },
  { value: 'Three-phase', label: 'Model options' },
];
---

<section class="relative py-20 sm:py-28 lg:py-36 bg-slate-950 overflow-hidden" aria-labelledby="stats-heading">
  <div class="absolute inset-0 bg-gradient-to-b from-slate-900 to-slate-950"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[min(600px,90vw)] h-[400px] bg-brand-500/5 rounded-full blur-[120px]"></div>

  <div class="container-main relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="section-label text-brand-400">
        <span class="w-8 h-px bg-brand-500"></span>
        Published range
      </span>
      <h2 id="stats-heading" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mt-6 leading-tight">
        Product families in the <span class="text-gradient">Qbits catalogue</span>
      </h2>
      <p class="mt-5 text-slate-400">Availability and specifications are model specific. Confirm the current datasheet and quotation before designing or purchasing a system.</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-8">
      {facts.map((fact) => (
        <div class="group relative text-center p-6 sm:p-8 rounded-3xl bg-white/5 border border-white/10 hover:bg-white/10 hover:border-brand-500/30 transition-all duration-500">
          <p class="relative text-xl sm:text-2xl font-bold text-white mb-3">{fact.value}</p>
          <p class="relative text-sm font-medium text-slate-400 uppercase tracking-wider">{fact.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
