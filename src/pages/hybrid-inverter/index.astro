---
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { getProductsByCategory } from '../../data/products';

const hybridProducts = getProductsByCategory('hybrid');
const singlePhase = hybridProducts.filter(p => p.phase === 'single');
const threePhase = hybridProducts.filter(p => p.phase === 'three');

const advantages = [
  { title: 'Energy Independence', desc: 'Store excess solar energy and use it when the grid is down or during peak hours. Reduce dependence on utility power.' },
  { title: 'Cost Savings', desc: 'Reduce electricity bills by using stored solar power during expensive peak rate periods. Faster payback on investment.' },
  { title: 'Backup Power', desc: 'Keep critical appliances running during power outages with seamless <10 second switching. UPS-grade reliability.' },
  { title: '120A Battery Current', desc: 'High charge/discharge current supports rapid battery cycling and high power backup loads.' },
  { title: '2x Peak Power', desc: 'Handle motor starting surges and inductive loads with 2x rated power for 15 seconds.' },
  { title: 'Multi-Battery Support', desc: 'Compatible with both lead-acid and lithium-ion battery chemistries for maximum flexibility.' },
];
---

<Layout
  title="Hybrid Inverters | Qbits Energy"
  description="Intelligent battery-ready hybrid solar inverters from 3kW to 12kW. Seamless grid and off-grid switching with smart energy management."
  canonical="/hybrid-inverter/"
>
  <HeaderV2 />

  <main>
    <PageHeader
      label="Hybrid Inverters"
      title="Battery-Ready"
      highlight="Hybrid Inverters"
      description="Take control of your energy with Qbits hybrid inverters. Store solar power for backup and achieve true energy independence."
      bgImage="/images/hybrid.webp"
    />

    <!-- Advantages -->
    <section class="section-padding bg-white" aria-labelledby="adv-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Why Hybrid
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="adv-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Advantages of Going Hybrid
          </h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {advantages.map(a => (
            <div class="bg-slate-50 rounded-2xl p-8 adv-card">
              <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center text-accent mb-5">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">{a.title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed">{a.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Single Phase -->
    <section class="section-padding bg-slate-50 product-section" aria-labelledby="single-phase-heading">
      <div class="container-main">
        <div class="flex items-center gap-4 mb-4">
          <span class="section-label">
            <span class="w-8 h-px bg-brand-500"></span>
            Residential
          </span>
        </div>
        <h2 id="single-phase-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Single Phase Hybrid</h2>
        <p class="text-slate-500 max-w-2xl mb-12">Ideal for homes and small businesses. Store solar energy for evening use or power cuts. Available in 3kW to 8kW options.</p>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {singlePhase.map(product => (
            <a href={`/our-products/${product.id}/`} class="group bg-white rounded-2xl border border-slate-200 p-6 hover:border-accent/30 hover:shadow-xl hover:shadow-accent/5 transition-all duration-500 product-card">
              <div class="flex items-center justify-between mb-5">
                <span class="text-xs font-bold uppercase tracking-wider text-accent bg-accent/10 px-3 py-1.5 rounded-full">1 Phase Hybrid</span>
                <span class="text-xs text-slate-400 font-mono">{product.id}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors mb-3">{product.name}</h3>
              <p class="text-sm text-slate-500 mb-5">{product.voltageRange} • {product.communication}</p>
              <div class="grid grid-cols-3 gap-3 pt-5 border-t border-slate-100">
                <div class="text-center"><p class="text-xl font-bold text-slate-900">{product.efficiency}</p><p class="text-[10px] text-slate-400 uppercase">Efficiency</p></div>
                <div class="text-center"><p class="text-xl font-bold text-slate-900">{product.mppt}</p><p class="text-[10px] text-slate-400 uppercase">MPPT</p></div>
                <div class="text-center"><p class="text-xl font-bold text-slate-900">{product.powerMax}kW</p><p class="text-[10px] text-slate-400 uppercase">Power</p></div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Three Phase -->
    <section class="section-padding bg-white product-section" aria-labelledby="three-phase-heading">
      <div class="container-main">
        <div class="flex items-center gap-4 mb-4">
          <span class="section-label">
            <span class="w-8 h-px bg-brand-500"></span>
            Commercial
          </span>
        </div>
        <h2 id="three-phase-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Three Phase Hybrid</h2>
        <p class="text-slate-500 max-w-2xl mb-12">For larger homes and commercial applications requiring three-phase power. Scalable from 5kW to 12kW with parallel capability.</p>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {threePhase.map(product => (
            <a href={`/our-products/${product.id}/`} class="group bg-white rounded-2xl border border-slate-200 p-6 hover:border-accent/30 hover:shadow-xl hover:shadow-accent/5 transition-all duration-500 product-card">
              <div class="flex items-center justify-between mb-5">
                <span class="text-xs font-bold uppercase tracking-wider text-accent bg-accent/10 px-3 py-1.5 rounded-full">3 Phase Hybrid</span>
                <span class="text-xs text-slate-400 font-mono">{product.id}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors mb-3">{product.name}</h3>
              <p class="text-sm text-slate-500 mb-5">{product.voltageRange} • {product.communication}</p>
              <div class="grid grid-cols-3 gap-3 pt-5 border-t border-slate-100">
                <div class="text-center"><p class="text-xl font-bold text-slate-900">{product.efficiency}</p><p class="text-[10px] text-slate-400 uppercase">Efficiency</p></div>
                <div class="text-center"><p class="text-xl font-bold text-slate-900">{product.mppt}</p><p class="text-[10px] text-slate-400 uppercase">MPPT</p></div>
                <div class="text-center"><p class="text-xl font-bold text-slate-900">{product.powerMax}kW</p><p class="text-[10px] text-slate-400 uppercase">Power</p></div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="section-padding bg-slate-950 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-brand-500/10 via-transparent to-accent/10"></div>
      <div class="container-main relative">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center text-brand-400">
            <span class="w-8 h-px bg-brand-400"></span>
            How It Works
            <span class="w-8 h-px bg-brand-400"></span>
          </span>
          <h2 class="text-3xl sm:text-4xl font-bold text-white mt-6">
            Day in the Life of a Hybrid System
          </h2>
        </div>
        <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto">
          {[
            { time: 'Morning', title: 'Solar Generation', desc: 'Panels start generating. Priority: direct home consumption, then battery charging.', icon: 'M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707' },
            { time: 'Afternoon', title: 'Peak Production', desc: 'Maximum solar output. Excess energy stored in batteries. Grid export if configured.', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
            { time: 'Evening', title: 'Battery Backup', desc: 'Solar drops. Battery seamlessly powers the home. Grid as final backup if needed.', icon: 'M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z' },
          ].map((step, i) => (
            <div class="text-center step-card">
              <div class="w-20 h-20 mx-auto rounded-2xl bg-white/10 backdrop-blur flex items-center justify-center text-brand-400 mb-6">
                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={step.icon}/></svg>
              </div>
              <span class="text-sm font-bold text-brand-400 uppercase tracking-wider">{step.time}</span>
              <h3 class="text-xl font-bold text-white mt-2 mb-3">{step.title}</h3>
              <p class="text-slate-400 text-sm leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 lg:py-32 bg-brand-500 text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="container-main relative text-center max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold mb-6">Ready for Energy Independence?</h2>
        <p class="text-lg text-brand-100 mb-10">Get a free consultation to design your hybrid solar system.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/contact-us/" class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-8 py-4 text-sm font-semibold text-brand-600 shadow-lg hover:bg-brand-50 transition-all">Request a Quote</a>
          <a href="/our-products/" class="btn-outline">View All Products</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

