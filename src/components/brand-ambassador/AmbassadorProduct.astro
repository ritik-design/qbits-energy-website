---
// Product pages — treats the photo as a product shot, not a celebrity placement.
// The whole point is that the unit in frame is the unit on this page.
const {
  image = '/brand-ambassador/portrait-1.webp',
  name = 'Dilip Joshi',
  product = 'Qbits on-grid inverter',
  heading = 'The Inverter In His Hands',
} = Astro.props;

const specs = [
  { value: '98.8%', label: 'Peak Efficiency' },
  { value: '8 + 4 Yr', label: 'Warranty' },
  { value: 'IP66', label: 'Enclosure' },
  { value: '1000+', label: 'Quality Tests' },
];
---

<section class="section-padding bg-slate-50" aria-labelledby="amb-product-heading">
  <div class="container-main">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Copy -->
      <div class="order-2 lg:order-1 lg:col-span-7">
        <span class="section-label">
          <span class="h-px w-8 bg-brand-500"></span>
          Brand Ambassador
        </span>

        <h2 id="amb-product-heading" class="mt-6 text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight text-slate-900">
          {heading}
        </h2>

        <p class="mt-6 max-w-xl text-base sm:text-lg leading-relaxed text-slate-600">
          That is not a prop. It is the same {product} we ship to installers across India,
          off the same line, with the same 8 + 4 year replacement warranty. {name} is our
          brand ambassador because the product holds up, not the other way round.
        </p>

        <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
          {specs.map((spec) => (
            <div class="rounded-2xl border border-slate-100 bg-white p-4 text-center">
              <p class="text-xl sm:text-2xl font-bold text-brand-600">{spec.value}</p>
              <p class="mt-1 text-xs font-medium text-slate-500">{spec.label}</p>
            </div>
          ))}
        </div>

        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/download-datasheets/" class="inline-flex items-center gap-2 rounded-full bg-slate-900 px-7 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-slate-800">
            Download Datasheet
          </a>
          <a href="/contact-us/" class="inline-flex items-center gap-2 rounded-full border-2 border-slate-200 px-7 py-3.5 text-sm font-semibold text-slate-700 transition-all duration-300 hover:border-brand-500 hover:text-brand-600">
            Request A Quote
          </a>
        </div>
      </div>

      <!-- Portrait -->
      <div class="order-1 lg:order-2 lg:col-span-5">
        <div class="relative mx-auto max-w-md">
          <div class="overflow-hidden rounded-[2rem] bg-white shadow-xl shadow-slate-900/5 ring-1 ring-slate-200">
            <img
              src={image}
              alt={`${name} holding a ${product}`}
              width="1200"
              height="1600"
              class="h-auto w-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="absolute -bottom-5 -left-4 hidden rounded-2xl bg-brand-500 px-5 py-3.5 shadow-lg shadow-brand-500/30 sm:block">
            <p class="text-[0.65rem] font-bold uppercase tracking-[0.18em] text-white/80">Brand Ambassador</p>
            <p class="mt-0.5 text-base font-bold text-white">{name}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
