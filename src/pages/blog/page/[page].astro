---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import HeaderV2 from '../../../components/HeaderV2.astro';
import Footer from '../../../components/Footer.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';

const PAGE_SIZE = 12;

export async function getStaticPaths() {
  const all = await getCollection('blog');
  const sorted = all
    .map((p) => ({
      slug: p.id,
      title: p.data.title,
      excerpt: p.data.excerpt,
      category: p.data.category,
      date: p.data.date,
      readTime: p.data.readTime,
      image: p.data.image,
      featured: p.data.featured,
    }))
    .sort((a, b) => +b.date - +a.date);

  const featured = sorted.find((p) => p.featured) || sorted[0];
  const regulars = sorted.filter((p) => p.slug !== featured?.slug);

  const totalPages = Math.max(1, Math.ceil(regulars.length / 12));
  // Pages 2..N (page 1 is served by /blog/index.astro)
  const paths = [];
  for (let p = 2; p <= totalPages; p++) {
    paths.push({
      params: { page: String(p) },
      props: {
        currentPage: p,
        totalPages,
        posts: regulars.slice((p - 1) * 12, p * 12),
        totalArticles: regulars.length + 1,
      },
    });
  }
  return paths;
}

const { currentPage, totalPages, posts, totalArticles } = Astro.props as {
  currentPage: number;
  totalPages: number;
  posts: any[];
  totalArticles: number;
};

const formatDate = (d: Date) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const buildPageNums = (cur: number, total: number): (number | '...')[] => {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  if (cur <= 4) return [1, 2, 3, 4, 5, '...', total];
  if (cur >= total - 3) return [1, '...', total - 4, total - 3, total - 2, total - 1, total];
  return [1, '...', cur - 1, cur, cur + 1, '...', total];
};
const pageNums = buildPageNums(currentPage, totalPages);
const pageHref = (n: number) => (n === 1 ? '/blog/' : `/blog/page/${n}/`);
---

<Layout
  title={`Solar Inverter Knowledge Hub - Page ${currentPage} of ${totalPages} | Qbits Energy`}
  description={`Page ${currentPage} of ${totalPages} - solar inverter buying guides, comparisons, maintenance tips, regulatory updates, and case studies from across India. ${totalArticles} articles in the Qbits Knowledge Hub.`}
  canonical={`/blog/page/${currentPage}/`}
>
  <HeaderV2 />

  <main id="main-content">
    <PageHeader
      label="Resources"
      title="Solar Knowledge"
      highlight="Hub"
      description="Stay updated with the latest in solar technology, maintenance tips, and industry insights."
    />

    <section class="pt-12 sm:pt-16 lg:pt-20 pb-20 sm:pb-24 lg:pb-28 bg-white" aria-labelledby="posts-heading">
      <div class="container-main">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-10 pb-6 border-b border-slate-200">
          <div>
            <span class="section-label">
              <span class="w-8 h-px bg-brand-500"></span>
              All Articles
            </span>
            <h2 id="posts-heading" class="text-3xl font-bold text-slate-900 mt-4">Latest Posts</h2>
          </div>
          <p class="text-sm text-slate-500">
            Page <span class="font-semibold text-slate-900">{currentPage}</span> of <span class="font-semibold text-slate-900">{totalPages}</span>
            <span class="mx-2 text-slate-300">|</span>
            <span class="font-semibold text-slate-900">{totalArticles}</span> articles
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-10">
          {posts.map((post) => (
            <article class="group relative flex flex-col">
              <a href={`/blog/${post.slug}/`} class="flex flex-col h-full">
                <div class="flex items-center gap-3 mb-4">
                  <span class="text-brand-600 font-bold uppercase tracking-wider text-[10px] bg-brand-50 ring-1 ring-brand-100 px-2.5 py-1 rounded-full">{post.category}</span>
                  <span class="text-xs text-slate-400">{post.readTime}</span>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-brand-600 transition-colors leading-snug tracking-tight">
                  {post.title}
                </h3>
                <p class="text-sm text-slate-500 leading-relaxed line-clamp-3 mb-5">{post.excerpt}</p>
                <div class="mt-auto pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
                  <span class="text-slate-400">{formatDate(post.date)}</span>
                  <span class="inline-flex items-center gap-1 font-semibold text-brand-600">
                    Read
                    <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                  </span>
                </div>
              </a>
            </article>
          ))}
        </div>

        <nav class="mt-12 flex items-center justify-center gap-2" aria-label="Blog pagination">
          <a href={pageHref(currentPage - 1)} class="inline-flex items-center justify-center min-w-10 h-10 px-3 rounded-full text-sm font-semibold border border-slate-200 text-slate-700 hover:border-brand-300 hover:text-brand-600 hover:bg-brand-50 transition-colors">Prev</a>
          {pageNums.map((n) => (
            n === '...' ? (
              <span class="inline-flex items-center justify-center w-10 h-10 text-sm text-slate-400">…</span>
            ) : n === currentPage ? (
              <span class="inline-flex items-center justify-center min-w-10 h-10 px-3 rounded-full text-sm font-bold bg-brand-500 text-white shadow-lg shadow-brand-500/20" aria-current="page">{n}</span>
            ) : (
              <a href={pageHref(n)} class="inline-flex items-center justify-center min-w-10 h-10 px-3 rounded-full text-sm font-semibold border border-slate-200 text-slate-700 hover:border-brand-300 hover:text-brand-600 hover:bg-brand-50 transition-colors">{n}</a>
            )
          ))}
          {currentPage < totalPages ? (
            <a href={pageHref(currentPage + 1)} class="inline-flex items-center justify-center min-w-10 h-10 px-3 rounded-full text-sm font-semibold border border-slate-200 text-slate-700 hover:border-brand-300 hover:text-brand-600 hover:bg-brand-50 transition-colors">Next</a>
          ) : (
            <span class="inline-flex items-center justify-center min-w-10 h-10 px-3 rounded-full text-sm font-semibold bg-slate-100 text-slate-400 cursor-not-allowed" aria-disabled="true">Next</span>
          )}
        </nav>
      </div>
    </section>

    <section class="py-24 lg:py-32 bg-brand-500 text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="container-main relative text-center max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold mb-6">Have Questions About Solar?</h2>
        <p class="text-lg text-brand-100 mb-10">Our team of solar experts is ready to help you with product selection, system design, and installation guidance.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/contact-us/" class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-8 py-4 text-sm font-semibold text-brand-600 shadow-lg hover:bg-brand-50 transition-all">Contact Us</a>
          <a href="/our-products/" class="btn-outline">Explore Products</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
