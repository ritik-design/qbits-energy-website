---
// Variant 5 — Compact announcement strip
// Slim and reusable. Drop it on product pages, the dealer page, or above the
// footer without stealing attention from the main content.
const {
  image = '/brand-ambassador/square-1.webp',
  name = 'Dilip Joshi',
} = Astro.props;
---

<section class="bg-white py-14 sm:py-20" aria-labelledby="amb-strip-heading">
  <div class="container-main">
    <div class="relative overflow-hidden rounded-[2rem] bg-slate-950">
      <!-- Ambient glow -->
      <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-brand-500/25 blur-[100px]" aria-hidden="true"></div>
      <div class="absolute -bottom-32 left-1/3 h-72 w-72 rounded-full bg-accent/10 blur-[100px]" aria-hidden="true"></div>

      <!-- Scrolling marquee -->
      <div class="relative overflow-hidden border-b border-white/10 py-3" aria-hidden="true">
        <div class="amb-marquee flex w-max gap-10 whitespace-nowrap text-[0.7rem] font-bold uppercase tracking-[0.3em] text-white/40">
          {Array.from({ length: 8 }).map(() => (
            <span class="flex items-center gap-10">
              New Brand Ambassador
              <span class="text-brand-400">◆</span>
              {name}
              <span class="text-brand-400">◆</span>
            </span>
          ))}
        </div>
      </div>

      <div class="relative flex flex-col items-center gap-8 p-8 sm:p-10 md:flex-row md:gap-10 md:p-12">
        <!-- Portrait -->
        <div class="relative shrink-0">
          <div class="h-32 w-32 overflow-hidden rounded-full ring-4 ring-brand-500/40 sm:h-40 sm:w-40">
            <img
              src={image}
              alt={`${name}, Brand Ambassador of Qbits Energy`}
              width="1000"
              height="1000"
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </div>
          <span class="absolute -bottom-2 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-brand-500 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-[0.15em] text-white">
            Ambassador
          </span>
        </div>

        <!-- Copy -->
        <div class="flex-1 text-center md:text-left">
          <h2 id="amb-strip-heading" class="text-2xl sm:text-3xl lg:text-4xl font-bold leading-tight text-white">
            Meet our new brand ambassador, <span class="text-gradient">{name}</span>
          </h2>
          <p class="mx-auto mt-3 max-w-xl text-sm sm:text-base leading-relaxed text-slate-400 md:mx-0">
            A name Indian families have trusted for decades, now backing the inverters that
            keep their homes running.
          </p>
        </div>

        <!-- CTA -->
        <div class="shrink-0">
          <a href="/our-products/" class="btn-primary whitespace-nowrap">
            Explore Products
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes amb-marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .amb-marquee {
    animation: amb-marquee-scroll 40s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .amb-marquee {
      animation: none;
    }
  }
</style>
