---
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

const pillars = [
  {
    title: 'Written Warranty Terms',
    desc: 'Public material describes an expandable warranty. Obtain the current duration, remedy, registration rules, exclusions, and service responsibilities for the exact model and sale.',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
    stat: 'Check',
    statLabel: 'Terms',
  },
  {
    title: 'Up to 99.02% Maximum Efficiency',
    desc: 'The 225/320K-EHV datasheet lists 99.02% maximum efficiency. Published values for other Qbits families range from 97.6% to 98.9%.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
    stat: '99.02',
    statLabel: '%',
  },
  {
    title: 'Model-Specific Monitoring',
    desc: 'Public product material describes monitoring and communication options. Confirm the supplied hardware, interface, available data and user access for the exact model.',
    icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
    stat: 'Check',
    statLabel: 'Interface',
  },
  {
    title: 'Project-Specific Limits',
    desc: 'Check the exact operating-temperature range, grid settings, voltage limits, enclosure rating and installation requirements for the selected model.',
    icon: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064',
    stat: 'Model',
    statLabel: 'Limits',
  },
  {
    title: 'IP66 Protection',
    desc: 'Current Qbits datasheets list IP66 enclosures. This classification does not establish site suitability, mounting method, corrosion resistance or service life.',
    icon: 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z',
    stat: 'IP66',
    statLabel: 'Rated',
  },
  {
    title: 'Model-Specific Engineering',
    desc: 'MPPT count, input limits, voltage window, efficiency, communication, cooling, and protection features differ across Qbits model families.',
    icon: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
    stat: '1–16',
    statLabel: 'MPPTs',
  },
];

const comparisons = [
  { feature: 'Warranty', qbits: 'Expandable warranty stated publicly', others: 'Obtain current written terms' },
  { feature: 'Efficiency', qbits: '97.6% to 99.02% maximum by family', others: 'Compare the exact model value' },
  { feature: 'Monitoring', qbits: 'Remote monitoring described publicly', others: 'Confirm interface and data handling' },
  { feature: 'Certificates', qbits: 'Standards and BIS registration shown', others: 'Verify exact model scope and validity' },
  { feature: 'Enclosure', qbits: 'IP66 listed in current datasheets', others: 'Check installation and environmental limits' },
  { feature: 'Starting voltage', qbits: '50 V to 550 V by family', others: 'Use the exact string-design value' },
];

const trustSignals = [
  { number: '1.5–320 kW', label: 'On-Grid Range' },
  { number: '3–12 kW', label: 'Hybrid Range' },
  { number: '1–16', label: 'MPPTs By Model' },
  { number: 'IP66', label: 'Published Enclosure' },
];
---

<Layout
  title="Why Qbits | Qbits Energy"
  description="Compare Qbits inverter families using published efficiency, MPPT, voltage, enclosure, monitoring, certificate, and warranty information."
  canonical="/why-qbits/"
>
  <HeaderV2 />

  <main id="main-content">
    <PageHeader
      label="Why Choose Us"
      title="The Qbits"
      highlight="Advantage"
      description="When you choose Qbits, you choose reliability, innovation, and a partner committed to your solar success."
      bgImage="/images/smart-features.webp"
    />

    <!-- Trust Bar -->
    <section class="py-16 lg:py-20 bg-slate-950 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="container-main relative">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
          {trustSignals.map(ts => (
            <div class="text-center trust-item">
              <p class="text-3xl sm:text-4xl font-extrabold text-white">{ts.number}</p>
              <p class="text-sm font-medium text-slate-400 mt-2 uppercase tracking-wider">{ts.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Pillars -->
    <section class="section-padding bg-white" aria-labelledby="pillars-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Key Advantages
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="pillars-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Six Reasons to Choose Qbits
          </h2>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {pillars.map((p, i) => (
            <div class="group bg-slate-50 rounded-2xl p-8 hover:shadow-xl hover:shadow-brand-500/5 transition-all duration-500 hover:-translate-y-1 pillar-card">
              <div class="flex items-center justify-between mb-6">
                <div class="w-14 h-14 rounded-xl bg-brand-100 flex items-center justify-center text-brand-600 group-hover:bg-brand-500 group-hover:text-white transition-all duration-500">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={p.icon}/></svg>
                </div>
                <div class="text-right">
                  <p class="text-2xl font-bold text-brand-600">{p.stat}</p>
                  <p class="text-xs text-slate-400 uppercase">{p.statLabel}</p>
                </div>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-3">{p.title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed">{p.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Comparison Table -->
    <section class="section-padding bg-slate-50" aria-labelledby="compare-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Comparison
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="compare-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            What The Published Data Shows
          </h2>
        </div>
        <div class="max-w-3xl mx-auto">
          <div class="bg-white rounded-2xl shadow-xl shadow-slate-900/5 overflow-hidden">
            <div class="grid grid-cols-3 gap-4 px-6 py-4 bg-slate-950 text-white font-semibold text-sm">
              <span>Feature</span>
              <span class="text-brand-400 text-center">Qbits</span>
              <span class="text-center text-slate-400">Others</span>
            </div>
            {comparisons.map((c, i) => (
              <div class={`grid grid-cols-3 gap-4 px-6 py-4 text-sm compare-row ${i % 2 === 0 ? 'bg-slate-50/50' : 'bg-white'}`}>
                <span class="font-medium text-slate-700">{c.feature}</span>
                <span class="text-center font-semibold text-brand-600 flex items-center justify-center gap-1.5">
                  <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  {c.qbits}
                </span>
                <span class="text-center text-slate-500">{c.others}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Certifications -->
    <section class="section-padding bg-white" aria-labelledby="cert-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Published Standards
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="cert-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Verify Model Scope And Validity
          </h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-4xl mx-auto">
          {[
            { code: 'BIS', name: 'Registration shown in catalogue', desc: 'Verify the exact model scope and current validity.' },
            { code: 'IS', name: 'IS 16221 / IS 16169', desc: 'Standards cited in published Qbits product documents.' },
            { code: 'IEC', name: 'IEC 62109 / IEC 62116', desc: 'Standards cited in published Qbits product documents.' },
            { code: 'Docs', name: 'Model-specific evidence', desc: 'Request current certificates and reports before approval.' },
          ].map(cert => (
            <div class="bg-slate-50 rounded-2xl p-8 text-center cert-card">
              <div class="w-16 h-16 mx-auto rounded-2xl bg-brand-500 flex items-center justify-center text-white text-xl font-bold mb-5">
                {cert.code}
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">{cert.name}</h3>
              <p class="text-sm text-slate-500">{cert.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 lg:py-32 bg-brand-500 text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="container-main relative text-center max-w-3xl">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6">Ready to Make the Switch?</h2>
        <p class="text-lg text-brand-100 mb-10">Compare the exact model documents, project fit, written warranty and local service route before choosing a Qbits inverter.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/our-products/" class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-8 py-4 text-sm font-semibold text-brand-600 shadow-lg hover:bg-brand-50 transition-all">Explore Products</a>
          <a href="/contact-us/" class="btn-outline">Contact Us</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
