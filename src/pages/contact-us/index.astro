---
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

const contactMethods = [
  {
    title: 'Sales Inquiry',
    desc: 'Discuss your project requirements and get a customized quote.',
    icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z',
    value: '+91 99791 92935',
    link: 'tel:+919979192935',
    action: 'Call Now',
  },
  {
    title: 'Email Us',
    desc: 'Send us detailed queries - we respond within 24 hours.',
    icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
    value: 'service@qbitsenergy.com',
    link: 'mailto:service@qbitsenergy.com',
    action: 'Send Email',
  },
  {
    title: 'WhatsApp',
    desc: 'Quick chat for instant product info and pricing.',
    icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z',
    value: '+91 99791 92935',
    link: 'https://wa.me/919979192935',
    action: 'Chat Now',
  },
  {
    title: 'Visit Us',
    desc: 'Corporate office in Surat, Gujarat - open Mon-Sat.',
    icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z',
    value: 'Surat, Gujarat, India',
    link: 'https://maps.google.com/?q=Surat,Gujarat',
    action: 'Get Directions',
  },
];

const inquiryTypes = [
  'Product Inquiry',
  'Become a Dealer',
  'Service Support',
  'Project Consultation',
  'General Question',
];
---

<Layout
  title="Contact Us | Qbits Energy"
  description="Get in touch with Qbits Energy for product inquiries, dealer partnerships, service support, and project consultations. Call +91 99791 92935."
  canonical="/contact-us/"
>
  <HeaderV2 />

  <main id="main-content">
    <PageHeader
      label="Get in Touch"
      title="Contact"
      highlight="Qbits Energy"
      description="Have questions about our products or need a quote? Our team is here to help you every step of the way."
      bgImage="/homepage/built-for-india.webp"
    />

    <!-- Contact Methods -->
    <section class="section-padding bg-white" aria-labelledby="methods-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Reach Out
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="methods-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Multiple Ways to Connect
          </h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {contactMethods.map(method => (
            <div class="bg-slate-50 rounded-2xl p-8 text-center hover:shadow-xl hover:shadow-brand-500/5 transition-all duration-500 hover:-translate-y-1 group method-card">
              <div class="w-14 h-14 mx-auto rounded-xl bg-brand-100 flex items-center justify-center text-brand-600 mb-5 group-hover:bg-brand-500 group-hover:text-white transition-all duration-500">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={method.icon}/></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">{method.title}</h3>
              <p class="text-sm text-slate-500 mb-4">{method.desc}</p>
              <p class="text-brand-600 font-semibold text-sm mb-4">{method.value}</p>
              <a href={method.link} target={method.link.startsWith('http') ? '_blank' : undefined} rel={method.link.startsWith('http') ? 'noopener noreferrer' : undefined} class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:text-brand-700">
                {method.action}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Form + Info -->
    <section class="section-padding bg-slate-50" aria-labelledby="form-heading">
      <div class="container-main">
        <div class="grid lg:grid-cols-5 gap-12">
          <!-- Form -->
          <div class="lg:col-span-3">
            <div class="bg-white rounded-2xl shadow-xl shadow-slate-900/5 p-8 lg:p-10">
              <span class="section-label">
                <span class="w-8 h-px bg-brand-500"></span>
                Send a Message
              </span>
              <h2 id="form-heading" class="text-2xl font-bold text-slate-900 mt-4 mb-8">
                Tell Us About Your Project
              </h2>
              <form id="lead-form" class="space-y-5" action="#" method="post">
                <div class="grid sm:grid-cols-2 gap-5">
                  <div>
                    <label for="name" class="block text-sm font-medium text-slate-700 mb-1.5">Full Name</label>
                    <input type="text" id="name" name="name" required maxlength="80" autocomplete="name" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all bg-slate-50/50" placeholder="Your name" />
                  </div>
                  <div>
                    <label for="email" class="block text-sm font-medium text-slate-700 mb-1.5">Email</label>
                    <input type="email" id="email" name="email" required maxlength="120" autocomplete="email" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all bg-slate-50/50" placeholder="you@example.com" />
                  </div>
                </div>
                <div class="grid sm:grid-cols-2 gap-5">
                  <div>
                    <label for="phone" class="block text-sm font-medium text-slate-700 mb-1.5">Phone</label>
                    <input type="tel" id="phone" name="phone" pattern="[+0-9 ()\-]{7,16}" inputmode="tel" autocomplete="tel" maxlength="20" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all bg-slate-50/50" placeholder="+91 ..." />
                  </div>
                  <div>
                    <label for="subject" class="block text-sm font-medium text-slate-700 mb-1.5">Subject</label>
                    <select id="subject" name="subject" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all bg-slate-50/50">
                      {inquiryTypes.map(t => <option>{t}</option>)}
                    </select>
                  </div>
                </div>
                <div>
                  <label for="message" class="block text-sm font-medium text-slate-700 mb-1.5">Message</label>
                  <textarea id="message" name="message" rows="5" required minlength="10" maxlength="2000" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all resize-none bg-slate-50/50" placeholder="How can we help you? Tell us about your solar project..."></textarea>
                </div>
                <!-- Honeypot: visible to bots, hidden from humans + screen readers -->
                <div aria-hidden="true" style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden">
                  <label>Don't fill this: <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" /></label>
                </div>
                <button type="submit" id="lead-submit" class="btn-primary w-full sm:w-auto">
                  <span data-label-default>Send Message</span>
                  <span data-label-sending class="hidden">Sending…</span>
                </button>
                <p id="lead-status" class="text-sm mt-2 hidden" role="status" aria-live="polite"></p>
              </form>
              <script is:inline define:vars={{
                  GAS_ENDPOINT: import.meta.env.PUBLIC_GAS_ENDPOINT || '',
                  FORM_TOKEN: import.meta.env.PUBLIC_FORM_TOKEN || '',
                }}>
                (() => {
                  const FALLBACK_EMAIL = 'service@qbitsenergy.com';
                  const SUCCESS_MESSAGE = 'Thanks! We\u2019ll be in touch within 24 hours.';
                  const isConfigured = /^https:\/\/script\.google\.com\/macros\/.+\/exec/.test(GAS_ENDPOINT);

                  const form   = document.getElementById('lead-form');
                  const status = document.getElementById('lead-status');
                  const btn    = document.getElementById('lead-submit');
                  const labelDefault = btn.querySelector('[data-label-default]');
                  const labelSending = btn.querySelector('[data-label-sending]');

                  const setSending = (sending) => {
                    btn.disabled = sending;
                    labelDefault.classList.toggle('hidden', sending);
                    labelSending.classList.toggle('hidden', !sending);
                  };

                  const showStatus = (msg, ok) => {
                    status.classList.remove('hidden');
                    status.textContent = msg;
                    status.className = 'text-sm mt-2 ' + (ok ? 'text-emerald-600' : 'text-rose-600');
                  };

                  const buildMailto = (fd) => {
                    const subject = fd.get('subject') || 'Inquiry from qbitsenergy.com';
                    const body =
                      'Name: ' + (fd.get('name') || '') + '\n' +
                      'Email: ' + (fd.get('email') || '') + '\n' +
                      'Phone: ' + (fd.get('phone') || '') + '\n\n' +
                      (fd.get('message') || '');
                    return 'mailto:' + FALLBACK_EMAIL +
                      '?subject=' + encodeURIComponent(subject) +
                      '&body=' + encodeURIComponent(body);
                  };

                  form.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    if (!form.reportValidity()) return;

                    // Honeypot - silently succeed for bots.
                    if ((form.elements.namedItem('website') || {}).value) {
                      form.reset();
                      showStatus(SUCCESS_MESSAGE, true);
                      return;
                    }

                    const fd = new FormData(form);
                    ['name', 'email', 'message', 'phone'].forEach((k) => {
                      const v = fd.get(k);
                      if (typeof v === 'string') fd.set(k, v.trim());
                    });
                    fd.delete('website');
                    fd.append('source', 'contact-form');
                    fd.append('page', location.pathname);
                    fd.append('userAgent', navigator.userAgent);
                    fd.append('submittedAt', new Date().toISOString());
                    if (FORM_TOKEN) fd.append('token', FORM_TOKEN);

                    if (typeof window.gtag === 'function') {
                      window.gtag('event', 'form_submit', {
                        form_id: 'lead-form',
                        subject: fd.get('subject'),
                      });
                    }

                    setSending(true);

                    // No endpoint configured - hand off to the user's mail client.
                    if (!isConfigured) {
                      window.location.href = buildMailto(fd);
                      form.reset();
                      showStatus('Opening your email app - please send to complete.', true);
                      setSending(false);
                      return;
                    }

                    try {
                      // no-cors: Apps Script /exec redirects to googleusercontent.com and
                      // the redirected response can't be read cross-origin. The POST itself
                      // still reaches the script - row is appended + notification email sent
                      // server-side. We just don't try to read an opaque response body.
                      await fetch(GAS_ENDPOINT, {
                        method: 'POST',
                        mode: 'no-cors',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: new URLSearchParams(fd).toString(),
                      });
                      form.reset();
                      showStatus(SUCCESS_MESSAGE, true);
                    } catch (err) {
                      console.error(err);
                      window.location.href = buildMailto(fd);
                      form.reset();
                      showStatus('Network issue - opening your email app instead.', false);
                    } finally {
                      setSending(false);
                    }
                  });
                })();
              </script>
            </div>
          </div>

          <!-- Sidebar Info -->
          <div class="lg:col-span-2 space-y-6">
            <!-- Prefer to self-book? Cal.com placeholder. Configure CAL_USERNAME in env to activate. -->
            <div class="bg-slate-900 rounded-2xl p-8 text-white">
              <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-brand-400">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-400 animate-pulse"></span>
                Book a slot
              </span>
              <h3 class="text-xl font-bold mt-4 mb-2">Prefer to self-book?</h3>
              <p class="text-sm text-slate-300 leading-relaxed mb-5">
                Pick a 20-minute slot with a Qbits engineer - sizing, products, partner near you.
              </p>
              <a href="https://wa.me/919979192935?text=Hi,%20I%20want%20to%20book%20a%20call%20with%20a%20Qbits%20engineer." target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-brand-500 hover:bg-brand-600 transition-colors px-5 py-2.5 text-sm font-semibold text-white">
                Book on WhatsApp
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
            </div>

            <div class="bg-brand-500 rounded-2xl p-8 text-white">
              <h3 class="text-xl font-bold mb-4">Become a Partner</h3>
              <p class="text-sm text-brand-100 leading-relaxed mb-6">
                Join our growing network of dealers and distributors across India. Get exclusive pricing, marketing support, and technical training.
              </p>
              <a href="https://wa.me/919979192935" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold text-brand-600 hover:bg-brand-50 transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                Chat on WhatsApp
              </a>
            </div>

            <div class="bg-white rounded-2xl shadow-xl shadow-slate-900/5 p-8">
              <h3 class="text-lg font-bold text-slate-900 mb-4">Office Hours</h3>
              <ul class="space-y-3 text-sm">
                <li class="flex justify-between">
                  <span class="text-slate-500">Monday – Friday</span>
                  <span class="font-medium text-slate-900">9:00 AM – 6:00 PM</span>
                </li>
                <li class="flex justify-between">
                  <span class="text-slate-500">Saturday</span>
                  <span class="font-medium text-slate-900">10:00 AM – 4:00 PM</span>
                </li>
                <li class="flex justify-between">
                  <span class="text-slate-500">Sunday</span>
                  <span class="font-medium text-slate-400">Closed</span>
                </li>
              </ul>
            </div>

            <div class="bg-white rounded-2xl shadow-xl shadow-slate-900/5 p-8">
              <h3 class="text-lg font-bold text-slate-900 mb-4">Corporate Office</h3>
              <p class="text-sm text-slate-500 leading-relaxed">
                201, Anupam Square<br/>
                Mahadev Chowk Mota Varachha<br/>
                Surat, Gujarat – 394101<br/>
                India
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

