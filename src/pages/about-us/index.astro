---
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

const milestones = [
  { year: '2016', title: 'Heaven Green Energy Founded', desc: 'Started solar EPC and installation services across Gujarat.' },
  { year: '2019', title: '1,000+ Installations', desc: 'Reached milestone of 1,000 successful solar installations.' },
  { year: '2022', title: 'Qbits Brand Launched', desc: 'Launched Qbits as dedicated inverter manufacturing division.' },
  { year: '2023', title: 'BIS & IEC Certified', desc: 'Achieved full BIS and IEC certification for product range.' },
  { year: '2024', title: 'Pan-India Presence', desc: 'Expanded dealer network to 20+ cities across India.' },
  { year: '2025', title: 'AI Monitoring Platform', desc: 'Launched Qbits AI-powered monitoring with WhatsApp alerts.' },
];

const values = [
  { title: 'Innovation', desc: 'Continuous improvement through R&D and technology-driven design. Every product cycle brings measurable advancement.', img: '/about/innovation.webp' },
  { title: 'Integrity', desc: 'Ethical practices and transparent partnerships. We build trust through honest communication and fair dealing.', img: '/about/integrity.webp' },
  { title: 'Excellence', desc: 'ISO 9001 certification and Adani Solar distributorship. Quality is not checked at the end, it is built in from day one.', img: '/about/excellence.webp' },
  { title: 'Sustainability', desc: 'Positive environmental impact with every installation. We measure success in megawatts of clean energy delivered.', img: '/about/sustainability.webp' },
];

const stats = [
  { value: '10,000+', label: 'Solar Installations', suffix: '' },
  { value: '22+', label: 'Channel Partners', suffix: '' },
  { value: '20+', label: 'Cities Served', suffix: '' },
  { value: '12', label: 'Year Warranty', suffix: 'Y' },
];

const team = [
  {
    name: 'Nirav Dhanani',
    role: 'CEO',
    photo: '/team/nirav-dhanani.webp',
    linkedin: 'https://www.linkedin.com/in/nirav-dhanani-700332129',
  },
  {
    name: 'Keyur Rakholiya',
    role: 'CTO',
    photo: '/team/keyur-rakholiya.webp',
    linkedin: 'https://www.linkedin.com/in/keyur-rakholiya-6a077885',
  },
  {
    name: 'Akash Hirapara',
    role: 'CFO',
    photo: '/team/akash-hirapara.webp',
    linkedin: 'https://www.linkedin.com/in/akash-hirpara-5b0632ab',
  },
  {
    name: 'Piyush Chandel',
    role: 'B2B Sales Head',
    photo: '/team/piyush-chandel.webp',
    linkedin: null,
    objectPosition: 'object-center',
  },
];

const differentiators = [
  { title: 'German IGBT Technology', desc: 'Premium power conversion components selected for 20-year operational life.' },
  { title: '1,000+ Quality Tests', desc: 'Every inverter undergoes rigorous automated testing before dispatch.' },
  { title: 'Indian Server Data', desc: '100% data sovereignty - all monitoring data stays on Indian servers.' },
  { title: 'IP66 Enclosure', desc: 'Rugged weather protection designed for harsh Indian rooftop conditions.' },
];
---

<Layout
  title="About Us | Qbits Energy"
  description="Qbits Inverters Limited – Powering India's Smarter Solar Future. A subsidiary of Heaven Green Energy Limited with 8+ years of experience in solar EPC, manufacturing, and clean energy innovation."
  canonical="/about-us/"
>
  <HeaderV2 />

  <main id="main-content">
    <PageHeader
      label="About Qbits"
      title="Powering India's"
      highlight="Solar Future"
      description="From trusted legacy to smart energy innovation - building an energy-independent India, one inverter at a time."
      bgImage="/images/features.webp"
    />

    <!-- Company Overview -->
    <section class="section-padding bg-white overflow-hidden" aria-labelledby="about-heading">
      <div class="container-main">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div class="order-2 lg:order-1">
            <span class="section-label">
              <span class="w-8 h-px bg-brand-500"></span>
              Our Story
            </span>
            <h2 id="about-heading" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mt-6 mb-6 leading-tight">
              Qbits Inverters Limited
            </h2>
            <p class="text-lg text-brand-600 font-semibold mb-6">
              From Trusted Legacy to Smart Energy Innovation
            </p>
            <p class="text-slate-600 leading-relaxed mb-4">
              A subsidiary of Heaven Green Energy Limited with 8+ years of experience in solar EPC, manufacturing, and clean energy innovation. Qbits designs and manufactures residential, commercial, and industrial solar inverters, hybrid inverters, and BESS using selected branded BOM for electronic components.
            </p>
            <p class="text-slate-600 leading-relaxed mb-8">
              Every Qbits inverter undergoes 1000+ automated quality tests, uses high performance IGBTs and capacitors designed for long lifecycle stability, and is protected by a rugged IP66 enclosure suitable for harsh Indian rooftop conditions.
            </p>
            <div class="flex flex-wrap gap-4">
              <a href="/our-products/" class="btn-primary">Explore Products</a>
              <a href="/contact-us/" class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-slate-200 px-8 py-4 text-sm font-semibold text-slate-700 hover:border-brand-300 hover:text-brand-600 transition-all">
                Contact Us
              </a>
            </div>
          </div>
          <div class="order-1 lg:order-2 relative">
            <div class="absolute -top-10 -right-10 w-72 h-72 bg-brand-100 rounded-full blur-3xl opacity-50"></div>
            <div class="relative rounded-2xl overflow-hidden shadow-2xl">
              <img width="720" height="540" src="/about/feature.webp" alt="Qbits Solar Inverter Installation" class="w-full" loading="lazy" />
            </div>
            <div class="absolute -bottom-6 -left-6 bg-white rounded-2xl shadow-xl p-5 hidden md:block">
              <p class="text-3xl font-bold text-brand-600">8+</p>
              <p class="text-sm text-slate-500">Years of Excellence</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="py-20 lg:py-24 bg-slate-950 relative overflow-hidden" aria-labelledby="stats-heading">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="container-main relative">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
          {stats.map((s, i) => (
            <div class="text-center stat-item" data-index={i}>
              <p class="text-4xl sm:text-5xl font-extrabold text-white">{s.value}</p>
              <p class="text-sm font-medium text-slate-400 mt-3 uppercase tracking-wider">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Innovation -->
    <section class="section-padding bg-slate-50 overflow-hidden">
      <div class="container-main">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div class="relative">
            <div class="absolute -top-10 -left-10 w-72 h-72 bg-accent/10 rounded-full blur-3xl opacity-50"></div>
            <div class="relative rounded-2xl overflow-hidden shadow-xl">
              <img width="720" height="540" src="/images/smart-features.webp" alt="Qbits Smart Features" class="w-full" loading="lazy" />
            </div>
          </div>
          <div>
            <span class="section-label">
              <span class="w-8 h-px bg-brand-500"></span>
              Innovation
            </span>
            <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6 mb-6 leading-tight">
              Meet Qbits: The Future of Smart Solar Power
            </h2>
            <p class="text-lg text-brand-600 font-semibold mb-6">
              Where Intelligent Design Meets Everyday Energy Needs
            </p>
            <p class="text-slate-600 leading-relaxed mb-8">
              Qbits inverters deliver real-time performance monitoring, AI-based optimization, and robust grid connectivity. With AI-powered WhatsApp alerts, 100% data security on Indian servers, and a 12-year full replacement warranty, Qbits brings intelligence, durability, and peace of mind to every solar installation.
            </p>
            <div class="space-y-4">
              {[
                'Smart inverter design and manufacturing',
                'Full-scale project execution and maintenance',
                'End-to-end energy management and monitoring',
              ].map(item => (
                <div class="flex items-center gap-4">
                  <div class="w-10 h-10 rounded-xl bg-brand-100 flex items-center justify-center text-brand-600 shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  </div>
                  <span class="text-slate-700 font-medium">{item}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Differentiators -->
    <section class="section-padding bg-white" aria-labelledby="diff-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            What Sets Us Apart
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="diff-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Built Different, Built for India
          </h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {differentiators.map((d, i) => (
            <div class="group relative bg-slate-50 rounded-2xl p-8 hover:bg-brand-500 transition-all duration-500 diff-card">
              <div class="w-14 h-14 rounded-xl bg-brand-100 flex items-center justify-center text-brand-600 mb-5 group-hover:bg-white/20 group-hover:text-white transition-all duration-500">
                <span class="text-2xl font-bold">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-white transition-colors">{d.title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed group-hover:text-brand-100 transition-colors">{d.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Timeline -->
    <section class="section-padding bg-slate-50" aria-labelledby="journey-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Our Journey
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="journey-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Milestones That Define Us
          </h2>
        </div>
        <div class="relative max-w-4xl mx-auto">
          <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px bg-brand-200 md:-translate-x-px"></div>
          {milestones.map((m, i) => (
            <div class={`relative flex items-start gap-8 mb-12 last:mb-0 ${i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'} timeline-item`}>
              <div class={`flex-1 hidden md:block ${i % 2 === 0 ? 'text-right' : 'text-left'}`}>
                {i % 2 === 0 && (
                  <div>
                    <span class="inline-block text-sm font-bold text-brand-600 bg-brand-50 px-3 py-1 rounded-full mb-2">{m.year}</span>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">{m.title}</h3>
                    <p class="text-slate-500 text-sm">{m.desc}</p>
                  </div>
                )}
              </div>
              <div class="relative z-10 w-8 h-8 rounded-full bg-brand-500 border-4 border-white shadow-lg shrink-0 mt-1"></div>
              <div class="flex-1 md:hidden">
                <span class="inline-block text-sm font-bold text-brand-600 bg-brand-50 px-3 py-1 rounded-full mb-2">{m.year}</span>
                <h3 class="text-xl font-bold text-slate-900 mb-2">{m.title}</h3>
                <p class="text-slate-500 text-sm">{m.desc}</p>
              </div>
              <div class={`flex-1 hidden md:block ${i % 2 === 0 ? 'text-left' : 'text-right'}`}>
                {i % 2 !== 0 && (
                  <div>
                    <span class="inline-block text-sm font-bold text-brand-600 bg-brand-50 px-3 py-1 rounded-full mb-2">{m.year}</span>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">{m.title}</h3>
                    <p class="text-slate-500 text-sm">{m.desc}</p>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Values -->
    <section class="section-padding bg-white" aria-labelledby="values-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Culture
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="values-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Our Core Values
          </h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {values.map(v => (
            <div class="group bg-slate-50 rounded-2xl p-8 text-center hover:shadow-xl hover:shadow-brand-500/5 transition-all duration-500 hover:-translate-y-1">
              <div class="w-20 h-20 mx-auto rounded-2xl bg-white ring-1 ring-brand-100 flex items-center justify-center mb-6 group-hover:ring-brand-300 transition-all duration-500">
                <img src={v.img} alt={v.title} width="48" height="48" class="w-12 h-12 object-contain" loading="lazy" />
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-3">{v.title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed">{v.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Leadership Team -->
    <section class="section-padding bg-slate-50" aria-labelledby="team-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Business Pioneers
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="team-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Our Leadership Team
          </h2>
          <p class="mt-4 text-slate-500">
            The people building Qbits into India's smartest solar inverter brand.
          </p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
          {team.map((m) => (
            <article class="group bg-white rounded-2xl overflow-hidden ring-1 ring-slate-200 hover:ring-brand-300 hover:shadow-xl hover:shadow-brand-500/5 transition-all duration-500">
              <div class="aspect-[4/5] overflow-hidden bg-slate-100">
                <img
                  src={m.photo}
                  alt={`${m.name}, ${m.role}`}
                  width="600"
                  height="750"
                  loading="lazy"
                  class={`w-full h-full object-cover ${m.objectPosition ?? 'object-top'} transition-transform duration-700 group-hover:scale-105`}
                />
              </div>
              <div class="p-5 sm:p-6">
                <h3 class="text-lg font-bold text-slate-900">
                  {m.linkedin ? (
                    <a href={m.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-brand-600 inline-flex items-center gap-2">
                      {m.name}
                      <svg class="w-4 h-4 text-slate-400 group-hover:text-brand-600" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                    </a>
                  ) : (
                    m.name
                  )}
                </h3>
                <p class="text-sm text-brand-600 font-semibold mt-1">{m.role}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Vision -->
    <section class="py-24 lg:py-32 bg-brand-500 text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="container-main relative text-center max-w-3xl">
        <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.25em] text-brand-200 mb-6">
          <span class="w-8 h-px bg-brand-300"></span>
          Our Vision
          <span class="w-8 h-px bg-brand-300"></span>
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-8 leading-tight">
          To Become India's Leading Smart Energy Powerhouse
        </h2>
        <p class="text-xl text-brand-100 leading-relaxed">
          Transforming how the nation produces and consumes power. We envision an India where every home and business generates its own clean, affordable electricity - powered by Qbits intelligence.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="section-padding bg-slate-950 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-brand-500/10 via-transparent to-accent/10"></div>
      <div class="container-main relative text-center max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">Empowering a Smarter India</h2>
        <p class="text-lg text-slate-400 leading-relaxed mb-10">
          Qbits is powering possibilities across India - from homes to industries, from villages to metro cities. Join us in building an energy-independent India.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/our-products/" class="btn-primary">Explore Products</a>
          <a href="/contact-us/" class="btn-outline">Get in Touch</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

