---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

const allPosts = await getCollection('blog');
const posts = allPosts
  .map((p) => ({
    slug: p.id,
    title: p.data.title,
    excerpt: p.data.excerpt,
    category: p.data.category,
    date: p.data.date,
    readTime: p.data.readTime,
    image: p.data.image,
    featured: p.data.featured,
  }))
  .sort((a, b) => +b.date - +a.date);

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const featuredPost = posts.find((p) => p.featured) || posts[0];
const regularPosts = posts.filter((p) => p.slug !== featuredPost?.slug);
const totalArticles = posts.length;
---

<Layout
  title="Solar Inverter Knowledge Hub - India 2026 | Qbits Energy"
  description="Buying guides, comparisons, maintenance tips, regulatory updates (PM Surya Ghar, ALMM, net metering), and case studies for solar inverter buyers and installers across India."
  canonical="/blog/"
>
  <HeaderV2 />

  <main id="main-content">
    <PageHeader
      label="Resources"
      title="Solar Knowledge"
      highlight="Hub"
      description="Stay updated with the latest in solar technology, maintenance tips, and industry insights."
    />

    {featuredPost && (
      <section class="bg-white pt-12 sm:pt-16 lg:pt-20 pb-10 sm:pb-14" aria-labelledby="featured-heading">
        <div class="container-main">
          <a href={`/blog/${featuredPost.slug}/`} class="block relative rounded-3xl overflow-hidden ring-1 ring-slate-200 hover:ring-brand-200 transition-all duration-500 group bg-gradient-to-br from-slate-50 via-white to-brand-50/40">
            <div class="absolute inset-0 opacity-[0.04] pointer-events-none" style="background-image: radial-gradient(circle at 1px 1px, #0f172a 1px, transparent 0); background-size: 24px 24px;"></div>
            <div class="absolute -top-32 -right-32 w-96 h-96 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="relative p-8 sm:p-12 lg:p-16 grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
              <div class="lg:col-span-2 flex lg:flex-col items-center lg:items-start gap-3">
                <span class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.18em] text-brand-600">
                  <span class="w-6 h-px bg-brand-500"></span>
                  Featured
                </span>
                <span class="text-brand-600 font-bold uppercase tracking-wider text-[10px] bg-brand-50 ring-1 ring-brand-100 px-3 py-1 rounded-full">{featuredPost.category}</span>
              </div>
              <div class="lg:col-span-10">
                <h2 id="featured-heading" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 leading-[1.15] tracking-tight mb-5 group-hover:text-brand-600 transition-colors">
                  {featuredPost.title}
                </h2>
                <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-6 max-w-3xl">{featuredPost.excerpt}</p>
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-500">
                  <span>{formatDate(featuredPost.date)}</span>
                  <span class="w-1 h-1 rounded-full bg-slate-300"></span>
                  <span>{featuredPost.readTime} read</span>
                  <span class="w-1 h-1 rounded-full bg-slate-300"></span>
                  <span class="inline-flex items-center gap-1.5 font-semibold text-brand-600">
                    Read article
                    <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                  </span>
                </div>
              </div>
            </div>
          </a>
        </div>
      </section>
    )}

    <section class="pb-20 sm:pb-24 lg:pb-28 bg-white" aria-labelledby="posts-heading">
      <div class="container-main">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-10 pb-6 border-b border-slate-200">
          <div>
            <span class="section-label">
              <span class="w-8 h-px bg-brand-500"></span>
              All Articles
            </span>
            <h2 id="posts-heading" class="text-3xl font-bold text-slate-900 mt-4">Latest Posts</h2>
          </div>
          <p class="text-sm text-slate-500">
            <span class="font-semibold text-slate-900">{totalArticles}</span> articles
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-10">
          {regularPosts.map((post) => (
            <article class="group relative flex flex-col" data-category={post.category.toLowerCase().replace(/\s+/g, '-')}>
              <a href={`/blog/${post.slug}/`} class="flex flex-col h-full">
                <div class="flex items-center gap-3 mb-4">
                  <span class="text-brand-600 font-bold uppercase tracking-wider text-[10px] bg-brand-50 ring-1 ring-brand-100 px-2.5 py-1 rounded-full">{post.category}</span>
                  <span class="text-xs text-slate-400">{post.readTime}</span>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-brand-600 transition-colors leading-snug tracking-tight">
                  {post.title}
                </h3>
                <p class="text-sm text-slate-500 leading-relaxed line-clamp-3 mb-5">{post.excerpt}</p>
                <div class="mt-auto pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
                  <span class="text-slate-400">{formatDate(post.date)}</span>
                  <span class="inline-flex items-center gap-1 font-semibold text-brand-600">
                    Read
                    <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                  </span>
                </div>
              </a>
            </article>
          ))}
        </div>

      </div>
    </section>

    <section class="py-24 lg:py-32 bg-brand-500 text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="container-main relative text-center max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold mb-6">Have Questions About Solar?</h2>
        <p class="text-lg text-brand-100 mb-10">Our team of solar experts is ready to help you with product selection, system design, and installation guidance.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/contact-us/" class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-8 py-4 text-sm font-semibold text-brand-600 shadow-lg hover:bg-brand-50 transition-all">Contact Us</a>
          <a href="/our-products/" class="btn-outline">Explore Products</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

