---
const currentPath = Astro.url.pathname;

const navLinks = [
  { label: 'Products', href: '/our-products/' },
  { label: 'On-Grid', href: '/on-grid-inverter/' },
  { label: 'Hybrid', href: '/hybrid-inverter/' },
  { label: 'Solutions', href: '#', children: [
    { label: 'Residential', href: '/residential-solution/' },
    { label: 'Commercial & Industrial', href: '/c-i-solution/' },
  ]},
  { label: 'Why Qbits', href: '/why-qbits/' },
  { label: 'About', href: '/about-us/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contact', href: '/contact-us/' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-500" id="main-header">
  <div class="absolute inset-0 bg-white/0 backdrop-blur-none border-b border-white/0 transition-all duration-500" id="header-bg"></div>

  <div class="container-main relative">
    <div class="flex items-center justify-between h-20 lg:h-24">
      <!-- Logo -->
      <a href="/" class="flex items-center shrink-0 group" aria-label="Qbits Energy Home">
        <img
          src="/logo green.webp"
          alt="Qbits Energy"
          class="h-10 w-auto"
        />
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1">
        {navLinks.map((link) => (
          link.children ? (
            <div class="relative group" data-dropdown>
              <button
                class="flex items-center gap-1.5 px-4 py-2.5 text-sm font-medium text-white/70 hover:text-white rounded-full hover:bg-white/10 transition-all duration-300 nav-link"
                aria-expanded="false"
                aria-haspopup="true"
              >
                {link.label}
                <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <div class="absolute top-full left-0 mt-2 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 translate-y-2 group-hover:translate-y-0">
                <div class="bg-white/95 backdrop-blur-xl rounded-2xl shadow-2xl shadow-slate-900/10 border border-slate-100 py-3 overflow-hidden">
                  {link.children.map((child) => (
                    <a
                      href={child.href}
                      class="block px-5 py-3 text-sm text-slate-600 hover:text-brand-600 hover:bg-brand-50/50 transition-colors"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class={`px-4 py-2.5 text-sm font-medium rounded-full transition-all duration-300 nav-link ${
                currentPath === link.href
                  ? 'text-brand-400 bg-white/10'
                  : 'text-white/70 hover:text-white hover:bg-white/10'
              }`}
            >
              {link.label}
            </a>
          )
        ))}
      </nav>

      <!-- Actions -->
      <div class="flex items-center gap-4">
        <a href="https://support.qbitsenergy.com/contactus?_gl=1*vncrp7*_ga*MTY3NTYxNjE4LjE3NzQzNzU3NTE.*_ga_CEKB9PFTBJ*czE3ODA0MDI3NDAkbzE0JGcwJHQxNzgwNDAyNzQwJGo2MCRsMCRoMA.." target="_blank" rel="noopener" class="hidden sm:inline-flex items-center justify-center gap-2 rounded-full bg-brand-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-500/20 transition-all duration-300 hover:bg-brand-600 hover:shadow-brand-500/40 hover:-translate-y-0.5">
          Contact us
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden p-2.5 rounded-xl text-white hover:bg-white/10 transition-colors"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg class="w-6 h-6 menu-open" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg class="w-6 h-6 menu-close hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden hidden absolute top-full left-0 right-0 bg-white/95 backdrop-blur-xl border-b border-slate-100">
    <nav class="container-main py-6 space-y-1">
      {navLinks.map((link) => (
        link.children ? (
          <div class="space-y-1">
            <span class="block px-4 py-3 text-sm font-semibold text-slate-900">{link.label}</span>
            {link.children.map((child) => (
              <a href={child.href} class="block px-4 py-3 pl-8 text-sm text-slate-500 hover:text-brand-600 hover:bg-brand-50/50 rounded-xl transition-colors">
                {child.label}
              </a>
            ))}
          </div>
        ) : (
          <a href={link.href} class={`block px-4 py-3 text-sm font-medium rounded-xl transition-colors ${
            currentPath === link.href ? 'text-brand-600 bg-brand-50' : 'text-slate-500 hover:text-brand-600 hover:bg-brand-50/50'
          }`}>
            {link.label}
          </a>
        )
      ))}
      <div class="pt-4 border-t border-slate-100">
        <a href="https://support.qbitsenergy.com/contactus?_gl=1*vncrp7*_ga*MTY3NTYxNjE4LjE3NzQzNzU3NTE.*_ga_CEKB9PFTBJ*czE3ODA0MDI3NDAkbzE0JGcwJHQxNzgwNDAyNzQwJGo2MCRsMCRoMA.." target="_blank" rel="noopener" class="flex items-center gap-2 px-4 py-3 text-sm font-medium text-brand-600 bg-brand-50 rounded-xl">
          Contact us
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('main-header');
  const headerBg = document.getElementById('header-bg');
  const logoQbits = document.getElementById('logo-qbits');
  const navLinks = document.querySelectorAll('.nav-link');
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  function updateHeader() {
    const currentScroll = window.scrollY;
    const isScrolled = currentScroll > 50;

    if (headerBg) {
      if (isScrolled) {
        headerBg.classList.remove('bg-white/0', 'backdrop-blur-none', 'border-white/0');
        headerBg.classList.add('bg-white/80', 'backdrop-blur-xl', 'border-slate-100/80', 'shadow-sm');
      } else {
        headerBg.classList.add('bg-white/0', 'backdrop-blur-none', 'border-white/0');
        headerBg.classList.remove('bg-white/80', 'backdrop-blur-xl', 'border-slate-100/80', 'shadow-sm');
      }
    }

    if (logoQbits) {
      if (isScrolled) {
        logoQbits.classList.remove('text-white');
        logoQbits.classList.add('text-slate-900');
      } else {
        logoQbits.classList.add('text-white');
        logoQbits.classList.remove('text-slate-900');
      }
    }

    navLinks.forEach((link) => {
      if (isScrolled) {
        link.classList.remove('text-white/70', 'hover:text-white', 'hover:bg-white/10');
        link.classList.add('text-slate-500', 'hover:text-brand-600', 'hover:bg-brand-50/50');
        if (link.classList.contains('text-brand-400')) {
          link.classList.remove('text-brand-400', 'bg-white/10');
          link.classList.add('text-brand-600', 'bg-brand-50');
        }
      } else {
        link.classList.add('text-white/70', 'hover:text-white', 'hover:bg-white/10');
        link.classList.remove('text-slate-500', 'hover:text-brand-600', 'hover:bg-brand-50/50');
        if (link.classList.contains('text-brand-600')) {
          link.classList.remove('text-brand-600', 'bg-brand-50');
          link.classList.add('text-brand-400', 'bg-white/10');
        }
      }
    });

    if (mobileBtn) {
      if (isScrolled) {
        mobileBtn.classList.remove('text-white', 'hover:bg-white/10');
        mobileBtn.classList.add('text-slate-600', 'hover:bg-slate-100');
      } else {
        mobileBtn.classList.add('text-white', 'hover:bg-white/10');
        mobileBtn.classList.remove('text-slate-600', 'hover:bg-slate-100');
      }
    }
  }

  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();

  mobileBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden');
    mobileBtn.setAttribute('aria-expanded', String(!isOpen));
    mobileBtn.querySelector('.menu-open')?.classList.toggle('hidden');
    mobileBtn.querySelector('.menu-close')?.classList.toggle('hidden');
  });
</script>
