---
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

const inverters = [
  { name: 'QB 1.5-4.0KTLS', vmax: 500, vmpptMin: 50 },
  { name: 'QB 4.6-6KTLS', vmax: 500, vmpptMin: 50 },
  { name: 'QB 4-6KTLD', vmax: 500, vmpptMin: 50 },
  { name: 'QB 6-17KTLC', vmax: 850, vmpptMin: 200 },
  { name: 'QB 20-30KTLC', vmax: 850, vmpptMin: 200 },
  { name: 'QB 30-40KTLC-Pro', vmax: 850, vmpptMin: 200 },
  { name: 'QB 40-50KTLC-Plus', vmax: 850, vmpptMin: 200 },
  { name: 'QB 50-60KTLC', vmax: 850, vmpptMin: 200 },
  { name: 'QB 70-110KTLC-Pro', vmax: 1000, vmpptMin: 200 },
  { name: 'QB 80-125KTLC', vmax: 1000, vmpptMin: 200 },
  { name: 'QB 225-320K-EHV', vmax: 1500, vmpptMin: 500 },
];
---

<Layout
  title="String Sizing Calculator | Qbits Energy"
  description="Calculate optimal solar panel string configuration for your Qbits inverter. Input panel specs and get string sizing recommendations."
  canonical="/string-sizing-calculator/"
>
  <HeaderV2 />

  <main>
    <PageHeader
      label="Solar Tools"
      title="String Sizing"
      highlight="Calculator"
      description="Calculate the optimal string configuration for your solar panels and Qbits inverter. Ensure safe and efficient operation."
    />

    <!-- How It Works -->
    <section class="section-padding bg-white" aria-labelledby="how-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Guide
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="how-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            How String Sizing Works
          </h2>
        </div>
        <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto">
          {[
            { step: '01', title: 'Input Panel Specs', desc: 'Enter Voc, Vmp, and temperature coefficients from your panel datasheet.' },
            { step: '02', title: 'Select Inverter', desc: 'Choose your Qbits inverter or enter DC voltage limits manually.' },
            { step: '03', title: 'Get Results', desc: 'The calculator recommends minimum and maximum panels per string.' },
          ].map(s => (
            <div class="bg-slate-50 rounded-2xl p-8 text-center step-card">
              <span class="text-4xl font-extrabold text-brand-200">{s.step}</span>
              <h3 class="text-lg font-bold text-slate-900 mt-4 mb-2">{s.title}</h3>
              <p class="text-sm text-slate-500">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Calculator -->
    <section class="section-padding bg-slate-50" aria-labelledby="calc-heading">
      <div class="container-main max-w-3xl">
        <div class="bg-white rounded-2xl shadow-xl shadow-slate-900/5 overflow-hidden">
          <div class="px-8 lg:px-10 pt-10 pb-6 border-b border-slate-100">
            <span class="section-label">
              <span class="w-8 h-px bg-brand-500"></span>
              Calculator
            </span>
            <h2 id="calc-heading" class="text-2xl font-bold text-slate-900 mt-4">Enter Your Parameters</h2>
          </div>

          <div class="p-8 lg:p-10">
            <form id="calculator-form" class="space-y-6">
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-1.5">Panel Voc (V)</label>
                  <input type="number" id="voc" step="0.1" required class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none bg-slate-50/50" placeholder="e.g. 45.5" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-1.5">Panel Vmp (V)</label>
                  <input type="number" id="vmp" step="0.1" required class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none bg-slate-50/50" placeholder="e.g. 37.2" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-1.5">Min Temperature (°C)</label>
                  <input type="number" id="tmin" required class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none bg-slate-50/50" placeholder="e.g. 5" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-1.5">Max Temperature (°C)</label>
                  <input type="number" id="tmax" required class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none bg-slate-50/50" placeholder="e.g. 55" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-1.5">Inverter Max DC Voltage (V)</label>
                  <input type="number" id="vmax" required class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none bg-slate-50/50" placeholder="e.g. 550" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-1.5">Inverter MPPT Min Voltage (V)</label>
                  <input type="number" id="vmppt-min" required class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none bg-slate-50/50" placeholder="e.g. 90" />
                </div>
              </div>

              <div class="pt-4 border-t border-slate-100">
                <p class="text-xs text-slate-400 mb-3 font-medium uppercase tracking-wider">Quick Select Qbits Inverter</p>
                <select id="inverter-select" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none bg-slate-50/50">
                  <option value="">-- Select Inverter --</option>
                  {inverters.map(inv => (
                    <option value={`${inv.vmax},${inv.vmpptMin}`}>{inv.name} (Max {inv.vmax}V, Min {inv.vmpptMin}V)</option>
                  ))}
                </select>
              </div>

              <button type="submit" class="btn-primary w-full">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                Calculate String Size
              </button>
            </form>

            <div id="results" class="hidden mt-8 pt-8 border-t border-slate-100">
              <h3 class="text-xl font-bold text-slate-900 mb-6">Results</h3>
              <div class="grid sm:grid-cols-2 gap-4">
                <div class="bg-brand-50 rounded-2xl p-6 text-center">
                  <p class="text-sm text-slate-500 uppercase tracking-wider mb-2">Max Panels per String</p>
                  <p class="text-4xl font-extrabold text-brand-600" id="max-panels">-</p>
                </div>
                <div class="bg-brand-50 rounded-2xl p-6 text-center">
                  <p class="text-sm text-slate-500 uppercase tracking-wider mb-2">Min Panels per String</p>
                  <p class="text-4xl font-extrabold text-brand-600" id="min-panels">-</p>
                </div>
              </div>
              <div id="recommendation" class="mt-6 p-4 rounded-xl text-sm"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Disclaimer -->
    <section class="py-16 bg-white">
      <div class="container-main max-w-3xl">
        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-amber-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            <div>
              <h3 class="font-semibold text-amber-900 mb-1">Important Note</h3>
              <p class="text-sm text-amber-800 leading-relaxed">This calculator provides estimates based on standard temperature coefficients. Always consult a qualified solar engineer and refer to your specific panel and inverter datasheets before finalizing the design. Qbits is not liable for system designs based on this tool.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('calculator-form');
  const results = document.getElementById('results');
  const inverterSelect = document.getElementById('inverter-select') as HTMLSelectElement;
  const vmaxInput = document.getElementById('vmax') as HTMLInputElement;
  const vmpptMinInput = document.getElementById('vmppt-min') as HTMLInputElement;

  inverterSelect?.addEventListener('change', () => {
    const val = inverterSelect.value;
    if (val) {
      const [vmax, vmpptMin] = val.split(',');
      vmaxInput.value = vmax;
      vmpptMinInput.value = vmpptMin;
    }
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const voc = parseFloat((document.getElementById('voc') as HTMLInputElement)?.value || '0');
    const vmp = parseFloat((document.getElementById('vmp') as HTMLInputElement)?.value || '0');
    const tmin = parseFloat((document.getElementById('tmin') as HTMLInputElement)?.value || '0');
    const tmax = parseFloat((document.getElementById('tmax') as HTMLInputElement)?.value || '0');
    const vmax = parseFloat(vmaxInput?.value || '0');
    const vmpptMin = parseFloat(vmpptMinInput?.value || '0');

    const vocMax = voc * (1 + (25 - tmin) * 0.0033);
    const vmpMin = vmp * (1 + (25 - tmax) * 0.0045);

    const maxPanels = Math.floor(vmax / vocMax);
    const minPanels = Math.ceil(vmpptMin / vmpMin);

    document.getElementById('max-panels')!.textContent = String(maxPanels);
    document.getElementById('min-panels')!.textContent = String(minPanels);

    const rec = document.getElementById('recommendation');
    if (rec) {
      if (minPanels > maxPanels) {
        rec.className = 'mt-6 p-4 rounded-xl text-sm bg-red-50 text-red-700 border border-red-200';
        rec.innerHTML = '<span class="font-semibold">Warning:</span> No valid configuration found with these parameters. Please adjust your inverter or panel selection.';
      } else {
        rec.className = 'mt-6 p-4 rounded-xl text-sm bg-brand-50 text-brand-700 border border-brand-200';
        rec.innerHTML = `<span class="font-semibold">Recommended:</span> Install <strong>${minPanels} to ${maxPanels}</strong> panels per string. This ensures the string voltage stays within the inverter operating window across all temperature conditions.`;
      }
    }

    results?.classList.remove('hidden');
    results?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
</script>

