---
import { productImageSizes } from '../../data/product-images';
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { getProductsByCategory, type Product } from '../../data/products';
import AmbassadorProduct from '../../components/brand-ambassador/AmbassadorProduct.astro';

const onGridProducts = getProductsByCategory('on-grid');
const singlePhase = onGridProducts.filter(p => p.phase === 'single');
const threePhase = onGridProducts.filter(p => p.phase === 'three');

const kw = (p: Product) => (p.powerMin === p.powerMax ? `${p.powerMin} kW` : `${p.powerMin}–${p.powerMax} kW`);
const mpptText = (p: Product) => (/\d/.test(p.mpptLabel) ? p.mpptLabel : `${p.mppt} MPPT${p.mppt > 1 ? 's' : ''}`);
const enquiryHref = (p: Product) =>
  `/contact-us/?subject=Product+Inquiry&model=${encodeURIComponent(p.name)}&from=%2Fon-grid-inverter%2F#lead-form`;

const featureIcons: Record<string, string> = {
  'IP66 Weather Protection': 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  'Wi-Fi/4G/Bluetooth': 'M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0',
  'Digital Warranty': 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  '50V DC Start-up': 'M13 10V3L4 14h7v7l9-11h-7z',
  'Built-in DC/AC SPD': 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
  '90V-290V AC Range': 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  '750W Panel Support': 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z',
  '98% Efficiency': 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
};

function getFeatureIcon(feature: string): string {
  for (const [key, icon] of Object.entries(featureIcons)) {
    if (feature.includes(key)) return icon;
  }
  return 'M5 13l4 4L19 7';
}

const SITE = 'https://qbitsenergy.com';
const onGridSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'On-Grid Solar Inverters',
  description: 'Qbits on-grid solar inverters for residential, commercial, and industrial use across India.',
  numberOfItems: onGridProducts.length,
  itemListElement: onGridProducts.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: p.name,
      url: `${SITE}/our-products/${p.id}/`,
      image: p.image ? `${SITE}${p.image}` : `${SITE}/og-image.webp`,
      sku: p.id,
      brand: { '@type': 'Brand', name: 'Qbits Energy' },
      category: 'On-Grid Solar Inverter',
    },
  })),
};
---

<Layout
  title="Qbits On-Grid Solar Inverters: 1.5 kW to 320 kW"
  description="Qbits single- and three-phase on-grid solar inverters from 1.5 kW to 320 kW. Compare MPPT count, efficiency and AC rating by model and download datasheets."
  canonical="/on-grid-inverter/"
>
  <HeaderV2 />
  <script type="application/ld+json" set:html={JSON.stringify(onGridSchema)} />

  <main id="main-content">
    <PageHeader
      label="On-Grid Inverters"
      title="Grid-Tied Solar"
      highlight="Inverters"
      description="Compare Qbits on-grid inverter families using exact model datasheets, string limits, communication options, and current written commercial documents."
      bgImage="/images/ongrid-res.webp"
    />

    <!-- Single Phase -->
    <section class="py-10 bg-slate-50" aria-labelledby="ongrid-select-heading"><div class="container-main max-w-5xl">
      <h2 id="ongrid-select-heading" class="text-2xl font-bold text-slate-900">Select by capacity, phase and string design</h2>
      <p class="mt-3 text-slate-600">A suitable on-grid inverter must match the project's AC connection and the proposed modules' voltage and current. The QB-4/5/6KTLD datasheet specifies two independent MPPTs, an 80–550 V tracking range, 550 V maximum DC input and 20 A per tracker. A 50 V start-up figure is not its normal tracking range.</p>
      <p class="mt-3 text-slate-600"><a class="text-brand-600 underline" href="/datasheets/products/QB_Data-Sheet_4.0-6.0-kw_2MPPT_1Phs.pdf">Check that model's datasheet</a>, compare <a class="text-brand-600 underline" href="/blog/single-vs-3-phase-inverter/">single versus three phase</a> and use the <a class="text-brand-600 underline" href="/string-sizing-calculator/">string-sizing screen</a>. For an exact recommendation, <a class="text-brand-600 underline" href="/contact-us/?subject=Product+Inquiry&from=%2Fon-grid-inverter%2F#lead-form">send your panel and connection details</a>.</p>
    </div></section>
    <!-- Model selector table -->
    <section class="py-12 bg-white" aria-labelledby="ongrid-compare-heading"><div class="container-main max-w-6xl">
      <h2 id="ongrid-compare-heading" class="text-2xl font-bold text-slate-900">Compare on-grid models side by side</h2>
      <p class="mt-3 text-slate-600 max-w-3xl">Each row is a model family from the published product data. The kW figure is the range across the family, and efficiency is the maximum figure quoted for it, so confirm the exact rating on the datasheet for the model you shortlist.</p>
      <div class="mt-6 overflow-x-auto rounded-2xl border border-slate-200">
        <table class="min-w-full text-left text-sm">
          <caption class="sr-only">Qbits on-grid inverter families by capacity, phase, MPPT count and maximum efficiency</caption>
          <thead class="bg-slate-100 text-xs uppercase tracking-wider text-slate-600">
            <tr>
              <th scope="col" class="px-4 py-3 font-semibold">Model</th>
              <th scope="col" class="px-4 py-3 font-semibold">Capacity</th>
              <th scope="col" class="px-4 py-3 font-semibold">Phase</th>
              <th scope="col" class="px-4 py-3 font-semibold">MPPT</th>
              <th scope="col" class="px-4 py-3 font-semibold">Max efficiency</th>
              <th scope="col" class="px-4 py-3 font-semibold">Details</th>
            </tr>
          </thead>
          <tbody class="bg-white text-slate-700">
            {onGridProducts.map((p) => (
              <tr class="border-t border-slate-100 align-top">
                <th scope="row" class="px-4 py-3 font-semibold text-slate-900"><a href={`/our-products/${p.id}/`} class="text-brand-600 hover:text-brand-700">{p.name}</a></th>
                <td class="px-4 py-3 whitespace-nowrap">{kw(p)}</td>
                <td class="px-4 py-3 whitespace-nowrap">{p.phase === 'single' ? 'Single-phase' : 'Three-phase'}</td>
                <td class="px-4 py-3">{mpptText(p)}</td>
                <td class="px-4 py-3">{p.efficiency}</td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <a href={`/our-products/${p.id}/`} class="text-brand-600 hover:text-brand-700 font-medium">Model page</a>
                  {p.datasheet && (<span> &middot; <a href={p.datasheet} class="text-brand-600 hover:text-brand-700 font-medium">Datasheet (PDF)</a></span>)}
                  <span> &middot; <a href={enquiryHref(p)} class="text-brand-600 hover:text-brand-700 font-medium">Enquire</a></span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div></section>

    <!-- Common sizes -->
    <section class="py-12 bg-slate-50" aria-labelledby="ongrid-sizes-heading"><div class="container-main max-w-6xl">
      <h2 id="ongrid-sizes-heading" class="text-2xl font-bold text-slate-900">Common system sizes and where to start</h2>
      <p class="mt-3 text-slate-600 max-w-3xl">These are starting points for a shortlist, not a recommendation. The final choice depends on your connection, panels and roof.</p>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h3 class="text-lg font-bold text-slate-900">3 kW</h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">QB 3.0KTLS is a single-phase model with one MPPT, in the <a class="text-brand-600 underline" href="/our-products/QB-1.5-4.0KTLS/">QB-1.5-4.0KTLS family</a>. Read the <a class="text-brand-600 underline" href="/blog/best-3kw-solar-inverter-india-2026/">3 kW inverter guide</a> for on-grid and hybrid options at this size.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h3 class="text-lg font-bold text-slate-900">5 kW</h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">QB 5KTLS has one MPPT (<a class="text-brand-600 underline" href="/our-products/QB-4.6-6KTLS/">QB-4.6-6KTLS family</a>), QB 5KTLD has two (<a class="text-brand-600 underline" href="/our-products/QB-4-6KTLD/">QB-4-6KTLD family</a>), and QB 5KTLC is three-phase. The <a class="text-brand-600 underline" href="/blog/best-5kw-solar-inverter-india-2026/">5 kW inverter guide</a> compares them by use case.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h3 class="text-lg font-bold text-slate-900">10 kW</h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">QB 10KTLC is a three-phase model with two MPPTs, in the <a class="text-brand-600 underline" href="/our-products/QB-6-17KTLC/">QB-6-17KTLC family</a>. The <a class="text-brand-600 underline" href="/blog/best-10kw-solar-inverter-india-2026/">10 kW inverter guide</a> covers three-phase picks for villas, shops and small units.</p>
        </div>
      </div>
    </div></section>

    <!-- How to choose -->
    <section class="py-12 bg-white" aria-labelledby="ongrid-choose-heading"><div class="container-main max-w-6xl">
      <h2 id="ongrid-choose-heading" class="text-2xl font-bold text-slate-900">How to choose between on-grid models</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div>
          <h3 class="text-lg font-bold text-slate-900">Single-phase or three-phase</h3>
          <p class="mt-2 text-slate-600 leading-relaxed">Match the inverter to the supply at your meter. A single-phase connection takes a single-phase inverter and a three-phase connection takes a three-phase one. DISCOMs set their own capacity limits for single-phase connections, so check yours before shortlisting. The <a class="text-brand-600 underline" href="/blog/single-vs-3-phase-inverter/">single versus three phase guide</a> walks through the decision.</p>
        </div>
        <div>
          <h3 class="text-lg font-bold text-slate-900">Size to the sanctioned load and the array</h3>
          <p class="mt-2 text-slate-600 leading-relaxed">Many DISCOMs limit solar capacity to the sanctioned load or contract demand shown on your electricity bill, so start there. Then pair the inverter's AC rating with the array's DC size. A DC array moderately larger than the AC rating is common, but too large a ratio clips output at midday. See <a class="text-brand-600 underline" href="/blog/solar-inverter-sizing/">solar inverter sizing</a> for the arithmetic.</p>
        </div>
        <div>
          <h3 class="text-lg font-bold text-slate-900">Number of MPPTs</h3>
          <p class="mt-2 text-slate-600 leading-relaxed">One MPPT suits a roof where every panel faces the same way with the same shade. Roofs with two orientations, or a mix of shaded and open areas, are easier to design with separate MPPT inputs, so check the MPPT column above. <a class="text-brand-600 underline" href="/blog/dual-mppt-vs-single-mppt/">Dual versus single MPPT</a> explains when the extra input is worth it.</p>
        </div>
        <div>
          <h3 class="text-lg font-bold text-slate-900">On-grid or hybrid</h3>
          <p class="mt-2 text-slate-600 leading-relaxed">An on-grid inverter exports to the grid and does not supply the home during an outage on its own. If you need backup from a battery, look at the <a class="text-brand-600 underline" href="/hybrid-inverter/">hybrid inverters</a> instead, and read <a class="text-brand-600 underline" href="/blog/on-grid-vs-hybrid/">on-grid versus hybrid</a> to compare the two.</p>
        </div>
      </div>
      <p class="mt-8 text-slate-600">For installers and dealers who want to supply these models, see <a class="text-brand-600 underline" href="/become-our-partner/">how to become a Qbits partner</a>.</p>
    </div></section>

    <section class="section-padding bg-white" aria-labelledby="single-phase-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Residential
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="single-phase-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Single Phase Inverters
          </h2>
          <p class="mt-4 text-slate-500">
            Suited to <a href="/residential-solution/" class="text-brand-600 hover:text-brand-700 font-medium">residential installations</a>, with <a href="/blog/solar-inverter-monitoring-systems-in-india/" class="text-brand-600 hover:text-brand-700 font-medium">monitoring options</a> that vary by model and accessory. Each model lists its own maximum efficiency.
          </p>
        </div>

        <div class="space-y-8 max-w-5xl mx-auto">
          {singlePhase.map((product) => (
            <div class="group bg-white rounded-2xl border border-slate-200 overflow-hidden hover:border-brand-200 hover:shadow-xl hover:shadow-brand-500/5 transition-all duration-500">
              <div class="grid md:grid-cols-2 gap-0">
                <!-- Product Image -->
                <div class="relative bg-gradient-to-br from-slate-50 to-slate-100 p-8 flex items-center justify-center min-h-[280px]">
                  {product.image ? (
                    <img width={productImageSizes[product.image]?.width} height={productImageSizes[product.image]?.height} src={product.image} alt={product.name} class="max-h-[220px] w-auto object-contain group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                  ) : (
                    <div class="w-20 h-20 rounded-xl bg-slate-200 border border-slate-300 flex items-center justify-center">
                      <svg class="w-10 h-10 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                      </svg>
                    </div>
                  )}
                </div>
                <!-- Product Info -->
                <div class="p-8 flex flex-col justify-center">
                  <div class="flex items-center gap-3 mb-3">
                    <span class="text-xs font-bold uppercase tracking-wider text-brand-600 bg-brand-50 px-3 py-1.5 rounded-full">
                      {product.series} Series
                    </span>
                    <span class="text-xs text-slate-400">
                      {product.phase === 'single' ? 'Single-phase' : 'Three-phase'} & {product.mpptLabel}
                    </span>
                  </div>
                  <h3 class="text-2xl font-bold text-slate-900 mb-4">{product.name}</h3>

                  <!-- Features -->
                  <div class="grid grid-cols-2 gap-3 mb-6">
                    {product.features.slice(0, 4).map(feature => (
                      <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-lg bg-brand-100 flex items-center justify-center text-brand-600 flex-shrink-0">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={getFeatureIcon(feature)}/>
                          </svg>
                        </div>
                        <span class="text-xs text-slate-600 font-medium leading-tight">{feature}</span>
                      </div>
                    ))}
                  </div>

                  <div class="flex items-center gap-4">
                    <a href="/download-datasheets/" class="inline-flex items-center gap-2 rounded-full bg-brand-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-500/20 hover:bg-brand-600 transition-all">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                      Download Data Sheet
                    </a>
                    <a href={`/our-products/${product.id}/`} class="text-sm font-semibold text-brand-600 hover:text-brand-700">
                      View Details →
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Three Phase -->
    <section class="section-padding bg-slate-50" aria-labelledby="three-phase-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Commercial & Industrial
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="three-phase-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Three Phase Inverters
          </h2>
          <p class="mt-4 text-slate-500">
            Models for <a href="/c-i-solution/" class="text-brand-600 hover:text-brand-700 font-medium">commercial and industrial installations</a>. Compare each model's <a href="/glossary/mppt/" class="text-brand-600 hover:text-brand-700 font-medium">MPPT configuration</a>, voltage and current limits, protection, derating, communications, and required certificates.
          </p>
        </div>

        <div class="space-y-8 max-w-5xl mx-auto">
          {threePhase.map((product) => (
            <div class="group bg-white rounded-2xl border border-slate-200 overflow-hidden hover:border-brand-200 hover:shadow-xl hover:shadow-brand-500/5 transition-all duration-500">
              <div class="grid md:grid-cols-2 gap-0">
                <!-- Product Image -->
                <div class="relative bg-gradient-to-br from-slate-50 to-slate-100 p-8 flex items-center justify-center min-h-[280px]">
                  {product.image ? (
                    <img width={productImageSizes[product.image]?.width} height={productImageSizes[product.image]?.height} src={product.image} alt={product.name} class="max-h-[220px] w-auto object-contain group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                  ) : (
                    <div class="w-20 h-20 rounded-xl bg-slate-200 border border-slate-300 flex items-center justify-center">
                      <svg class="w-10 h-10 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                      </svg>
                    </div>
                  )}
                </div>
                <!-- Product Info -->
                <div class="p-8 flex flex-col justify-center">
                  <div class="flex items-center gap-3 mb-3">
                    <span class="text-xs font-bold uppercase tracking-wider text-brand-600 bg-brand-50 px-3 py-1.5 rounded-full">
                      {product.series} Series
                    </span>
                    <span class="text-xs text-slate-400">
                      {product.phase === 'single' ? 'Single-phase' : 'Three-phase'} & {product.mpptLabel}
                    </span>
                  </div>
                  <h3 class="text-2xl font-bold text-slate-900 mb-4">{product.name}</h3>

                  <!-- Features -->
                  <div class="grid grid-cols-2 gap-3 mb-6">
                    {product.features.slice(0, 4).map(feature => (
                      <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-lg bg-brand-100 flex items-center justify-center text-brand-600 flex-shrink-0">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={getFeatureIcon(feature)}/>
                          </svg>
                        </div>
                        <span class="text-xs text-slate-600 font-medium leading-tight">{feature}</span>
                      </div>
                    ))}
                  </div>

                  <div class="flex items-center gap-4">
                    <a href="/download-datasheets/" class="inline-flex items-center gap-2 rounded-full bg-brand-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-500/20 hover:bg-brand-600 transition-all">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                      Download Data Sheet
                    </a>
                    <a href={`/our-products/${product.id}/`} class="text-sm font-semibold text-brand-600 hover:text-brand-700">
                      View Details →
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Brand Ambassador -->
    <AmbassadorProduct
      product="Qbits on-grid inverter"
      image="/brand-ambassador/product-dilip-joshi.webp"
    />

    <!-- CTA -->
    <section class="py-24 lg:py-32 bg-slate-950 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-brand-500/10 via-transparent to-accent/10"></div>
      <div class="container-main relative text-center max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">Not Sure Which Inverter You Need?</h2>
        <p class="text-lg text-slate-400 mb-10">Use the <a href="/string-sizing-calculator/" class="text-brand-400 hover:text-white font-medium">preliminary string screen</a>, then request current model documents and confirm any advisory or engineering scope.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/download-datasheets/" class="btn-primary">Download Datasheets</a>
          <a href="/contact-us/?subject=Product+Inquiry&from=%2Fon-grid-inverter%2F#lead-form" class="btn-outline">Request an On-Grid Quote</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
