---
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

const partners = [
  { name: 'Amrit Green Energy Pvt. Ltd.', city: 'Surat', state: 'Gujarat', phone: '+91 98765 43210' },
  { name: 'SunTech Solar Solutions', city: 'Rajkot', state: 'Gujarat', phone: '+91 98765 43211' },
  { name: 'GreenWave EPC', city: 'Ahmedabad', state: 'Gujarat', phone: '+91 98765 43212' },
  { name: 'PowerUp Distributors', city: 'Mumbai', state: 'Maharashtra', phone: '+91 98765 43213' },
  { name: 'SolarMax Installers', city: 'Pune', state: 'Maharashtra', phone: '+91 98765 43214' },
  { name: 'EcoEnergy Partners', city: 'Jaipur', state: 'Rajasthan', phone: '+91 98765 43215' },
  { name: 'Vijay Solar Services', city: 'Indore', state: 'Madhya Pradesh', phone: '+91 98765 43216' },
  { name: 'BrightSun Solutions', city: 'Bangalore', state: 'Karnataka', phone: '+91 98765 43217' },
];

const states = [...new Set(partners.map(p => p.state))];

const supportTypes = [
  { title: 'Installation', desc: 'Certified technicians for safe and efficient inverter installation.', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
  { title: 'Maintenance', desc: 'Regular servicing and preventive maintenance to maximize inverter life.', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z' },
  { title: 'Repair & Replacement', desc: 'Quick turnaround for warranty claims and spare part replacement.', icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z' },
  { title: 'Technical Training', desc: 'Product training for dealers and installers across India.', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
];
---

<Layout
  title="Authorized Service Partners | Qbits Energy"
  description="Find Qbits authorized service partners across India. Search by state and city for installation, service, and support."
  canonical="/authorized-service-partners/"
>
  <HeaderV2 />

  <main>
    <PageHeader
      label="Support Network"
      title="Authorized"
      highlight="Service Partners"
      description="Find certified Qbits partners for installation, maintenance, and support across India."
    />

    <!-- Support Types -->
    <section class="section-padding bg-white" aria-labelledby="support-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            What We Offer
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="support-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Comprehensive Support Services
          </h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {supportTypes.map(s => (
            <div class="bg-slate-50 rounded-2xl p-8 text-center support-card">
              <div class="w-14 h-14 mx-auto rounded-xl bg-brand-100 flex items-center justify-center text-brand-600 mb-5">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={s.icon}/></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">{s.title}</h3>
              <p class="text-sm text-slate-500">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Partner Directory -->
    <section class="section-padding bg-slate-50" aria-labelledby="directory-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Partner Directory
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="directory-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Find a Partner Near You
          </h2>
        </div>

        <div class="max-w-4xl mx-auto">
          <div class="bg-white rounded-2xl shadow-xl shadow-slate-900/5 p-6 mb-8">
            <div class="flex flex-col sm:flex-row gap-4">
              <div class="relative flex-1">
                <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                <input type="text" id="partner-search" placeholder="Search by name, city, or state..." class="w-full rounded-xl border border-slate-200 pl-12 pr-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none bg-slate-50/50" />
              </div>
              <select id="state-filter" class="rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none bg-slate-50/50">
                <option value="">All States</option>
                {states.map(s => <option value={s}>{s}</option>)}
              </select>
            </div>
          </div>

          <div class="bg-white rounded-2xl shadow-xl shadow-slate-900/5 overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead class="bg-slate-950 text-white">
                  <tr>
                    <th class="text-left px-6 py-4 font-semibold">Partner Name</th>
                    <th class="text-left px-6 py-4 font-semibold">City</th>
                    <th class="text-left px-6 py-4 font-semibold">State</th>
                    <th class="text-left px-6 py-4 font-semibold">Contact</th>
                  </tr>
                </thead>
                <tbody id="partner-table" class="divide-y divide-slate-100">
                  {partners.map(p => (
                    <tr class="hover:bg-brand-50/50 transition-colors partner-row" data-state={p.state} data-search={`${p.name} ${p.city} ${p.state}`.toLowerCase()}>
                      <td class="px-6 py-5 font-medium text-slate-900">{p.name}</td>
                      <td class="px-6 py-5 text-slate-500">{p.city}</td>
                      <td class="px-6 py-5">
                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-brand-50 text-brand-700">
                          {p.state}
                        </span>
                      </td>
                      <td class="px-6 py-5">
                        <a href={`tel:${p.phone.replace(/\s/g, '')}`} class="inline-flex items-center gap-1.5 text-brand-600 hover:text-brand-700 font-medium">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                          {p.phone}
                        </a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Become Partner CTA -->
    <section class="py-24 lg:py-32 bg-brand-500 text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="container-main relative text-center max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold mb-6">Want to Become a Partner?</h2>
        <p class="text-lg text-brand-100 mb-10">Join our growing network of authorized service partners across India. Get exclusive pricing, training, and marketing support.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/contact-us/" class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-8 py-4 text-sm font-semibold text-brand-600 shadow-lg hover:bg-brand-50 transition-all">Apply Now</a>
          <a href="https://wa.me/919979192935" target="_blank" rel="noopener" class="btn-outline">Chat on WhatsApp</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const searchInput = document.getElementById('partner-search');
  const stateFilter = document.getElementById('state-filter');
  const rows = document.querySelectorAll('.partner-row');

  function filter() {
    const query = (searchInput as HTMLInputElement)?.value.toLowerCase() || '';
    const state = (stateFilter as HTMLSelectElement)?.value || '';
    rows.forEach(row => {
      const rowState = row.getAttribute('data-state') || '';
      const rowSearch = row.getAttribute('data-search') || '';
      const matchState = !state || rowState === state;
      const matchSearch = !query || rowSearch.includes(query);
      row.classList.toggle('hidden', !(matchState && matchSearch));
    });
  }

  searchInput?.addEventListener('input', filter);
  stateFilter?.addEventListener('change', filter);
</script>

