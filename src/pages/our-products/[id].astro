---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { products, getProductById, getRelatedProducts } from '../../data/products';

export function getStaticPaths() {
  return products.map(p => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const product = getProductById(id!);
const related = product ? getRelatedProducts(product) : [];

if (!product) {
  return Astro.redirect('/404');
}
---

<Layout
  title={`${product.name} | Qbits Energy`}
  description={`${product.name} - ${product.category === 'on-grid' ? 'On-Grid' : 'Hybrid'} solar inverter with ${product.efficiency} efficiency, ${product.mppt} MPPT, and ${product.warranty}.`}
  canonical={`/our-products/${product.id}/`}
>
  <Header />

  <main class="pt-[104px] lg:pt-[120px]">
    <!-- Breadcrumb -->
    <div class="bg-slate-50 border-b border-slate-100">
      <div class="container-main py-3">
        <nav class="flex items-center gap-2 text-sm text-slate-500">
          <a href="/" class="hover:text-brand-600 transition-colors">Home</a>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <a href="/our-products/" class="hover:text-brand-600 transition-colors">Products</a>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span class="text-slate-900 font-medium">{product.id}</span>
        </nav>
      </div>
    </div>

    <!-- Product Hero -->
    <section class="section-padding bg-white">
      <div class="container-main">
        <div class="grid lg:grid-cols-2 gap-12 items-start">
          <div>
            <div class="aspect-square bg-slate-100 rounded-2xl flex items-center justify-center">
              <div class="text-center">
                <div class="w-32 h-32 mx-auto rounded-2xl bg-white shadow-lg flex items-center justify-center">
                  <svg class="w-16 h-16 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={product.category === 'on-grid' ? 'M13 10V3L4 14h7v7l9-11h-7z' : 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10'}/>
                  </svg>
                </div>
                <p class="mt-4 text-sm text-slate-400">{product.id}</p>
              </div>
            </div>
          </div>
          <div>
            <div class="flex items-center gap-3 mb-3">
              <span class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ${product.category === 'on-grid' ? 'bg-brand-50 text-brand-700' : 'bg-accent/10 text-accent-dark'}`}>
                {product.category === 'on-grid' ? 'On-Grid' : 'Hybrid'}
              </span>
              <span class="text-xs text-slate-400 font-mono">{product.id}</span>
            </div>
            <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">{product.name}</h1>
            <p class="text-slate-500 mb-6">{product.series} | {product.phase === 'single' ? 'Single Phase' : 'Three Phase'} | {product.powerMax}kW</p>

            <div class="grid grid-cols-3 gap-3 mb-8">
              <div class="bg-slate-50 rounded-xl p-4 text-center">
                <p class="text-2xl font-bold text-brand-600">{product.efficiency}</p>
                <p class="text-xs text-slate-500 uppercase mt-1">Efficiency</p>
              </div>
              <div class="bg-slate-50 rounded-xl p-4 text-center">
                <p class="text-2xl font-bold text-brand-600">{product.mppt}</p>
                <p class="text-xs text-slate-500 uppercase mt-1">MPPT</p>
              </div>
              <div class="bg-slate-50 rounded-xl p-4 text-center">
                <p class="text-2xl font-bold text-brand-600">{product.warranty.replace(' Years', 'Y')}</p>
                <p class="text-xs text-slate-500 uppercase mt-1">Warranty</p>
              </div>
            </div>

            <div class="flex flex-wrap gap-3">
              <a href="/contact-us/" class="btn-primary">Product Inquiry</a>
              <a href={`/downloads/datasheet-${product.id}.pdf`} class="btn-secondary">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                Datasheet
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Specifications -->
    <section class="section-padding bg-slate-50" aria-labelledby="specs-heading">
      <div class="container-main">
        <h2 id="specs-heading" class="text-2xl sm:text-3xl font-bold text-slate-900 mb-8">Technical Specifications</h2>
        <div class="max-w-3xl">
          <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
            <table class="w-full text-sm">
              <tbody class="divide-y divide-slate-100">
                {[
                  ['Model', product.id],
                  ['Series', product.series],
                  ['Category', product.category === 'on-grid' ? 'On-Grid' : 'Hybrid'],
                  ['Phase', product.phase === 'single' ? 'Single Phase' : 'Three Phase'],
                  ['Power Range', `${product.powerMin}-${product.powerMax}kW`],
                  ['Max Efficiency', product.efficiency],
                  ['MPPT', `${product.mppt} (${product.mpptLabel})`],
                  ['DC Voltage Range', product.voltageRange],
                  ['AC Frequency', product.frequency],
                  ['Protection', product.protection],
                  ['Display', product.display],
                  ['Communication', product.communication],
                  ['Warranty', product.warranty],
                ].map(([label, value]) => (
                  <tr class="hover:bg-slate-50">
                    <td class="px-5 py-3 font-medium text-slate-700 w-1/3">{label}</td>
                    <td class="px-5 py-3 text-slate-600">{value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Related Products -->
    {related.length > 0 && (
      <section class="section-padding bg-white">
        <div class="container-main">
          <h2 class="text-2xl font-bold text-slate-900 mb-8">Related Products</h2>
          <div class="grid md:grid-cols-3 gap-6">
            {related.map(r => (
              <a href={`/our-products/${r.id}/`} class="group card hover:border-brand-200 hover:shadow-lg transition-all">
                <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors">{r.name}</h3>
                <p class="text-sm text-slate-500 mt-1">{r.powerMax}kW | {r.efficiency}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</Layout>
