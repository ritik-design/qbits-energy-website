---
const features = [
  {
    title: 'India-First Engineering',
    description: 'Designed and tested specifically for Indian grid conditions, voltage fluctuations, and extreme temperatures.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
  },
  {
    title: 'Maximum Efficiency',
    description: 'Industry-leading conversion efficiency up to 98.8% with advanced multi-MPPT algorithms for optimal energy harvest.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
  },
  {
    title: 'Smart Monitoring',
    description: 'Real-time remote monitoring via mobile app and web portal. Track performance, diagnose issues, and optimize output.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
  },
  {
    title: 'Robust Protection',
    description: 'IP65 rated enclosure with comprehensive protection: anti-islanding, surge protection, short circuit, and over-temperature.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
  },
  {
    title: '5+ Year Warranty',
    description: 'Comprehensive warranty coverage with pan-India service network and rapid replacement commitment.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`,
  },
  {
    title: 'Rapid Support',
    description: 'Dedicated technical support team with 24/7 helpline and authorized service partners in every major city.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>`,
  },
];
---

<section class="section-padding bg-white" aria-labelledby="why-heading">
  <div class="container-main">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
      <!-- Left: Heading -->
      <div class="lg:sticky lg:top-28">
        <span class="section-label reveal">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
          </svg>
          Why Choose Qbits
        </span>

        <h2 id="why-heading" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mt-6 reveal reveal-delay-1">
          Built for
          <span class="text-gradient">Indian Conditions</span>
          <br />Trusted by Experts
        </h2>

        <p class="mt-6 text-lg text-slate-500 leading-relaxed reveal reveal-delay-2">
          Every Qbits inverter is engineered with deep understanding of India's diverse climate, grid infrastructure, and energy needs.
        </p>

        <div class="mt-8 reveal reveal-delay-3">
          <a href="/why-qbits/" class="btn-primary">
            Discover Our Edge
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right: Feature Grid -->
      <div class="grid sm:grid-cols-2 gap-6">
        {features.map((feature, i) => (
          <div class={`group card hover:border-brand-200 hover:shadow-brand-900/5 reveal reveal-delay-${(i % 3) + 1}`}>
            <div class="w-12 h-12 rounded-xl bg-brand-50 flex items-center justify-center text-brand-600 mb-4 group-hover:bg-brand-600 group-hover:text-white transition-colors duration-300">
              <Fragment set:html={feature.icon} />
            </div>
            <h3 class="text-base font-semibold text-slate-900 mb-2">{feature.title}</h3>
            <p class="text-sm text-slate-500 leading-relaxed">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
