---
const resources = [
  {
    title: 'Datasheets',
    desc: 'Detailed technical specifications for all Qbits inverter models.',
    href: '/download-datasheets/',
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  },
  {
    title: 'Calculator',
    desc: 'String sizing calculator to design your solar system correctly.',
    href: '/string-sizing-calculator/',
    icon: 'M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z',
  },
  {
    title: 'Warranty',
    desc: 'Industry-leading warranty terms and easy claim process.',
    href: '/contact-us/',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    title: 'Installation Guides',
    desc: 'Step-by-step manuals for installers and technicians.',
    href: '/contact-us/',
    icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
  },
  {
    title: 'Blogs',
    desc: 'Latest insights on solar technology, trends, and best practices.',
    href: '/blog/',
    icon: 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z',
  },
];
---

<section class="py-20 sm:py-28 lg:py-36 bg-white" aria-labelledby="resources-heading">
  <div class="container-main">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="section-label">
        <span class="w-8 h-px bg-brand-500"></span>
        Resources
      </span>
      <h2 id="resources-heading" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mt-6 leading-tight">
        Everything You <span class="text-gradient">Need</span>
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-5">
      {resources.map((item) => (
        <a href={item.href} class="group relative rounded-2xl bg-slate-50 border border-slate-100 p-6 hover:border-brand-200 hover:shadow-lg hover:shadow-brand-500/5 hover:-translate-y-1 transition-all duration-500">
          <div class="w-12 h-12 rounded-xl bg-brand-500/10 flex items-center justify-center mb-5 group-hover:bg-brand-500 group-hover:scale-110 transition-all duration-300">
            <svg class="w-6 h-6 text-brand-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon}/>
            </svg>
          </div>
          <h3 class="text-base font-bold text-slate-900 mb-2">{item.title}</h3>
          <p class="text-sm text-slate-500 leading-relaxed">{item.desc}</p>
          <span class="inline-flex items-center gap-1 mt-4 text-sm font-semibold text-brand-600 group-hover:gap-2 transition-all">
            Access
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
