<section class="py-20 lg:py-28 bg-brand-500 text-white relative overflow-hidden" aria-labelledby="made-for-india-heading">
  <div class="absolute inset-0 opacity-10" aria-hidden="true" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>

  <div class="container-main relative text-center max-w-3xl">
    <h2 id="made-for-india-heading" class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight">
      Proudly Designed and Engineered For India
    </h2>
    <p class="mt-6 text-lg text-brand-100 leading-relaxed">
      Qbits inverters are 100% made for India - engineered to withstand extreme temperatures, voltage fluctuations, and dust. Our R&D center in India ensures every product is tailored for Indian grid conditions and customer needs.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-6">
      <div class="flex items-center gap-2 bg-white/10 rounded-full px-5 py-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"/></svg>
        <span class="text-sm font-medium">Made in India</span>
      </div>
      <div class="flex items-center gap-2 bg-white/10 rounded-full px-5 py-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        <span class="text-sm font-medium">BIS Certified</span>
      </div>
      <div class="flex items-center gap-2 bg-white/10 rounded-full px-5 py-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        <span class="text-sm font-medium">98% Efficiency</span>
      </div>
    </div>
  </div>
</section>
