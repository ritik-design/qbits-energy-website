---
const posts = [
  {
    title: 'How to Choose the Right Solar Inverter for Your Home',
    excerpt: 'A comprehensive guide to selecting the perfect inverter capacity, type, and features for Indian households.',
    category: 'Guide',
    date: 'May 2026',
    href: '/blog/',
    image: '/Homepage/Our Participations one.webp',
  },
  {
    title: 'Understanding MPPT Technology in Modern Solar Inverters',
    excerpt: 'Deep dive into Maximum Power Point Tracking and why it matters for your solar system\'s efficiency.',
    category: 'Technology',
    date: 'Apr 2026',
    href: '/blog/',
    image: '/Homepage/Our Participations two.webp',
  },
  {
    title: 'Solar Inverter Maintenance: A Complete Checklist',
    excerpt: 'Keep your solar inverter running at peak performance with these essential maintenance tips.',
    category: 'Maintenance',
    date: 'Mar 2026',
    href: '/blog/',
    image: '/Homepage/Our Participations three.webp',
  },
];
---

<section class="py-20 sm:py-28 lg:py-36 bg-slate-50" aria-labelledby="blog-heading">
  <div class="container-main">
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-6 mb-14">
      <div>
        <span class="section-label">
          <span class="w-8 h-px bg-brand-500"></span>
          Insights
        </span>
        <h2 id="blog-heading" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mt-6 leading-tight">
          Latest From <span class="text-gradient">Qbits</span>
        </h2>
      </div>
      <a href="/blog/" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-600 hover:text-brand-700 transition-colors">
        View All Articles
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {posts.map((post) => (
        <a href={post.href} class="group block rounded-2xl bg-white border border-slate-100 overflow-hidden hover:shadow-xl hover:shadow-brand-500/5 hover:-translate-y-1 transition-all duration-500">
          <div class="aspect-[16/10] bg-slate-100 overflow-hidden">
            <img
              src={post.image}
              alt={post.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
          </div>
          <div class="p-6">
            <div class="flex items-center gap-3 mb-3">
              <span class="px-2.5 py-0.5 rounded-full bg-brand-50 text-brand-600 text-xs font-bold uppercase">{post.category}</span>
              <span class="text-xs text-slate-400">{post.date}</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-brand-600 transition-colors line-clamp-2">{post.title}</h3>
            <p class="text-sm text-slate-500 leading-relaxed line-clamp-2">{post.excerpt}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
