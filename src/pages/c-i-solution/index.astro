---
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { products, type Product } from '../../data/products';

// Three-phase on-grid families are the commercial and industrial range.
const ciProducts = products.filter(p => p.category === 'on-grid' && p.phase === 'three');
const kw = (p: Product) => (p.powerMin === p.powerMax ? `${p.powerMin} kW` : `${p.powerMin}–${p.powerMax} kW`);
const mpptText = (p: Product) => (/\d/.test(p.mpptLabel) ? p.mpptLabel : `${p.mppt} MPPT${p.mppt > 1 ? 's' : ''}`);
const enquiryHref = (p: Product) =>
  `/contact-us/?subject=Product+Inquiry&model=${encodeURIComponent(p.name)}&from=%2Fc-i-solution%2F#lead-form`;

const features = [
  { title: 'Three-Phase, 5 to 320 kW', desc: 'Published three-phase models run from QB 5KTLC to QB 320K-EHV. Choose the exact model for your site, grid voltage and array.', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
  { title: 'Project Configuration', desc: 'Confirm each inverter and its string and MPPT layout against the exact model documents.', icon: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4' },
  { title: 'Communication Options', desc: 'The published three-phase models list Wi-Fi communication with optional RS485 or GPRS. Confirm the supported monitoring interface for your model.', icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
  { title: 'Project Economics', desc: 'Model savings from site load, tariff, generation and installed cost.', icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  { title: 'Multi-MPPT Technology', desc: 'MPPT count depends on the model: 2 on the QB 5 to 30KTLC families, 8 to 10 on the QB 80 to 125KTLC family, and 12 as standard on QB 225/320K-EHV (14 or 16 optional on 320 kW).', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
  { title: 'Enclosure and DC Input', desc: 'Every published three-phase model lists an IP66 enclosure and a maximum DC input of 1100 V (1500 V on QB 225/320K-EHV).', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
];

const segments = [
  { title: 'Manufacturing', desc: 'Check roof area, daytime load and the connection voltage before choosing the inverter capacity.', icon: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z' },
  { title: 'Warehousing', desc: 'Check roof area, daytime load and connection constraints for the proposed system.', icon: 'M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z' },
  { title: 'Commercial Buildings', desc: 'Office complexes and retail spaces. Confirm phase, connection voltage and approvals with the local utility.', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
  { title: 'Educational Institutions', desc: 'Schools and colleges with large rooftops and daytime consumption.', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
];

const roiStats = [
  { value: '5–320', label: 'Published three-phase range', suffix: ' kW' },
  { value: String(ciProducts.length), label: 'Three-phase model families', suffix: '' },
  { value: `${Math.min(...ciProducts.map(p => p.mppt))}–${Math.max(...ciProducts.map(p => p.mppt))}`, label: 'MPPTs, varies by model', suffix: '' },
  { value: 'Site', label: 'Model project ROI', suffix: '' },
];
---

<Layout
  title="Qbits Commercial and Industrial Solar Inverters, 5-320 kW"
  description="Evaluate Qbits three-phase inverter families for commercial and industrial projects: phase, AC voltage, exact-model documents and written terms."
  canonical="/c-i-solution/"
>
  <HeaderV2 />

  <main id="main-content">
    <PageHeader
      label="Solutions"
      title="Commercial & Industrial"
      highlight="Solar Inverters"
      description="Choose an inverter for your grid connection, PV array and project requirements. Request exact-model documents and a site-specific quotation."
      bgImage="/images/ongrid-commercial.webp"
    />

    <!-- Hero Content -->
    <section class="section-padding bg-white overflow-hidden" aria-labelledby="ci-heading">
      <div class="container-main">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div class="relative">
            <div class="absolute -top-10 -left-10 w-72 h-72 bg-brand-100 rounded-full blur-3xl opacity-50"></div>
            <div class="relative rounded-2xl overflow-hidden shadow-2xl">
              <img width="720" height="540" src="/homepage-new/partner-program.webp" alt="Commercial Solar Installation" class="w-full" loading="lazy" />
            </div>
            <div class="absolute -bottom-6 -right-6 bg-white rounded-2xl shadow-xl p-5 hidden md:block">
              <p class="text-3xl font-bold text-brand-600">Quote</p>
              <p class="text-sm text-slate-500">Site-specific payback</p>
            </div>
          </div>
          <div>
            <span class="section-label">
              <span class="w-8 h-px bg-brand-500"></span>
              For Business
            </span>
            <h2 id="ci-heading" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mt-6 mb-6 leading-tight">
              Specify the Inverter for Your Project
            </h2>
            <p class="text-lg text-brand-600 font-semibold mb-6">
              Match the inverter to your grid connection and array.
            </p>
            <p class="text-slate-600 leading-relaxed mb-6">
              Qbits publishes three-phase inverter families for <a href="/blog/solar-inverter-for-factory/" class="text-brand-600 font-medium hover:underline">factories</a>, warehouses, offices, and large-scale installations. Check the exact model limits, monitoring options and site assumptions before estimating <a href="/blog/solar-irr-payback-ci-india/" class="text-brand-600 font-medium hover:underline">return on investment</a>.
            </p>
            <p class="text-slate-600 leading-relaxed mb-8">
              Published three-phase families extend from 5 kW to 320 kW. Models with multiple <a href="/glossary/mppt/" class="text-brand-600 font-medium hover:underline">MPPTs</a> may support separately designed array groups when their voltage and current limits permit. Request the current <a href="/glossary/bis-certification/" class="text-brand-600 font-medium hover:underline">BIS</a>, <a href="/glossary/iec-62109/" class="text-brand-600 font-medium hover:underline">IEC</a> and project evidence for the exact SKU instead of treating a standard cited in a datasheet as a current certificate.
            </p>
            <div class="flex flex-wrap gap-4">
              <a href="/our-products/" class="btn-primary">Explore Inverters</a>
              <a href="/contact-us/?subject=Project+Consultation&from=%2Fc-i-solution%2F#lead-form" class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-slate-200 px-8 py-4 text-sm font-semibold text-slate-700 hover:border-brand-300 hover:text-brand-600 transition-all">
                Discuss Your Requirements
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-12 bg-slate-50" aria-labelledby="procurement-heading">
      <div class="container-main max-w-5xl">
        <h2 id="procurement-heading" class="text-2xl font-bold text-slate-900">Prepare the inverter requirement before requesting a quote</h2>
        <p class="mt-3 text-slate-600">Provide the project location, grid voltage and phase, proposed PV array, model or capacity shortlist, number of units and delivery schedule. Separate inverter AC capacity from array DC capacity and total project size.</p>
        <p class="mt-3 text-slate-600">Check <a class="text-brand-600 underline" href="/download-datasheets/">model datasheets</a> and the <a class="text-brand-600 underline" href="/blog/inverter-suppliers-india/">EPC supplier qualification checklist</a>. If you are an EPC buying several units, you can <a class="text-brand-600 underline" href="/contact-us/?subject=EPC+%2F+Bulk+Supply&role=EPC+Company&from=%2Fc-i-solution%2F#lead-form">send a bulk supply enquiry</a>. The <a class="text-brand-600 underline" href="/our-products/QB-225-320K-EHV/">225–320 kW EHV family</a> specifies an 800 Vac connection; assess its transformer and grid requirements separately from low-voltage rooftop families.</p>
      </div>
    </section>

    <!-- Model selector table -->
    <section class="py-12 bg-white" aria-labelledby="ci-compare-heading">
      <div class="container-main max-w-6xl">
        <h2 id="ci-compare-heading" class="text-2xl font-bold text-slate-900">Compare three-phase models</h2>
        <p class="mt-3 text-slate-600 max-w-3xl">Each row is a three-phase on-grid family from the published product data. The kW figure is the range across the family, and MPPT count and efficiency are as listed for it, so confirm the exact figures on the datasheet for the model you shortlist. For the high-capacity <a class="text-brand-600 underline" href="/our-products/QB-225-320K-EHV/">225–320 kW EHV family</a>, check the grid connection voltage first.</p>
        <div class="mt-6 overflow-x-auto rounded-2xl border border-slate-200">
          <table class="min-w-full text-left text-sm">
            <caption class="sr-only">Qbits three-phase on-grid inverter families by capacity, MPPT count and maximum efficiency</caption>
            <thead class="bg-slate-100 text-xs uppercase tracking-wider text-slate-600">
              <tr>
                <th scope="col" class="px-4 py-3 font-semibold">Model</th>
                <th scope="col" class="px-4 py-3 font-semibold">Capacity</th>
                <th scope="col" class="px-4 py-3 font-semibold">Phase</th>
                <th scope="col" class="px-4 py-3 font-semibold">MPPT</th>
                <th scope="col" class="px-4 py-3 font-semibold">Max efficiency</th>
                <th scope="col" class="px-4 py-3 font-semibold">Details</th>
              </tr>
            </thead>
            <tbody class="bg-white text-slate-700">
              {ciProducts.map((p) => (
                <tr class="border-t border-slate-100 align-top">
                  <th scope="row" class="px-4 py-3 font-semibold text-slate-900"><a href={`/our-products/${p.id}/`} class="text-brand-600 hover:text-brand-700">{p.name}</a></th>
                  <td class="px-4 py-3 whitespace-nowrap">{kw(p)}</td>
                  <td class="px-4 py-3 whitespace-nowrap">Three-phase</td>
                  <td class="px-4 py-3">{mpptText(p)}</td>
                  <td class="px-4 py-3">{p.efficiency}</td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    <a href={`/our-products/${p.id}/`} class="text-brand-600 hover:text-brand-700 font-medium">Model page</a>
                    {p.datasheet && (<span> &middot; <a href={p.datasheet} class="text-brand-600 hover:text-brand-700 font-medium">Datasheet (PDF)</a></span>)}
                    <span> &middot; <a href={enquiryHref(p)} class="text-brand-600 hover:text-brand-700 font-medium">Enquire</a></span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- How to choose -->
    <section class="py-12 bg-slate-50" aria-labelledby="ci-choose-heading">
      <div class="container-main max-w-6xl">
        <h2 id="ci-choose-heading" class="text-2xl font-bold text-slate-900">How to choose a commercial or industrial inverter</h2>
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          <div>
            <h3 class="text-lg font-bold text-slate-900">Start from the connection</h3>
            <p class="mt-2 text-slate-600 leading-relaxed">Note the supply voltage, sanctioned load or contract demand, and who approves the interconnection. Many DISCOMs limit solar capacity to the sanctioned load or contract demand. The <a class="text-brand-600 underline" href="/blog/3-phase-solar-inverter/">three-phase inverter buyer guide</a> covers what to check on a three-phase connection.</p>
          </div>
          <div>
            <h3 class="text-lg font-bold text-slate-900">Separate AC and DC capacity</h3>
            <p class="mt-2 text-slate-600 leading-relaxed">The inverter's AC rating, the array's DC size and the total project size are three different numbers. Choose the inverter count from the AC load and the connection, then check the array fits within each model's input limits. <a class="text-brand-600 underline" href="/blog/solar-inverter-for-factory/">Solar inverters for factories</a> walks through typical industrial loads.</p>
          </div>
          <div>
            <h3 class="text-lg font-bold text-slate-900">Plan MPPTs around roof zones</h3>
            <p class="mt-2 text-slate-600 leading-relaxed">Give each roof zone with a different tilt, orientation or shading its own MPPT where you can. A mid-size example is <a class="text-brand-600 underline" href="/our-products/QB-30-40KTLC-Pro/">QB 30/33/36/40KTLC-Pro</a>, a three-phase family listed with 3 MPPTs and a maximum efficiency of 98.6–98.7% by model. Larger roofs may suit families with more MPPTs, as the table shows.</p>
          </div>
          <div>
            <h3 class="text-lg font-bold text-slate-900">Check strings and the business case</h3>
            <p class="mt-2 text-slate-600 leading-relaxed">Check string voltage and current against each MPPT's limits using the <a class="text-brand-600 underline" href="/string-sizing-calculator/">string sizing calculator</a> as a first screen. When you estimate returns, use your own tariff, load and installed cost, as in <a class="text-brand-600 underline" href="/blog/solar-irr-payback-ci-india/">solar IRR and payback for C&amp;I</a>.</p>
          </div>
        </div>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/contact-us/?subject=Project+Consultation&from=%2Fc-i-solution%2F#lead-form" class="btn-primary">Discuss Your Requirements</a>
          <a href="/download-datasheets/" class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-slate-200 px-8 py-4 text-sm font-semibold text-slate-700 hover:border-brand-300 hover:text-brand-600 transition-all">Download Datasheets</a>
        </div>
        <p class="mt-6 text-slate-600">Installers and dealers who want to supply these models can <a class="text-brand-600 underline" href="/become-our-partner/">apply to become a Qbits partner</a>.</p>
      </div>
    </section>

    <!-- ROI Stats -->
    <section class="py-20 lg:py-24 bg-slate-950 relative overflow-hidden" aria-labelledby="roi-heading">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="container-main relative">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="section-label justify-center text-brand-400">
            <span class="w-8 h-px bg-brand-400"></span>
            Range
            <span class="w-8 h-px bg-brand-400"></span>
          </span>
          <h2 id="roi-heading" class="text-3xl sm:text-4xl font-bold text-white mt-6">
            The Three-Phase Range at a Glance
          </h2>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
          {roiStats.map(s => (
            <div class="text-center stat-item">
              <p class="text-4xl sm:text-5xl font-extrabold text-white">{s.value}<span class="text-brand-400">{s.suffix}</span></p>
              <p class="text-sm font-medium text-slate-400 mt-3 uppercase tracking-wider">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="section-padding bg-slate-50" aria-labelledby="features-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Features
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="features-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Built for Commercial Scale
          </h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map(f => (
            <div class="bg-white rounded-2xl p-8 feature-card">
              <div class="w-12 h-12 rounded-xl bg-brand-100 flex items-center justify-center text-brand-600 mb-5">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={f.icon}/></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">{f.title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Segments -->
    <section class="section-padding bg-white" aria-labelledby="segment-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Industries
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="segment-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Where Three-Phase Inverters Are Used
          </h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {segments.map(s => (
            <div class="bg-slate-50 rounded-2xl p-8 segment-card hover:bg-brand-500 group transition-all duration-500">
              <div class="w-12 h-12 rounded-xl bg-brand-100 flex items-center justify-center text-brand-600 mb-5 group-hover:bg-white/20 group-hover:text-white transition-all">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={s.icon}/></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-white transition-colors">{s.title}</h3>
              <p class="text-sm text-slate-500 group-hover:text-brand-100 transition-colors">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 lg:py-32 bg-brand-500 text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="container-main relative text-center max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold mb-6">Ready to Shortlist Your Project’s Inverters?</h2>
        <p class="text-lg text-brand-100 mb-10">Share your project requirements and request model-specific pricing, availability and documents. Pricing is quoted for the exact model.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/contact-us/?subject=Project+Consultation&from=%2Fc-i-solution%2F#lead-form" class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-8 py-4 text-sm font-semibold text-brand-600 shadow-lg hover:bg-brand-50 transition-all">Discuss Your Requirements</a>
          <a href="/download-datasheets/" class="btn-outline">Download Datasheets</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
