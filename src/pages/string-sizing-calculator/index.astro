---
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

// Adani N-type TOPCon panel database. tc in %/°C relative to STC (25°C).
const PANELS = [
  { model: 'AS-M10120-BHC-550W', wp: 550, voc: 51.00, vmp: 43.35, isc: 13.36, imp: 12.69, tcVoc: -0.23, tcVmp: -0.28 },
  { model: 'AS-M10120-BHC-555W', wp: 555, voc: 51.20, vmp: 43.52, isc: 13.43, imp: 12.75, tcVoc: -0.23, tcVmp: -0.28 },
  { model: 'AS-M10120-BHC-560W', wp: 560, voc: 51.40, vmp: 43.69, isc: 13.49, imp: 12.82, tcVoc: -0.23, tcVmp: -0.28 },
  { model: 'AS-M10120-BHC-565W', wp: 565, voc: 51.60, vmp: 43.86, isc: 13.56, imp: 12.88, tcVoc: -0.23, tcVmp: -0.28 },
  { model: 'AS-M10120-BHC-570W', wp: 570, voc: 51.80, vmp: 44.03, isc: 13.63, imp: 12.95, tcVoc: -0.23, tcVmp: -0.28 },
