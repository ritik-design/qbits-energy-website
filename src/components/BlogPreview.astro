---
const posts = [
  {
    title: 'Understanding MPPT Technology in Modern Solar Inverters',
    excerpt: 'Maximum Power Point Tracking is the key to maximizing solar energy harvest. Learn how advanced MPPT algorithms improve system efficiency.',
    category: 'Technology',
    date: 'May 28, 2026',
    slug: 'understanding-mppt-technology',
    readTime: '6 min read',
  },
  {
    title: 'Inverter Overheating: Causes and Prevention',
    excerpt: 'High temperatures can significantly impact inverter performance and lifespan. Discover best practices for thermal management.',
    category: 'Maintenance',
    date: 'May 15, 2026',
    slug: 'inverter-overheating',
    readTime: '5 min read',
  },
  {
    title: 'Choosing Between On-Grid and Hybrid Inverters',
    excerpt: 'Not sure which inverter type suits your needs? We break down the differences, benefits, and ideal use cases for each.',
    category: 'Buying Guide',
    date: 'May 02, 2026',
    slug: 'on-grid-vs-hybrid',
    readTime: '8 min read',
  },
];
---

<section class="section-padding bg-slate-50" aria-labelledby="blog-heading">
  <div class="container-main">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12">
      <div>
        <span class="section-label reveal">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
          </svg>
          Latest Insights
        </span>
        <h2 id="blog-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6 reveal reveal-delay-1">
          Solar Knowledge <span class="text-gradient">Hub</span>
        </h2>
      </div>
      <a href="/blog/" class="hidden sm:inline-flex items-center gap-2 text-sm font-semibold text-brand-600 hover:text-brand-700 transition-colors group">
        View All Articles
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
      {posts.map((post, i) => (
        <article class={`group card p-0 overflow-hidden hover:border-brand-200 reveal reveal-delay-${i + 1}`}>
          <!-- Image placeholder -->
          <div class="h-48 bg-gradient-to-br from-slate-200 to-slate-300 relative overflow-hidden">
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="w-16 h-16 rounded-xl bg-white/80 flex items-center justify-center shadow-sm">
                <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
            </div>
            <div class="absolute top-4 left-4">
              <span class="inline-flex items-center rounded-full bg-white/90 backdrop-blur px-3 py-1 text-xs font-semibold text-brand-700 shadow-sm">
                {post.category}
              </span>
            </div>
          </div>

          <div class="p-6">
            <div class="flex items-center gap-3 text-xs text-slate-400 mb-3">
              <span>{post.date}</span>
              <span class="w-1 h-1 rounded-full bg-slate-300"/>
              <span>{post.readTime}</span>
            </div>

            <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-brand-700 transition-colors line-clamp-2">
              <a href={`/blog/${post.slug}/`} class="focus:outline-none focus:text-brand-700">
                <span class="absolute inset-0" aria-hidden="true"/>
                {post.title}
              </a>
            </h3>

            <p class="text-sm text-slate-500 leading-relaxed line-clamp-3">{post.excerpt}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-8 text-center sm:hidden">
      <a href="/blog/" class="btn-secondary">View All Articles</a>
    </div>
  </div>
</section>
