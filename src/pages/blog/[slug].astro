---
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  const posts = [
    { slug: 'understanding-mppt-technology', title: 'Understanding MPPT Technology in Modern Solar Inverters', category: 'Technology', date: 'May 28, 2026', readTime: '6 min', excerpt: 'MPPT is the brain of every modern solar inverter. Learn how it squeezes the maximum power out of your panels, why multi-MPPT matters, and what to look for when buying.', image: '/images/hybrid.jpg', author: 'Qbits Editorial' },
    { slug: 'inverter-overheating', title: 'Inverter Overheating: Causes and Prevention', category: 'Maintenance', date: 'May 15, 2026', readTime: '5 min', excerpt: 'Heat is the silent killer of solar inverters. Here are the most common causes of overheating and the practical steps to keep your system running cool.', image: '/images/ongrid-res.jpg', author: 'Qbits Editorial' },
    { slug: 'on-grid-vs-hybrid', title: 'Choosing Between On-Grid and Hybrid Inverters', category: 'Buying Guide', date: 'May 02, 2026', readTime: '8 min', excerpt: 'On-grid or hybrid? The right choice depends on your goals, your grid, and your budget. A clear, side-by-side breakdown to help you decide.', image: '/images/ongrid-commercial.jpg', author: 'Qbits Editorial' },
    { slug: 'sizing-solar-inverter', title: 'How to Size Your Solar Inverter Correctly', category: 'Guide', date: 'April 20, 2026', readTime: '7 min', excerpt: 'Undersize and you cap your output. Oversize and you waste money. This guide walks through the simple math behind sizing a solar inverter the right way.', image: '/images/features.png', author: 'Qbits Editorial' },
    { slug: 'ai-solar-monitoring', title: 'The Future of Solar: AI-Powered Monitoring', category: 'Technology', date: 'April 10, 2026', readTime: '5 min', excerpt: 'AI is changing the way solar systems are monitored — from fault detection to yield forecasting. Here is what is already shipping and what is coming next.', image: '/images/products-bg.jpg', author: 'Qbits Editorial' },
    { slug: 'inverter-warranties', title: 'Understanding Solar Inverter Warranties', category: 'Guide', date: 'March 28, 2026', readTime: '6 min', excerpt: 'A warranty is more than a number on a spec sheet. Learn what is actually covered, what is not, and the fine print that decides whether your claim gets paid.', image: '/images/hybrid.jpg', author: 'Qbits Editorial' },
  ];
  return posts.map(p => ({ params: { slug: p.slug }, props: p }));
}

const { title, category, date, readTime, excerpt, image, author } = Astro.props;

const toc = [
  { id: 'introduction', label: 'Introduction' },
  { id: 'key-benefits', label: 'Key Benefits' },
  { id: 'what-to-look-for', label: 'What to Look For' },
  { id: 'conclusion', label: 'Conclusion' },
];

const faqs = [
  { q: 'How long do solar inverters typically last?', a: 'Most quality solar inverters last between 10 and 15 years, with premium models often exceeding 20 years when paired with regular maintenance and proper ventilation.' },
  { q: 'Can I install a solar inverter myself?', a: 'We strongly recommend professional installation. A licensed installer ensures correct sizing, grid compliance, and that your manufacturer warranty stays valid.' },
  { q: 'What is the difference between on-grid and hybrid inverters?', a: 'On-grid inverters feed solar power to the grid and need grid power to operate. Hybrid inverters add battery support and can run during outages, giving you backup and self-consumption.' },
  { q: 'Do I need multiple MPPT trackers?', a: 'If your panels face different directions, sit at different tilts, or experience shading, multiple MPPTs let each string operate at its own peak — squeezing out noticeably more yield.' },
];
---

<Layout
  title={`${title} | Qbits Energy Blog`}
  description={excerpt || title}
  canonical={`/blog/${Astro.params.slug}/`}
>
  <HeaderV2 />

  <main class="pt-[104px] lg:pt-[120px] bg-white">
    <!-- Hero: split layout -->
    <section class="relative overflow-hidden bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="absolute -top-40 -right-40 w-[28rem] h-[28rem] bg-brand-500/20 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-[28rem] h-[28rem] bg-accent/10 rounded-full blur-3xl"></div>

      <div class="container-main relative py-16 lg:py-24">
        <nav class="flex items-center gap-2 text-xs text-slate-400 mb-8" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white transition">Home</a>
          <span>/</span>
          <a href="/blog/" class="hover:text-white transition">Blog</a>
          <span>/</span>
          <span class="text-slate-300 truncate">{title}</span>
        </nav>

        <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
          <!-- Left: title + meta + author -->
          <div>
            <span class="inline-flex items-center gap-2 text-brand-400 font-bold uppercase tracking-wider text-xs bg-brand-500/15 ring-1 ring-brand-500/30 px-3 py-1.5 rounded-full">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-400"></span>
              {category}
            </span>

            <h1 class="mt-6 text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-white leading-[1.1] tracking-tight">{title}</h1>

            {excerpt && (
              <p class="mt-6 text-lg text-slate-300 leading-relaxed max-w-xl">{excerpt}</p>
            )}

            <div class="mt-8 flex items-center gap-4 pt-6 border-t border-white/10">
              <div class="w-12 h-12 rounded-full bg-gradient-to-br from-brand-400 to-brand-600 flex items-center justify-center text-white font-bold">
                {author?.[0] ?? 'Q'}
              </div>
              <div class="flex flex-col">
                <span class="text-white font-semibold text-sm">{author}</span>
                <div class="flex items-center gap-3 text-xs text-slate-400 mt-0.5">
                  <span>{date}</span>
                  <span class="w-1 h-1 rounded-full bg-slate-500"></span>
                  <span>{readTime} read</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Right: feature image -->
          <div class="relative">
            <div class="relative aspect-[4/3] rounded-2xl overflow-hidden ring-1 ring-white/10 shadow-2xl">
              <img src={image} alt={title} class="w-full h-full object-cover" loading="eager" />
              <div class="absolute inset-0 bg-gradient-to-tr from-slate-950/30 via-transparent to-transparent"></div>
            </div>
            <div class="absolute -inset-4 -z-10 bg-gradient-to-br from-brand-500/20 to-accent/20 rounded-3xl blur-2xl"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Body: content + sticky sidebar -->
    <section class="py-16 lg:py-20">
      <div class="container-main">
        <div class="grid lg:grid-cols-[1fr_320px] gap-12 lg:gap-16">
          <!-- Left: article content -->
          <article>
            <div class="prose prose-lg max-w-none prose-headings:font-bold prose-headings:text-slate-900 prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:scroll-mt-28 prose-p:text-slate-600 prose-p:leading-relaxed prose-a:text-brand-600 prose-a:no-underline hover:prose-a:underline prose-strong:text-slate-900 prose-li:text-slate-600">
              <slot>
                <p class="text-xl leading-relaxed text-slate-700 mb-8 not-prose font-medium">Solar inverter technology continues to evolve, bringing better efficiency, smarter monitoring, and longer lifespans to renewable energy systems. In this article, we explore the key aspects of modern solar inverters and how they can benefit your installation.</p>

                <h2 id="introduction">Introduction</h2>
                <p>The solar inverter is the brain of every photovoltaic system. It converts the DC electricity produced by your panels into the AC power that runs your home, your business, or feeds back into the grid. Yet many buyers spend most of their budget on panels and pick an inverter as an afterthought.</p>

                <h2 id="key-benefits">Key Benefits of Modern Solar Inverters</h2>
                <p>Modern solar inverters offer numerous advantages over older models, including higher conversion efficiency, advanced monitoring capabilities, and improved grid support features. These improvements translate to better performance and higher returns on your solar investment.</p>
                <p>With efficiency ratings now reaching 98.8% and beyond, today's inverters waste less energy during the DC-to-AC conversion process. This means more of your solar generation reaches your appliances or the grid, maximizing your financial returns.</p>

                <h2 id="what-to-look-for">What to Look for When Choosing an Inverter</h2>
                <p>When selecting a solar inverter for your installation, consider factors such as efficiency ratings, warranty terms, monitoring capabilities, and compatibility with your specific solar panel configuration.</p>
                <ul>
                  <li><strong>Efficiency:</strong> Look for maximum efficiency above 98% for on-grid systems.</li>
                  <li><strong>Warranty:</strong> A 10-12 year warranty indicates manufacturer confidence.</li>
                  <li><strong>MPPT:</strong> Multiple MPPT channels handle shading and orientation differences.</li>
                  <li><strong>Protection:</strong> IP65 or IP66 rating ensures durability in outdoor conditions.</li>
                  <li><strong>Monitoring:</strong> Real-time monitoring helps identify issues quickly.</li>
                </ul>

                <h2 id="conclusion">Conclusion</h2>
                <p>Investing in a quality solar inverter is essential for maximizing the performance and longevity of your solar energy system. With the right inverter, you can enjoy reliable, efficient power generation for decades.</p>
              </slot>
            </div>

            <!-- FAQ -->
            <div class="mt-16 pt-12 border-t border-slate-200">
              <div class="flex items-center gap-3 mb-8">
                <span class="text-brand-600 font-bold uppercase tracking-wider text-xs bg-brand-500/10 px-3 py-1 rounded-full">FAQ</span>
                <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">Frequently Asked Questions</h2>
              </div>
              <div class="space-y-3">
                {faqs.map((f, i) => (
                  <details class="group rounded-xl border border-slate-200 bg-white hover:border-brand-300 transition-colors" open={i === 0}>
                    <summary class="flex items-center justify-between cursor-pointer list-none p-5 sm:p-6">
                      <span class="font-semibold text-slate-900 text-base sm:text-lg pr-4">{f.q}</span>
                      <span class="flex-shrink-0 w-8 h-8 rounded-full bg-slate-100 group-hover:bg-brand-500 group-hover:text-white text-slate-600 flex items-center justify-center transition-all">
                        <svg class="w-4 h-4 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                      </span>
                    </summary>
                    <div class="px-5 sm:px-6 pb-6 -mt-2 text-slate-600 leading-relaxed">{f.a}</div>
                  </details>
                ))}
              </div>
            </div>

            <!-- Share + back -->
            <div class="mt-12 pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
              <a href="/blog/" class="inline-flex items-center gap-2 text-brand-600 hover:text-brand-700 font-semibold">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                Back to Blog
              </a>
              <div class="flex items-center gap-3">
                <span class="text-sm text-slate-500">Share:</span>
                <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=https://qbitsenergy.com/blog/${Astro.params.slug}/`} target="_blank" rel="noopener" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 hover:bg-brand-500 hover:text-white transition-all">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
                </a>
                <a href={`https://www.linkedin.com/shareArticle?mini=true&url=https://qbitsenergy.com/blog/${Astro.params.slug}/&title=${encodeURIComponent(title)}`} target="_blank" rel="noopener" class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 hover:bg-brand-500 hover:text-white transition-all">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                </a>
              </div>
            </div>

            <!-- Author box -->
            <div class="mt-16 rounded-2xl bg-gradient-to-br from-slate-50 to-white ring-1 ring-slate-200 p-6 sm:p-8">
              <div class="flex flex-col sm:flex-row gap-6">
                <div class="w-20 h-20 flex-shrink-0 rounded-2xl bg-gradient-to-br from-brand-400 to-brand-600 flex items-center justify-center text-white text-2xl font-bold">
                  {author?.[0] ?? 'Q'}
                </div>
                <div class="flex-1">
                  <div class="text-xs uppercase tracking-wider text-brand-600 font-bold">Written by</div>
                  <h3 class="text-xl font-bold text-slate-900 mt-1">{author}</h3>
                  <p class="text-slate-600 mt-2 leading-relaxed">The Qbits Energy editorial team writes about solar inverters, battery storage, and the hardware powering India's energy transition. We work directly with our engineers to keep every guide accurate and current.</p>
                  <div class="mt-4 flex items-center gap-3">
                    <a href="/about-us/" class="text-sm font-semibold text-brand-600 hover:text-brand-700">More about Qbits →</a>
                  </div>
                </div>
              </div>
            </div>
          </article>

          <!-- Right: sticky sidebar -->
          <aside class="lg:block">
            <div class="lg:sticky lg:top-32 space-y-6">
              <!-- CTA banner -->
              <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-brand-600 via-brand-700 to-slate-900 p-6 text-white shadow-xl">
                <div class="absolute -top-10 -right-10 w-32 h-32 bg-white/10 rounded-full blur-2xl"></div>
                <div class="relative">
                  <span class="inline-block text-[10px] font-bold uppercase tracking-widest bg-white/15 px-2.5 py-1 rounded-full">Free Consultation</span>
                  <h3 class="mt-4 text-xl font-bold leading-tight">Planning a solar project?</h3>
                  <p class="mt-2 text-sm text-white/85 leading-relaxed">Talk to a Qbits engineer about sizing, products, and pricing.</p>
                  <a href="/contact-us/" class="mt-5 inline-flex items-center gap-2 bg-white text-brand-700 text-sm font-bold px-4 py-2.5 rounded-lg hover:bg-slate-100 transition">
                    Talk To Sales
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                  </a>
                </div>
              </div>

              <!-- Table of contents -->
              <nav class="rounded-2xl ring-1 ring-slate-200 bg-white p-6" aria-label="Table of contents">
                <div class="flex items-center gap-2 mb-4">
                  <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
                  <span class="text-xs font-bold uppercase tracking-wider text-slate-500">On this page</span>
                </div>
                <ul class="space-y-2 text-sm">
                  {toc.map(t => (
                    <li>
                      <a href={`#${t.id}`} class="toc-link block py-1.5 pl-3 border-l-2 border-slate-200 text-slate-600 hover:text-brand-600 hover:border-brand-500 transition-colors">{t.label}</a>
                    </li>
                  ))}
                </ul>
              </nav>

              <!-- Quick downloads -->
              <div class="rounded-2xl ring-1 ring-slate-200 bg-white p-6">
                <h4 class="font-bold text-slate-900">Resources</h4>
                <p class="text-sm text-slate-500 mt-1">Datasheets and brochures</p>
                <a href="/download-datasheets/" class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand-600 hover:text-brand-700">
                  Browse downloads
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- Full-width final CTA -->
    <section class="relative overflow-hidden bg-gradient-to-br from-slate-950 via-brand-900 to-slate-950">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[40rem] h-[40rem] bg-brand-500/20 rounded-full blur-3xl"></div>
      <div class="container-main relative py-20 lg:py-28">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-flex items-center gap-2 rounded-full bg-white/5 border border-white/10 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-brand-400">
            <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
            Get Started
          </span>
          <h2 class="mt-6 text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight tracking-tight">
            Ready to power your project with Qbits?
          </h2>
          <p class="mt-5 text-base sm:text-lg text-slate-300 max-w-xl mx-auto">
            Get a personalized quote, request a product demo, or find your nearest distributor — our team is one click away.
          </p>
          <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/contact-us/" class="btn-primary text-sm py-3.5 px-8">
              Talk To Sales
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            <a href="/download-datasheets/" class="btn-outline text-sm py-3.5 px-8">
              Download Datasheets
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  // Highlight active TOC entry on scroll
  const links = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
  const targets = Array.from(links)
    .map(l => document.querySelector(l.getAttribute('href') || ''))
    .filter((el): el is Element => !!el);

  if (targets.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            links.forEach((l) => {
              const active = l.getAttribute('href') === `#${id}`;
              l.classList.toggle('text-brand-600', active);
              l.classList.toggle('border-brand-500', active);
              l.classList.toggle('font-semibold', active);
            });
          }
        });
      },
      { rootMargin: '-30% 0px -60% 0px' }
    );
    targets.forEach((t) => observer.observe(t));
  }
</script>
