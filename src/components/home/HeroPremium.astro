---
// Background slides cross-fade behind the hero copy. First slide is eager +
// high priority (it is the LCP image); the rest lazy-load.
const slides = [
  { src: '/homepage/hero-dilip-joshi.webp', alt: 'Dilip Joshi, Qbits Energy brand ambassador, holding a Qbits solar inverter' },
  { src: '/homepage/qbits-hero.webp', alt: 'Qbits solar inverter installation' },
];
---

<section class="relative md:min-h-screen md:flex md:items-center overflow-hidden bg-slate-950" aria-labelledby="hero-heading">
  <!-- Desktop: full-width background slider -->
  <div class="absolute inset-0 hidden md:block" aria-hidden="true">
    {slides.map((slide, i) => (
      <img
        src={slide.src}
        alt={slide.alt}
        width="1920"
        height="1080"
        class="hero-slide absolute inset-0 w-full h-full object-cover object-bottom scale-[1.05] origin-bottom"
        style={`animation-delay: ${i * 6}s;`}
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : 'auto'}
        decoding="async"
      />
    ))}
  </div>

  <!-- Floating particles effect (desktop only) -->
  <div class="absolute inset-0 z-20 overflow-hidden pointer-events-none hidden md:block" aria-hidden="true">
    <div class="absolute top-1/4 right-1/4 w-2 h-2 rounded-full bg-brand-400/30 animate-pulse"></div>
    <div class="absolute top-1/3 right-1/3 w-1.5 h-1.5 rounded-full bg-brand-400/20 animate-pulse" style="animation-delay: 1s;"></div>
    <div class="absolute bottom-1/3 right-1/3 w-1 h-1 rounded-full bg-brand-400/40 animate-pulse" style="animation-delay: 2s;"></div>
    <div class="absolute top-2/3 right-1/4 w-2 h-2 rounded-full bg-accent/20 animate-pulse" style="animation-delay: 0.5s;"></div>
  </div>

  <!-- Content -->
  <div class="container-main relative z-30 w-full pt-28 pb-10 md:py-24">
    <div class="max-w-2xl text-center mx-auto md:mx-0 md:text-left">
      <span class="hero-badge inline-flex items-center gap-2 rounded-full bg-white/5 border border-white/10 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-brand-400 mb-6">
        <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
        India's Solar Inverter Pioneer
      </span>

      <h1 id="hero-heading" class="hero-headline text-center md:text-left text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-white leading-[1.05] tracking-tight">
        Built For India's
        <span class="block mt-1 bg-gradient-to-r from-brand-400 via-brand-300 to-accent bg-clip-text text-transparent">
          Toughest Solar
        </span>
        <span class="block mt-1">Conditions</span>
      </h1>

      <p class="hero-desc text-center md:text-left mt-6 text-base sm:text-lg text-white max-w-lg mx-auto md:mx-0 leading-relaxed">
        High-efficiency solar inverters engineered for India's heat, voltage fluctuations, dust, and demanding grid conditions.
      </p>

      <div class="hero-buttons mt-8 flex flex-col sm:flex-row items-stretch sm:items-center md:items-start justify-center md:justify-start gap-4">
        <a href="/our-products/" class="btn-primary text-sm py-3.5 px-8 justify-center">
          Explore Products
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="/contact-us/" class="btn-outline text-sm py-3.5 px-8 justify-center">
          Get a free site survey
        </a>
      </div>
    </div>

    <!-- Mobile: image below content -->
    <div class="mt-10 md:hidden">
      <img
        src="/qbits-home.webp"
        alt="Qbits solar inverter installation"
        width="1280"
        height="900"
        class="w-full h-auto object-contain"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>

  <style>
    /* Two-slide cross-fade. Each slide is visible for ~6s of the 12s cycle,
       with a 1s overlap so neither the copy nor the page background flashes. */
    .hero-slide {
      opacity: 0;
      animation: hero-slide-fade 12s linear infinite;
    }

    @keyframes hero-slide-fade {
      0%    { opacity: 1; }
      42%   { opacity: 1; }
      50%   { opacity: 0; }
      92%   { opacity: 0; }
      100%  { opacity: 1; }
    }

    /* No motion: show the first slide only, held still. */
    @media (prefers-reduced-motion: reduce) {
      .hero-slide {
        animation: none;
        opacity: 0;
      }
      .hero-slide:first-child {
        opacity: 1;
      }
    }
  </style>

  <!-- Scroll indicator (desktop only) -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-30 hidden md:flex flex-col items-center gap-2">
    <span class="text-xs text-slate-600 uppercase tracking-widest">Scroll</span>
    <svg class="w-5 h-5 text-slate-600 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
  </div>
</section>
