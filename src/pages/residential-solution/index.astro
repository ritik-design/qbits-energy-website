---
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

const features = [
  { title: '1-10kW Range', desc: 'Perfect for homes of all sizes — from compact apartments to large villas.', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { title: 'Net Metering Ready', desc: 'Export excess power to the grid and earn credits on your electricity bill.', icon: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4' },
  { title: 'Smart App Monitoring', desc: 'Track generation, consumption, and savings from your phone, anywhere.', icon: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z' },
  { title: 'Compact Wall-Mount', desc: 'Sleek, lightweight design that fits easily on any wall or rooftop structure.', icon: 'M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z' },
  { title: '12-Year Warranty', desc: 'Industry-leading warranty with pan-India service and rapid replacement.', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
  { title: 'AI WhatsApp Alerts', desc: 'Get instant alerts for faults, performance drops, and maintenance needs.', icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z' },
];

const useCases = [
  { title: 'Independent House', desc: '3-10kW systems for villas and bungalows with rooftop space.', power: '3-10kW' },
  { title: 'Apartments', desc: 'Compact 1-3kW systems for apartment balconies and terraces.', power: '1-3kW' },
  { title: 'Farm Houses', desc: 'Off-grid capable hybrid systems for remote locations.', power: '5-10kW' },
  { title: 'Gated Communities', desc: 'Shared solar systems for common area power and lighting.', power: '10-50kW' },
];
---

<Layout
  title="Residential Solar Solutions | Qbits Energy"
  description="Complete residential solar inverter solutions for Indian homes. From 1kW to 10kW with smart monitoring, net metering, and 12-year warranty."
  canonical="/residential-solution/"
>
  <HeaderV2 />

  <main>
    <PageHeader
      label="Solutions"
      title="Residential Solar"
      highlight="Solutions"
      description="Power your home with clean, reliable solar energy. Qbits residential inverters are designed for maximum efficiency and easy monitoring."
    />

    <!-- Hero Content -->
    <section class="section-padding bg-white overflow-hidden" aria-labelledby="res-heading">
      <div class="container-main">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <span class="section-label">
              <span class="w-8 h-px bg-brand-500"></span>
              For Your Home
            </span>
            <h2 id="res-heading" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mt-6 mb-6 leading-tight">
              Solar Power for Your Home
            </h2>
            <p class="text-lg text-brand-600 font-semibold mb-6">
              Reduce Bills. Increase Independence. Go Green.
            </p>
            <p class="text-slate-600 leading-relaxed mb-6">
              Qbits residential inverters are the perfect choice for homeowners looking to reduce electricity bills and contribute to a greener future. Our compact, efficient inverters work seamlessly with rooftop solar installations of all sizes.
            </p>
            <p class="text-slate-600 leading-relaxed mb-8">
              With up to 98% efficiency, AI-powered monitoring via WhatsApp, and a 12-year warranty, Qbits brings peace of mind to every residential solar project. Net metering ready for maximum savings.
            </p>
            <div class="flex flex-wrap gap-4">
              <a href="/our-products/" class="btn-primary">Explore Inverters</a>
              <a href="/contact-us/" class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-slate-200 px-8 py-4 text-sm font-semibold text-slate-700 hover:border-brand-300 hover:text-brand-600 transition-all">
                Get a Quote
              </a>
            </div>
          </div>
          <div class="relative">
            <div class="absolute -top-10 -right-10 w-72 h-72 bg-brand-100 rounded-full blur-3xl opacity-50"></div>
            <div class="relative rounded-2xl overflow-hidden shadow-2xl">
              <img src="/images/ongrid-res.jpg" alt="Residential Solar Installation" class="w-full" loading="lazy" />
            </div>
            <div class="absolute -bottom-6 -left-6 bg-white rounded-2xl shadow-xl p-5 hidden md:block">
              <p class="text-3xl font-bold text-brand-600">₹0</p>
              <p class="text-sm text-slate-500">Electricity Bill Possible</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="section-padding bg-slate-50" aria-labelledby="features-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Features
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="features-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Built for Indian Homes
          </h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map(f => (
            <div class="bg-white rounded-2xl p-8 feature-card">
              <div class="w-12 h-12 rounded-xl bg-brand-100 flex items-center justify-center text-brand-600 mb-5">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={f.icon}/></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">{f.title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Use Cases -->
    <section class="section-padding bg-white" aria-labelledby="usecase-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Applications
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="usecase-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Homes We Power
          </h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {useCases.map(u => (
            <div class="bg-slate-50 rounded-2xl p-8 text-center usecase-card hover:bg-brand-500 group transition-all duration-500">
              <p class="text-3xl font-bold text-brand-600 mb-2 group-hover:text-white transition-colors">{u.power}</p>
              <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-white transition-colors">{u.title}</h3>
              <p class="text-sm text-slate-500 group-hover:text-brand-100 transition-colors">{u.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Savings Calculator teaser -->
    <section class="py-24 lg:py-32 bg-slate-950 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-brand-500/10 via-transparent to-accent/10"></div>
      <div class="container-main relative text-center max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">Calculate Your Savings</h2>
        <p class="text-lg text-slate-400 mb-10">Use our string sizing calculator to find the optimal inverter and panel configuration for your home.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/string-sizing-calculator/" class="btn-primary">String Sizing Calculator</a>
          <a href="/contact-us/" class="btn-outline">Talk to an Expert</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

