---
const products = [
  {
    title: 'On Grid Inverters',
    subtitle: '1kW - 125kW',
    desc: 'High-efficiency grid-tied inverters for every scale.',
    href: '/on-grid-inverter/',
    image: '/homepage-new/on-grid-inverters.png',
  },
  {
    title: 'Hybrid Inverters',
    subtitle: '3kW - 12kW',
    desc: 'Battery-ready inverters for energy independence.',
    href: '/hybrid-inverter/',
    image: '/homepage-new/hybrid-inverters.png',
  },
];
---

<section class="py-20 sm:py-28 lg:py-36 bg-white" aria-labelledby="categories-heading">
  <div class="container-main">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="section-label">
        <span class="w-8 h-px bg-brand-500"></span>
        Product Range
      </span>
      <h2 id="categories-heading" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mt-6 leading-tight">
        Choose Your <span class="text-gradient">Power</span>
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      {products.map((product) => (
        <a href={product.href} class="group flex flex-col">
          <!-- Image -->
          <div class="rounded-3xl overflow-hidden bg-slate-50 border border-slate-100 aspect-[4/3] flex items-center justify-center p-6 sm:p-8 transition-shadow duration-500 group-hover:shadow-xl group-hover:shadow-brand-500/5">
            <img width="1920" height="1080"
              src={product.image}
              alt={product.title}
              class="w-full h-full object-contain transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
          </div>

          <!-- Content below image -->
          <div class="mt-6 px-1">
            <p class="text-sm font-medium text-brand-600 mb-2">{product.subtitle}</p>
            <h3 class="text-xl sm:text-2xl lg:text-3xl font-bold text-slate-900 mb-2 group-hover:text-brand-600 transition-colors duration-500">{product.title}</h3>
            <p class="text-sm sm:text-base text-slate-500 mb-4">{product.desc}</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-brand-600 group-hover:gap-3 transition-all">
              Explore
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
