---
const checks = [
  {
    title: 'Match the exact model',
    content: 'Use the model datasheet to confirm phase, MPPT count, voltage window, protection rating, communication options, and operating limits for your design.',
  },
  {
    title: 'Request written commercial terms',
    content: 'Obtain the current quotation, warranty terms, registration steps, exclusions, remedy, and service process for the exact model before purchase.',
  },
  {
    title: 'Verify project requirements',
    content: 'Ask the installer or EPC to confirm compatibility with the array, grid connection, battery if applicable, local DISCOM rules, and required protection devices.',
  },
];
---

<section class="section-padding bg-white" aria-labelledby="buyer-checks-heading">
  <div class="container-main">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="section-label reveal">Buyer checks</span>
      <h2 id="buyer-checks-heading" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mt-6 reveal reveal-delay-1">
        Verify before <span class="text-gradient">you select a model</span>
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
      {checks.map((item, i) => (
        <div class={`card reveal reveal-delay-${i + 1}`}>
          <h3 class="font-semibold text-slate-900 mb-3">{item.title}</h3>
          <p class="text-slate-600 leading-relaxed text-sm">{item.content}</p>
        </div>
      ))}
    </div>
  </div>
</section>
