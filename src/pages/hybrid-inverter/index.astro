---
import { productImageSizes } from '../../data/product-images';
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { getProductsByCategory, type Product } from '../../data/products';

const hybridProducts = getProductsByCategory('hybrid');
const singlePhase = hybridProducts.filter(p => p.phase === 'single');
const threePhase = hybridProducts.filter(p => p.phase === 'three');

const kw = (p: Product) => (p.powerMin === p.powerMax ? `${p.powerMin} kW` : `${p.powerMin}–${p.powerMax} kW`);
const mpptText = (p: Product) => (/\d/.test(p.mpptLabel) ? p.mpptLabel : `${p.mppt} MPPT${p.mppt > 1 ? 's' : ''}`);
const batteryCurrent = (p: Product) => (p.features.find(f => /battery current/i.test(f)) ?? '').replace(/\s*battery current/i, '');
const enquiryHref = (p: Product) =>
  `/contact-us/?subject=Product+Inquiry&model=${encodeURIComponent(p.name)}&from=%2Fhybrid-inverter%2F#lead-form`;

const keyFeatures = [
  { icon: 'M13 10V3L4 14h7v7l9-11h-7z', title: 'Model-specific battery current limits' },
  { icon: 'M3 21v-8a2 2 0 012-2h14a2 2 0 012 2v8M3 7v-2a2 2 0 012-2h14a2 2 0 012 2v2M3 7h18M9 14v2m6-2v2', title: 'Model-specific backup and peak-power limits' },
  { icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z', title: 'Transfer behavior must be checked for the exact model and load' },
  { icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10', title: 'Battery chemistry, voltage, protocol and firmware require compatibility confirmation' },
];

const featureIcons: Record<string, string> = {
  'IP66 Weather Protection': 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  'Wi-Fi/4G/Bluetooth': 'M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0',
  'Digital Warranty': 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  '50V DC Start-up': 'M13 10V3L4 14h7v7l9-11h-7z',
  'Built-in DC/AC SPD': 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
  '90V-290V AC Range': 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  '750W Panel Support': 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z',
  '98% Efficiency': 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
  '120A Battery Charge/Discharge': 'M13 10V3L4 14h7v7l9-11h-7z',
  '2x Peak Power 15s': 'M3 21v-8a2 2 0 012-2h14a2 2 0 012 2v8M3 7v-2a2 2 0 012-2h14a2 2 0 012 2v2M3 7h18M9 14v2m6-2v2',
  'UPS Switching <10s': 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  'Lead-acid & Lithium': 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
};

function getFeatureIcon(feature: string): string {
  for (const [key, icon] of Object.entries(featureIcons)) {
    if (feature.includes(key)) return icon;
  }
  return 'M5 13l4 4L19 7';
}

const SITE = 'https://qbitsenergy.com';
const hybridSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Hybrid Solar Inverters',
  description: 'Qbits hybrid solar inverters with battery support and supported grid and backup operating modes for Indian homes and small commercial sites.',
  numberOfItems: hybridProducts.length,
  itemListElement: hybridProducts.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: p.name,
      url: `${SITE}/our-products/${p.id}/`,
      image: p.image ? `${SITE}${p.image}` : `${SITE}/og-image.webp`,
      sku: p.id,
      brand: { '@type': 'Brand', name: 'Qbits Energy' },
      category: 'Hybrid Solar Inverter',
    },
  })),
};
---

<Layout
  title="Qbits Hybrid Solar Inverters: 3 kW to 12 kW, 48 V Battery"
  description="Qbits single- and three-phase hybrid inverters from 3 kW to 12 kW for 48 V batteries. Compare battery current, PV input and MPPT; get datasheets."
  canonical="/hybrid-inverter/"
>
  <HeaderV2 />
  <script type="application/ld+json" set:html={JSON.stringify(hybridSchema)} />

  <main id="main-content">
    <PageHeader
      label="Hybrid Inverters"
      title="Battery-Ready"
      highlight="Hybrid Inverters"
      description="Take control of your energy with Qbits hybrid inverters. Store solar power for backup and check your required backup loads."
      bgImage="/images/hybrid.webp"
    />

    <!-- Key Features -->
    <section class="py-10 bg-white" aria-labelledby="hybrid-select-heading"><div class="container-main max-w-5xl">
      <h2 id="hybrid-select-heading" class="text-2xl font-bold text-slate-900">Choose the exact hybrid model and battery</h2>
      <p class="mt-3 text-slate-600">The QBH single-phase catalogue covers 3 to 6 kW variants. Its 3 kW model has one MPPT; the larger variants have two. For the QBH-5KS48P, check the published 150–450 V tracking range, 500 V maximum PV input and 120 A maximum battery current. The battery model, BMS communication and backup circuits also need project-specific approval.</p>
      <p class="mt-3 text-slate-600"><a class="text-brand-600 underline" href="/datasheets/products/Qbits-Hybride-Inverter-Catalogue-1.pdf">Read the QBH datasheet</a>, then compare the <a class="text-brand-600 underline" href="/blog/5kw-hybrid-inverter-price-india/">5 kW price and quote scope</a> or use the <a class="text-brand-600 underline" href="/blog/battery-sizing-hybrid-solar/">battery load worksheet</a>. <a class="text-brand-600 underline" href="/contact-us/?subject=Product+Inquiry&from=%2Fhybrid-inverter%2F#lead-form">Send the intended battery and load list</a> for a model-specific enquiry.</p>
    </div></section>
    <section class="section-padding bg-white" aria-labelledby="features-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Key Features
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="features-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Hybrid Fields to Verify
          </h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
          {keyFeatures.map(f => (
            <div class="bg-slate-50 rounded-2xl p-8 text-center">
              <div class="w-14 h-14 mx-auto rounded-xl bg-accent/10 flex items-center justify-center text-accent mb-5">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={f.icon}/>
                </svg>
              </div>
              <p class="text-sm text-slate-600 font-medium leading-relaxed">{f.title}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Model selector table -->
    <section class="py-12 bg-slate-50" aria-labelledby="hybrid-compare-heading"><div class="container-main max-w-6xl">
      <h2 id="hybrid-compare-heading" class="text-2xl font-bold text-slate-900">Compare hybrid models side by side</h2>
      <p class="mt-3 text-slate-600 max-w-3xl">Each row is a model family from the published product data. All three QBH datasheets list a 48 V rated battery voltage and accept lithium or lead-acid batteries, subject to compatibility. The kW figure is the range across the family, so confirm the exact rating and battery current on the datasheet.</p>
      <div class="mt-6 overflow-x-auto rounded-2xl border border-slate-200">
        <table class="min-w-full text-left text-sm">
          <caption class="sr-only">Qbits hybrid inverter families by capacity, phase, MPPT count, battery current, PV input and maximum efficiency</caption>
          <thead class="bg-slate-100 text-xs uppercase tracking-wider text-slate-600">
            <tr>
              <th scope="col" class="px-4 py-3 font-semibold">Model</th>
              <th scope="col" class="px-4 py-3 font-semibold">Capacity</th>
              <th scope="col" class="px-4 py-3 font-semibold">Phase</th>
              <th scope="col" class="px-4 py-3 font-semibold">MPPT</th>
              <th scope="col" class="px-4 py-3 font-semibold">Battery current</th>
              <th scope="col" class="px-4 py-3 font-semibold">PV input</th>
              <th scope="col" class="px-4 py-3 font-semibold">Max efficiency</th>
              <th scope="col" class="px-4 py-3 font-semibold">Details</th>
            </tr>
          </thead>
          <tbody class="bg-white text-slate-700">
            {hybridProducts.map((p) => (
              <tr class="border-t border-slate-100 align-top">
                <th scope="row" class="px-4 py-3 font-semibold text-slate-900"><a href={`/our-products/${p.id}/`} class="text-accent hover:text-accent-dark">{p.name}</a></th>
                <td class="px-4 py-3 whitespace-nowrap">{kw(p)}</td>
                <td class="px-4 py-3 whitespace-nowrap">{p.phase === 'single' ? 'Single-phase' : 'Three-phase'}</td>
                <td class="px-4 py-3">{mpptText(p)}</td>
                <td class="px-4 py-3 whitespace-nowrap">{batteryCurrent(p)}</td>
                <td class="px-4 py-3">{p.voltageRange}</td>
                <td class="px-4 py-3">{p.efficiency}</td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <a href={`/our-products/${p.id}/`} class="text-accent hover:text-accent-dark font-medium">Model page</a>
                  {p.datasheet && (<span> &middot; <a href={p.datasheet} class="text-accent hover:text-accent-dark font-medium">Datasheet (PDF)</a></span>)}
                  <span> &middot; <a href={enquiryHref(p)} class="text-accent hover:text-accent-dark font-medium">Enquire</a></span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div></section>

    <!-- How to choose -->
    <section class="py-12 bg-white" aria-labelledby="hybrid-choose-heading"><div class="container-main max-w-6xl">
      <h2 id="hybrid-choose-heading" class="text-2xl font-bold text-slate-900">How to choose between hybrid models</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div>
          <h3 class="text-lg font-bold text-slate-900">Start with the loads you want to back up</h3>
          <p class="mt-2 text-slate-600 leading-relaxed">List the appliances that must keep running in an outage, their wattage and how many hours you need. That sets the backup power and battery size, and the inverter follows from it. The <a class="text-accent underline" href="/blog/battery-sizing-hybrid-solar/">battery sizing guide</a> has a worksheet for this.</p>
        </div>
        <div>
          <h3 class="text-lg font-bold text-slate-900">Match battery current and capacity</h3>
          <p class="mt-2 text-slate-600 leading-relaxed">The battery current column shows the maximum charge and discharge current the inverter supports. The battery you pair with it must be rated to deliver and accept that current, and its BMS must communicate with the inverter. Confirm compatibility with the battery maker before ordering.</p>
        </div>
        <div>
          <h3 class="text-lg font-bold text-slate-900">Single-phase or three-phase</h3>
          <p class="mt-2 text-slate-600 leading-relaxed">Pick the phase that matches your supply and the loads you want on backup. The QBH single-phase families cover 3 to 8 kW and the three-phase family covers 5 to 12 kW. For help with the decision, read <a class="text-accent underline" href="/blog/single-vs-3-phase-inverter/">single versus three phase</a>.</p>
        </div>
        <div>
          <h3 class="text-lg font-bold text-slate-900">MPPT inputs and the PV array</h3>
          <p class="mt-2 text-slate-600 leading-relaxed">Check that your string voltage stays inside the PV input range in the table, including on cold mornings. Roofs facing two directions are easier with two MPPTs. The <a class="text-accent underline" href="/string-sizing-calculator/">string sizing calculator</a> gives a first check of a panel and inverter pairing.</p>
        </div>
      </div>
      <p class="mt-8 text-slate-600">If you do not need battery backup, <a class="text-accent underline" href="/blog/on-grid-vs-hybrid/">on-grid versus hybrid</a> explains the trade-off, and the <a class="text-accent underline" href="/on-grid-inverter/">on-grid range</a> may fit better. For comparisons across brands, see <a class="text-accent underline" href="/blog/best-hybrid-solar-inverter-india-2026/">the hybrid inverter comparison</a> and the <a class="text-accent underline" href="/blog/hybrid-inverter-price-india/">hybrid inverter price guide</a>. Installers and dealers can <a class="text-accent underline" href="/become-our-partner/">apply to become a Qbits partner</a>.</p>
    </div></section>

    <!-- Single Phase -->
    <section class="section-padding bg-slate-50" aria-labelledby="single-phase-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Residential
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="single-phase-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Single Phase Hybrid
          </h2>
          <p class="mt-4 text-slate-500">
            Suited to <a href="/residential-solution/" class="text-accent hover:text-accent-dark underline underline-offset-2 font-medium">homes</a> and small businesses. Store solar energy for evening use or <a href="/blog/solar-inverter-power-cut-backup/" class="text-accent hover:text-accent-dark underline underline-offset-2 font-medium">power cuts</a>. Available in 3kW to 8kW options.
          </p>
        </div>

        <div class="space-y-8 max-w-5xl mx-auto">
          {singlePhase.map((product) => (
            <div class="group bg-white rounded-2xl border border-slate-200 overflow-hidden hover:border-accent/30 hover:shadow-xl hover:shadow-accent/5 transition-all duration-500">
              <div class="grid md:grid-cols-2 gap-0">
                <!-- Product Image -->
                <div class="relative bg-gradient-to-br from-slate-50 to-slate-100 p-8 flex items-center justify-center min-h-[280px]">
                  {product.image ? (
                    <img width={productImageSizes[product.image]?.width} height={productImageSizes[product.image]?.height} src={product.image} alt={product.name} class="max-h-[220px] w-auto object-contain group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                  ) : (
                    <div class="w-20 h-20 rounded-xl bg-slate-200 border border-slate-300 flex items-center justify-center">
                      <svg class="w-10 h-10 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                      </svg>
                    </div>
                  )}
                </div>
                <!-- Product Info -->
                <div class="p-8 flex flex-col justify-center">
                  <div class="flex items-center gap-3 mb-3">
                    <span class="text-xs font-bold uppercase tracking-wider text-accent bg-accent/10 px-3 py-1.5 rounded-full">
                      {product.series} Series
                    </span>
                    <span class="text-xs text-slate-400">
                      {product.phase === 'single' ? 'Single-phase' : 'Three Phase'}
                    </span>
                  </div>
                  <h3 class="text-2xl font-bold text-slate-900 mb-4">{product.name}</h3>

                  <!-- Features -->
                  <div class="grid grid-cols-2 gap-3 mb-6">
                    {product.features.slice(0, 4).map(feature => (
                      <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center text-accent flex-shrink-0">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={getFeatureIcon(feature)}/>
                          </svg>
                        </div>
                        <span class="text-xs text-slate-600 font-medium leading-tight">{feature}</span>
                      </div>
                    ))}
                  </div>

                  <div class="flex items-center gap-4">
                    <a href="/download-datasheets/" class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-accent/20 hover:bg-accent-dark transition-all">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                      Download Data Sheet
                    </a>
                    <a href={`/our-products/${product.id}/`} class="text-sm font-semibold text-accent hover:text-accent-dark">
                      View Details →
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Three Phase -->
    <section class="section-padding bg-white" aria-labelledby="three-phase-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Commercial
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="three-phase-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Three Phase Hybrid
          </h2>
          <p class="mt-4 text-slate-500">
            For larger homes and <a href="/c-i-solution/" class="text-accent hover:text-accent-dark underline underline-offset-2 font-medium">commercial applications</a> requiring three-phase power. Models from 5 kW to 12 kW.
          </p>
        </div>

        <div class="space-y-8 max-w-5xl mx-auto">
          {threePhase.map((product) => (
            <div class="group bg-white rounded-2xl border border-slate-200 overflow-hidden hover:border-accent/30 hover:shadow-xl hover:shadow-accent/5 transition-all duration-500">
              <div class="grid md:grid-cols-2 gap-0">
                <!-- Product Image -->
                <div class="relative bg-gradient-to-br from-slate-50 to-slate-100 p-8 flex items-center justify-center min-h-[280px]">
                  {product.image ? (
                    <img width={productImageSizes[product.image]?.width} height={productImageSizes[product.image]?.height} src={product.image} alt={product.name} class="max-h-[220px] w-auto object-contain group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                  ) : (
                    <div class="w-20 h-20 rounded-xl bg-slate-200 border border-slate-300 flex items-center justify-center">
                      <svg class="w-10 h-10 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                      </svg>
                    </div>
                  )}
                </div>
                <!-- Product Info -->
                <div class="p-8 flex flex-col justify-center">
                  <div class="flex items-center gap-3 mb-3">
                    <span class="text-xs font-bold uppercase tracking-wider text-accent bg-accent/10 px-3 py-1.5 rounded-full">
                      {product.series} Series
                    </span>
                    <span class="text-xs text-slate-400">
                      {product.phase === 'single' ? 'Single-phase' : 'Three Phase'}
                    </span>
                  </div>
                  <h3 class="text-2xl font-bold text-slate-900 mb-4">{product.name}</h3>

                  <!-- Features -->
                  <div class="grid grid-cols-2 gap-3 mb-6">
                    {product.features.slice(0, 4).map(feature => (
                      <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center text-accent flex-shrink-0">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={getFeatureIcon(feature)}/>
                          </svg>
                        </div>
                        <span class="text-xs text-slate-600 font-medium leading-tight">{feature}</span>
                      </div>
                    ))}
                  </div>

                  <div class="flex items-center gap-4">
                    <a href="/download-datasheets/" class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-accent/20 hover:bg-accent-dark transition-all">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                      Download Data Sheet
                    </a>
                    <a href={`/our-products/${product.id}/`} class="text-sm font-semibold text-accent hover:text-accent-dark">
                      View Details →
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 lg:py-32 bg-brand-500 text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
