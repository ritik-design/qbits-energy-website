---
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import { getEntry } from 'astro:content';
import { products, getProductById, getRelatedProducts, getProductPowerLabel, getProductSeoTitle, getProductSeoDescription, WARRANTY_NOTE } from '../../data/products';
import { productImageSizes } from '../../data/product-images';

export function getStaticPaths() {
  return products.map(p => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const product = getProductById(id!);

if (!product) {
  return Astro.redirect('/404');
}

const isOnGrid = product.category === 'on-grid';
const categoryColor = isOnGrid ? 'brand' : 'accent';
const categoryBg = isOnGrid ? 'bg-brand-50 text-brand-700' : 'bg-accent/10 text-accent-dark';
const categoryLabel = isOnGrid ? 'On-Grid' : 'Hybrid';
const phaseLabel = product.phase === 'single' ? 'Single-Phase' : 'Three-Phase';
const powerLabel = getProductPowerLabel(product);
const typeLabel = `${phaseLabel.toLowerCase()} ${categoryLabel.toLowerCase()}`;
// Sibling models: same category and phase (the EHV family has none; see getRelatedProducts).
const samePhaseSiblings = getRelatedProducts(product, 20).sort((a, b) => a.powerMax - b.powerMax);
// A lone model in its phase (the three-phase hybrid) falls back to the other models of the same type.
const useTypeFallback = samePhaseSiblings.length === 0 && product.id !== 'QB-225-320K-EHV';
const siblings = useTypeFallback
  ? products.filter(p => p.category === product.category && p.id !== product.id).sort((a, b) => a.powerMax - b.powerMax)
  : samePhaseSiblings;
const siblingsHeading = useTypeFallback ? `Other ${categoryLabel.toLowerCase()} models` : `Other ${typeLabel} models`;
const hubUrl = isOnGrid ? '/on-grid-inverter/' : '/hybrid-inverter/';
// "Guides for this model": blog posts mapped in products.ts. Skip any slug that no longer exists.
const guideEntries = (await Promise.all((product.guides ?? []).map((slug) => getEntry('blog', slug)))).filter(Boolean);
// The contact form reads ?subject, ?model, ?message and ?from and prefills the enquiry from them.
const quoteUrl = `/contact-us/?${new URLSearchParams({ subject: 'Product Inquiry', model: product.id, message: `I would like pricing, availability and written warranty terms for the ${product.name}.`, from: `/our-products/${product.id}/` })}#lead-form`;
const documentUrl = `/contact-us/?${new URLSearchParams({ subject: 'Technical Documents', model: product.id, from: `/our-products/${product.id}/` })}#lead-form`;
const heroDimensions = product.image ? productImageSizes[product.image] : undefined;
// 768 px variants of the large hero images, so phones do not download the full-size file.
const HERO_768 = new Set([
  '/homepage-new/1kw.webp', '/homepage-new/3kw.webp', '/homepage-new/5kw.webp', '/homepage-new/10kw.webp',
  '/homepage-new/25kw.webp', '/homepage-new/50kw.webp', '/homepage-new/110kw.webp', '/homepage-new/hybrid.webp',
  '/product-images/product-image-2.webp', '/product-images/product-image-4.webp',
]);
const heroVariant = product.image && HERO_768.has(product.image) ? product.image.replace(/\.webp$/, '-768.webp') : null;
const heroSrcset = heroVariant && heroDimensions
  ? `${heroVariant} 768w, ${product.image} ${heroDimensions.width}w`
  : product.image === '/product-images/image.webp'
    ? '/product-images/image-640.webp 640w, /product-images/image.webp 1024w'
    : undefined;
const heroSizes = heroSrcset ? '(min-width: 1024px) 50vw, 100vw' : undefined;
const datasheetNotes: Record<string, string> = {
  'QB-4.6-6KTLS': 'The linked datasheet lists 4.6, 5 and 6 kW variants. Ask for the exact-model document before selecting other variants named in this family.',
  'QB-6-17KTLC': 'The linked datasheet lists 6, 8, 10, 12, 15 and 17 kW variants. Request the exact-model document before specifying a 5 kW variant.',
  'QB-225-320K-EHV': 'This family’s linked datasheet specifies 800 Vac and a 1500 V maximum DC input. Check the transformer, grid connection and exact model limits; do not treat it as an interchangeable low-voltage rooftop inverter.',
};

const SITE = 'https://qbitsenergy.com';
const productUrl = `${SITE}/our-products/${product.id}/`;
const whatsappText = `I am interested in the ${product.name} (${productUrl})`;
const whatsappUrl = `https://api.whatsapp.com/send?phone=919979192935&text=${encodeURIComponent(whatsappText)}`;

// Spec rows. A row is shown only when this model's own datasheet states it (see products.ts).
const specRows: [string, string | undefined][] = [
  ['Model', product.id],
  ['Series', product.series],
  ['Category', categoryLabel],
  ['Phase', product.phase === 'single' ? 'Single Phase' : 'Three Phase'],
  ['Power Range', `${product.powerMin}-${product.powerMax}${product.powerUnit}`],
  ['Rated Output Power by Variant', product.ratedOutput],
  ['Max Efficiency', product.efficiency],
  ['MPPT', product.mpptLabel],
  ['DC Voltage Range', product.voltageRange],
  ['Max DC Input Current', product.maxInputCurrent],
  ['Grid Voltage Range', product.gridVoltageRange],
  ['AC Frequency', product.frequency],
  ['Operating Temperature', product.operatingTemperature],
  ['Protection Rating', product.protection],
  ['Display', product.display],
  ['Communication', product.communication],
  ['Safety and EMC Standards (as printed on the datasheet)', product.safetyStandard],
  ['Grid-Connection Standards (as printed on the datasheet)', product.gridStandard],
  ['Warranty', product.warranty],
];
const visibleSpecRows = specRows.filter((row): row is [string, string] => Boolean(row[1]));
// Schema properties mirror rows that are visible in the table above.
const schemaSpecLabels = new Set(['Rated Output Power by Variant', 'Max Efficiency', 'MPPT', 'DC Voltage Range', 'Max DC Input Current', 'Grid Voltage Range', 'Operating Temperature', 'Protection Rating']);
const additionalProperty = visibleSpecRows
  .filter(([label]) => schemaSpecLabels.has(label))
  .map(([label, value]) => ({ '@type': 'PropertyValue', name: label, value }));

const warrantyPhrase = 'model-specific written warranty terms available on request';

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: `${product.name} - ${categoryLabel} solar inverter from Qbits Energy. ${product.efficiency} efficiency, ${product.mpptLabel}; ${warrantyPhrase}.`,
  sku: product.id,
  mpn: product.id,
  url: productUrl,
  image: product.image ? `${SITE}${product.image}` : `${SITE}/og-image.webp`,
  brand: { '@type': 'Brand', name: 'Qbits Energy' },
  manufacturer: {
    '@type': 'Organization',
    name: 'Qbits Energy',
    url: SITE,
  },
  category: isOnGrid ? 'On-Grid Solar Inverter' : 'Hybrid Solar Inverter',
  additionalProperty,
  // No `offers` block: pricing is quote-based through the dealer/partner network, not
  // published per-unit. An Offer without a required `price` fails Rich Results validation,
  // so a valid Product with no offers is correct here rather than a fabricated price.
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Products', item: `${SITE}/our-products/` },
    { '@type': 'ListItem', position: 3, name: product.name, item: productUrl },
  ],
};
---

<Layout
  title={getProductSeoTitle(product)}
  description={getProductSeoDescription(product)}
  canonical={`/our-products/${product.id}/`}
  ogImage={`/og/product-${product.id}.webp`}
>
  <HeaderV2 />
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <main id="main-content" class="pt-[104px] lg:pt-[120px]">
    <!-- Breadcrumb -->
    <div class="bg-slate-50 border-b border-slate-100">
      <div class="container-main py-3">
        <nav class="flex items-center gap-2 text-sm text-slate-500">
          <a href="/" class="hover:text-brand-600 transition-colors">Home</a>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <a href="/our-products/" class="hover:text-brand-600 transition-colors">Products</a>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span class="text-slate-900 font-medium">{product.id}</span>
        </nav>
      </div>
    </div>

    <!-- Product Hero -->
    <section class="section-padding bg-white overflow-hidden">
      <div class="container-main">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <!-- Image -->
          <div>
            <div class="aspect-square bg-gradient-to-br from-slate-100 to-slate-200 rounded-2xl flex items-center justify-center relative overflow-hidden">
              {product.image ? (
                <img width={heroDimensions?.width} height={heroDimensions?.height} src={product.image}
                  srcset={heroSrcset}
                  sizes={heroSizes}
                  alt={product.name} class="w-full h-full object-contain" loading="eager" fetchpriority="high" decoding="async" />
              ) : (
                <div class="text-center relative z-10">
                  <div class="w-40 h-40 mx-auto rounded-3xl bg-white shadow-xl flex items-center justify-center">
                    <svg class="w-20 h-20 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d={isOnGrid ? 'M13 10V3L4 14h7v7l9-11h-7z' : 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10'}/>
                    </svg>
                  </div>
                  <p class="mt-6 text-sm text-slate-400 font-mono">{product.id}</p>
                </div>
              )}
            </div>

            <!-- Quick Specs Bar -->
            <div class="grid grid-cols-3 gap-3 mt-6">
              <div class="bg-slate-50 rounded-xl p-4 text-center">
                <p class="text-2xl font-bold text-brand-600">{product.efficiency}</p>
                <p class="text-[10px] text-slate-400 uppercase tracking-wider mt-1">Efficiency</p>
              </div>
              <div class="bg-slate-50 rounded-xl p-4 text-center">
                <p class="text-2xl font-bold text-brand-600">{product.mpptLabel}</p>
                <p class="text-[10px] text-slate-400 uppercase tracking-wider mt-1">MPPT</p>
              </div>
              <div class="bg-slate-50 rounded-xl p-4 text-center">
                <p class="text-2xl font-bold text-brand-600">{product.powerMax}kW</p>
                <p class="text-[10px] text-slate-400 uppercase tracking-wider mt-1">Max Power</p>
              </div>
            </div>
          </div>

          <!-- Info -->
          <div>
            <div class="flex items-center gap-3 mb-4">
              <span class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-bold ${categoryBg}`}>
                {categoryLabel}
              </span>
              <span class="text-xs text-slate-400 font-mono">{product.id}</span>
            </div>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mb-4 leading-tight">{product.name}</h1>
            <p class="text-slate-500 mb-8">{product.series} Series | {product.phase === 'single' ? 'Single Phase' : 'Three Phase'} | {product.powerMin}-{product.powerMax}{product.powerUnit}</p>

            <!-- Features -->
            <div class="space-y-3 mb-8">
              {product.features.map(f => (
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-lg bg-brand-100 flex items-center justify-center text-brand-600 shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  </div>
                  <span class="text-slate-700 text-sm">{f}</span>
                </div>
              ))}
            </div>

            <div class="flex flex-wrap gap-3">
              <a href={quoteUrl} class="btn-primary" data-cta="product_quote" data-model={product.id}>Request a quote for {product.id}</a>
              {product.datasheet && (
                <a href={product.datasheet} target="_blank" rel="noopener noreferrer" data-cta="product_datasheet" data-model={product.id} class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-slate-200 px-8 py-4 text-sm font-semibold text-slate-700 hover:border-brand-300 hover:text-brand-600 transition-all">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                  Download datasheet (PDF)
                </a>
              )}
            </div>
            <p class="mt-4 text-sm text-slate-500">Need other models? See <a href="/download-datasheets/" class="text-brand-600 underline">all Qbits inverter datasheets</a>.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Specifications -->
    <section class="section-padding bg-slate-50" aria-labelledby="specs-heading">
      <div class="container-main">
        <div class="max-w-3xl mx-auto">
          <span class="section-label">
            <span class="w-8 h-px bg-brand-500"></span>
            Technical Data
          </span>
          <h2 id="specs-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-4 mb-10">Technical Specifications</h2>

          <div class="bg-white rounded-2xl shadow-xl shadow-slate-900/5 overflow-hidden">
            <table class="w-full text-sm">
              <tbody class="divide-y divide-slate-100">
                {visibleSpecRows.map(([label, value]) => (
                  <tr class="hover:bg-slate-50/50 transition-colors">
                    <td class="px-6 py-4 font-semibold text-slate-700 w-2/5">{label}</td>
                    <td class="px-6 py-4 text-slate-600">{value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <p class="mt-4 flex items-start gap-2 text-sm text-slate-500">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>{WARRANTY_NOTE}</span>
          </p>
          {datasheetNotes[product.id] && <p class="mt-4 rounded-xl bg-white p-4 text-sm text-slate-600">{datasheetNotes[product.id]}</p>}
          <div class="mt-6 rounded-xl bg-white p-5 text-sm text-slate-600">
            <h3 class="font-semibold text-slate-900">Before specifying this inverter</h3>
            <p class="mt-2">Check the exact variant’s AC connection, MPPT voltage window, input and short-circuit current limits against the array design. Request current certificates, installation instructions, monitoring options and written warranty terms for the quoted model.</p>
            <p class="mt-2">For procurement, include the model, quantity, project location, grid connection and required delivery date in your <a href={quoteUrl} class="text-brand-600 underline">inverter RFQ</a>.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Downloads -->
    {product.datasheet && (
      <section class="py-16 lg:py-20 bg-white" aria-labelledby="downloads-heading">
        <div class="container-main">
          <div class="text-center max-w-2xl mx-auto mb-12">
            <span class="section-label justify-center">
              <span class="w-8 h-px bg-brand-500"></span>
              Downloads
              <span class="w-8 h-px bg-brand-500"></span>
            </span>
            <h2 id="downloads-heading" class="text-3xl font-bold text-slate-900 mt-6">Product Documents</h2>
            <p class="mt-4 text-slate-500">Datasheet for the {product.id} family, or the <a href="/download-datasheets/" class="text-brand-600 underline">full set of Qbits inverter datasheets</a>.</p>
          </div>
          <div class="grid sm:grid-cols-2 gap-6 max-w-2xl mx-auto">
            <a href={product.datasheet} target="_blank" rel="noopener noreferrer" class="group bg-slate-50 rounded-2xl p-8 text-center hover:bg-brand-500 transition-all duration-500">
              <div class="w-14 h-14 mx-auto rounded-xl bg-brand-100 flex items-center justify-center text-brand-600 mb-5 group-hover:bg-white/20 group-hover:text-white transition-all">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-1 group-hover:text-white transition-colors">Datasheet</h3>
              <p class="text-sm text-slate-500 group-hover:text-brand-100 transition-colors">Full technical specifications</p>
            </a>
            <a href={documentUrl} class="group bg-slate-50 rounded-2xl p-8 text-center hover:bg-brand-500 transition-all duration-500">
              <div class="w-14 h-14 mx-auto rounded-xl bg-brand-100 flex items-center justify-center text-brand-600 mb-5 group-hover:bg-white/20 group-hover:text-white transition-all">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-1 group-hover:text-white transition-colors">Manual & Warranty</h3>
              <p class="text-sm text-slate-500 group-hover:text-brand-100 transition-colors">Request installation guide & warranty card</p>
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Other models of the same type, and guides that mention this model -->
    {(siblings.length > 0 || guideEntries.length > 0) && (
      <section class="py-16 lg:py-20 bg-slate-50" aria-label="Other models and guides">
        <div class="container-main">
          <div class={`max-w-4xl mx-auto grid gap-10 ${siblings.length > 0 && guideEntries.length > 0 ? 'md:grid-cols-2' : ''}`}>
            {siblings.length > 0 && (
              <div>
                <h2 class="text-2xl font-bold text-slate-900">{siblingsHeading}</h2>
                <ul class="mt-5 space-y-3 text-sm text-slate-600">
                  {siblings.map(r => (
                    <li>
                      <a href={`/our-products/${r.id}/`} class="font-semibold text-brand-600 underline hover:text-brand-700">{r.name}: {getProductPowerLabel(r)} {r.phase === 'single' ? 'single-phase' : 'three-phase'} {r.category === 'on-grid' ? 'on-grid' : 'hybrid'} inverter</a>
                      <span class="block text-slate-500">{r.mpptLabel}; {r.efficiency.replace(' maximum', '')} max efficiency</span>
                    </li>
                  ))}
                </ul>
                <p class="mt-5 text-sm text-slate-500">Compare every family on the <a href={hubUrl} class="text-brand-600 underline">{isOnGrid ? 'on-grid' : 'hybrid'} inverter range</a> page or in the <a href="/our-products/" class="text-brand-600 underline">full Qbits product list</a>.</p>
              </div>
            )}
            {guideEntries.length > 0 && (
              <div>
                <h2 class="text-2xl font-bold text-slate-900">Guides for this model</h2>
                <ul class="mt-5 space-y-3 text-sm">
                  {guideEntries.map(g => (
                    <li><a href={`/blog/${g!.id}/`} class="font-semibold text-brand-600 underline hover:text-brand-700">{g!.data.title}</a></li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      </section>
    )}

    <!-- CTA -->
    <section class="py-24 lg:py-32 bg-slate-950 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-brand-500/10 via-transparent to-accent/10"></div>
      <div class="container-main relative text-center max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">Ready to Order?</h2>
        <p class="text-lg text-slate-400 mb-10">Get in touch with our sales team for pricing, availability, and delivery information.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href={quoteUrl} class="btn-primary" data-cta="product_quote_bottom" data-model={product.id}>Request a quote for {product.id}</a>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-outline" data-cta="product_whatsapp" data-model={product.id}>WhatsApp about the {product.id}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
