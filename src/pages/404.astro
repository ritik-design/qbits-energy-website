---
import Layout from '../layouts/Layout.astro';
import HeaderV2 from '../components/HeaderV2.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="404 - Page Not Found | Qbits Energy"
  description="The page you are looking for could not be found. Explore our solar inverter products or contact us for assistance."
>
  <HeaderV2 />

  <main class="pt-[104px] lg:pt-[120px]">
    <section class="section-padding bg-white">
      <div class="container-main text-center max-w-xl">
        <div class="w-24 h-24 mx-auto rounded-full bg-brand-50 flex items-center justify-center text-brand-500 mb-6">
          <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>

        <h1 class="text-6xl sm:text-8xl font-extrabold text-brand-500 mb-4">404</h1>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4">Page Not Found</h2>
        <p class="text-slate-500 mb-8">The page you are looking for might have been moved, deleted, or does not exist.</p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/" class="btn-primary">Go to Homepage</a>
          <a href="/our-products/" class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-slate-200 px-8 py-4 text-sm font-semibold text-slate-700 hover:border-brand-300 hover:text-brand-600 transition-all">Explore Products</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
