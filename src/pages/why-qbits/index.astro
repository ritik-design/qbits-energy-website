---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

const reasons = [
  { title: '12 Year Warranty', desc: 'Industry-leading warranty coverage with pan-India service support and rapid replacement commitment.', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
  { title: '98% Efficiency', desc: 'Maximum power conversion efficiency ensures you get the most energy from every ray of sunlight.', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
  { title: 'AI Monitoring', desc: 'Real-time AI-powered monitoring via WhatsApp, mobile app, and web dashboard.', icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
  { title: 'Built for India', desc: 'Engineered specifically for Indian grid conditions, extreme temperatures, and voltage fluctuations.', icon: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064' },
  { title: 'IP66 Protection', desc: 'Superior weather protection with IP66-rated enclosures for dust and water resistance.', icon: 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z' },
  { title: 'German IGBT', desc: 'Premium German IGBT technology for reliable power conversion and long operational life.', icon: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z' },
];
---

<Layout
  title="Why Qbits | Qbits Energy"
  description="Discover why Qbits is India's trusted solar inverter brand. 12-year warranty, 98% efficiency, AI monitoring, IP66 protection, and built for Indian conditions."
  canonical="/why-qbits/"
>
  <Header />

  <main>
    <PageHeader
      label="Why Choose Us"
      title="The Qbits"
      highlight="Advantage"
      description="When you choose Qbits, you choose reliability, innovation, and a partner committed to your solar success."
    />

    <section class="section-padding bg-white" aria-labelledby="reasons-heading">
      <div class="container-main">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {reasons.map((r, i) => (
            <div class="card group hover:border-brand-200">
              <div class="w-14 h-14 rounded-xl bg-brand-50 flex items-center justify-center text-brand-600 mb-5 group-hover:bg-brand-500 group-hover:text-white transition-colors">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={r.icon}/></svg>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">{r.title}</h3>
              <p class="text-slate-500 text-sm leading-relaxed">{r.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section-padding bg-brand-500 text-white">
      <div class="container-main text-center max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold mb-6">Ready to make the switch?</h2>
        <p class="text-lg text-brand-100 mb-8">Join thousands of satisfied customers who trust Qbits for their solar energy needs.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/our-products/" class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-brand-600 hover:bg-brand-50 transition-colors">Explore Products</a>
          <a href="/contact-us/" class="inline-flex items-center gap-2 rounded-lg border-2 border-white px-6 py-3 text-sm font-semibold text-white hover:bg-white/10 transition-colors">Contact Us</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
