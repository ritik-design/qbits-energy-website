---
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

const posts = [
  {
    title: 'Understanding MPPT Technology in Modern Solar Inverters',
    excerpt: 'Maximum Power Point Tracking is the key to maximizing solar energy harvest. Learn how advanced MPPT algorithms improve system efficiency by up to 30% compared to older technologies.',
    category: 'Technology',
    date: 'May 28, 2026',
    slug: 'understanding-mppt-technology',
    readTime: '6 min',
    featured: true,
  },
  {
    title: 'Inverter Overheating: Causes and Prevention',
    excerpt: 'High temperatures can significantly impact inverter performance and lifespan. Discover best practices for thermal management in Indian conditions.',
    category: 'Maintenance',
    date: 'May 15, 2026',
    slug: 'inverter-overheating',
    readTime: '5 min',
  },
  {
    title: 'Choosing Between On-Grid and Hybrid Inverters',
    excerpt: 'Not sure which inverter type suits your needs? We break down the differences, benefits, and ideal use cases for each system type.',
    category: 'Buying Guide',
    date: 'May 02, 2026',
    slug: 'on-grid-vs-hybrid',
    readTime: '8 min',
  },
  {
    title: 'How to Size Your Solar Inverter Correctly',
    excerpt: 'Proper inverter sizing is crucial for system performance. Learn the key factors to consider when selecting inverter capacity for your installation.',
    category: 'Guide',
    date: 'April 20, 2026',
    slug: 'sizing-solar-inverter',
    readTime: '7 min',
  },
  {
    title: 'The Future of Solar: AI-Powered Monitoring',
    excerpt: 'Artificial intelligence is transforming solar energy management. Explore how AI monitoring improves efficiency and reduces downtime.',
    category: 'Technology',
    date: 'April 10, 2026',
    slug: 'ai-solar-monitoring',
    readTime: '5 min',
  },
  {
    title: 'Understanding Solar Inverter Warranties',
    excerpt: 'What does a 12-year warranty really cover? We explain inverter warranties, what to look for, and how to protect your investment.',
    category: 'Guide',
    date: 'March 28, 2026',
    slug: 'inverter-warranties',
    readTime: '6 min',
  },
];

const categories = [...new Set(posts.map(p => p.category))];
const featuredPost = posts.find(p => p.featured);
const regularPosts = posts.filter(p => !p.featured);
---

<Layout
  title="Blog | Qbits Energy"
  description="Latest insights on solar technology, inverter maintenance, buying guides, and industry trends from Qbits Energy."
  canonical="/blog/"
>
  <HeaderV2 />

  <main>
    <PageHeader
      label="Resources"
      title="Solar Knowledge"
      highlight="Hub"
      description="Stay updated with the latest in solar technology, maintenance tips, and industry insights."
    />

    <!-- Featured Post -->
    {featuredPost && (
      <section class="section-padding bg-white" aria-labelledby="featured-heading">
        <div class="container-main">
          <div class="grid lg:grid-cols-2 gap-10 items-center">
            <div class="relative rounded-2xl overflow-hidden bg-gradient-to-br from-brand-500 to-brand-700 aspect-[4/3] flex items-center justify-center">
              <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 30px 30px;"></div>
              <div class="text-center relative z-10">
                <div class="w-20 h-20 mx-auto rounded-2xl bg-white/20 backdrop-blur flex items-center justify-center">
                  <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </div>
              </div>
            </div>
            <div>
              <div class="flex items-center gap-3 text-sm mb-4">
                <span class="text-brand-600 font-bold uppercase tracking-wider text-xs bg-brand-50 px-3 py-1 rounded-full">{featuredPost.category}</span>
                <span class="text-slate-400">{featuredPost.date}</span>
                <span class="text-slate-400">{featuredPost.readTime} read</span>
              </div>
              <h2 id="featured-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4 leading-tight">
                <a href={`/blog/${featuredPost.slug}/`} class="hover:text-brand-600 transition-colors">{featuredPost.title}</a>
              </h2>
              <p class="text-slate-500 leading-relaxed mb-6">{featuredPost.excerpt}</p>
              <a href={`/blog/${featuredPost.slug}/`} class="inline-flex items-center gap-2 text-brand-600 hover:text-brand-700 font-semibold">
                Read Article
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- All Posts -->
    <section class="section-padding bg-slate-50" aria-labelledby="posts-heading">
      <div class="container-main">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 mb-12">
          <div>
            <span class="section-label">
              <span class="w-8 h-px bg-brand-500"></span>
              All Articles
            </span>
            <h2 id="posts-heading" class="text-3xl font-bold text-slate-900 mt-4">Latest Posts</h2>
          </div>
          <div class="flex flex-wrap gap-2">
            <button class="category-btn px-4 py-2 rounded-full text-sm font-medium bg-brand-500 text-white shadow-lg shadow-brand-500/20" data-category="all">All</button>
            {categories.map(cat => (
              <button class="category-btn px-4 py-2 rounded-full text-sm font-medium border border-slate-200 text-slate-600 hover:border-brand-300 hover:bg-brand-50 transition-colors" data-category={cat.toLowerCase().replace(/\s+/g, '-')} >{cat}</button>
            ))}
          </div>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {regularPosts.map(post => (
            <article class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:shadow-brand-500/5 transition-all duration-500 group blog-card" data-category={post.category.toLowerCase().replace(/\s+/g, '-')}>
              <div class="h-48 bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center relative overflow-hidden">
                <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, #049D65 1px, transparent 0); background-size: 20px 20px;"></div>
                <div class="w-16 h-16 rounded-2xl bg-white/80 backdrop-blur flex items-center justify-center shadow-sm relative z-10">
                  <svg class="w-8 h-8 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                </div>
              </div>
              <div class="p-6">
                <div class="flex items-center gap-3 text-xs text-slate-400 mb-3">
                  <span class="text-brand-600 font-bold uppercase tracking-wider text-[10px] bg-brand-50 px-2 py-0.5 rounded-full">{post.category}</span>
                  <span>{post.date}</span>
                  <span>{post.readTime}</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-brand-600 transition-colors leading-snug">
                  <a href={`/blog/${post.slug}/`}>{post.title}</a>
                </h3>
                <p class="text-sm text-slate-500 line-clamp-2">{post.excerpt}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 lg:py-32 bg-brand-500 text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="container-main relative text-center max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold mb-6">Have Questions About Solar?</h2>
        <p class="text-lg text-brand-100 mb-10">Our team of solar experts is ready to help you with product selection, system design, and installation guidance.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/contact-us/" class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-8 py-4 text-sm font-semibold text-brand-600 shadow-lg hover:bg-brand-50 transition-all">Contact Us</a>
          <a href="/our-products/" class="btn-outline">Explore Products</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const btns = document.querySelectorAll('.category-btn');
  const cards = document.querySelectorAll('.blog-card');

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-category');
      btns.forEach(b => {
        b.classList.remove('bg-brand-500', 'text-white', 'shadow-lg');
        b.classList.add('text-slate-600');
      });
      btn.classList.add('bg-brand-500', 'text-white', 'shadow-lg');
      btn.classList.remove('text-slate-600');

      cards.forEach(card => {
        const cardCat = card.getAttribute('data-category');
        card.classList.toggle('hidden', cat !== 'all' && cardCat !== cat);
      });
    });
  });
</script>

