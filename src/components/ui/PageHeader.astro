---
export interface Props {
  label?: string;
  title: string;
  highlight?: string;
  description?: string;
  bgImage?: string;
  centered?: boolean;
}

const { label, title, highlight, description, bgImage, centered = false } = Astro.props;
---

<section class="relative pt-28 pb-16 lg:pt-36 lg:pb-24 overflow-hidden bg-slate-950" aria-labelledby="page-heading">
  {bgImage && (
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/90 to-slate-950/70 z-10"></div>
      <img width="1920" height="1080" src={bgImage} alt="" class="w-full h-full object-cover opacity-40" loading="eager" />
    </div>
  )}

  <div class={`container-main relative z-20 ${centered ? 'text-center' : ''}`}>
    {label && (
      <span class={`section-label text-brand-400 ${centered ? 'justify-center' : ''}`}>
        <span class="w-8 h-px bg-brand-500"></span>
        {label}
      </span>
    )}
    <h1 id="page-heading" class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mt-6 leading-tight">
      {title}
      {highlight && <span class="text-gradient">{` ${highlight}`}</span>}
    </h1>
    {description && (
      <p class={`mt-4 text-lg text-slate-400 leading-relaxed ${centered ? 'mx-auto max-w-2xl' : 'max-w-2xl'}`}>{description}</p>
    )}
  </div>
</section>
