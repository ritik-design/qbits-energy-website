<script is:inline>
  (() => {
    const SUCCESS_MESSAGE = 'Thank you! Your partner application has been submitted. We will contact you within 2-3 business days.';
    const ERROR_MESSAGE = 'Sorry, we couldn\'t submit your application. Please call +91 99791 92935 or email service@qbitsenergy.com.';
    const SUBMIT_TIMEOUT_MS = 20000;

    const form = document.getElementById('partner-form');
    const frame = document.getElementById('partner-form-frame');
    const status = document.getElementById('partner-status');
    const btn = document.getElementById('partner-submit');
    const labelDefault = btn.querySelector('[data-label-default]');
    const labelSending = btn.querySelector('[data-label-sending]');

    const setSending = (sending) => {
      btn.disabled = sending;
      labelDefault.classList.toggle('hidden', sending);
      labelSending.classList.toggle('hidden', !sending);
    };

    const showStatus = (msg, ok) => {
      status.classList.remove('hidden');
      status.textContent = msg;
      status.className = 'text-sm mt-4 ' + (ok ? 'text-emerald-600' : 'text-rose-600');
      if (ok) status.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };

    let awaitingResponse = false;
    let submitTimeout = null;

    form.addEventListener('submit', (e) => {
      if (!form.checkValidity()) {
        e.preventDefault();
        form.reportValidity();
        return;
      }

      // Honeypot - silently succeed for bots, never actually submit.
      if ((form.elements.namedItem('website2') || {}).value) {
        e.preventDefault();
        form.reset();
        showStatus(SUCCESS_MESSAGE, true);
        return;
      }

      form.elements.namedItem('_subject').value =
        'New Qbits Channel Partner Application: ' + (form.elements.namedItem('companyName').value || 'Unknown');
      form.elements.namedItem('page').value = location.pathname;
      form.elements.namedItem('submittedAt').value = new Date().toISOString();

      if (typeof window.gtag === 'function') {
        window.gtag('event', 'form_submit', {
          form_id: 'partner-form',
          subject: 'Channel Partner Application',
        });
      }

      // Sync to Odoo CRM in parallel (text fields only) — non-blocking.
      const odooData = {
        source: 'partner-form',
        page: location.pathname,
        submittedAt: new Date().toISOString(),
      };
      for (const [key, value] of new FormData(form).entries()) {
        if (key === 'website2' || key.startsWith('_') || typeof value !== 'string') continue;
        odooData[key] = value.trim();
      }
      fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(odooData),
      }).catch((err) => console.error('CRM sync failed:', err));

      // Not calling e.preventDefault() here — the form submits natively into the
      // hidden iframe below. FormSubmit's AJAX/fetch endpoint silently drops file
      // attachments, so a genuine multipart POST is the only way the uploaded
      // GST/PAN document actually gets delivered.
      awaitingResponse = true;
      setSending(true);
      clearTimeout(submitTimeout);
      submitTimeout = setTimeout(() => {
        if (!awaitingResponse) return;
        awaitingResponse = false;
        setSending(false);
        showStatus(ERROR_MESSAGE, false);
      }, SUBMIT_TIMEOUT_MS);
    });

    frame.addEventListener('load', () => {
      if (!awaitingResponse) return; // ignore the initial blank-frame load
      awaitingResponse = false;
      clearTimeout(submitTimeout);
      setSending(false);
      form.reset();
      showStatus(SUCCESS_MESSAGE, true);
    });
  })();
</script>
