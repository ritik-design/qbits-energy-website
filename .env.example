# Set in Cloudflare Pages dashboard → Settings → Environment Variables.
# These are read by the Cloudflare Pages Function at runtime, NOT inlined into the build.

# === Lead capture ===
# Apps Script Web App URL (must end in /exec). When unset, forms fall back to mailto.
# See google-apps-script/README.md.
GAS_ENDPOINT=

# Shared token appended server-side to every form POST; Apps Script validates it.
# Optional but recommended. Set the same value as the FORM_TOKEN script property in Apps Script.
FORM_TOKEN=

# === Analytics ===
# GTM container ID, e.g. GTM-XXXXXXX. When unset, GTM snippet does not render.
PUBLIC_GTM_ID=

# === Indexing ===
# Set to "true" on preview/staging deployments (e.g. *.pages.dev) to keep them out of Google.
# Leave unset/blank on production qbitsenergy.com so the site is crawlable.
PUBLIC_ROBOTS_NOINDEX=
