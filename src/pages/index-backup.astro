---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import AboutSection from '../components/AboutSection.astro';
import FeaturesGrid from '../components/FeaturesGrid.astro';
import ProductsSection from '../components/ProductsSection.astro';
import EventsSection from '../components/EventsSection.astro';
import LogosSection from '../components/LogosSection.astro';
import ClientFeedback from '../components/ClientFeedback.astro';
import SmartFeatures from '../components/SmartFeatures.astro';
import MadeForIndia from '../components/MadeForIndia.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout
  title="Qbits Energy | Solar Inverter Manufacturer India"
  description="India's leading AI-powered solar inverter brand. On-grid and hybrid inverters with smart monitoring, 12-year warranty, and 98% efficiency. BIS & IEC certified."
  canonical="/"
>
  <Header />

  <main>
    <HeroSection />
    <AboutSection />
    <FeaturesGrid />
    <ProductsSection />
    <EventsSection />
    <LogosSection />
    <ClientFeedback />
    <SmartFeatures />
    <MadeForIndia />
    <CTASection />
  </main>

  <Footer />
</Layout>
