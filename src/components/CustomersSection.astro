---
const partners = [
  { name: 'Amrit Green Energy Pvt. Ltd.', image: '/images/partner-1.webp' },
  { name: 'Partner 2', image: '/images/partner-2.webp' },
  { name: 'Partner 3', image: '/images/partner-1.webp' },
  { name: 'Partner 4', image: '/images/partner-2.webp' },
  { name: 'Partner 5', image: '/images/partner-1.webp' },
  { name: 'Partner 6', image: '/images/partner-2.webp' },
  { name: 'Partner 7', image: '/images/partner-1.webp' },
  { name: 'Partner 8', image: '/images/partner-2.webp' },
];
---

<section class="section-padding bg-slate-50" aria-labelledby="customers-heading">
  <div class="container-main">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="section-label">Strong Connection</span>
      <h2 id="customers-heading" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mt-4">On Customers</h2>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
      {partners.map((partner) => (
        <div class="bg-white rounded-xl border border-slate-200 p-6 flex items-center justify-center h-24 hover:shadow-md transition-shadow">
          <div class="text-center">
            <p class="text-xs font-semibold text-slate-500">{partner.name}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
