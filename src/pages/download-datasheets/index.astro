---
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

const onGridDocs = [
  {
    name: '1.5/2.0/2.7/3.0/3.3/3.6/4.0 KTS',
    desc: 'Single Phase & Single MPPT',
    link: '/datasheets/products/QB_Data-Sheet_2.0-4.0-kw_1MPPT_1Phs.pdf',
  },
  {
    name: 'QB-4/5/6 KTLD',
    desc: 'Single Phase & Dual MPPT',
    link: '/datasheets/products/QB_Data-Sheet_4.0-6.0-kw_2MPPT_1Phs.pdf',
  },
  {
    name: 'QB-4.6/5/6 KTLS',
    desc: 'Single Phase & Single MPPT',
    link: '/datasheets/products/QB_Data-Sheet_4.6-6.0-kw_1MPPT_1Phs.pdf',
  },
  {
    name: 'QB-6/8/10/12/15/17 KTLC',
    desc: 'Three Phase & Dual MPPT',
    link: '/datasheets/products/QB_Data-Sheet_6.0-17.0-kw_2MPPT_3Phs.pdf',
  },
  {
    name: 'QB-20/23/25/28/30 KTLC',
    desc: 'Three Phase & Dual MPPT',
    link: '/datasheets/products/QB_Data-Sheet_20.0-30.0-kw_3Phs.pdf',
  },
  {
    name: 'QB-30/33/36/40 KTLC-Pro',
    desc: 'Three Phase & Multi MPPT',
    link: '/datasheets/products/QB_Data-Sheet_30.0-40.0-kw_3Phs.pdf',
  },
  {
    name: 'QB-40/45/50 KTLC-Plus',
    desc: 'Three Phase & Multi MPPT',
    link: '/datasheets/products/QB_Data-Sheet_40.0-50.0-kw_3Phs.pdf',
  },
  {
    name: 'QB-50/60 KTLC',
    desc: 'Three Phase & Multi MPPT',
    link: '/datasheets/products/QB_Data-Sheet_50.0-60.0-kw_3Phs.pdf',
  },
  {
    name: 'QB-70/75/80/90/100/110 KTLC-Pro',
    desc: 'Three Phase & Multi MPPT',
    link: '/datasheets/products/QB_Data-Sheet_70.0-100.0-kw_3Phs.pdf',
  },
  {
    name: 'QB-80/90/100/110/125 KTLC',
    desc: 'Three Phase & Multi MPPT',
    link: '/datasheets/products/QB_Data-Sheet_80.0-125.0-kw_3Phs.pdf',
  },
  {
    name: 'QB-225/320 K-EHV',
    desc: 'Three Phase & Multi MPPT (Utility-Scale)',
    link: '/datasheets/products/QB_Data-Sheet_225.0-320.0-kw_3Phs_Utility-Scale.pdf',
  },
];

const hybridDocs = [
  {
    name: 'QBH-3KS/3K6S/4KS/4K6S/5KS/6KS48P',
    desc: 'Single Phase',
    link: '/datasheets/products/Qbits-Hybride-Inverter-Catalogue-1.pdf',
  },
  {
    name: 'QBH-7KS/7K6S/8KS48P',
    desc: 'Single Phase',
    link: '/datasheets/products/Qbits-Hybride-Inverter-Catalogue-2.pdf',
  },
  {
    name: 'QBH-5/6/7/8/10/12KS48P3',
    desc: 'Three Phase',
    link: '/datasheets/products/Qbits-Hybride-Inverter-Catalogue-3.pdf',
  },
];
---

<Layout
  title="Download Datasheets | Qbits Energy"
  description="Download product datasheets, manuals, warranty information, and certificates for all Qbits solar inverters."
  canonical="/download-datasheets/"
>
  <HeaderV2 />

  <main id="main-content">
    <PageHeader
      label="Resources"
      title="Download"
      highlight="Datasheets"
      description="Access product datasheets, manuals, warranty documents, and certifications for all Qbits inverters."
    />

    <!-- Soft email opt-in CTA - bundle all datasheets to your inbox -->
    <section class="bg-gradient-to-br from-brand-600 via-brand-700 to-slate-900 py-12 lg:py-16 text-white relative overflow-hidden" aria-labelledby="bundle-heading">
      <div class="absolute -top-32 right-1/4 w-96 h-96 bg-white/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="container-main relative grid lg:grid-cols-[1fr_minmax(360px,460px)] gap-8 items-center">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full bg-white/10 ring-1 ring-white/20 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-brand-100">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-300 animate-pulse"></span>
            EPC / Dealer bundle
          </span>
          <h2 id="bundle-heading" class="mt-4 text-2xl sm:text-3xl font-bold leading-tight">
            Need every datasheet, manual, and certificate in one go?
          </h2>
          <p class="mt-3 text-sm text-brand-100 leading-relaxed max-w-xl">
            Give us your email and we'll send the full Qbits inverter bundle (PDFs + datasheets + <a href="/blog/solar-inverter-certifications/" class="underline hover:text-white">IEC/BIS certs</a>) to your inbox within minutes. Use it for <a href="/blog/how-to-evaluate-solar-epc-bids/" class="underline hover:text-white">EPC bids</a>, BoQ specs, or <a href="/glossary/net-metering/" class="underline hover:text-white">net-metering</a> paperwork.
          </p>
        </div>
        <form id="datasheet-bundle-form" class="bg-white/10 ring-1 ring-white/20 backdrop-blur-sm rounded-2xl p-5 sm:p-6 space-y-3" action="#" method="post">
          <div>
            <label for="db-name" class="block text-[10px] font-bold uppercase tracking-wider text-brand-200 mb-1">Name</label>
            <input type="text" id="db-name" name="name" required maxlength="80" autocomplete="name" class="w-full rounded-lg bg-white/95 text-slate-900 placeholder:text-slate-400 border-0 px-3 py-2.5 text-sm focus:ring-2 focus:ring-brand-300 outline-none" placeholder="Your name" />
          </div>
          <div>
            <label for="db-email" class="block text-[10px] font-bold uppercase tracking-wider text-brand-200 mb-1">Work email</label>
            <input type="email" id="db-email" name="email" required maxlength="120" autocomplete="email" class="w-full rounded-lg bg-white/95 text-slate-900 placeholder:text-slate-400 border-0 px-3 py-2.5 text-sm focus:ring-2 focus:ring-brand-300 outline-none" placeholder="you@company.com" />
          </div>
          <div>
            <label for="db-phone" class="block text-[10px] font-bold uppercase tracking-wider text-brand-200 mb-1">Mobile number</label>
            <input type="tel" id="db-phone" name="phone" required maxlength="20" inputmode="tel" pattern="[0-9+\-\s()]{10,20}" autocomplete="tel" class="w-full rounded-lg bg-white/95 text-slate-900 placeholder:text-slate-400 border-0 px-3 py-2.5 text-sm focus:ring-2 focus:ring-brand-300 outline-none" placeholder="+91 98765 43210" />
          </div>
          <div>
            <label for="db-company" class="block text-[10px] font-bold uppercase tracking-wider text-brand-200 mb-1">Company name</label>
            <input type="text" id="db-company" name="companyName" required maxlength="120" autocomplete="organization" class="w-full rounded-lg bg-white/95 text-slate-900 placeholder:text-slate-400 border-0 px-3 py-2.5 text-sm focus:ring-2 focus:ring-brand-300 outline-none" placeholder="Your company" />
          </div>
          <div aria-hidden="true" style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden">
            <label>Don't fill: <input type="text" id="db-website" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <input type="hidden" name="subject" value="Datasheet bundle request" />
          <button type="submit" id="db-submit" class="w-full rounded-lg bg-white hover:bg-brand-50 text-brand-700 transition-colors px-4 py-3 text-sm font-bold">
            <span data-db-default>Send me the bundle</span>
            <span data-db-sending class="hidden">Sending…</span>
          </button>
          <p id="db-status" class="text-xs hidden" role="status" aria-live="polite"></p>
          <p class="text-[10px] text-brand-100/80 leading-relaxed">
            Or scroll down to grab individual PDFs anonymously. By submitting you agree to our <a href="/privacy-policy/" class="underline hover:text-white">Privacy Policy</a>.
          </p>
        </form>
      </div>
    </section>

    <script is:inline>
      (() => {
        const ENDPOINT = '/api/datasheet-bundle';
        const SUCCESS_MESSAGE = 'Thanks! Check your inbox — the catalogue is on its way.';
        const ERROR_MESSAGE = 'Couldn\u2019t send your request. Please email service@qbitsenergy.com.';

        const form = document.getElementById('datasheet-bundle-form');
        if (!form) return;
        const status = document.getElementById('db-status');
        const btn = document.getElementById('db-submit');
        const labelDefault = btn.querySelector('[data-db-default]');
        const labelSending = btn.querySelector('[data-db-sending]');

        const setSending = (s) => {
          btn.disabled = s;
          labelDefault.classList.toggle('hidden', s);
          labelSending.classList.toggle('hidden', !s);
        };
        const showStatus = (msg, ok) => {
          status.classList.remove('hidden');
          status.textContent = msg;
          status.className = 'text-xs ' + (ok ? 'text-emerald-200' : 'text-rose-200');
        };

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!form.checkValidity()) {
            form.reportValidity();
            return;
          }
          if ((form.elements.namedItem('website') || {}).value) {
            form.reset();
            showStatus(SUCCESS_MESSAGE, true);
            return;
          }

          const fd = new FormData(form);
          const data = {};
          for (const [k, v] of fd.entries()) {
            if (k === 'website') continue;
            if (typeof v === 'string') data[k] = v.trim();
          }
          data.source = 'datasheet-bundle';
          data.page = location.pathname;
          data.submittedAt = new Date().toISOString();

          if (typeof window.gtag === 'function') {
            window.gtag('event', 'generate_lead', { form_id: 'datasheet-bundle-form' });
          }

          // Sync to Odoo CRM in parallel — non-blocking, doesn't affect the email-based UX below.
          fetch('/api/lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          }).catch((err) => console.error('CRM sync failed:', err));

          setSending(true);
          try {
            const res = await fetch(ENDPOINT, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
              },
              body: JSON.stringify(data),
            });
            const result = await res.json().catch(() => ({}));
            if (result.success === 'true' || result.success === true) {
              form.reset();
              showStatus(SUCCESS_MESSAGE, true);
            } else {
              throw new Error(result.message || 'Submission failed');
            }
          } catch (err) {
            console.error('Datasheet bundle submission failed:', err);
            showStatus(ERROR_MESSAGE, false);
          } finally {
            setSending(false);
          }
        });
      })();
    </script>

    <!-- Doc Types -->
    <section class="section-padding bg-white" aria-labelledby="doctypes-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Resources
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="doctypes-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Available Documents
          </h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-4xl mx-auto">
          {[
            { name: 'Datasheet', desc: 'Technical specifications and performance data' },
            { name: 'User Manual', desc: 'Installation and operation instructions' },
            { name: 'Warranty', desc: 'Warranty terms and claim procedures' },
            { name: 'Certificates', desc: 'BIS, IEC, and ISO certifications' },
          ].map(d => (
            <div class="bg-slate-50 rounded-2xl p-8 text-center">
              <div class="w-14 h-14 mx-auto rounded-xl bg-brand-100 flex items-center justify-center text-brand-600 mb-5">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">{d.name}</h3>
              <p class="text-sm text-slate-500">{d.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- On-Grid Datasheets -->
    <section class="section-padding bg-slate-50" aria-labelledby="ongrid-downloads-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            On-Grid Inverters
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="ongrid-downloads-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Qbits On-Grid Datasheets
          </h2>
        </div>

        <div class="max-w-5xl mx-auto">
          <div class="bg-white rounded-2xl shadow-xl shadow-slate-900/5 overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead class="bg-slate-950 text-white">
                  <tr>
                    <th class="text-left px-6 py-4 font-semibold">Product Name</th>
                    <th class="text-left px-6 py-4 font-semibold">Description</th>
                    <th class="text-left px-6 py-4 font-semibold">Download</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {onGridDocs.map((doc) => (
                    <tr class="hover:bg-brand-50/50 transition-colors">
                      <td class="px-6 py-5 font-medium text-slate-900">{doc.name}</td>
                      <td class="px-6 py-5 text-slate-500">{doc.desc}</td>
                      <td class="px-6 py-5">
                        <a href={doc.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-brand-600 hover:text-brand-700 font-medium text-xs">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                          Datasheet
                        </a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Hybrid Datasheets -->
    <section class="section-padding bg-white" aria-labelledby="hybrid-downloads-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Hybrid Inverters
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="hybrid-downloads-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Qbits Hybrid Datasheets
          </h2>
        </div>

        <div class="max-w-5xl mx-auto">
          <div class="bg-white rounded-2xl shadow-xl shadow-slate-900/5 overflow-hidden border border-slate-200">
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead class="bg-slate-950 text-white">
                  <tr>
                    <th class="text-left px-6 py-4 font-semibold">Product Name</th>
                    <th class="text-left px-6 py-4 font-semibold">Description</th>
                    <th class="text-left px-6 py-4 font-semibold">Download</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {hybridDocs.map((doc) => (
                    <tr class="hover:bg-accent/5 transition-colors">
                      <td class="px-6 py-5 font-medium text-slate-900">{doc.name}</td>
                      <td class="px-6 py-5 text-slate-500">{doc.desc}</td>
                      <td class="px-6 py-5">
                        <a href={doc.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-accent hover:text-accent-dark font-medium text-xs">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                          Datasheet
                        </a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 lg:py-32 bg-slate-950 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-brand-500/10 via-transparent to-accent/10"></div>
      <div class="container-main relative text-center max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">Can't Find What You Need?</h2>
        <p class="text-lg text-slate-400 mb-10">Contact our support team or browse our <a href="/authorized-service-partners/" class="underline hover:text-white">authorized service partners</a> for additional documentation or technical assistance.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/contact-us/" class="btn-primary">Contact Support</a>
          <a href="https://wa.me/919979192935" target="_blank" rel="noopener noreferrer" class="btn-outline">WhatsApp Us</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
