---
import { indiaStates } from '../../data/indiaStates';

// Geo names come from the boundary dataset; `label` is what we show on the site.
const network: Record<string, { label: string; centers: string[]; partners: number }> = {
  'Maharashtra': { label: 'Maharashtra', centers: ['Mumbai', 'Pune', 'Nagpur', 'Nashik', 'Aurangabad'], partners: 240 },
  'Gujarat': { label: 'Gujarat', centers: ['Surat', 'Ahmedabad', 'Vadodara', 'Rajkot'], partners: 225 },
  'Uttar Pradesh': { label: 'Uttar Pradesh', centers: ['Lucknow', 'Kanpur', 'Agra', 'Varanasi', 'Noida'], partners: 195 },
  'Rajasthan': { label: 'Rajasthan', centers: ['Jaipur', 'Jodhpur', 'Udaipur'], partners: 165 },
  'Madhya Pradesh': { label: 'Madhya Pradesh', centers: ['Indore', 'Bhopal', 'Gwalior'], partners: 140 },
  'Karnataka': { label: 'Karnataka', centers: ['Bengaluru', 'Mysuru', 'Hubballi', 'Mangaluru'], partners: 135 },
  'Tamil Nadu': { label: 'Tamil Nadu', centers: ['Chennai', 'Coimbatore', 'Madurai', 'Salem'], partners: 130 },
  'Andhra Pradesh': { label: 'Andhra Pradesh', centers: ['Visakhapatnam', 'Vijayawada', 'Guntur'], partners: 105 },
  'Telangana': { label: 'Telangana', centers: ['Hyderabad', 'Warangal'], partners: 95 },
  'Haryana': { label: 'Haryana', centers: ['Gurugram', 'Faridabad', 'Panipat'], partners: 90 },
  'Punjab': { label: 'Punjab', centers: ['Ludhiana', 'Amritsar', 'Jalandhar'], partners: 85 },
  'Delhi': { label: 'Delhi NCR', centers: ['New Delhi'], partners: 80 },
  'West Bengal': { label: 'West Bengal', centers: ['Kolkata', 'Siliguri', 'Durgapur'], partners: 75 },
  'Kerala': { label: 'Kerala', centers: ['Kochi', 'Thiruvananthapuram', 'Kozhikode'], partners: 70 },
  'Bihar': { label: 'Bihar', centers: ['Patna', 'Muzaffarpur'], partners: 65 },
  'Orissa': { label: 'Odisha', centers: ['Bhubaneswar', 'Cuttack'], partners: 55 },
  'Chhattisgarh': { label: 'Chhattisgarh', centers: ['Raipur', 'Bhilai'], partners: 45 },
  'Jharkhand': { label: 'Jharkhand', centers: ['Ranchi', 'Jamshedpur'], partners: 40 },
  'Uttaranchal': { label: 'Uttarakhand', centers: ['Dehradun', 'Haldwani'], partners: 35 },
  'Assam': { label: 'Assam', centers: ['Guwahati', 'Silchar'], partners: 30 },
  'Himachal Pradesh': { label: 'Himachal Pradesh', centers: ['Shimla', 'Baddi'], partners: 25 },
  'Jammu and Kashmir': { label: 'Jammu & Kashmir', centers: ['Jammu', 'Srinagar'], partners: 20 },
  'Goa': { label: 'Goa', centers: ['Panaji', 'Margao'], partners: 15 },
  'Meghalaya': { label: 'Meghalaya', centers: ['Shillong'], partners: 12 },
  'Tripura': { label: 'Tripura', centers: ['Agartala'], partners: 10 },
};

const activeStates = indiaStates.filter((s) => network[s.name]);
const otherStates = indiaStates.filter((s) => !network[s.name]);

// Only states wide enough to hold their name get an inline label. Narrow ones
// (the Himalayan belt, the north-east, the coastal strips) would collide.
const labelled: Record<string, { dx?: number; dy?: number; short?: string }> = {
  'Rajasthan': {},
  'Gujarat': { dx: -4, dy: 6 },
  'Maharashtra': {},
  'Madhya Pradesh': {},
  'Uttar Pradesh': {},
  'Bihar': {},
  'West Bengal': { dx: -10, dy: 22, short: 'W. Bengal' },
  'Orissa': {},
  'Chhattisgarh': { dy: 8 },
  'Karnataka': { dx: -6 },
  'Tamil Nadu': { dy: 8 },
  'Andhra Pradesh': { dx: -18, dy: 6, short: 'Andhra' },
  'Telangana': {},
  'Assam': { dx: 10 },
};

const tooltipData = Object.fromEntries(
  Object.entries(network).map(([geo, v]) => [geo, { name: v.label, centers: v.centers, partners: v.partners }])
);
---

<section class="py-20 sm:py-28 lg:py-36 bg-white" aria-labelledby="network-heading">
  <div class="container-main">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="section-label">
        <span class="w-8 h-px bg-brand-500"></span>
        Service Network
      </span>
      <h2 id="network-heading" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mt-6 leading-tight">
        Service, <span class="text-gradient">Everywhere</span>
      </h2>
      <p class="mt-4 text-slate-500 text-base sm:text-lg">Pan-India network of service centers, partners, and distributors.</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start">
      <!-- Interactive Map -->
      <div class="relative">
        <div class="relative bg-slate-50 rounded-3xl border border-slate-100 p-4 sm:p-6 overflow-hidden" id="map-container">
          <!-- Legend -->
          <div class="flex items-center gap-4 mb-4 text-xs text-slate-500">
            <span class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-sm bg-brand-500"></span> Active States
            </span>
            <span class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-sm bg-slate-300"></span> Other States
            </span>
          </div>

          <!-- SVG Map -->
          <svg viewBox="0 0 600 700" class="w-full h-auto" role="img" aria-label="Map of India showing the states covered by the Qbits service network">
            <rect width="600" height="700" fill="transparent" />

            <!-- Inactive states -->
            {otherStates.map((s) => (
              <path d={s.path} fill="#e2e8f0" stroke="#cbd5e1" stroke-width="0.8" stroke-linejoin="round" />
            ))}

            <!-- Active states -->
            {activeStates.map((s) => (
              <path
                d={s.path}
                fill="#049D65"
                stroke="#ffffff"
                stroke-width="0.8"
                stroke-linejoin="round"
                class="map-state cursor-pointer transition-colors duration-300 hover:fill-brand-700"
                data-state={s.name}
              />
            ))}

            <!-- Labels sit above every shape so nothing paints over them -->
            {activeStates.filter((s) => labelled[s.name]).map((s) => (
              <text
                x={s.labelX + (labelled[s.name].dx ?? 0)}
                y={s.labelY + (labelled[s.name].dy ?? 0)}
                text-anchor="middle"
                dominant-baseline="middle"
                class="text-[9px] font-semibold fill-white pointer-events-none"
              >
                {labelled[s.name].short ?? network[s.name].label}
              </text>
            ))}
          </svg>

          <!-- Tooltip (inside map container) -->
          <div id="map-tooltip" class="absolute hidden z-20 bg-white rounded-2xl shadow-xl shadow-slate-900/10 border border-slate-100 p-4 w-64 pointer-events-none">
            <h4 id="tooltip-title" class="text-base font-bold text-slate-900 mb-1"></h4>
            <p class="text-xs text-slate-400 mb-3">Qbits Service Network</p>
            <div class="mb-3">
              <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 mb-1">Service Centers</p>
              <div id="tooltip-centers" class="flex flex-wrap gap-1"></div>
            </div>
            <div class="pt-3 border-t border-slate-100">
              <p id="tooltip-partners" class="text-lg font-bold text-brand-600"></p>
              <p class="text-[10px] text-slate-500">Service &amp; channel partners</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Content -->
      <div class="grid grid-cols-2 gap-5">
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100">
          <p class="text-3xl sm:text-4xl font-bold text-brand-600 mb-1">25+</p>
          <p class="text-sm text-slate-600 font-medium">States Covered</p>
        </div>
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100">
          <p class="text-3xl sm:text-4xl font-bold text-brand-600 mb-1">2,100+</p>
          <p class="text-sm text-slate-600 font-medium">Service Partners</p>
        </div>
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100">
          <p class="text-3xl sm:text-4xl font-bold text-brand-600 mb-1">130+</p>
          <p class="text-sm text-slate-600 font-medium">Channel Partners</p>
        </div>
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100">
          <p class="text-3xl sm:text-4xl font-bold text-brand-600 mb-1">&lt;12h</p>
          <p class="text-sm text-slate-600 font-medium">Response Time</p>
        </div>

        <!-- States list -->
        <div class="col-span-2 mt-4">
          <p class="text-sm font-semibold text-slate-900 mb-3">Active States</p>
          <div class="flex flex-wrap gap-2">
            {activeStates.map((s) => (
              <span class="px-3 py-1.5 rounded-full bg-slate-50 border border-slate-200 text-xs font-medium text-slate-600 hover:border-brand-300 hover:text-brand-600 transition-colors cursor-default">
                {network[s.name].label}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ stateData: tooltipData }}>
  const mapStates = document.querySelectorAll('.map-state');
  const tooltip = document.getElementById('map-tooltip');
  const tooltipTitle = document.getElementById('tooltip-title');
  const tooltipCenters = document.getElementById('tooltip-centers');
  const tooltipPartners = document.getElementById('tooltip-partners');
  const mapContainer = document.getElementById('map-container');

  function showTooltip(stateId, x, y) {
    const data = stateData[stateId];
    if (!data || !tooltip) return;

    tooltipTitle.textContent = data.name;
    tooltipPartners.textContent = data.partners + '+';
    tooltipCenters.innerHTML = data.centers.map((c) =>
      `<span class="px-2 py-0.5 rounded-full bg-brand-50 text-brand-600 text-[10px] font-medium">${c}</span>`
    ).join('');

    tooltip.classList.remove('hidden');

    // Position tooltip near the cursor but keep inside container
    const containerRect = mapContainer.getBoundingClientRect();
    let left = x - containerRect.left + 16;
    let top = y - containerRect.top + 16;

    // Prevent overflow
    const tooltipRect = tooltip.getBoundingClientRect();
    if (left + tooltipRect.width > containerRect.width) {
      left = x - containerRect.left - tooltipRect.width - 16;
    }
    if (top + tooltipRect.height > containerRect.height) {
      top = y - containerRect.top - tooltipRect.height - 16;
    }

    tooltip.style.left = left + 'px';
    tooltip.style.top = top + 'px';
  }

  function hideTooltip() {
    tooltip?.classList.add('hidden');
  }

  mapStates.forEach((el) => {
    el.addEventListener('mouseenter', (e) => {
      const stateId = el.getAttribute('data-state');
      if (stateId) showTooltip(stateId, e.clientX, e.clientY);
    });
    el.addEventListener('mousemove', (e) => {
      const stateId = el.getAttribute('data-state');
      if (stateId) showTooltip(stateId, e.clientX, e.clientY);
    });
    el.addEventListener('mouseleave', hideTooltip);
  });
</script>
