---
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

const onGridDocs = [
  {
    name: '1.5/2.0/2.7/3.0/3.3/3.6/4.0 KTS',
    desc: 'Single Phase & Single MPPT',
    link: '/datasheets/products/QB_Data-Sheet_2.0-4.0-kw_1MPPT_1Phs.pdf',
  },
  {
    name: 'QB-4/5/6 KTLD',
    desc: 'Single Phase & Dual MPPT',
    link: '/datasheets/products/QB_Data-Sheet_4.0-6.0-kw_2MPPT_1Phs.pdf',
  },
  {
    name: 'QB-4.6/5/6 KTLS',
    desc: 'Single Phase & Single MPPT',
    link: '/datasheets/products/QB_Data-Sheet_4.6-6.0-kw_1MPPT_1Phs.pdf',
  },
  {
    name: 'QB-6/8/10/12/15/17 KTLC',
    desc: 'Three Phase & Dual MPPT',
    link: '/datasheets/products/QB_Data-Sheet_6.0-17.0-kw_2MPPT_3Phs.pdf',
  },
  {
    name: 'QB-20/23/25/28/30 KTLC',
    desc: 'Three Phase & Dual MPPT',
    link: '/datasheets/products/QB_Data-Sheet_20.0-30.0-kw_3Phs.pdf',
  },
  {
    name: 'QB-30/33/36/40 KTLC-Pro',
    desc: 'Three Phase & Multi MPPT',
    link: '/datasheets/products/QB_Data-Sheet_30.0-40.0-kw_3Phs.pdf',
  },
  {
    name: 'QB-40/45/50 KTLC-Plus',
    desc: 'Three Phase & Multi MPPT',
    link: '/datasheets/products/QB_Data-Sheet_40.0-50.0-kw_3Phs.pdf',
  },
  {
    name: 'QB-50/60 KTLC',
    desc: 'Three Phase & Multi MPPT',
    link: '/datasheets/products/QB_Data-Sheet_50.0-60.0-kw_3Phs.pdf',
  },
  {
    name: 'QB-70/75/80/90/100/110 KTLC-Pro',
    desc: 'Three Phase & Multi MPPT',
    link: '/datasheets/products/QB_Data-Sheet_70.0-100.0-kw_3Phs.pdf',
  },
  {
    name: 'QB-80/90/100/110/125 KTLC',
    desc: 'Three Phase & Multi MPPT',
    link: '/datasheets/products/QB_Data-Sheet_80.0-125.0-kw_3Phs.pdf',
  },
  {
    name: 'QB-225/320 K-EHV',
    desc: 'Three Phase & Multi MPPT (Utility-Scale)',
    link: '/datasheets/products/QB_Data-Sheet_225.0-320.0-kw_3Phs_Utility-Scale.pdf',
  },
];

const hybridDocs = [
  {
    name: 'QBH-3KS/3K6S/4KS/4K6S/5KS/6KS48P',
    desc: 'Single Phase',
    link: '/datasheets/products/Qbits-Hybride-Inverter-Catalogue-1.pdf',
  },
  {
    name: 'QBH-7KS/7K6S/8KS48P',
    desc: 'Single Phase',
    link: '/datasheets/products/Qbits-Hybride-Inverter-Catalogue-2.pdf',
  },
  {
    name: 'QBH-5/6/7/8/10/12KS48P3',
    desc: 'Three Phase',
    link: '/datasheets/products/Qbits-Hybride-Inverter-Catalogue-3.pdf',
  },
];
---

<Layout
  title="Download Datasheets | Qbits Energy"
  description="Download product datasheets, manuals, warranty information, and certificates for all Qbits solar inverters."
  canonical="/download-datasheets/"
>
  <HeaderV2 />

  <main>
    <PageHeader
      label="Resources"
      title="Download"
      highlight="Datasheets"
      description="Access product datasheets, manuals, warranty documents, and certifications for all Qbits inverters."
    />

    <!-- Doc Types -->
    <section class="section-padding bg-white" aria-labelledby="doctypes-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Resources
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="doctypes-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Available Documents
          </h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-4xl mx-auto">
          {[
            { name: 'Datasheet', desc: 'Technical specifications and performance data' },
            { name: 'User Manual', desc: 'Installation and operation instructions' },
            { name: 'Warranty', desc: 'Warranty terms and claim procedures' },
            { name: 'Certificates', desc: 'BIS, IEC, and ISO certifications' },
          ].map(d => (
            <div class="bg-slate-50 rounded-2xl p-8 text-center">
              <div class="w-14 h-14 mx-auto rounded-xl bg-brand-100 flex items-center justify-center text-brand-600 mb-5">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">{d.name}</h3>
              <p class="text-sm text-slate-500">{d.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- On-Grid Datasheets -->
    <section class="section-padding bg-slate-50" aria-labelledby="ongrid-downloads-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            On-Grid Inverters
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="ongrid-downloads-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Qbits On-Grid Datasheets
          </h2>
        </div>

        <div class="max-w-5xl mx-auto">
          <div class="bg-white rounded-2xl shadow-xl shadow-slate-900/5 overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead class="bg-slate-950 text-white">
                  <tr>
                    <th class="text-left px-6 py-4 font-semibold">Product Name</th>
                    <th class="text-left px-6 py-4 font-semibold">Description</th>
                    <th class="text-left px-6 py-4 font-semibold">Download</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {onGridDocs.map((doc) => (
                    <tr class="hover:bg-brand-50/50 transition-colors">
                      <td class="px-6 py-5 font-medium text-slate-900">{doc.name}</td>
                      <td class="px-6 py-5 text-slate-500">{doc.desc}</td>
                      <td class="px-6 py-5">
                        <a href={doc.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-brand-600 hover:text-brand-700 font-medium text-xs">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                          Datasheet
                        </a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Hybrid Datasheets -->
    <section class="section-padding bg-white" aria-labelledby="hybrid-downloads-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Hybrid Inverters
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="hybrid-downloads-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Qbits Hybrid Datasheets
          </h2>
        </div>

        <div class="max-w-5xl mx-auto">
          <div class="bg-white rounded-2xl shadow-xl shadow-slate-900/5 overflow-hidden border border-slate-200">
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead class="bg-slate-950 text-white">
                  <tr>
                    <th class="text-left px-6 py-4 font-semibold">Product Name</th>
                    <th class="text-left px-6 py-4 font-semibold">Description</th>
                    <th class="text-left px-6 py-4 font-semibold">Download</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {hybridDocs.map((doc) => (
                    <tr class="hover:bg-accent/5 transition-colors">
                      <td class="px-6 py-5 font-medium text-slate-900">{doc.name}</td>
                      <td class="px-6 py-5 text-slate-500">{doc.desc}</td>
                      <td class="px-6 py-5">
                        <a href={doc.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-accent hover:text-accent-dark font-medium text-xs">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                          Datasheet
                        </a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 lg:py-32 bg-slate-950 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-brand-500/10 via-transparent to-accent/10"></div>
      <div class="container-main relative text-center max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">Can't Find What You Need?</h2>
        <p class="text-lg text-slate-400 mb-10">Contact our support team for additional documentation or technical assistance.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/contact-us/" class="btn-primary">Contact Support</a>
          <a href="https://wa.me/919979192935" target="_blank" rel="noopener" class="btn-outline">WhatsApp Us</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
