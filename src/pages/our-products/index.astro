---
import Layout from '../../layouts/Layout.astro';
import HeaderV2 from '../../components/HeaderV2.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { products } from '../../data/products';

const onGridProducts = products.filter(p => p.category === 'on-grid');
const hybridProducts = products.filter(p => p.category === 'hybrid');

const featureIcons: Record<string, string> = {
  '8 + 4 Year Warranty': 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
  'IP66 Weather Protection': 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  'AI WhatsApp Monitoring': 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
  'Wi-Fi/4G/Bluetooth': 'M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0',
  'Digital Warranty': 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  '50V DC Start-up': 'M13 10V3L4 14h7v7l9-11h-7z',
  'Built-in DC/AC SPD': 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
  '90V-290V AC Range': 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  '100% DC Oversizing': 'M5 10l7-7m0 0l7 7m-7-7v18',
  '750W Panel Support': 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z',
  '98% Efficiency': 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
  'BIS/IEC Certified': 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z',
  '120A Battery Charge/Discharge': 'M13 10V3L4 14h7v7l9-11h-7z',
  '2x Peak Power 15s': 'M3 21v-8a2 2 0 012-2h14a2 2 0 012 2v8M3 7v-2a2 2 0 012-2h14a2 2 0 012 2v2M3 7h18M9 14v2m6-2v2',
  'UPS Switching <10s': 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  'Lead-acid & Lithium': 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
};

function getFeatureIcon(feature: string): string {
  for (const [key, icon] of Object.entries(featureIcons)) {
    if (feature.includes(key)) return icon;
  }
  return 'M5 13l4 4L19 7';
}

const SITE = 'https://qbitsenergy.com';
const productListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Qbits Solar Inverter Lineup',
  description: 'Complete range of Qbits on-grid and hybrid solar inverters for residential, commercial, and industrial use across India.',
  numberOfItems: products.length,
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: p.name,
      url: `${SITE}/our-products/${p.id}/`,
      image: p.image ? `${SITE}${p.image}` : `${SITE}/og-image.webp`,
      sku: p.id,
      brand: { '@type': 'Brand', name: 'Qbits Energy' },
      category: p.category === 'on-grid' ? 'On-Grid Solar Inverter' : 'Hybrid Solar Inverter',
    },
  })),
};
---

<Layout
  title="Solar Inverters India - On-Grid & Hybrid | Qbits Energy"
  description="Explore Qbits range of on-grid and hybrid solar inverters. From 1kW residential to 320kW commercial solutions. BIS certified with 8 + 4 year warranty."
  canonical="/our-products/"
>
  <HeaderV2 />
  <script type="application/ld+json" set:html={JSON.stringify(productListSchema)} />

  <main id="main-content">
    <!-- Hero -->
    <section class="relative pt-28 pb-16 lg:pt-36 lg:pb-24 overflow-hidden bg-slate-950" aria-labelledby="hero-heading">
      <div class="absolute inset-0 hidden md:block">
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/90 to-slate-950/70 z-10"></div>
        <img width="1920" height="1080" src="/images/products-bg.webp" alt="" class="w-full h-full object-cover opacity-40" loading="eager" />
      </div>
      <div class="container-main relative z-20 text-center md:text-left">
        <span class="section-label text-brand-400 justify-center md:justify-start">
          <span class="w-8 h-px bg-brand-500"></span>
          Our Products
        </span>
        <h1 id="hero-heading" class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mt-6 leading-tight max-w-4xl mx-auto md:mx-0">
          Solar Inverters <span class="text-gradient">Built For India</span>
        </h1>
        <p class="mt-6 text-lg text-slate-400 max-w-3xl leading-relaxed mx-auto md:mx-0">
          At Qbits Energy, we don't just make inverters - we design peace of mind. Built for Indian homes and businesses, our solar inverters deliver steady, efficient, and intelligent power in every condition. Whether it's your cozy home, busy office, or large industrial setup - Qbits gives you clean energy, easy control, and lasting reliability.
        </p>
        <p class="mt-4 text-lg text-slate-400 max-w-3xl leading-relaxed mx-auto md:mx-0">
          Explore our range of On-Grid and Hybrid Solar Inverters, thoughtfully designed to make solar energy simpler and more rewarding.
        </p>
        <div class="mt-8">
          <a href="/download-datasheets/" class="btn-primary">Download Data Sheet</a>
        </div>
        <!-- Product Image - Mobile Only -->
        <div class="mt-10 md:hidden flex justify-center">
          <img width="720" height="720" src="/product-images/product-image.webp" alt="Qbits Solar Inverter" class="max-h-[260px] w-auto object-contain" loading="eager" />
        </div>
      </div>
    </section>

    <!-- On-Grid Inverters -->
    <section class="section-padding bg-white" aria-labelledby="ongrid-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            On-Grid Inverters
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="ongrid-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Grid-Tied Solar Solutions
          </h2>
          <p class="mt-4 text-slate-500">
            High-efficiency grid-tied inverters that convert DC solar power to AC for direct grid export or self-consumption.
          </p>
        </div>

        <div class="space-y-8 max-w-5xl mx-auto">
          {onGridProducts.map((product, i) => (
            <div class="group bg-white rounded-2xl border border-slate-200 overflow-hidden hover:border-brand-200 hover:shadow-xl hover:shadow-brand-500/5 transition-all duration-500">
              <div class="grid md:grid-cols-2 gap-0">
                <!-- Product Image -->
                <div class="relative bg-gradient-to-br from-slate-50 to-slate-100 p-8 flex items-center justify-center min-h-[280px]">
                  {product.image ? (
                    <img width="720" height="480" src={product.image} alt={product.name} class="max-h-[220px] w-auto object-contain group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                  ) : (
                    <div class="w-20 h-20 rounded-xl bg-slate-200 border border-slate-300 flex items-center justify-center">
                      <svg class="w-10 h-10 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                      </svg>
                    </div>
                  )}
                </div>
                <!-- Product Info -->
                <div class="p-8 flex flex-col justify-center">
                  <div class="flex items-center gap-3 mb-3">
                    <span class="text-xs font-bold uppercase tracking-wider text-brand-600 bg-brand-50 px-3 py-1.5 rounded-full">
                      {product.series} Series
                    </span>
                    <span class="text-xs text-slate-400">
                      {product.phase === 'single' ? 'Single-phase' : 'Three-phase'} & {product.mpptLabel}
                    </span>
                  </div>
                  <h3 class="text-2xl font-bold text-slate-900 mb-4">{product.name}</h3>

                  <!-- Features -->
                  <div class="grid grid-cols-2 gap-3 mb-6">
                    {product.features.slice(0, 4).map(feature => (
                      <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-lg bg-brand-100 flex items-center justify-center text-brand-600 flex-shrink-0">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={getFeatureIcon(feature)}/>
                          </svg>
                        </div>
                        <span class="text-xs text-slate-600 font-medium leading-tight">{feature}</span>
                      </div>
                    ))}
                  </div>

                  <div class="flex items-center gap-4">
                    <a href="/download-datasheets/" class="inline-flex items-center gap-2 rounded-full bg-brand-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-500/20 hover:bg-brand-600 transition-all">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                      Download Data Sheet
                    </a>
                    <a href={`/our-products/${product.id}/`} class="text-sm font-semibold text-brand-600 hover:text-brand-700">
                      View Details →
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Hybrid Inverters -->
    <section class="section-padding bg-slate-50" aria-labelledby="hybrid-heading">
      <div class="container-main">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="section-label justify-center">
            <span class="w-8 h-px bg-brand-500"></span>
            Hybrid Inverters
            <span class="w-8 h-px bg-brand-500"></span>
          </span>
          <h2 id="hybrid-heading" class="text-3xl sm:text-4xl font-bold text-slate-900 mt-6">
            Battery-Ready Power Solutions
          </h2>
          <p class="mt-4 text-slate-500">
            Intelligent battery-ready inverters that store excess solar energy for use during power cuts or peak hours.
          </p>
        </div>

        <div class="space-y-8 max-w-5xl mx-auto">
          {hybridProducts.map((product) => (
            <div class="group bg-white rounded-2xl border border-slate-200 overflow-hidden hover:border-accent/30 hover:shadow-xl hover:shadow-accent/5 transition-all duration-500">
              <div class="grid md:grid-cols-2 gap-0">
                <!-- Product Image -->
                <div class="relative bg-gradient-to-br from-slate-50 to-slate-100 p-8 flex items-center justify-center min-h-[280px]">
                  {product.image ? (
                    <img width="720" height="480" src={product.image} alt={product.name} class="max-h-[220px] w-auto object-contain group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                  ) : (
                    <div class="w-20 h-20 rounded-xl bg-slate-200 border border-slate-300 flex items-center justify-center">
                      <svg class="w-10 h-10 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                      </svg>
                    </div>
                  )}
                </div>
                <!-- Product Info -->
                <div class="p-8 flex flex-col justify-center">
                  <div class="flex items-center gap-3 mb-3">
                    <span class="text-xs font-bold uppercase tracking-wider text-accent bg-accent/10 px-3 py-1.5 rounded-full">
                      {product.series} Series
                    </span>
                    <span class="text-xs text-slate-400">
                      {product.phase === 'single' ? 'Single-phase' : 'Three Phase'}
                    </span>
                  </div>
                  <h3 class="text-2xl font-bold text-slate-900 mb-4">{product.name}</h3>

                  <!-- Features -->
                  <div class="grid grid-cols-2 gap-3 mb-6">
                    {product.features.slice(0, 4).map(feature => (
                      <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center text-accent flex-shrink-0">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={getFeatureIcon(feature)}/>
                          </svg>
                        </div>
                        <span class="text-xs text-slate-600 font-medium leading-tight">{feature}</span>
                      </div>
                    ))}
                  </div>

                  <div class="flex items-center gap-4">
                    <a href="/download-datasheets/" class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-accent/20 hover:bg-accent-dark transition-all">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                      Download Data Sheet
                    </a>
                    <a href={`/our-products/${product.id}/`} class="text-sm font-semibold text-accent hover:text-accent-dark">
                      View Details →
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 lg:py-32 bg-brand-500 text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="container-main relative text-center max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold mb-6">Need Help Choosing?</h2>
        <p class="text-lg text-brand-100 mb-10">Our solar experts can recommend the perfect inverter for your installation. Get a free consultation today.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/contact-us/" class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-8 py-4 text-sm font-semibold text-brand-600 shadow-lg hover:bg-brand-50 transition-all">Contact Sales</a>
          <a href="/download-datasheets/" class="btn-outline">Download Datasheets</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
