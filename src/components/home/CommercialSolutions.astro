---
const benefits = [
  { title: 'Higher ROI', desc: 'Maximize returns with 98.8% efficiency and minimal maintenance costs.', icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  { title: 'Reliability', desc: 'Engineered for 24/7 operation with advanced thermal management.', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
  { title: 'Remote Monitoring', desc: 'Monitor multiple sites from a single dashboard in real-time.', icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
  { title: 'Fleet Management', desc: 'Centralized management for large-scale solar installations.', icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10' },
];
---

<section class="py-20 sm:py-28 lg:py-36 bg-slate-50 overflow-hidden" aria-labelledby="commercial-heading">
  <div class="container-main">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <!-- Content -->
      <div>
        <span class="section-label">
          <span class="w-8 h-px bg-brand-500"></span>
          Commercial & Industrial
        </span>
        <h2 id="commercial-heading" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mt-6 leading-tight">
          Built For <span class="text-gradient">Commercial Scale</span>
        </h2>
        <p class="mt-6 text-base sm:text-lg text-slate-600 leading-relaxed max-w-lg">
          From factories and warehouses to office complexes and hospitals, Qbits C&I inverters deliver the power, reliability, and intelligence that large-scale operations demand.
        </p>

        <div class="mt-10 grid sm:grid-cols-2 gap-5">
          {benefits.map((item) => (
            <div class="group p-5 rounded-2xl bg-white border border-slate-100 hover:border-brand-200 hover:shadow-lg hover:shadow-brand-500/5 transition-all duration-300">
              <div class="w-10 h-10 rounded-xl bg-brand-500/10 flex items-center justify-center mb-4 group-hover:bg-brand-500 group-hover:scale-110 transition-all duration-300">
                <svg class="w-5 h-5 text-brand-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon}/>
                </svg>
              </div>
              <h3 class="text-base font-bold text-slate-900 mb-1">{item.title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>

        <div class="mt-10">
          <a href="/c-i-solution/" class="btn-primary">
            Explore C&I Solutions
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Image -->
      <div class="relative">
        <div class="aspect-[4/5] rounded-3xl overflow-hidden bg-slate-200">
          <img
            src="/images/ongrid-commercial.jpg"
            alt="Commercial solar installation with Qbits inverter"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="absolute -bottom-6 -left-6 w-48 h-48 bg-brand-500/5 rounded-full blur-3xl"></div>
        <div class="absolute -top-6 -right-6 w-32 h-32 bg-accent/5 rounded-full blur-2xl"></div>
      </div>
    </div>
  </div>
</section>
